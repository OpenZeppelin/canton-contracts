-- | Experimental identity hook upgrade baseline, version 0.1.0.
--
-- This package is a non-public D3 forward-compatibility spike for root
-- PLAN.md -> "June Decision Gate". D3 remains deferred and v1 remains
-- single-domain; this package only provides the baseline surface later checked
-- through Daml Smart Contract Upgrades.
--
-- Not public M1 surface. The runtime flag must be present on every toy
-- contract so downstream code cannot accidentally treat the shape as stable.
module OpenZeppelin.Experimental.Identity.Upgrade where

data OpaqueIdentityAttestation = OpaqueIdentityAttestation with
    envelope : Text
  deriving (Eq, Show)

experimentalFeatureFlag : Text
experimentalFeatureFlag = "experimental.identity-hook-upgrade.enabled"

-- | Toy issuer registry used only to mint the baseline holding.
--
-- Signatories: `issuer`.
-- Observers: none.
-- Controllers: `issuer` controls `ToyRegistry_Mint`.
-- Choices: `ToyRegistry_Mint`.
-- Disclosed parties: the issuer discloses the registry only to test flows or
-- parties that need to mint toy holdings.
-- Privacy expectations: registry configuration is private to the issuer unless
-- explicitly disclosed.
-- Authorization assumptions: this is a stub issuer authority, not a D4
-- multi-sig decision. D4 remains open, so the issuer party can later be backed
-- by either an on-ledger multi-sig contract or a Canton topology multi-hosted
-- party without this experiment choosing between them.
-- Archival behavior: nonconsuming mint; the registry persists.
-- Failure modes: mint rejects if the experimental feature flag is absent or the
-- amount is non-positive.
-- Upgrade and migration assumptions: this v0.1.0 registry is the old package in
-- the SCU chain. Later versions may add optional fields or new choices, but
-- this mint choice signature must remain valid for old consumer code.
template ToyRegistry
  with
    issuer : Party
    featureFlag : Text
  where
    signatory issuer

    nonconsuming choice ToyRegistry_Mint : ContractId ToyHolding
      with
        owner : Party
        amount : Int
      controller issuer
      do
        requireExperimentalFlag featureFlag
        assertMsg eNonPositiveAmount (amount > 0)
        create ToyHolding with
          issuer
          owner
          amount
          featureFlag

-- | Toy transferable holding used as the baseline transfer hook surface.
--
-- Signatories: `issuer`, so issuer authority can create successor holdings
-- during owner-controlled transfer.
-- Observers: `owner`.
-- Controllers: `owner` controls `ToyHolding_Transfer`.
-- Choices: `ToyHolding_Transfer`.
-- Disclosed parties: current owner observes the holding; successor owners
-- observe only the successor contract. The opaque attestation is a choice
-- argument and does not create a separately-staked attestation contract.
-- Privacy expectations: holdings are private to issuer and current owner; the
-- identity proof's meaning stays outside this package and is not exposed as
-- typed Daml fields.
-- Authorization assumptions: the transfer hook verifies only that an opaque
-- attestation envelope was supplied. Subject binding, issuer trust, freshness,
-- and proof semantics must be enforced by the single-domain node/operator layer
-- before this toy transfer is submitted.
-- Archival behavior: transfer is consuming and creates a successor holding for
-- `newOwner`.
-- Failure modes: an empty envelope is rejected; stale, wrong-subject,
-- wrong-issuer, or otherwise invalid-looking envelopes are accepted on-ledger
-- because v0.1.0 deliberately does not inspect the attestation contents.
-- Upgrade and migration assumptions: this is the baseline M1 stand-in. The
-- transfer choice argument and return type are the compatibility boundary for
-- the v0.2.0 SCU check.
template ToyHolding
  with
    issuer : Party
    owner : Party
    amount : Int
    featureFlag : Text
  where
    signatory issuer
    observer owner

    choice ToyHolding_Transfer : ContractId ToyHolding
      with
        newOwner : Party
        identityAttestation : OpaqueIdentityAttestation
      controller owner
      do
        requireExperimentalFlag featureFlag
        assertMsg eSelfTransfer (newOwner /= owner)
        requireOpaqueIdentityAttestation identityAttestation
        create this with owner = newOwner

requireOpaqueIdentityAttestation : OpaqueIdentityAttestation -> Update ()
requireOpaqueIdentityAttestation attestation =
  assertMsg eMissingAttestation (attestation.envelope /= "")

requireExperimentalFlag : Text -> Update ()
requireExperimentalFlag flag =
  assertMsg eFeatureDisabled (flag == experimentalFeatureFlag)

eFeatureDisabled : Text
eFeatureDisabled = "IdentityHookUpgrade: experimental feature flag disabled"

eNonPositiveAmount : Text
eNonPositiveAmount = "IdentityHookUpgrade: amount must be positive"

eSelfTransfer : Text
eSelfTransfer = "IdentityHookUpgrade: self-transfer is not part of the toy flow"

eMissingAttestation : Text
eMissingAttestation = "IdentityHookUpgrade: opaque identity attestation is missing"
