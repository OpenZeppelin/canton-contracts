-- | Allocation template implementing the Token Standard V2 `Allocation`
-- interface.
module OpenZeppelin.TokenCIP112V1.Allocation where

import DA.Assert (assertDeadlineExceeded, assertWithinDeadline)
import DA.Foldable (forA_)
import DA.List (dedupSort)
import DA.Map qualified as Map
import DA.Optional (fromOptional, isNone, isSome)
import DA.TextMap qualified as TextMap
import DA.Time (RelTime, addRelTime, convertMicrosecondsToRelTime)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.Api.Token.TransferEventsV2 qualified as TransferEventsV2
import Splice.TokenStandard.Utils

import OpenZeppelin.TokenCIP112V1.Base
import OpenZeppelin.TokenCIP112V1.Holding

-- | Per-allocation proof that the settlement factory ran its exact-cover
-- validation for this settlement and this authorizer's leg set.
--
-- `Allocation_Settle` is a plain interface choice whose actor set is admin plus
-- executors — the same parties who drive a batch — so without this proof they
-- could settle allocations one at a time, bypassing the cover check and
-- thereby minting or burning value. The factory mints one of these per
-- allocation and hands it over through the choice context; the settle body
-- consumes it.
--
-- It carries only data the allocation's own stakeholders already have, so
-- fetching it does not divulge sibling allocations.
template BatchSettlementAuthorization with
    admin : Party
    settlement : AllocationV2.SettlementInfo
    authorizer : HoldingV2.Account
    transferLegSides : [AllocationV2.TransferLegSide]
      -- ^ The effective leg set for this iteration: the allocation's own legs
      -- plus the executor-supplied extra legs the cover check validated.
    nextIterationFunding : Optional (TextMap.TextMap Decimal)
      -- ^ The next-iteration reservation the factory validated, `None` when
      -- this settlement ends the iteration chain.
  where
    signatory admin

-- | A ready-to-settle allocation backed by locked holdings. When
-- `allocation.nextIterationFunding` is set, iterated settlement is enabled:
-- each settle may carry executor-supplied extra transfer legs and reserve
-- funding for a successor allocation, created in the same transaction.
template TokenAllocation with
    originalAllocationCid : Optional (ContractId AllocationV2.Allocation)
    settlement : AllocationV2.SettlementInfo
    allocation : AllocationV2.AllocationSpecification
    lockedHoldingCids : [ContractId TokenHolding]
    requestedAt : Time
      -- ^ The wallet-supplied request time, retained so stale or replayed
      -- allocate requests remain diagnosable after the fact.
    createdAt : Time
      -- ^ When the original allocation was created; carried unchanged onto
      -- iteration successors.
    numIterations : Int
      -- ^ Settlement iterations executed so far; zero for the original
      -- allocation.
    expiresAt : Time
    lockExpiresAt : Time
      -- ^ When the funding lock expires. Strictly after `expiresAt`, so there
      -- is always a window in which the admin's expiry path is guaranteed to
      -- succeed before the authorizer can re-spend the funding.
    maxTTL : RelTime
      -- ^ The registry's storage bound, snapshotted at allocation time so each
      -- settlement iteration can bump the successor's expiry without reaching
      -- back to the registry contract.
    lockGrace : RelTime
      -- ^ How long the funding lock outlives `expiresAt`, snapshotted from the
      -- registry so every iteration reproduces the admin's guaranteed expiry
      -- window.
  where
    signatory allocation.admin, accountParties allocation.admin allocation.authorizer
    observer settlement.executors
    ensure isValidSettlementInfoV2 settlement
      && isValidAllocationSpecificationV2 (const True) allocation
      -- A reservation draws on a regular account's holdings; special
      -- (mint/burn) accounts hold nothing to reserve.
      && (isNone allocation.nextIterationFunding || isRegularAccount allocation.authorizer)
      && numIterations >= 0
      && expiresAt < lockExpiresAt
      && maxTTL > convertMicrosecondsToRelTime 0
      && lockGrace > convertMicrosecondsToRelTime 0
      -- A committed allocation with no settlement deadline can never be
      -- withdrawn (the standard's own `ensureWithdrawIsAllowed` fails closed),
      -- so refuse to create that shape at all.
      && (not allocation.committed || isSome allocation.settlementDeadline)

    interface instance AllocationV2.Allocation for TokenAllocation where
      view = AllocationV2.AllocationView with
        originalAllocationCid
        settlement
        allocation
        holdingCids = map (toInterfaceContractId @HoldingV2.Holding) lockedHoldingCids
        createdAt
        numIterations
        expiresAt = Some expiresAt
        availableActions = allocationAvailableActions this
        meta = emptyMetadata

      -- The contract observers (executors) see every lifecycle exercise
      -- regardless of which actor subset invoked it.
      allocation_settleExtraObservers _ = observer this
      allocation_cancelExtraObservers _ = observer this
      allocation_withdrawExtraObservers _ = observer this

      allocation_settleImpl self arg = do
        archiveAndCheckActors self arg.actors [allocation.admin :: settlement.executors]
        -- Re-checked here even when driven by the settlement factory: this
        -- choice is also directly callable by admin plus executors.
        forA_ allocation.settlementDeadline (assertWithinDeadline "allocation.settlementDeadline")
        -- The factory's cover check is only enforceable if this choice refuses
        -- to run without the factory's proof.
        _ <- requireBatchAuthorization this arg
        validateNextIterationArgs "Allocation_Settle" (isSome allocation.nextIterationFunding)
          arg.extraTransferLegSides arg.nextIterationFunding
        settleAllocation self this arg.extraTransferLegSides arg.nextIterationFunding

      allocation_withdrawImpl self arg = do
        archiveAndCheckActors self arg.actors [accountParties allocation.admin allocation.authorizer]
        ensureWithdrawIsAllowed allocation
        holdings <- unlockAndLog this "allocation withdrawn"
        pure AllocationV2.AllocationResult with
          output = AllocationV2.AllocationResult_Withdrawn
          authorizerHoldingCids = holdings
          meta = emptyMetadata

      allocation_cancelImpl self arg = do
        -- Executors may cancel any time; the admin only once `expiresAt` has
        -- passed (checked by the default implementation).
        allocationV2_cancelDefaultImpl (toInterface this) self arg $ do
          holdings <- unlockAndLog this "allocation cancelled"
          pure (holdings, emptyMetadata)

    -- | Last-resort admin cleanup for an allocation whose funding was already
    -- reclaimed elsewhere (the authorizer re-spent it as an expired-lock input,
    -- or self-unlocked it), which makes every fund-returning path fail on the
    -- archived holding. Only available once the funding lock has expired, by
    -- which time the authorizer can always recover the holding themselves via
    -- `TokenHolding_OwnerUnlock`, so this can never strand funds.
    choice TokenAllocation_AdminGC : ()
      controller allocation.admin
      do assertDeadlineExceeded "allocation lockExpiresAt" lockExpiresAt


-- View helpers
---------------

-- | Actions wallets may take, reported to exactly match what the choice bodies
-- accept. The standard's default helper advertises withdraw for the account
-- principal alone, but withdrawing re-creates the holding, whose signatories
-- include every account party — so the joint set is what the implementation
-- requires and therefore what must be advertised.
allocationAvailableActions
  : TokenAllocation -> Map.Map AllocationV2.AllocationAction [[Party]]
allocationAvailableActions this = Map.fromList $
  [ (AllocationV2.AA_Cancel, [dedupSort this.settlement.executors])
  , (AllocationV2.AA_Settle, [dedupSort (this.allocation.admin :: this.settlement.executors)])
  ] <>
  [ (AllocationV2.AA_Withdraw, [accountParties this.allocation.admin this.allocation.authorizer])
  | not this.allocation.committed || isSome this.allocation.settlementDeadline
  ]


-- Settlement internals
-----------------------

-- | Read and consume the factory's per-allocation authorization, checking it
-- covers exactly this allocation's settlement, authorizer, effective leg set
-- (the allocation's own legs plus the settle call's extra legs), and
-- next-iteration reservation. Binding the extra legs and the reservation to
-- the admin-signed proof means a settle can only ever run with the exact
-- iteration arguments the factory's cover check validated.
requireBatchAuthorization
  : TokenAllocation -> AllocationV2.Allocation_Settle -> Update BatchSettlementAuthorization
requireBatchAuthorization this arg = do
  authCid <- case TextMap.lookup batchAuthorizationContextKey arg.extraArgs.context.values of
    Some (AV_ContractId anyCid) ->
      pure (fromAnyContractId anyCid : ContractId BatchSettlementAuthorization)
    Some _ -> fail "batch authorization context value must be a contract id"
    None -> fail
      "Allocation_Settle requires the settlement factory's batch authorization; \
      \settle through SettlementFactory_SettleBatch"
  auth <- fetch authCid
  archive authCid
  require' ("authorization.admin", auth.admin) isEqualR ("allocation.admin", this.allocation.admin)
  require' ("authorization.settlement", auth.settlement) isEqualR ("allocation.settlement", this.settlement)
  require' ("authorization.authorizer", auth.authorizer)
    isEqualR ("allocation.authorizer", this.allocation.authorizer)
  require' ("authorization.transferLegSides", dedupSort auth.transferLegSides)
    isEqualR ("allocation effective transferLegSides",
      dedupSort (this.allocation.transferLegSides <> arg.extraTransferLegSides))
  require' ("authorization.nextIterationFunding", auth.nextIterationFunding)
    isEqualR ("Allocation_Settle.nextIterationFunding", arg.nextIterationFunding)
  pure auth

-- | Net settlement of one allocation: consume the locked funds, add the
-- authorizer's net credit per instrument across the effective legs (the
-- allocation's own plus the executor-supplied extra legs), require every total
-- to be non-negative (an under-funded sender fails closed), reserve the
-- requested next-iteration funding as freshly locked holdings, and pay out the
-- remainder as unlocked holdings.
--
-- When a reservation is requested — including an empty one — a successor
-- allocation backed by the reserved holdings is created and returned, with an
-- empty leg set, a bumped storage expiry (the standard's recommendation), and
-- the commitment and deadline carried over. `authorizerHoldingCids` reports
-- only the unlocked payouts; the reserved holdings are visible through the
-- successor's view.
settleAllocation
  : ContractId AllocationV2.Allocation -> TokenAllocation
  -> [AllocationV2.TransferLegSide] -> Optional (TextMap.TextMap Decimal)
  -> Update AllocationV2.AllocationResult
settleAllocation self this extraTransferLegSides nextIterationFunding = do
  let admin = this.allocation.admin
      authorizer = this.allocation.authorizer
      effectiveLegSides = this.allocation.transferLegSides <> extraTransferLegSides
      reserveAmounts = fromOptional TextMap.empty nextIterationFunding
  lockedAmounts <- debitHoldings (fetchAndArchiveLockedHolding admin authorizer) this.lockedHoldingCids
  let netAmounts = netAllocationCreditAmounts authorizer effectiveLegSides
      totalAmounts = textMapUnionWith (+) lockedAmounts netAmounts

  -- The reserved holdings get a fresh lock window, bumped per iteration within
  -- the same deadline bound the original allocation was created under; the
  -- bump is monotone because `computeStorageExpiry` grows with `now`.
  now <- getTime
  let newExpiresAt = computeStorageExpiry this.maxTTL now this.allocation.settlementDeadline
      newLockExpiresAt = newExpiresAt `addRelTime` this.lockGrace
      lock = HoldingV2.Lock with
        holders = dedupSort (admin :: this.settlement.executors)
        expiresAt = Some newLockExpiresAt
        expiresAfter = None
        context = Some ("allocation for settlement " <> this.settlement.id)

  lockedAndPayouts <- forA (TextMap.toList (textMapMergeWithDefault (0.0, 0.0) totalAmounts reserveAmounts)) $
    \(instrumentId, (total, reserve)) -> do
      require' ("locked funds plus net credit for " <> instrumentId, total)
        isGreaterOrEqualR ("zero", 0.0)
      require' ("locked funds plus net credit for " <> instrumentId, total)
        isGreaterOrEqualR ("requested next-iteration funding", reserve)
      newLockedCids <-
        if reserve > 0.0
          then (:: []) <$> createTokenHolding admin authorizer instrumentId reserve (Some lock)
          else pure []
      payoutCids <-
        if total - reserve > 0.0
          then do
            cid <- createTokenHolding admin authorizer instrumentId (total - reserve) None
            pure [(instrumentId, [toInterfaceContractId @HoldingV2.Holding cid])]
          else pure []
      pure (newLockedCids, payoutCids)

  let newLockedHoldingCids = concatMap fst lockedAndPayouts
      payoutCids = TextMap.fromListWithR (++) (concatMap snd lockedAndPayouts)

  nextIterationAllocationCid <- case nextIterationFunding of
    None -> pure None
    Some reserve -> do
      successorCid <- create this with
        -- Successors point at the chain's original allocation.
        originalAllocationCid = Some (fromOptional self this.originalAllocationCid)
        allocation = this.allocation with
          -- The specified legs settle in the first iteration only.
          transferLegSides = []
          nextIterationFunding = Some reserve
        lockedHoldingCids = newLockedHoldingCids
        numIterations = this.numIterations + 1
        expiresAt = newExpiresAt
        lockExpiresAt = newLockExpiresAt
      pure (Some (toInterfaceContractId @AllocationV2.Allocation successorCid))

  emitHoldingsChange admin authorizer this.settlement.executors
    (map toInterfaceContractId this.lockedHoldingCids)
    (map toInterfaceContractId newLockedHoldingCids <> concat (textMapValues payoutCids))
    (map toEventLegSide effectiveLegSides)
    "allocation settled"
  pure AllocationV2.AllocationResult with
    output = AllocationV2.AllocationResult_Settled with nextIterationAllocationCid
    authorizerHoldingCids = payoutCids
    meta = emptyMetadata

-- | Release the locked holdings to the authorizer and log the change.
unlockAndLog : TokenAllocation -> Text -> Update (TextMap.TextMap [ContractId HoldingV2.Holding])
unlockAndLog this reason = do
  let admin = this.allocation.admin
  holdings <- unlockHoldings admin this.allocation.authorizer this.lockedHoldingCids
  emitHoldingsChange admin this.allocation.authorizer this.settlement.executors
    (map toInterfaceContractId this.lockedHoldingCids)
    (concat (textMapValues holdings))
    []
    reason
  pure holdings

toEventLegSide : AllocationV2.TransferLegSide -> TransferEventsV2.TransferLegSide
toEventLegSide s = TransferEventsV2.TransferLegSide with
  transferLegId = s.transferLegId
  side = case s.side of
    AllocationV2.SenderSide -> TransferEventsV2.SenderSide
    AllocationV2.ReceiverSide -> TransferEventsV2.ReceiverSide
  otherside = s.otherside
  amount = s.amount
  instrumentId = s.instrumentId
  meta = s.meta

