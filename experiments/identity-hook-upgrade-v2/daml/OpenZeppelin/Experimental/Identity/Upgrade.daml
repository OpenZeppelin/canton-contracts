-- | Experimental identity hook upgrade, version 0.2.0.
--
-- This package is a non-public D3 forward-compatibility spike for root
-- PLAN.md -> "June Decision Gate". D3 remains deferred and v1 remains
-- single-domain; this package checks whether typed identity-claim semantics can
-- be added through Daml Smart Contract Upgrades without changing the baseline
-- transfer choice.
--
-- Not public M1 surface. The runtime flag must be present on every toy
-- contract so downstream code cannot accidentally treat the shape as stable.
module OpenZeppelin.Experimental.Identity.Upgrade where

data OpaqueIdentityAttestation = OpaqueIdentityAttestation with
    envelope : Text
  deriving (Eq, Show)

data IdentityClaimKind
  = KYC_VALIDATED
  | OTHER_IDENTITY_CLAIM
  deriving (Eq, Show)

data IdentityExtensionConfig = IdentityExtensionConfig with
    trustedIssuers : [Party]
  deriving (Eq, Show)

experimentalFeatureFlag : Text
experimentalFeatureFlag = "experimental.identity-hook-upgrade.enabled"

-- | Typed identity claim used by the v0.2.0 extension choice.
--
-- Signatories: `claimSigner`, the party whose ledger signature makes the claim
-- unforgeable in this toy model.
-- Observers: `subjectParty`, the identity subject expected to disclose the
-- claim for transfer verification.
-- Controllers: none; the typed transfer hook fetches the claim by disclosed
-- `ContractId` and does not archive it.
-- Choices: none.
-- Disclosed parties: claim signer and subject party are stakeholders; the typed
-- transfer requires the subject/new owner to co-authorize so the claim can be
-- fetched without turning recipient KYC status into owner-visible public data.
-- Privacy expectations: the claim is visible only to the signer, subject, and
-- explicitly-disclosed verifiers. This toy stores no PII, only typed metadata.
-- Authorization assumptions: the hook checks that the claim is signed by its
-- declared issuer, that the issuer is trusted by the holding's extension
-- config, that the claim subject is the new owner, that the kind is
-- `KYC_VALIDATED`, and that the claim has not expired. It does not implement
-- production ONCHAINID keys, ERC-735 claim topics, revocation registries, or
-- issuer key rotation.
-- Archival behavior: no choices; claims remain reusable until expiry because a
-- KYC credential is not a one-transfer compliance token.
-- Failure modes: stale, wrong-subject, signer/declared-issuer mismatch,
-- untrusted issuer, and wrong claim kind fail on-ledger; `claimId` is
-- non-enforcing metadata and provides no uniqueness or replay guarantee.
-- Upgrade and migration assumptions: added only in v0.2.0. Old v0.1.0
-- contracts do not contain claims and remain usable through the unchanged
-- baseline transfer choice.
template KycClaim
  with
    claimSigner : Party
    declaredIssuer : Party
    subjectParty : Party
    claimKind : IdentityClaimKind
    validUntil : Time
    claimId : Text
  where
    signatory claimSigner
    observer subjectParty

-- | Toy issuer registry used to mint holdings.
--
-- Signatories: `issuer`.
-- Observers: none.
-- Controllers: `issuer` controls `ToyRegistry_Mint`.
-- Choices: `ToyRegistry_Mint`.
-- Disclosed parties: the issuer discloses the registry only to test flows or
-- parties that need to mint toy holdings.
-- Privacy expectations: registry configuration is private to the issuer unless
-- explicitly disclosed. The optional identity extension contains trusted issuer
-- parties only, not PII.
-- Authorization assumptions: this is a stub issuer authority, not a D4
-- multi-sig decision. D4 remains open, so the issuer party can later be backed
-- by either an on-ledger multi-sig contract or a Canton topology multi-hosted
-- party without this experiment choosing between them.
-- Archival behavior: nonconsuming mint; the registry persists.
-- Failure modes: mint rejects if the experimental feature flag is absent or the
-- amount is non-positive. Typed transfer later fails if `identityExtension` is
-- `None` or the presented claim issuer is not trusted by the snapshot.
-- Upgrade and migration assumptions: `identityExtension` is an appended
-- Optional field. Old v0.1.0 registries upgrade with `None`, preserving the old
-- mint choice signature and old consumer behavior.
template ToyRegistry
  with
    issuer : Party
    featureFlag : Text
    identityExtension : Optional IdentityExtensionConfig
  where
    signatory issuer

    nonconsuming choice ToyRegistry_Mint : ContractId ToyHolding
      with
        owner : Party
        amount : Int
      controller issuer
      do
        requireExperimentalFlag featureFlag
        assertMsg eNonPositiveAmount (amount > 0)
        create ToyHolding with
          issuer
          owner
          amount
          featureFlag
          identityExtension

-- | Toy transferable holding with an additive typed-claim extension point.
--
-- Signatories: `issuer`, so issuer authority can create successor holdings
-- during owner-controlled transfer.
-- Observers: `owner`.
-- Controllers: `owner` controls the baseline `ToyHolding_Transfer`; `owner` and
-- `newOwner` jointly control `ToyHolding_TransferWithClaim`.
-- Choices: `ToyHolding_Transfer`, `ToyHolding_TransferWithClaim`.
-- Disclosed parties: current owner observes the holding; successor owners
-- observe only the successor contract and, for the typed extension choice, their
-- own `KycClaim`.
-- Privacy expectations: holdings are private to issuer and current owner;
-- typed claim metadata is separately private to claim signer and subject unless
-- disclosed for the transfer.
-- Authorization assumptions: the baseline transfer keeps the v0.1.0 opaque
-- attestation semantics. The typed extension enforces minimum typed claim
-- fields with recipient/claim-subject co-authorization. It does not implement
-- cross-domain identity, production issuer registries, ONCHAINID key recovery,
-- or D4 signer-control semantics.
-- Archival behavior: both transfer choices are consuming and create a successor
-- holding for `newOwner`; the KYC claim is fetched but not archived.
-- Failure modes: the baseline choice still accepts stale, wrong-subject, or
-- wrong-issuer opaque envelopes on-ledger. The typed choice blocks missing
-- extension config, stale claim, wrong subject, signer/declared-issuer
-- mismatch, untrusted issuer, and wrong claim kind.
-- Upgrade and migration assumptions: `identityExtension` is an appended
-- Optional field. Old v0.1.0 holdings upgrade with `None` and remain
-- transferable through the unchanged baseline choice. Typed behavior is opt-in
-- for v0.2.0 holdings minted from a registry with `Some` extension config.
template ToyHolding
  with
    issuer : Party
    owner : Party
    amount : Int
    featureFlag : Text
    identityExtension : Optional IdentityExtensionConfig
  where
    signatory issuer
    observer owner

    choice ToyHolding_Transfer : ContractId ToyHolding
      with
        newOwner : Party
        identityAttestation : OpaqueIdentityAttestation
      controller owner
      do
        requireExperimentalFlag featureFlag
        assertMsg eSelfTransfer (newOwner /= owner)
        requireOpaqueIdentityAttestation identityAttestation
        create this with owner = newOwner

    choice ToyHolding_TransferWithClaim : ContractId ToyHolding
      with
        newOwner : Party
        identityAttestation : OpaqueIdentityAttestation
        claimCid : ContractId KycClaim
      controller owner, newOwner
      do
        requireExperimentalFlag featureFlag
        assertMsg eSelfTransfer (newOwner /= owner)
        requireOpaqueIdentityAttestation identityAttestation
        config <- requireIdentityExtension identityExtension
        claim <- fetch claimCid
        now <- getTime
        requireKycValidatedClaim newOwner config.trustedIssuers now claim
        create this with owner = newOwner

requireKycValidatedClaim : Party -> [Party] -> Time -> KycClaim -> Update ()
requireKycValidatedClaim expectedSubject trustedIssuers now claim = do
  assertMsg eIssuerMismatch (claim.claimSigner == claim.declaredIssuer)
  assertMsg eUntrustedIssuer (containsParty claim.declaredIssuer trustedIssuers)
  assertMsg eWrongSubject (claim.subjectParty == expectedSubject)
  assertMsg eWrongClaimKind (claim.claimKind == KYC_VALIDATED)
  assertMsg eClaimExpired (now <= claim.validUntil)

containsParty : Party -> [Party] -> Bool
containsParty needle haystack =
  case haystack of
    [] -> False
    issuer :: rest -> issuer == needle || containsParty needle rest

requireIdentityExtension : Optional IdentityExtensionConfig -> Update IdentityExtensionConfig
requireIdentityExtension extension =
  case extension of
    Some config -> pure config
    None -> abort eIdentityExtensionMissing

requireOpaqueIdentityAttestation : OpaqueIdentityAttestation -> Update ()
requireOpaqueIdentityAttestation attestation =
  assertMsg eMissingAttestation (attestation.envelope /= "")

requireExperimentalFlag : Text -> Update ()
requireExperimentalFlag flag =
  assertMsg eFeatureDisabled (flag == experimentalFeatureFlag)

eFeatureDisabled : Text
eFeatureDisabled = "IdentityHookUpgrade: experimental feature flag disabled"

eNonPositiveAmount : Text
eNonPositiveAmount = "IdentityHookUpgrade: amount must be positive"

eSelfTransfer : Text
eSelfTransfer = "IdentityHookUpgrade: self-transfer is not part of the toy flow"

eMissingAttestation : Text
eMissingAttestation = "IdentityHookUpgrade: opaque identity attestation is missing"

eIdentityExtensionMissing : Text
eIdentityExtensionMissing = "IdentityHookUpgrade: typed identity extension is not configured"

eIssuerMismatch : Text
eIssuerMismatch = "IdentityHookUpgrade: claim signer does not match declared issuer"

eUntrustedIssuer : Text
eUntrustedIssuer = "IdentityHookUpgrade: claim issuer is not trusted"

eWrongSubject : Text
eWrongSubject = "IdentityHookUpgrade: KYC claim subject mismatch"

eWrongClaimKind : Text
eWrongClaimKind = "IdentityHookUpgrade: claim is not KYC_VALIDATED"

eClaimExpired : Text
eClaimExpired = "IdentityHookUpgrade: KYC claim expired"
