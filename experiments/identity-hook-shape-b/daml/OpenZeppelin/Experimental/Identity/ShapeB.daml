-- | Experimental identity hook shape B.
--
-- This package is a non-public D3 forward-compatibility spike for root
-- PLAN.md -> "June Decision Gate". D3 remains deferred and v1 remains
-- single-domain; this package only checks whether a typed KYC claim plus a
-- trusted-issuer-registry shape can be layered behind a toy transfer hook
-- without committing public M1 surface.
--
-- Not public M1 surface. The runtime flag must be present on every toy
-- contract so downstream code cannot accidentally treat the shape as stable.
module OpenZeppelin.Experimental.Identity.ShapeB where

data IdentityClaimKind
  = KYC_VALIDATED
  | OTHER_IDENTITY_CLAIM
  deriving (Eq, Show)

experimentalFeatureFlag : Text
experimentalFeatureFlag = "experimental.identity-hook-shape-b.enabled"

-- | Typed identity claim used by the toy transfer hook.
--
-- Signatories: `claimSigner`, the party whose ledger signature makes the claim
-- unforgeable in this toy model.
-- Observers: `subjectParty`, the identity subject expected to disclose the
-- claim for transfer verification.
-- Controllers: none; the transfer hook fetches the claim by disclosed
-- `ContractId` and does not archive it.
-- Choices: none.
-- Disclosed parties: claim signer and subject party are stakeholders; the toy
-- transfer requires the subject/new owner to co-authorize so the claim can be
-- fetched without turning recipient KYC status into owner-visible public data.
-- Privacy expectations: the claim is visible only to the signer, subject, and
-- explicitly-disclosed verifiers. This toy stores no PII, only typed metadata.
-- Authorization assumptions: the hook checks that the claim is signed by its
-- declared issuer, that the issuer is trusted by the registry snapshot on the
-- holding, that the claim subject is the new owner, that the kind is
-- `KYC_VALIDATED`, and that the claim has not expired. It does not implement
-- production ONCHAINID keys, ERC-735 claim topics, revocation registries, or
-- issuer key rotation.
-- Archival behavior: no choices; claims remain reusable until expiry. This is
-- deliberate because a KYC credential is not a one-transfer compliance token.
-- Failure modes: stale, wrong-subject, signer/declared-issuer mismatch,
-- untrusted issuer, and wrong claim kind fail on-ledger; `claimId` is
-- non-enforcing metadata and provides no uniqueness or replay guarantee.
-- Compromised trusted issuer credentials and off-ledger identity proofing
-- remain outside this toy package.
-- Upgrade and migration assumptions: experimental-only, not public API, and
-- removable once the D3 forward-compatibility shape check is complete.
template KycClaim
  with
    claimSigner : Party
    declaredIssuer : Party
    subjectParty : Party
    claimKind : IdentityClaimKind
    validUntil : Time
    claimId : Text
  where
    signatory claimSigner
    observer subjectParty

-- | Minimal trusted-issuer registry and toy mint authority.
--
-- Signatories: `registryAdmin`.
-- Observers: none.
-- Controllers: `registryAdmin` controls `TrustedIssuerRegistry_Mint`.
-- Choices: `TrustedIssuerRegistry_Mint`.
-- Disclosed parties: the registry admin discloses the registry only to parties
-- or test flows that need to see it.
-- Privacy expectations: trusted issuer membership is private to the registry
-- admin unless explicitly disclosed.
-- Authorization assumptions: this is a stub issuer/registry authority, not a
-- D4 multi-sig decision. D4 remains open, so `registryAdmin` can later be backed
-- by either an on-ledger multi-sig contract or a Canton topology multi-hosted
-- party without this experiment choosing between them.
-- Archival behavior: nonconsuming mint; the registry persists. Minted holdings
-- carry a snapshot of `trustedIssuers`, so registry mutation semantics are
-- intentionally not part of this spike.
-- Failure modes: mint rejects if the experimental feature flag is absent or the
-- amount is non-positive. Transfers fail if their presented claim issuer is not
-- in the holding's trusted-issuer snapshot.
-- Upgrade and migration assumptions: toy-only and excluded from the public M1
-- library surface.
template TrustedIssuerRegistry
  with
    registryAdmin : Party
    trustedIssuers : [Party]
    featureFlag : Text
  where
    signatory registryAdmin

    nonconsuming choice TrustedIssuerRegistry_Mint : ContractId ToyHolding
      with
        owner : Party
        amount : Int
      controller registryAdmin
      do
        requireExperimentalFlag featureFlag
        assertMsg eNonPositiveAmount (amount > 0)
        create ToyHolding with
          registryAdmin
          owner
          amount
          featureFlag
          trustedIssuers

-- | Toy transferable holding used to exercise the typed identity hook.
--
-- Signatories: `registryAdmin`, so the issuer/registry authority can create
-- successor holdings during owner-controlled transfer.
-- Observers: `owner`.
-- Controllers: `owner` and `newOwner` jointly control `ToyHolding_Transfer`.
-- Choices: `ToyHolding_Transfer`.
-- Disclosed parties: current owner observes the holding; successor owners
-- observe only the successor contract and their own `KycClaim`.
-- Privacy expectations: holdings are private to registry admin and current
-- owner; typed claim metadata is separately private to claim signer and subject
-- unless disclosed.
-- Authorization assumptions: the transfer hook enforces the minimum typed
-- claim fields candidate B claims to enforce, with the recipient/claim subject
-- co-authorizing the transfer so the claim fetch is ledger-authorized. It does not implement
-- cross-domain identity, production issuer registries, ONCHAINID key recovery,
-- or D4 signer-control semantics.
-- Archival behavior: transfer is consuming and creates a successor holding for
-- `newOwner`; the KYC claim is fetched but not archived.
-- Failure modes: stale, wrong-subject, signer/declared-issuer mismatch,
-- untrusted issuer, and wrong claim kind block transfer; compromised trusted
-- issuer credentials and registry snapshot staleness remain outside this toy
-- package.
-- Upgrade and migration assumptions: toy-only and removable after the D3
-- forward-compatibility shape check.
template ToyHolding
  with
    registryAdmin : Party
    owner : Party
    amount : Int
    featureFlag : Text
    trustedIssuers : [Party]
  where
    signatory registryAdmin
    observer owner

    choice ToyHolding_Transfer : ContractId ToyHolding
      with
        newOwner : Party
        claimCid : ContractId KycClaim
      controller owner, newOwner
      do
        requireExperimentalFlag featureFlag
        assertMsg eSelfTransfer (newOwner /= owner)
        claim <- fetch claimCid
        now <- getTime
        requireKycValidatedClaim newOwner trustedIssuers now claim
        create this with owner = newOwner

requireKycValidatedClaim : Party -> [Party] -> Time -> KycClaim -> Update ()
requireKycValidatedClaim expectedSubject trustedIssuers now claim = do
  assertMsg eIssuerMismatch (claim.claimSigner == claim.declaredIssuer)
  assertMsg eUntrustedIssuer (containsParty claim.declaredIssuer trustedIssuers)
  assertMsg eWrongSubject (claim.subjectParty == expectedSubject)
  assertMsg eWrongClaimKind (claim.claimKind == KYC_VALIDATED)
  assertMsg eClaimExpired (now <= claim.validUntil)

containsParty : Party -> [Party] -> Bool
containsParty needle haystack =
  case haystack of
    [] -> False
    issuer :: rest -> issuer == needle || containsParty needle rest

requireExperimentalFlag : Text -> Update ()
requireExperimentalFlag flag =
  assertMsg eFeatureDisabled (flag == experimentalFeatureFlag)

eFeatureDisabled : Text
eFeatureDisabled = "IdentityHookShapeB: experimental feature flag disabled"

eNonPositiveAmount : Text
eNonPositiveAmount = "IdentityHookShapeB: amount must be positive"

eSelfTransfer : Text
eSelfTransfer = "IdentityHookShapeB: self-transfer is not part of the toy flow"

eIssuerMismatch : Text
eIssuerMismatch = "IdentityHookShapeB: claim signer does not match declared issuer"

eUntrustedIssuer : Text
eUntrustedIssuer = "IdentityHookShapeB: claim issuer is not trusted"

eWrongSubject : Text
eWrongSubject = "IdentityHookShapeB: KYC claim subject mismatch"

eWrongClaimKind : Text
eWrongClaimKind = "IdentityHookShapeB: claim is not KYC_VALIDATED"

eClaimExpired : Text
eClaimExpired = "IdentityHookShapeB: KYC claim expired"
