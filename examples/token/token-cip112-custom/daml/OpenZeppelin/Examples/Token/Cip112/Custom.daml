-- | A compliance-grade token that owns every template it deploys and reuses
-- the OpenZeppelin CIP-0112 workflows unchanged. It depends on the types and
-- utils packages only, never on the default templates, so it has its own
-- upgrade lineage.
--
-- What it adds over the defaults, and the mechanism each addition uses:
--
-- - Roles. A pauser and a compliance officer hold delegated powers as the
--   controllers of consumer choices. The admin stays the signatory of every
--   contract and holds neither power.
-- - An auditor who observes every holding, instruction, and allocation, and
--   is an informee of every holdings-change event. A consumer field on each
--   template, reached through the closure that builds the operations
--   record, plus the `eventObservers` operation.
-- - A compliance freeze on holdings. A template field plus two choices, and
--   the `MyHolding_Spend` hook refuses a frozen holding, so every workflow
--   path (transfer, allocation, burn, unlock) refuses it without the
--   workflows knowing what a freeze is.
-- - A pause switch on the registry. A template field plus two choices,
--   checked before each factory and the mint offer delegate to the workflow.
-- - An account blocklist from `openzeppelin-blocklist-v1`. A blocker party
--   blocks and unblocks parties on a `Blocklist` contract that the admin
--   signs, and sees no holding. The registry's off-ledger API supplies the
--   blocklist in the choice context, and every choice that debits or
--   credits an account checks that account's owner and provider before it
--   delegates to the workflow.
-- - A fee on every transfer except a burn, paid to the admin's treasury
--   account. The factory composes two workflow calls: a one-step fee
--   transfer, then the main transfer funded by the fee leg's change.
-- - An executor allowlist on the registry, checked before delegating.
--
-- Nothing here changes a workflow body. The four templates are the unit a
-- consumer forks: the pending contracts decide which holding is created when
-- they complete, and a function cannot be stored in a payload, so a custom
-- holding needs custom instruction and allocation templates too.
module OpenZeppelin.Examples.Token.Cip112.Custom where

import DA.Foldable (forA_)
import DA.Optional (optionalToList)
import DA.TextMap qualified as TextMap

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.Api.Token.AllocationInstructionV2 qualified as AllocationInstructionV2
import Splice.Api.Token.TransferEventsV2 qualified as TransferEventsV2
import Splice.Api.Token.TransferInstructionV2 qualified as TransferInstructionV2
import Splice.TokenStandard.Utils

import OpenZeppelin.Token.Cip112.TypesV1
import OpenZeppelin.Token.Cip112.Utils.Holding
import OpenZeppelin.Token.Cip112.Utils.Transfer
import OpenZeppelin.Token.Cip112.Utils.Allocation
import OpenZeppelin.Token.Cip112.Utils.Registry

import OpenZeppelin.BlocklistV1 (Blocklist, fetchBlocklist, whenNotBlocked)

-- Roles
--------

-- | Parties with delegated powers, carried by every contract so the powers
-- follow the token rather than the registry contract's lifetime.
data AppRoles = AppRoles with
    auditor : Party
      -- ^ Observes every contract; holds no power.
    complianceOfficer : Party
      -- ^ Freezes and unfreezes holdings.
    blocklistId : Text
      -- ^ The id of the token's `Blocklist`, whose admin is the instrument
      -- admin. The blocker role lives on that contract.
  deriving (Eq, Show)

-- Blocklist
------------

-- | The choice-context key under which the registry's off-ledger API
-- supplies the blocklist contract id, with the contract as a disclosure.
blocklistContextKey : Text
blocklistContextKey = "blocklist"

-- | Fetch the token's blocklist from a choice context, pinned to the admin
-- and the blocklist id. A context without the blocklist is refused, so a
-- caller cannot skip the check by leaving it out.
blocklistFrom : Party -> AppRoles -> ExtraArgs -> Update Blocklist
blocklistFrom admin roles extraArgs =
  case TextMap.lookup blocklistContextKey extraArgs.context.values of
    Some (AV_ContractId cid) -> fetchBlocklist admin roles.blocklistId (coerceContractId cid)
    Some _ -> fail "blocklist context value must be a contract id"
    None -> fail "blocklist missing from the choice context"

-- | Fail when the owner or the provider of `account` is blocked. A blocked
-- provider blocks every account it provides. The CIP-0112 mint and burn
-- accounts have neither, so a mint or a burn checks only the other side.
whenAccountNotBlocked : Blocklist -> HoldingV2.Account -> Update ()
whenAccountNotBlocked blocklist account =
  forA_ (optionalToList account.owner <> optionalToList account.provider) (whenNotBlocked blocklist)

-- Event-log host
-----------------

template MyEventLog with
    admin : Party
  where
    signatory admin

    interface instance TransferEventsV2.EventLog for MyEventLog where
      view = TransferEventsV2.EventLogView with admin; meta = emptyMetadata
      eventLog_holdingsChangeImpl = eventLog_holdingsChangeDefaultImpl admin

-- The operations record
------------------------

-- | Built inside every choice body from the template's own fields. The
-- closure over `roles` is how consumer fields reach `createHolding` without
-- the workflows knowing about them. New holdings are never frozen.
myOps : Party -> AppRoles -> HoldingOps
myOps admin roles = HoldingOps with
  createHolding = \v -> toInterfaceContractId <$> create MyHolding with holding = v; roles; frozen = False
  consumeHolding = \cid -> do
    -- Pin the template first: a foreign `Holding` never reaches the spend.
    fetched <- fetchFromInterface @MyHolding cid
    case fetched of
      None -> fail "holding is not a MyHolding"
      Some (tcid, _) -> exercise tcid MyHolding_Spend
  withEventLog = \emit -> do
    cid <- create MyEventLog with admin
    emit (toInterfaceContractId cid)
    archive cid
  -- The auditor is an informee of every holdings-change event, so it can
  -- follow the standard event stream, not only the contracts.
  eventObservers = const [roles.auditor]

-- Holding
----------

-- | A holding with a compliance freeze. The standard view is unchanged, so
-- wallets see a frozen holding as an ordinary one; the freeze shows up when
-- they try to spend it.
template MyHolding with
    holding : HoldingV2.HoldingView
    roles : AppRoles
    frozen : Bool
  where
    signatory holding.instrumentId.admin, accountParties holding.instrumentId.admin holding.account
    observer lockHolders holding.lock, roles.auditor, roles.complianceOfficer
    ensure isValidHoldingView holding

    -- | The only way value leaves this holding. Controlled by the parties
    -- whose authority a plain archive would need, so the authorization
    -- model is unchanged; what changes is that the spend is a named choice
    -- the auditor sees, with a consumer rule inside it.
    choice MyHolding_Spend : HoldingV2.HoldingView
      controller holding.instrumentId.admin, accountParties holding.instrumentId.admin holding.account
      do
        require "holding is frozen" (not frozen)
        pure holding

    choice MyHolding_Freeze : ContractId MyHolding
      controller roles.complianceOfficer
      do
        require "holding is already frozen" (not frozen)
        create this with frozen = True

    choice MyHolding_Unfreeze : ContractId MyHolding
      controller roles.complianceOfficer
      do
        require "holding is not frozen" frozen
        create this with frozen = False

    -- | Refused while frozen: the workflow recreates the holding through
    -- `createHolding`, which would drop the freeze. Any consumer choice that
    -- recreates a holding has to make the same check. Refused for a blocked
    -- account, whose holdings stay as they are until it is unblocked.
    choice MyHolding_OwnerUnlock : ContractId HoldingV2.Holding
      with
        blocklistCid : ContractId Blocklist
      controller accountParties holding.instrumentId.admin holding.account
      do
        require "holding is frozen" (not frozen)
        blocklist <- fetchBlocklist holding.instrumentId.admin roles.blocklistId blocklistCid
        whenAccountNotBlocked blocklist holding.account
        holdingOwnerUnlockImpl (myOps holding.instrumentId.admin roles) (toInterfaceContractId self) holding

    interface instance HoldingV2.Holding for MyHolding where
      view = holding

-- Transfer instruction
-----------------------

template MyTransferInstruction with
    state : TransferInstructionState
    roles : AppRoles
  where
    signatory state.transfer.instrumentId.admin, senderParties state.transfer
    observer receiverParties state.transfer, roles.auditor
    ensure isValidTransferInstructionState state

    interface instance TransferInstructionV2.TransferInstruction for MyTransferInstruction where
      view = transferInstructionView state
      transferInstruction_acceptExtraObservers _ = observer this
      transferInstruction_rejectExtraObservers _ = observer this
      transferInstruction_withdrawExtraObservers _ = observer this
      -- Accepting debits the sender and credits the receiver, so both are
      -- checked at that time: a block after the offer stops it.
      transferInstruction_acceptImpl self arg = do
        blocklist <- blocklistFrom state.transfer.instrumentId.admin roles arg.extraArgs
        whenAccountNotBlocked blocklist state.transfer.sender
        whenAccountNotBlocked blocklist state.transfer.receiver
        transferAcceptImpl (ops this) self state arg
      -- Rejecting returns the funds to the sender's own account, so it stays
      -- open even when either side is blocked.
      transferInstruction_rejectImpl self arg = transferRejectImpl (ops this) self state arg
      -- Withdrawing is the sender unlocking its own funds, refused for a
      -- blocked sender.
      transferInstruction_withdrawImpl self arg = do
        blocklist <- blocklistFrom state.transfer.instrumentId.admin roles arg.extraArgs
        whenAccountNotBlocked blocklist state.transfer.sender
        transferWithdrawImpl (ops this) self state arg

    choice MyTransferInstruction_Expire : TransferInstructionV2.TransferInstructionResult
      controller state.transfer.instrumentId.admin
      do transferExpireImpl (ops this) state

    choice MyTransferInstruction_AdminGC : ()
      controller state.transfer.instrumentId.admin
      do transferGcImpl state

-- Allocation
-------------

template MyAllocation with
    state : AllocationState
    roles : AppRoles
  where
    signatory state.allocation.admin, accountParties state.allocation.admin state.allocation.authorizer
    observer state.settlement.executors, roles.auditor
    ensure isValidAllocationState state

    interface instance AllocationV2.Allocation for MyAllocation where
      view = allocationView state
      allocation_settleExtraObservers _ = observer this
      allocation_cancelExtraObservers _ = observer this
      allocation_withdrawExtraObservers _ = observer this
      allocation_settleImpl self arg =
        allocationSettleImpl (ops this) (\s -> toInterfaceContractId <$> create this with state = s) self state arg
      -- Withdrawing is the authorizer unlocking its own funds, refused for a
      -- blocked authorizer. Cancelling by the executors, or by the admin
      -- after expiry, returns the funds to the authorizer's account and
      -- stays open. Settlement is checked in the settlement factory, the
      -- only path through which the admin settles.
      allocation_withdrawImpl self arg = do
        blocklist <- blocklistFrom state.allocation.admin roles arg.extraArgs
        whenAccountNotBlocked blocklist state.allocation.authorizer
        allocationWithdrawImpl (ops this) self state arg
      allocation_cancelImpl self arg = allocationCancelImpl (ops this) self state arg

    choice MyAllocation_AdminGC : ()
      controller state.allocation.admin
      do allocationGcImpl state

-- Registry
-----------

-- | The registry rules contract: the three standard factories behind a pause
-- switch, a fee on transfers, an executor allowlist, and supply operations.
-- Pausing replaces the contract, so wallets need the new disclosure after
-- a pause or unpause, as with any change to the rules contract.
template MyRules with
    config : RegistryConfig
    roles : AppRoles
    pauser : Party
      -- ^ Flips the pause switch. Holds no other power.
    paused : Bool
    transferFeeBps : Int
      -- ^ Basis points of every transfer amount paid to the treasury when
      -- the transfer is instructed. Zero disables the fee leg.
    allowedExecutors : [Party]
      -- ^ The only settlement executors this registry accepts.
  where
    signatory config.admin
    observer pauser, roles.auditor
    ensure isValidRegistryConfig config
      && transferFeeBps >= 0 && transferFeeBps <= 10000

    choice MyRules_Pause : ContractId MyRules
      controller pauser
      do
        require "registry is already paused" (not paused)
        create this with paused = True

    choice MyRules_Unpause : ContractId MyRules
      controller pauser
      do
        require "registry is not paused" paused
        create this with paused = False

    interface instance AllocationV2.SettlementFactory for MyRules where
      view = AllocationV2.SettlementFactoryView with admin = config.admin; meta = emptyMetadata
      settlementFactory_publicFetchImpl = publicFetchDefaultImpl this
      settlementFactory_settleBatchExtraObservers _ = []
      -- Every trading account and every authorizer is checked at
      -- settlement, so an allocation committed before a block does not
      -- settle while the block holds.
      settlementFactory_settleBatchImpl self arg = do
        whenNotPaused this
        requireAllowedExecutors this arg.settlement.executors
        blocklist <- blocklistFrom config.admin roles arg.extraArgs
        forA_ arg.transferLegs $ \leg -> do
          whenAccountNotBlocked blocklist leg.sender
          whenAccountNotBlocked blocklist leg.receiver
        forA_ arg.allocations $ \finalized -> do
          v <- pinAllocationTo @MyAllocation finalized.allocationCid
          whenAccountNotBlocked blocklist v.allocation.authorizer
        settleBatchImpl (pinAllocationTo @MyAllocation) config.admin self arg

    interface instance AllocationInstructionV2.AllocationFactory for MyRules where
      view = AllocationInstructionV2.AllocationFactoryView with admin = config.admin; meta = emptyMetadata
      allocationFactory_publicFetchImpl = publicFetchDefaultImpl this
      allocationFactory_allocateExtraObservers = privateAssetAllocateExtraObservers
      allocationFactory_allocateImpl _self arg = do
        whenNotPaused this
        requireAllowedExecutors this arg.settlement.executors
        blocklist <- blocklistFrom config.admin roles arg.extraArgs
        whenAccountNotBlocked blocklist arg.allocation.authorizer
        forA_ arg.allocation.transferLegSides (whenAccountNotBlocked blocklist . (.otherside))
        allocationFactoryImpl config (ops this) (createAllocation this) arg

    interface instance TransferInstructionV2.TransferFactory for MyRules where
      view = TransferInstructionV2.TransferFactoryView with admin = config.admin; meta = emptyMetadata
      transferFactory_publicFetchImpl = publicFetchDefaultImpl this
      transferFactory_transferExtraObservers = transferFactoryV2_privateAsset_transferExtraObserversDefaultImpl
      -- The fee is charged on transfers between holders, so a burn pays none.
      transferFactory_transferImpl _self arg = do
        whenNotPaused this
        blocklist <- blocklistFrom config.admin roles arg.extraArgs
        whenAccountNotBlocked blocklist arg.transfer.sender
        whenAccountNotBlocked blocklist arg.transfer.receiver
        if arg.transfer.receiver == burnAccount
          then transferFactoryImpl config (ops this) (createInstruction this) arg
          else transferWithFee this arg

    nonconsuming choice MyRules_OfferMint : ContractId TransferInstructionV2.TransferInstruction
      with
        receiver : HoldingV2.Account
        instrumentId : Text
        amount : Decimal
        requestedAt : Time
        executeBefore : Time
        reason : Text
      controller config.admin
      do
        whenNotPaused this
        offerMintImpl config (createInstruction this) receiver instrumentId amount requestedAt executeBefore reason

    nonconsuming choice MyRules_ExpireAllocations : ()
      with
        cancelArgs : [(ContractId AllocationV2.Allocation, AllocationV2.Allocation_Cancel)]
      controller config.admin
      do expireAllocationsImpl (pinAllocationTo @MyAllocation) config.admin cancelArgs

    nonconsuming choice MyRules_ExpireTransferInstructions : ()
      with
        instructionCids : [ContractId MyTransferInstruction]
      controller config.admin
      do
        forA_ instructionCids $ \cid -> do
          instr <- fetch cid
          requireMatchExpected ("transfer.instrumentId.admin", instr.state.transfer.instrumentId.admin) config.admin
          _ <- exercise cid MyTransferInstruction_Expire
          pure ()

-- Registry policy
------------------

whenNotPaused : MyRules -> Update ()
whenNotPaused rules = require "registry is paused" (not rules.paused)

requireAllowedExecutors : MyRules -> [Party] -> Update ()
requireAllowedExecutors rules executors =
  require "a settlement executor is not approved by this registry"
    (all (`elem` rules.allowedExecutors) executors)

-- | The fee account: a regular account owned by the admin. A one-step
-- transfer into it needs the admin's authority on the receiving side, which
-- the rules contract's signatory supplies.
treasury : MyRules -> HoldingV2.Account
treasury rules = basicAccount rules.config.admin

feeFor : MyRules -> Decimal -> Decimal
feeFor rules amount = amount * intToDecimal rules.transferFeeBps / 10000.0

-- | The transfer factory as two workflow calls. The fee leg is an ordinary
-- one-step transfer of the fee to the treasury funded by the sender's
-- inputs; it consumes them and returns the sender's change. The main
-- transfer then runs on that change, exactly as the default factory would
-- on the original inputs. Both legs emit their standard events, so history
-- parsers see the fee as a transfer to the treasury. Inputs that cover the
-- amount but not the fee fail on the main leg's funding check.
transferWithFee
  : MyRules -> TransferInstructionV2.TransferFactory_Transfer
  -> Update TransferInstructionV2.TransferInstructionResult
transferWithFee rules arg = do
  let transfer = arg.transfer
      fee = feeFor rules transfer.amount
  inputs <-
    if fee > 0.0
      then do
        feeResult <- executeTransfer rules.config (ops rules) (createInstruction rules) True
          (transfer with receiver = treasury rules; amount = fee)
        pure feeResult.senderChangeCids
      else pure transfer.inputHoldingCids
  transferFactoryImpl rules.config (ops rules) (createInstruction rules)
    (arg with transfer = (transfer with inputHoldingCids = inputs))

createInstruction : MyRules -> CreateTransferInstruction
createInstruction rules s =
  toInterfaceContractId <$> create MyTransferInstruction with state = s; roles = rules.roles

createAllocation : MyRules -> CreateAllocation
createAllocation rules s =
  toInterfaceContractId <$> create MyAllocation with state = s; roles = rules.roles

-- | One class so every template builds its ops the same way.
class HasOps t where
  ops : t -> HoldingOps

instance HasOps MyTransferInstruction where
  ops this = myOps this.state.transfer.instrumentId.admin this.roles

instance HasOps MyAllocation where
  ops this = myOps this.state.allocation.admin this.roles

instance HasOps MyRules where
  ops this = myOps this.config.admin this.roles
