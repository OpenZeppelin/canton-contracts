-- | Drives `OpenZeppelin.Examples.Token.Cip112.Custom` through the Token Standard V2 interfaces and checks
-- each consumer addition: the auditor sees every contract, every path that
-- consumes a holding runs `MyHolding_Spend`, a late acceptance creates a
-- `MyHolding`, iteration successors are `MyAllocation`s, a frozen account's
-- holdings cannot fund, be paid out, be returned, or be merged or split,
-- its pending transfers and allocations complete once it is unfrozen,
-- batch settlement forwards each authorizer only its own status, a stale or
-- missing status is refused, the pause switch blocks the factories, mint
-- offers, and burns, the fee leg pays the treasury and exempts burns,
-- merges and splits bypass both the pause and the fee, the executor
-- allowlist is enforced, roles are separate, expired funding is reclaimed,
-- and a foreign holding or allocation is refused.
module OpenZeppelin.Examples.Token.Cip112.Custom.Test where

import DA.Action (unless)
import DA.Assert ((===))
import DA.Date (date, Month(Jan))
import DA.Foldable (forA_)
import DA.List (sort)
import DA.Map qualified as Map
import DA.Optional (isNone, isSome, optionalToList)
import DA.Text (isInfixOf)
import DA.TextMap qualified as TextMap
import DA.Time (addRelTime, days, hours, time)
import Daml.Script

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.Api.Token.AllocationInstructionV2 qualified as AllocationInstructionV2
import Splice.Api.Token.TransferEventsV2 qualified as TransferEventsV2
import Splice.Api.Token.TransferInstructionV2 qualified as TransferInstructionV2
import Splice.TokenStandard.Utils
  (basicAccount, burnAccount, reasonToMeta, senderSide, receiverSide, nonIteratedAllocation)

import OpenZeppelin.Token.Cip112.TypesV1 (RegistryConfig(..))
import OpenZeppelin.Examples.Token.Cip112.Custom

t0, t1, t2, t3, t4 : Time
t0 = time (date 2026 Jan 1) 0 0 0
t1 = time (date 2026 Jan 1) 0 10 0
t2 = time (date 2026 Jan 1) 0 20 0
t3 = time (date 2026 Jan 1) 0 30 0
t4 = time (date 2026 Jan 1) 2 0 0

emptyExtraArgs : ExtraArgs
emptyExtraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

data App = App with
    admin : Party
    auditor : Party
    complianceOfficer : Party
    pauser : Party
    exchange : Party
    alice : Party
    bob : Party
    rulesCid : ContractId MyRules
    rulesDisclosure : Disclosure
    settlement : AllocationV2.SettlementInfo

-- | A registry with the given transfer fee in basis points.
setupWith : Int -> Script App
setupWith transferFeeBps = do
  admin <- allocateParty "admin"
  auditor <- allocateParty "auditor"
  complianceOfficer <- allocateParty "complianceOfficer"
  pauser <- allocateParty "pauser"
  exchange <- allocateParty "exchange"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  setTime t1
  rulesCid <- submit admin do
    createCmd MyRules with
      config = RegistryConfig with admin; maxTTL = days 90; lockGrace = hours 1
      roles = AppRoles with auditor; complianceOfficer
      pauser
      paused = False
      transferFeeBps
      allowedExecutors = [exchange]
  Some rulesDisclosure <- queryDisclosure @MyRules admin rulesCid
  let app = App with
        admin; auditor; complianceOfficer; pauser; exchange; alice; bob; rulesCid; rulesDisclosure
        settlement = AllocationV2.SettlementInfo with
          executors = [exchange]
          id = "trade-1"
          cid = None
          meta = emptyMetadata
  forA_ [alice, bob] (openAccount app)
  pure app

setup : Script App
setup = setupWith 0

-- | Pausing replaces the rules contract; refresh the id and disclosure.
pauseRegistry : App -> Script App
pauseRegistry app = do
  newCid <- submit (actAs app.pauser) do exerciseCmd app.rulesCid MyRules_Pause
  Some disclosure <- queryDisclosure @MyRules app.admin newCid
  pure app with rulesCid = newCid; rulesDisclosure = disclosure

unpauseRegistry : App -> Script App
unpauseRegistry app = do
  newCid <- submit (actAs app.pauser) do exerciseCmd app.rulesCid MyRules_Unpause
  Some disclosure <- queryDisclosure @MyRules app.admin newCid
  pure app with rulesCid = newCid; rulesDisclosure = disclosure

-- Account statuses
-------------------

-- | The compliance officer opens `owner`'s account status.
openAccount : App -> Party -> Script (ContractId MyAccountStatus)
openAccount App{..} owner = submit (actAs complianceOfficer) do
  exerciseCmd rulesCid MyRules_OpenAccount with account = basicAccount owner

-- | `owner`'s one live account status under this registry's admin.
statusOf : App -> Party -> Script (ContractId MyAccountStatus)
statusOf app owner = do
  statuses <- queryFilter @MyAccountStatus app.admin
    (\s -> s.admin == app.admin && s.account == basicAccount owner)
  case statuses of
    [(cid, _)] -> pure cid
    other -> abort ("expected one live status for " <> show owner <> ", got " <> show (length other))

-- | A status as the registry serves it to a submitter that does not observe
-- it: the receiver on accept and reject, and the executors.
statusDisclosure : App -> ContractId MyAccountStatus -> Script Disclosure
statusDisclosure app statusCid = do
  Some disclosure <- queryDisclosure @MyAccountStatus app.admin statusCid
  pure disclosure

statusValue : ContractId MyAccountStatus -> AnyValue
statusValue statusCid = AV_ContractId (coerceContractId statusCid)

-- | The choice context of a choice that consumes a holding of the status's
-- account.
statusContext : ContractId MyAccountStatus -> ChoiceContext
statusContext statusCid = ChoiceContext with values = TextMap.fromList [(accountStatusKey, statusValue statusCid)]

statusArgs : ContractId MyAccountStatus -> ExtraArgs
statusArgs statusCid = ExtraArgs with context = statusContext statusCid; meta = emptyMetadata

-- | `owner`'s live status as extra arguments, with its disclosure.
statusFor : App -> Party -> Script (ExtraArgs, Disclosure)
statusFor app owner = do
  statusCid <- statusOf app owner
  disclosure <- statusDisclosure app statusCid
  pure (statusArgs statusCid, disclosure)

-- | The batch context the executors build: each authorizer's live status
-- under its batch key, with the disclosures they submit.
batchStatusArgs : App -> [Party] -> Script (ExtraArgs, [Disclosure])
batchStatusArgs app authorizers = do
  entries <- forA authorizers $ \authorizer -> do
    statusCid <- statusOf app authorizer
    disclosure <- statusDisclosure app statusCid
    pure ((batchStatusKey (basicAccount authorizer), statusValue statusCid), disclosure)
  pure
    ( ExtraArgs with
        context = ChoiceContext with values = TextMap.fromList (map fst entries)
        meta = emptyMetadata
    , map snd entries )

freeze : App -> Party -> Script (ContractId MyAccountStatus)
freeze app owner = do
  statusCid <- statusOf app owner
  submit (actAs app.complianceOfficer) do exerciseCmd statusCid MyAccountStatus_Freeze

unfreeze : App -> Party -> Script (ContractId MyAccountStatus)
unfreeze app owner = do
  statusCid <- statusOf app owner
  submit (actAs app.complianceOfficer) do exerciseCmd statusCid MyAccountStatus_Unfreeze

-- Supply
---------

offerMintCmd : App -> Party -> Decimal -> Commands (ContractId TransferInstructionV2.TransferInstruction)
offerMintCmd app receiver amount = offerMintOfCmd app receiver "TOK" amount

offerMintOfCmd : App -> Party -> Text -> Decimal -> Commands (ContractId TransferInstructionV2.TransferInstruction)
offerMintOfCmd App{..} receiver instrumentId amount =
  exerciseCmd rulesCid MyRules_OfferMint with
    receiver = basicAccount receiver
    instrumentId
    amount
    requestedAt = t0
    executeBefore = t2
    reason = "mint"

-- | The admin offers a mint and the owner accepts it. A mint offer locks
-- nothing, so its accept needs no status.
mint : App -> Party -> Decimal -> Script (ContractId HoldingV2.Holding)
mint app owner amount = mintOf app owner "TOK" amount

mintOf : App -> Party -> Text -> Decimal -> Script (ContractId HoldingV2.Holding)
mintOf app owner instrumentId amount = do
  offerCid <- submit (actAs app.admin) (offerMintOfCmd app owner instrumentId amount)
  result <- submit (actAs owner) do
    exerciseCmd offerCid TransferInstructionV2.TransferInstruction_Accept with
      actors = [owner]
      extraArgs = emptyExtraArgs
  case result.output of
    TransferInstructionV2.TransferInstructionResult_Completed [holdingCid] -> pure holdingCid
    other -> abort ("expected a completed mint, got: " <> show other)

-- | Balances of `owner` as seen by `who`: the owner, the auditor, or the
-- compliance officer.
balanceSeenBy : Party -> Party -> Script [Decimal]
balanceSeenBy who owner = do
  holdings <- query @MyHolding who
  pure (sort [h.holding.amount | (_, h) <- holdings, h.holding.account.owner == Some owner])

mkTransfer : App -> Party -> Party -> Decimal -> [ContractId HoldingV2.Holding] -> TransferInstructionV2.Transfer
mkTransfer App{..} sender receiver amount inputs = TransferInstructionV2.Transfer with
  sender = basicAccount sender
  receiver = basicAccount receiver
  amount
  instrumentId = HoldingV2.InstrumentId with admin; id = "TOK"
  requestedAt = t0
  executeBefore = t2
  inputHoldingCids = inputs
  meta = emptyMetadata

-- | A transfer through the factory. `extraArgs` carries the sender's status.
transferCmd
  : App -> [Party] -> ExtraArgs -> TransferInstructionV2.Transfer
  -> Commands TransferInstructionV2.TransferInstructionResult
transferCmd App{..} actors extraArgs transfer =
  exerciseCmd (toInterfaceContractId @TransferInstructionV2.TransferFactory rulesCid)
    TransferInstructionV2.TransferFactory_Transfer with transfer; actors; extraArgs

-- | The owner and the admin burn `amount` of a holding in one step.
burnCmd
  : App -> Party -> Decimal -> ExtraArgs -> ContractId HoldingV2.Holding
  -> Commands TransferInstructionV2.TransferInstructionResult
burnCmd app owner amount extraArgs holdingCid =
  transferCmd app [owner, app.admin] extraArgs ((mkTransfer app owner owner amount [holdingCid]) with receiver = burnAccount)

pendingCid : TransferInstructionV2.TransferInstructionResult -> Script (ContractId TransferInstructionV2.TransferInstruction)
pendingCid result = case result.output of
  TransferInstructionV2.TransferInstructionResult_Pending cid -> pure cid
  other -> abort ("expected pending instruction, got: " <> show other)

-- | Disclosures of locked funding, as the registry serves them: the admin is
-- the only lock holder, and it reads every holding as a signatory.
fundingDisclosures : App -> [ContractId HoldingV2.Holding] -> Script [Disclosure]
fundingDisclosures App{..} cids = forA cids $ \cid -> do
  Some d <- queryDisclosure admin (fromInterfaceContractId @MyHolding cid)
  pure d

-- | Disclosures of the locked funding of a pending transfer instruction.
instructionDisclosures : App -> ContractId TransferInstructionV2.TransferInstruction -> Script [Disclosure]
instructionDisclosures app instrCid = do
  Some v <- queryInterfaceContractId app.admin instrCid
  fundingDisclosures app v.transfer.inputHoldingCids

-- | Disclosures of the locked funding of an allocation.
allocationDisclosures : App -> ContractId AllocationV2.Allocation -> Script [Disclosure]
allocationDisclosures app allocCid = do
  Some v <- queryInterfaceContractId app.admin allocCid
  fundingDisclosures app v.holdingCids

acceptCmd, rejectCmd
  : Party -> ExtraArgs -> ContractId TransferInstructionV2.TransferInstruction
  -> Commands TransferInstructionV2.TransferInstructionResult
acceptCmd receiver extraArgs cid = exerciseCmd cid TransferInstructionV2.TransferInstruction_Accept with
  actors = [receiver]; extraArgs
rejectCmd receiver extraArgs cid = exerciseCmd cid TransferInstructionV2.TransferInstruction_Reject with
  actors = [receiver]; extraArgs

withdrawCmd
  : Party -> ExtraArgs -> ContractId TransferInstructionV2.TransferInstruction
  -> Commands TransferInstructionV2.TransferInstructionResult
withdrawCmd sender extraArgs cid = exerciseCmd cid TransferInstructionV2.TransferInstruction_Withdraw with
  actors = [sender]; extraArgs

-- | The receiver accepts, passing the sender's status. The registry
-- discloses the status and the locked funding to it.
accept : App -> Party -> Party -> ContractId TransferInstructionV2.TransferInstruction -> Script ()
accept app sender receiver instrCid = do
  (senderArgs, senderStatus) <- statusFor app sender
  funding <- instructionDisclosures app instrCid
  _ <- submit (actAs receiver <> discloseMany (senderStatus :: funding)) (acceptCmd receiver senderArgs instrCid)
  pure ()

mkLeg : Text -> Party -> Party -> Decimal -> AllocationV2.TransferLeg
mkLeg legId sender receiver amount = AllocationV2.TransferLeg with
  transferLegId = legId
  sender = basicAccount sender
  receiver = basicAccount receiver
  amount
  instrumentId = "TOK"
  meta = emptyMetadata

mkSpec : App -> Party -> [AllocationV2.TransferLegSide] -> Optional (TextMap.TextMap Decimal) -> AllocationV2.AllocationSpecification
mkSpec App{..} authorizer sides reserve = AllocationV2.AllocationSpecification with
  admin
  authorizer = basicAccount authorizer
  transferLegSides = sides
  settlementDeadline = Some t2
  nextIterationFunding = reserve
  committed = False
  meta = emptyMetadata

-- | An allocation through the factory. `extraArgs` carries the trader's
-- status.
allocateCmd
  : App -> AllocationV2.SettlementInfo -> Party -> AllocationV2.AllocationSpecification
  -> [ContractId HoldingV2.Holding] -> ExtraArgs
  -> Commands AllocationInstructionV2.AllocationInstructionResult
allocateCmd App{..} settlementInfo trader spec inputs extraArgs =
  exerciseCmd (toInterfaceContractId @AllocationInstructionV2.AllocationFactory rulesCid)
    AllocationInstructionV2.AllocationFactory_Allocate with
      settlement = settlementInfo
      allocation = spec
      requestedAt = t0
      inputHoldingCids = inputs
      extraArgs
      actors = [trader]

-- | The trader allocates, passing its own status, which it observes.
allocate : App -> Party -> AllocationV2.AllocationSpecification -> [ContractId HoldingV2.Holding] -> Script (ContractId AllocationV2.Allocation)
allocate app trader spec inputs = do
  traderArgs <- statusArgs <$> statusOf app trader
  result <- submit (actAs trader <> discloseMany [app.rulesDisclosure]) (allocateCmd app app.settlement trader spec inputs traderArgs)
  case result.output of
    AllocationInstructionV2.AllocationInstructionResult_Completed cid -> pure cid
    other -> abort ("expected completed allocation, got: " <> show other)

settleBatchCmd
  : App -> [AllocationV2.TransferLeg] -> [AllocationV2.FinalizedAllocation] -> ExtraArgs
  -> Commands AllocationV2.SettlementFactory_SettleBatchResult
settleBatchCmd App{..} legs finalizedAllocs extraArgs =
  exerciseCmd (toInterfaceContractId @AllocationV2.SettlementFactory rulesCid)
    AllocationV2.SettlementFactory_SettleBatch with
      settlement
      transferLegs = legs
      allocations = finalizedAllocs
      actors = [exchange]
      extraArgs

-- | The disclosures the exchange attaches to a settlement: the rules
-- contract and the locked funding of every allocation.
settlementDisclosures : App -> [AllocationV2.FinalizedAllocation] -> Script [Disclosure]
settlementDisclosures app finalizedAllocs = do
  holdingCids <- forA finalizedAllocs $ \f -> do
    Some v <- queryInterfaceContractId app.admin f.allocationCid
    pure v.holdingCids
  funding <- fundingDisclosures app (concat holdingCids)
  pure (app.rulesDisclosure :: funding)

-- | The exchange settles, passing the statuses of `authorizers` in the batch
-- context.
settleBatch
  : App -> [Party] -> [AllocationV2.TransferLeg] -> [AllocationV2.FinalizedAllocation]
  -> Script AllocationV2.SettlementFactory_SettleBatchResult
settleBatch app authorizers legs finalizedAllocs = do
  disclosures <- settlementDisclosures app finalizedAllocs
  (batchArgs, statuses) <- batchStatusArgs app authorizers
  submit (actAs app.exchange <> discloseMany (disclosures <> statuses))
    (settleBatchCmd app legs finalizedAllocs batchArgs)
cancelCmd : Party -> ExtraArgs -> ContractId AllocationV2.Allocation -> Commands AllocationV2.AllocationResult
cancelCmd actor extraArgs cid = exerciseCmd cid AllocationV2.Allocation_Cancel with
  actors = [actor]; extraArgs

allocationWithdrawCmd : Party -> ExtraArgs -> ContractId AllocationV2.Allocation -> Commands AllocationV2.AllocationResult
allocationWithdrawCmd authorizer extraArgs cid = exerciseCmd cid AllocationV2.Allocation_Withdraw with
  actors = [authorizer]; extraArgs

-- | The admin expires transfer instructions, each with its sender's status.
expireInstructionsCmd : App -> [(ContractId TransferInstructionV2.TransferInstruction, ExtraArgs)] -> Commands ()
expireInstructionsCmd App{..} instructions =
  exerciseCmd rulesCid MyRules_ExpireTransferInstructions with
    expireArgs =
      [ (fromInterfaceContractId @MyTransferInstruction cid, MyTransferInstruction_Expire with extraArgs)
      | (cid, extraArgs) <- instructions ]

-- | The admin expires allocations, each with its authorizer's status.
expireAllocationsCmd : App -> [(ContractId AllocationV2.Allocation, ExtraArgs)] -> Commands ()
expireAllocationsCmd App{..} allocations =
  exerciseCmd rulesCid MyRules_ExpireAllocations with
    cancelArgs =
      [ (cid, AllocationV2.Allocation_Cancel with actors = [admin]; extraArgs)
      | (cid, extraArgs) <- allocations ]

-- | The context of every `Allocation_Settle` in a transaction tree, with the
-- allocation it settled.
settleContexts : TransactionTree -> [(ContractId MyAllocation, ChoiceContext)]
settleContexts tree = concatMap settleContextsIn tree.rootEvents

settleContextsIn : TreeEvent -> [(ContractId MyAllocation, ChoiceContext)]
settleContextsIn (CreatedEvent _) = []
settleContextsIn (ExercisedEvent ex) =
  [ (cid, settle.extraArgs.context)
  | settle <- optionalToList (fromAnyChoice @AllocationV2.Allocation ex.argument : Optional AllocationV2.Allocation_Settle)
  , cid <- optionalToList (fromAnyContractId @MyAllocation ex.contractId) ]
    <> concatMap settleContextsIn ex.childEvents

-- | `MyHolding_Spend` exercises anywhere in a transaction tree.
countSpends : TransactionTree -> Int
countSpends tree = sum (map countSpendsIn tree.rootEvents)

countSpendsIn : TreeEvent -> Int
countSpendsIn (CreatedEvent _) = 0
countSpendsIn (ExercisedEvent ex) =
  (if isSome (fromAnyChoice @MyHolding ex.argument : Optional MyHolding_Spend) then 1 else 0)
  + sum (map countSpendsIn ex.childEvents)

-- | Every `EventLog_HoldingsChange` exercised in a transaction tree.
holdingsChangeEvents : TransactionTree -> [TransferEventsV2.EventLog_HoldingsChange]
holdingsChangeEvents tree = concatMap holdingsChangeEventsIn tree.rootEvents

holdingsChangeEventsIn : TreeEvent -> [TransferEventsV2.EventLog_HoldingsChange]
holdingsChangeEventsIn (CreatedEvent _) = []
holdingsChangeEventsIn (ExercisedEvent ex) =
  optionalToList (fromAnyChoice @TransferEventsV2.EventLog ex.argument)
    <> concatMap holdingsChangeEventsIn ex.childEvents

-- | Assert a tree carries at least `n` events and the auditor is an
-- informee of each.
auditorSeesEvents : Party -> Int -> TransactionTree -> Script ()
auditorSeesEvents auditor n tree = do
  let evs = holdingsChangeEvents tree
  assertMsg ("expected at least " <> show n <> " events, got " <> show (length evs)) (length evs >= n)
  all (\ev -> auditor `elem` ev.observers) evs === True

mustFailWith : Text -> SubmitOptions -> Commands a -> Script ()
mustFailWith expected options cmds = do
  result <- trySubmit options cmds
  case result of
    Right _ -> abort "submission succeeded but was expected to fail"
    Left err -> do
      let msg = show err
      unless (expected `isInfixOf` msg) $
        abort ("submission failed for an unexpected reason: " <> msg)


-- Consumer fields and constructors
-----------------------------------

-- | A transfer accepted in a later transaction creates the consumer's
-- `MyHolding`, carrying the roles, because the pending
-- `MyTransferInstruction` re-supplies the consumer's ops on accept.
testLateAcceptCreatesMyHolding : Script ()
testLateAcceptCreatesMyHolding = do
  app@App{..} <- setup
  aliceTok <- mint app alice 10.0
  (aliceArgs, _) <- statusFor app alice
  result <- submit (actAs alice <> discloseMany [rulesDisclosure])
    (transferCmd app [alice] aliceArgs (mkTransfer app alice bob 7.0 [aliceTok]))
  instrCid <- pendingCid result
  -- The pending contract is the consumer's template, visible to the auditor.
  Some _ <- queryContractId auditor (fromInterfaceContractId @MyTransferInstruction instrCid)
  accept app alice bob instrCid
  balanceSeenBy bob bob >>= (=== [7.0])
  balanceSeenBy alice alice >>= (=== [3.0])
  -- The auditor and the compliance officer observe every holding without
  -- being account parties.
  balanceSeenBy auditor bob >>= (=== [7.0])
  balanceSeenBy auditor alice >>= (=== [3.0])
  balanceSeenBy complianceOfficer bob >>= (=== [7.0])
  bobHoldings <- query @MyHolding bob
  all (\(_, h) -> h.roles.auditor == auditor) bobHoldings === True

-- | Funding goes through the consumer's spend choice. A one-step transfer
-- funded by two inputs exercises it twice; a burn once.
testSpendChoiceRunsOnFunding : Script ()
testSpendChoiceRunsOnFunding = do
  app@App{..} <- setup
  in1 <- mint app alice 4.0
  in2 <- mint app alice 6.0
  (aliceArgs, _) <- statusFor app alice
  tree <- submitTree (actAs [alice, bob] <> discloseMany [rulesDisclosure])
    (transferCmd app [alice, bob] aliceArgs (mkTransfer app alice bob 7.0 [in1, in2]))
  countSpends tree === 2
  balanceSeenBy alice alice >>= (=== [3.0])
  balanceSeenBy bob bob >>= (=== [7.0])
  [(bobCid, _)] <- query @MyHolding bob
  (bobArgs, _) <- statusFor app bob
  burnTree <- submitTree (actAs [admin, bob] <> discloseMany [rulesDisclosure])
    (burnCmd app bob 7.0 bobArgs (toInterfaceContractId @HoldingV2.Holding bobCid))
  countSpends burnTree === 1
  balanceSeenBy bob bob >>= (=== [])

-- | The unlocked holdings `owner` owns.
unlockedOf : Party -> Script [ContractId HoldingV2.Holding]
unlockedOf owner = do
  holdings <- queryFilter @MyHolding owner
    (\h -> isNone h.holding.lock && h.holding.account.owner == Some owner)
  pure [toInterfaceContractId cid | (cid, _) <- holdings]

-- | A pending transfer of `amount` from alice to bob, funded by all of
-- alice's unlocked holdings.
alicePendingTransfer : App -> Decimal -> Script (ContractId TransferInstructionV2.TransferInstruction)
alicePendingTransfer app@App{..} amount = do
  inputs <- unlockedOf alice
  (aliceArgs, _) <- statusFor app alice
  result <- submit (actAs alice <> discloseMany [rulesDisclosure])
    (transferCmd app [alice] aliceArgs (mkTransfer app alice bob amount inputs))
  pendingCid result

-- | Every path that consumes locked funding runs the spend choice, once per
-- locked holding: paying it out on accept or settle, and returning it to
-- its owner on reject, either withdraw, cancel, or expiry.
testSpendRunsOnEveryPath : Script ()
testSpendRunsOnEveryPath = do
  app@App{..} <- setup
  _ <- mint app alice 10.0
  (aliceArgs, aliceStatus) <- statusFor app alice

  accepted <- alicePendingTransfer app 4.0
  acceptFunding <- instructionDisclosures app accepted
  acceptTree <- submitTree (actAs bob <> discloseMany (aliceStatus :: acceptFunding)) (acceptCmd bob aliceArgs accepted)
  countSpends acceptTree === 1

  rejected <- alicePendingTransfer app 2.0
  rejectFunding <- instructionDisclosures app rejected
  rejectTree <- submitTree (actAs bob <> discloseMany (aliceStatus :: rejectFunding)) (rejectCmd bob aliceArgs rejected)
  countSpends rejectTree === 1

  withdrawn <- alicePendingTransfer app 2.0
  withdrawTree <- submitTree (actAs alice) (withdrawCmd alice aliceArgs withdrawn)
  countSpends withdrawTree === 1

  let leg = mkLeg "leg-1" alice bob 3.0
  cancelled <- allocate app alice (mkSpec app alice [senderSide leg] None) =<< unlockedOf alice
  cancelFunding <- allocationDisclosures app cancelled
  cancelTree <- submitTree (actAs exchange <> discloseMany (aliceStatus :: cancelFunding)) (cancelCmd exchange aliceArgs cancelled)
  countSpends cancelTree === 1

  withdrawnAlloc <- allocate app alice (mkSpec app alice [senderSide leg] None) =<< unlockedOf alice
  allocWithdrawTree <- submitTree (actAs alice) (allocationWithdrawCmd alice aliceArgs withdrawnAlloc)
  countSpends allocWithdrawTree === 1

  aliceAlloc <- allocate app alice (mkSpec app alice [senderSide leg] None) =<< unlockedOf alice
  bobAlloc <- allocate app bob (mkSpec app bob [receiverSide leg] None) []
  let finalized = map nonIteratedAllocation [aliceAlloc, bobAlloc]
  disclosures <- settlementDisclosures app finalized
  (batchArgs, statuses) <- batchStatusArgs app [alice, bob]
  settleTree <- submitTree (actAs exchange <> discloseMany (disclosures <> statuses))
    (settleBatchCmd app [leg] finalized batchArgs)
  -- Alice's one locked holding; bob's allocation locks nothing.
  countSpends settleTree === 1

  expiring <- alicePendingTransfer app 1.0
  setTime t3
  expireTree <- submitTree (actAs admin) (expireInstructionsCmd app [(expiring, aliceArgs)])
  countSpends expireTree === 1

  balanceSeenBy bob bob >>= (=== [3.0, 4.0])
  balanceSeenBy alice alice >>= (=== [1.0, 2.0])
  assertNoLocks alice

-- | The iteration successor is the consumer's `MyAllocation`, created by the
-- constructor the template passed.
testIteratedSuccessorIsMyAllocation : Script ()
testIteratedSuccessorIsMyAllocation = do
  app@App{..} <- setup
  aliceInput <- mint app alice 10.0
  aliceDep <- allocate app alice (mkSpec app alice [] (Some (TextMap.fromList [("TOK", 10.0)]))) [aliceInput]
  bobDep <- allocate app bob (mkSpec app bob [] (Some TextMap.empty)) []
  let fill = mkLeg "fill-1" alice bob 3.0
  r <- settleBatch app [alice, bob] [fill]
    [ AllocationV2.FinalizedAllocation with
        allocationCid = aliceDep
        extraTransferLegSides = [senderSide fill]
        nextIterationFunding = Some (TextMap.fromList [("TOK", 7.0)])
    , AllocationV2.FinalizedAllocation with
        allocationCid = bobDep
        extraTransferLegSides = [receiverSide fill]
        nextIterationFunding = None
    ]
  [aliceR, _] <- pure r.allocationSettleResults
  successor <- case aliceR.output of
    AllocationV2.AllocationResult_Settled (Some cid) -> pure cid
    other -> abort ("expected a successor, got: " <> show other)
  Some succ <- queryContractId auditor (fromInterfaceContractId @MyAllocation successor)
  succ.roles.auditor === auditor
  succ.state.numIterations === 1
  succ.state.originalAllocationCid === Some aliceDep
  balanceSeenBy bob bob >>= (=== [3.0])

-- | A full DvP through the consumer's registry.
testDvpSettles : Script ()
testDvpSettles = do
  app@App{..} <- setup
  aliceTok <- mint app alice 15.0
  let leg = mkLeg "leg-1" alice bob 10.0
  aliceAlloc <- allocate app alice (mkSpec app alice [senderSide leg] None) [aliceTok]
  bobAlloc <- allocate app bob (mkSpec app bob [receiverSide leg] None) []
  _ <- settleBatch app [alice, bob] [leg] (map nonIteratedAllocation [aliceAlloc, bobAlloc])
  balanceSeenBy alice alice >>= (=== [5.0])
  balanceSeenBy bob bob >>= (=== [10.0])

-- | `MyAllocation` settles through `allocationSettleImpl`. Without a
-- settlement deadline, `expiresAt` is `createdAt + maxTTL`. From `expiresAt`
-- on, the batch fails and the admin's expiry returns the funding.
testSettlementRefusedAfterExpiresAt : Script ()
testSettlementRefusedAfterExpiresAt = do
  app@App{..} <- setup
  aliceTok <- mint app alice 15.0
  Some rules <- queryContractId admin rulesCid
  let leg = mkLeg "leg-1" alice bob 10.0
      openSpec trader sides = (mkSpec app trader sides None) with settlementDeadline = None
      expiresAt = t0 `addRelTime` rules.config.maxTTL
  aliceAlloc <- allocate app alice (openSpec alice [senderSide leg]) [aliceTok]
  bobAlloc <- allocate app bob (openSpec bob [receiverSide leg]) []
  Some v <- queryInterfaceContractId @AllocationV2.Allocation alice aliceAlloc
  v.expiresAt === Some expiresAt
  setTime expiresAt
  let finalized = map nonIteratedAllocation [aliceAlloc, bobAlloc]
  disclosures <- settlementDisclosures app finalized
  (batchArgs, statuses) <- batchStatusArgs app [alice, bob]
  mustFailWith "Ledger time is at or past deadline 'allocation.expiresAt'"
    (actAs exchange <> discloseMany (disclosures <> statuses))
    (settleBatchCmd app [leg] finalized batchArgs)
  (aliceArgs, _) <- statusFor app alice
  (bobArgs, _) <- statusFor app bob
  submit (actAs admin) (expireAllocationsCmd app [(aliceAlloc, aliceArgs), (bobAlloc, bobArgs)])
  balanceSeenBy alice alice >>= (=== [5.0, 10.0])
  balanceSeenBy bob bob >>= (=== [])

-- | The auditor is an informee of every event the workflows emit for the
-- token: mint, the lock on instruction, both sides of the accepted
-- transfer, a one-step burn, and both events of a two-step burn: the lock
-- on request and the burn on the admin's accept. Visibility on contracts
-- alone would miss the standard event stream.
testAuditorObservesEvents : Script ()
testAuditorObservesEvents = do
  app@App{..} <- setup
  (aliceArgs, aliceStatus) <- statusFor app alice
  (bobArgs, _) <- statusFor app bob
  offerCid <- submit (actAs admin) (offerMintCmd app alice 10.0)
  (mintResult, mintTree) <- submitResultAndTree (actAs alice) (acceptCmd alice emptyExtraArgs offerCid)
  auditorSeesEvents auditor 1 mintTree
  [aliceTok] <- case mintResult.output of
    TransferInstructionV2.TransferInstructionResult_Completed cids -> pure cids
    other -> abort ("expected a completed mint, got: " <> show other)
  (result, instructTree) <- submitResultAndTree (actAs alice <> discloseMany [rulesDisclosure])
    (transferCmd app [alice] aliceArgs (mkTransfer app alice bob 7.0 [aliceTok]))
  auditorSeesEvents auditor 1 instructTree
  instrCid <- pendingCid result
  funding <- instructionDisclosures app instrCid
  acceptTree <- submitTree (actAs bob <> discloseMany (aliceStatus :: funding)) (acceptCmd bob aliceArgs instrCid)
  -- Sender-side and receiver-side events of the completed transfer.
  auditorSeesEvents auditor 2 acceptTree
  [(bobCid, _)] <- query @MyHolding bob
  (burnResult, burnTree) <- submitResultAndTree (actAs [admin, bob] <> discloseMany [rulesDisclosure])
    (burnCmd app bob 3.0 bobArgs (toInterfaceContractId @HoldingV2.Holding bobCid))
  auditorSeesEvents auditor 1 burnTree
  -- Bob requests a burn of the change alone; the auditor observes the
  -- pending request, and the admin accepts it.
  (requestResult, requestTree) <- submitResultAndTree (actAs bob <> discloseMany [rulesDisclosure])
    (transferCmd app [bob] bobArgs ((mkTransfer app bob bob 4.0 burnResult.senderChangeCids) with receiver = burnAccount))
  auditorSeesEvents auditor 1 requestTree
  requestCid <- pendingCid requestResult
  Some _ <- queryContractId auditor (fromInterfaceContractId @MyTransferInstruction requestCid)
  burnAcceptTree <- submitTree (actAs admin) (acceptCmd admin bobArgs requestCid)
  auditorSeesEvents auditor 1 burnAcceptTree
  balanceSeenBy auditor bob >>= (=== [])

-- Compliance freeze
--------------------

-- | Only the compliance officer opens a status, and only for a regular
-- account. The account parties and the auditor observe it. Only the
-- officer freezes and unfreezes, and each refuses the status it would
-- leave unchanged.
testOnlyComplianceOfficerControlsAccountStatus : Script ()
testOnlyComplianceOfficerControlsAccountStatus = do
  app@App{..} <- setup
  carol <- allocateParty "carol"
  submitMustFail (actAs admin) do
    exerciseCmd rulesCid MyRules_OpenAccount with account = basicAccount carol
  submitMustFail (actAs complianceOfficer) do
    exerciseCmd rulesCid MyRules_OpenAccount with account = burnAccount
  carolStatus <- openAccount app carol
  Some opened <- queryContractId carol carolStatus
  opened.frozen === False
  Some _ <- queryContractId auditor carolStatus

  -- Neither the admin (a signatory), the owner, nor the pauser can freeze.
  aliceStatus <- statusOf app alice
  submitMustFail (actAs admin) do exerciseCmd aliceStatus MyAccountStatus_Freeze
  submitMustFail (actAs alice) do exerciseCmd aliceStatus MyAccountStatus_Freeze
  submitMustFail (actAs pauser) do exerciseCmd aliceStatus MyAccountStatus_Freeze
  mustFailWith "account is not frozen" (actAs complianceOfficer) do
    exerciseCmd aliceStatus MyAccountStatus_Unfreeze
  frozenStatus <- freeze app alice
  mustFailWith "account is already frozen" (actAs complianceOfficer) do
    exerciseCmd frozenStatus MyAccountStatus_Freeze
  submitMustFail (actAs admin) do exerciseCmd frozenStatus MyAccountStatus_Unfreeze
  submitMustFail (actAs alice) do exerciseCmd frozenStatus MyAccountStatus_Unfreeze
  _ <- unfreeze app alice
  pure ()

-- | A frozen account's holdings are refused as funding for a transfer, an
-- allocation, and a burn. The holding keeps its id, and the standard view
-- still shows it as an ordinary holding. After unfreezing, the same
-- holding funds the transfer.
testFrozenAccountCannotFund : Script ()
testFrozenAccountCannotFund = do
  app@App{..} <- setup
  aliceTok <- mint app alice 10.0
  frozenArgs <- statusArgs <$> freeze app alice

  mustFailWith "account is frozen" (actAs alice <> discloseMany [rulesDisclosure])
    (transferCmd app [alice] frozenArgs (mkTransfer app alice bob 7.0 [aliceTok]))
  mustFailWith "account is frozen" (actAs alice <> discloseMany [rulesDisclosure])
    (allocateCmd app settlement alice (mkSpec app alice [senderSide (mkLeg "leg-1" alice bob 7.0)] None) [aliceTok] frozenArgs)
  mustFailWith "account is frozen" (actAs [admin, alice] <> discloseMany [rulesDisclosure])
    (burnCmd app alice 10.0 frozenArgs aliceTok)

  -- Wallets reading the standard interface see nothing unusual.
  Some v <- queryInterfaceContractId @HoldingV2.Holding alice aliceTok
  v.amount === 10.0
  v.lock === None

  thawedArgs <- statusArgs <$> unfreeze app alice
  _ <- submit (actAs [alice, bob] <> discloseMany [rulesDisclosure])
    (transferCmd app [alice, bob] thawedArgs (mkTransfer app alice bob 7.0 [aliceTok]))
  balanceSeenBy bob bob >>= (=== [7.0])
  balanceSeenBy alice alice >>= (=== [3.0])

-- | Freezing an account with a live locked transfer and allocation holds
-- both. New funding, accept, reject, both withdraws, batch and direct
-- settle, and cancel all fail. The freeze replaces only the status, so
-- after unfreezing the same instruction is accepted and the same allocation
-- settles.
testFreezeHoldsPendingFundsUntilUnfrozen : Script ()
testFreezeHoldsPendingFundsUntilUnfrozen = do
  app@App{..} <- setup
  _ <- mint app alice 10.0
  instrCid <- alicePendingTransfer app 4.0
  let leg = mkLeg "leg-1" alice bob 3.0
  aliceAlloc <- allocate app alice (mkSpec app alice [senderSide leg] None) =<< unlockedOf alice
  bobAlloc <- allocate app bob (mkSpec app bob [receiverSide leg] None) []
  change <- unlockedOf alice

  frozenStatus <- freeze app alice
  frozenDisclosure <- statusDisclosure app frozenStatus
  funding <- instructionDisclosures app instrCid
  allocFunding <- allocationDisclosures app aliceAlloc
  let frozenArgs = statusArgs frozenStatus
      asBob = actAs bob <> discloseMany (frozenDisclosure :: funding)
  mustFailWith "account is frozen" (actAs alice <> discloseMany [rulesDisclosure])
    (transferCmd app [alice] frozenArgs (mkTransfer app alice bob 1.0 change))
  mustFailWith "account is frozen" asBob (acceptCmd bob frozenArgs instrCid)
  mustFailWith "account is frozen" asBob (rejectCmd bob frozenArgs instrCid)
  mustFailWith "account is frozen" (actAs alice) (withdrawCmd alice frozenArgs instrCid)
  disclosures <- settlementDisclosures app (map nonIteratedAllocation [aliceAlloc, bobAlloc])
  (batchArgs, statuses) <- batchStatusArgs app [alice, bob]
  mustFailWith "account is frozen" (actAs exchange <> discloseMany (disclosures <> statuses))
    (settleBatchCmd app [leg] (map nonIteratedAllocation [aliceAlloc, bobAlloc]) batchArgs)
  mustFailWith "account is frozen" (actAs [admin, exchange]) do
    exerciseCmd aliceAlloc AllocationV2.Allocation_Settle with
      actors = [admin, exchange]
      extraTransferLegSides = []
      nextIterationFunding = None
      extraArgs = frozenArgs
  mustFailWith "account is frozen" (actAs exchange <> discloseMany (frozenDisclosure :: allocFunding))
    (cancelCmd exchange frozenArgs aliceAlloc)
  mustFailWith "account is frozen" (actAs alice) (allocationWithdrawCmd alice frozenArgs aliceAlloc)
  [(lockedCid, _)] <- queryFilter @MyHolding alice (\h -> isSome h.holding.lock && h.holding.amount == 4.0)

  _ <- unfreeze app alice
  -- The locked holdings kept their ids through the freeze.
  Some _ <- queryContractId alice lockedCid
  accept app alice bob instrCid
  _ <- settleBatch app [alice, bob] [leg] (map nonIteratedAllocation [aliceAlloc, bobAlloc])
  balanceSeenBy bob bob >>= (=== [3.0, 4.0])
  balanceSeenBy alice alice >>= (=== [3.0])
  assertNoLocks alice

-- | A frozen account's expired funding stays locked too: the admin's expiry
-- of its instruction and its allocation fails, and so does an expiry batch
-- that also holds another account's allocation, which goes through alone.
-- After unfreezing, both expire and return the funds.
testFreezeHoldsExpiryUntilUnfrozen : Script ()
testFreezeHoldsExpiryUntilUnfrozen = do
  app@App{..} <- setup
  (instrCid, aliceAlloc) <- lockAliceFunds app
  bobTok <- mint app bob 5.0
  bobAlloc <- allocate app bob (mkSpec app bob [senderSide (mkLeg "leg-2" bob alice 5.0)] None) [bobTok]
  frozenArgs <- statusArgs <$> freeze app alice
  (bobArgs, _) <- statusFor app bob
  setTime t3

  mustFailWith "account is frozen" (actAs admin) (expireInstructionsCmd app [(instrCid, frozenArgs)])
  mustFailWith "account is frozen" (actAs admin) (expireAllocationsCmd app [(aliceAlloc, frozenArgs)])
  mustFailWith "account is frozen" (actAs admin)
    (expireAllocationsCmd app [(bobAlloc, bobArgs), (aliceAlloc, frozenArgs)])
  submit (actAs admin) (expireAllocationsCmd app [(bobAlloc, bobArgs)])
  balanceSeenBy bob bob >>= (=== [5.0])

  thawedArgs <- statusArgs <$> unfreeze app alice
  submit (actAs admin) (expireInstructionsCmd app [(instrCid, thawedArgs)])
  submit (actAs admin) (expireAllocationsCmd app [(aliceAlloc, thawedArgs)])
  balanceSeenBy alice alice >>= (=== [3.0, 5.0, 7.0])
  assertNoLocks alice

-- | The status a submitter passes must be live: the ids from before a freeze
-- and before the unfreeze no longer fetch. A context without the entry, or
-- with an entry that is not a contract id, is refused. Only the live id
-- moves the holding.
testStaleOrMissingStatusIsRefused : Script ()
testStaleOrMissingStatusIsRefused = do
  app@App{..} <- setup
  aliceTok <- mint app alice 10.0
  original <- statusOf app alice
  frozenStatus <- freeze app alice
  thawed <- unfreeze app alice
  let send extraArgs = transferCmd app [alice, bob] extraArgs (mkTransfer app alice bob 7.0 [aliceTok])
      options = actAs [alice, bob] <> discloseMany [rulesDisclosure]
  submitMustFail options (send (statusArgs original))
  submitMustFail options (send (statusArgs frozenStatus))
  mustFailWith ("choice context has no '" <> accountStatusKey <> "' entry") options (send emptyExtraArgs)
  mustFailWith "must be a contract id" options
    (send (emptyExtraArgs with context = ChoiceContext with values = TextMap.fromList [(accountStatusKey, AV_Text "active")]))
  _ <- submit options (send (statusArgs thawed))
  balanceSeenBy bob bob >>= (=== [7.0])

-- | A live status of another account does not cover the holding, even when
-- that account is not frozen.
testOtherAccountsStatusIsRefused : Script ()
testOtherAccountsStatusIsRefused = do
  app@App{..} <- setup
  aliceTok <- mint app alice 10.0
  (bobArgs, bobStatus) <- statusFor app bob
  mustFailWith "account status does not cover this holding" (actAs [alice, bob] <> discloseMany [rulesDisclosure, bobStatus])
    (transferCmd app [alice, bob] bobArgs (mkTransfer app alice bob 7.0 [aliceTok]))

-- | A status counts only if the compliance officer recorded on the holding
-- signed it. The admin alone can create a status that names itself as the
-- officer, and it does not cover the holding. Neither does a status opened
-- under rules with another officer. A status opened under rules that
-- changed only the auditor still covers it.
testStatusMustCarryTheHoldingsOfficer : Script ()
testStatusMustCarryTheHoldingsOfficer = do
  app@App{..} <- setup
  aliceTok <- mint app alice 10.0
  otherOfficer <- allocateParty "otherOfficer"
  newAuditor <- allocateParty "newAuditor"
  Some rules <- queryContractId admin rulesCid
  let send statusCid = transferCmd app [alice, bob] (statusArgs statusCid) (mkTransfer app alice bob 7.0 [aliceTok])
      options = actAs [alice, bob] <> discloseMany [rulesDisclosure]
      openUnder newRoles = do
        newRulesCid <- submit admin do createCmd rules with roles = newRoles
        submit (actAs newRoles.complianceOfficer) do
          exerciseCmd newRulesCid MyRules_OpenAccount with account = basicAccount alice

  selfSigned <- submit admin do
    createCmd MyAccountStatus with
      admin
      account = basicAccount alice
      roles = AppRoles with auditor; complianceOfficer = admin
      frozen = False
  mustFailWith "account status does not cover this holding" options (send selfSigned)
  otherOfficerStatus <- openUnder (AppRoles with auditor; complianceOfficer = otherOfficer)
  mustFailWith "account status does not cover this holding" options (send otherOfficerStatus)
  newAuditorStatus <- openUnder (AppRoles with auditor = newAuditor; complianceOfficer)
  _ <- submit options (send newAuditorStatus)
  balanceSeenBy bob bob >>= (=== [7.0])

-- | The compliance officer signs every status, so the admin alone cannot
-- create one that names the officer. A status opened under rules with
-- another admin and the same officer does not cover alice's holding.
-- `testStatusMustCarryTheHoldingsOfficer` covers a status of another officer.
testStatusNeedsOfficerSignatureAndHoldingsAdmin : Script ()
testStatusNeedsOfficerSignatureAndHoldingsAdmin = do
  app@App{..} <- setup
  aliceTok <- mint app alice 10.0
  forged <- trySubmit (actAs admin) do
    createCmd MyAccountStatus with
      admin
      account = basicAccount alice
      roles = AppRoles with auditor; complianceOfficer
      frozen = False
  case forged of
    Left (AuthorizationError _) -> pure ()
    other -> abort ("expected an authorization error, got: " <> show other)
  otherAdmin <- allocateParty "otherAdmin"
  Some rules <- queryContractId admin rulesCid
  otherRulesCid <- submit otherAdmin do
    createCmd rules with config = rules.config with admin = otherAdmin
  otherStatus <- submit (actAs complianceOfficer) do
    exerciseCmd otherRulesCid MyRules_OpenAccount with account = basicAccount alice
  mustFailWith "account status does not cover this holding" (actAs [alice, bob] <> discloseMany [rulesDisclosure])
    (transferCmd app [alice, bob] (statusArgs otherStatus) (mkTransfer app alice bob 7.0 [aliceTok]))

-- | A holding keeps the compliance officer it was created with. After the
-- admin creates rules with another officer, a transfer that pays a fee from
-- an earlier holding is refused for the earlier officer's status and for
-- the new officer's. The fee leg's change carries the new officer, and one
-- choice context carries one status. A burn pays no fee, so the earlier
-- status still burns the holding.
testEarlierHoldingCannotPayFeeAfterOfficerChange : Script ()
testEarlierHoldingCannotPayFeeAfterOfficerChange = do
  app@App{..} <- setupWith 100
  aliceTok <- mint app alice 250.0
  earlierStatus <- statusOf app alice
  newOfficer <- allocateParty "newOfficer"
  Some rules <- queryContractId admin rulesCid
  newRulesCid <- submit admin do
    createCmd rules with roles = AppRoles with auditor; complianceOfficer = newOfficer
  Some newDisclosure <- queryDisclosure @MyRules admin newRulesCid
  newStatus <- submit (actAs newOfficer) do
    exerciseCmd newRulesCid MyRules_OpenAccount with account = basicAccount alice
  let newApp = app with rulesCid = newRulesCid; rulesDisclosure = newDisclosure
      send statusCid = transferCmd newApp [alice, bob] (statusArgs statusCid) (mkTransfer newApp alice bob 100.0 [aliceTok])
      options = actAs [alice, bob] <> discloseMany [newDisclosure]
  mustFailWith "account status does not cover this holding" options (send earlierStatus)
  mustFailWith "account status does not cover this holding" options (send newStatus)
  _ <- submit (actAs [admin, alice] <> discloseMany [newDisclosure])
    (burnCmd newApp alice 250.0 (statusArgs earlierStatus) aliceTok)
  balanceSeenBy alice alice >>= (=== [])

-- | The move the README describes for a new officer. Under the new rules, an
-- allocation funded by an earlier holding with the earlier status creates
-- its locked funding and change under the new officer, and a withdraw with
-- the new status returns the funding. Once every holding answers to the new
-- officer, a transfer that pays a fee goes through with the new status.
testHoldingMovesToNewOfficerThroughAllocation : Script ()
testHoldingMovesToNewOfficerThroughAllocation = do
  app@App{..} <- setupWith 100
  aliceTok <- mint app alice 250.0
  earlierStatus <- statusOf app alice
  newOfficer <- allocateParty "newOfficer"
  Some rules <- queryContractId admin rulesCid
  let newRoles = AppRoles with auditor; complianceOfficer = newOfficer
  newRulesCid <- submit admin do createCmd rules with roles = newRoles
  Some newDisclosure <- queryDisclosure @MyRules admin newRulesCid
  newStatus <- submit (actAs newOfficer) do
    exerciseCmd newRulesCid MyRules_OpenAccount with account = basicAccount alice
  let newApp = app with rulesCid = newRulesCid; rulesDisclosure = newDisclosure
      spec = mkSpec newApp alice [senderSide (mkLeg "leg-move" alice bob 100.0)] None

  allocated <- submit (actAs alice <> discloseMany [newDisclosure])
    (allocateCmd newApp settlement alice spec [aliceTok] (statusArgs earlierStatus))
  allocCid <- case allocated.output of
    AllocationInstructionV2.AllocationInstructionResult_Completed cid -> pure cid
    other -> abort ("expected completed allocation, got: " <> show other)
  funded <- query @MyHolding alice
  sort [(isSome h.holding.lock, h.holding.amount) | (_, h) <- funded] === [(False, 150.0), (True, 100.0)]
  all (\(_, h) -> h.roles == newRoles) funded === True
  _ <- submit (actAs alice) (allocationWithdrawCmd alice (statusArgs newStatus) allocCid)
  holdings <- query @MyHolding alice
  sort [h.holding.amount | (_, h) <- holdings] === [100.0, 150.0]
  all (\(_, h) -> h.roles == newRoles) holdings === True

  _ <- submit (actAs [alice, bob] <> discloseMany [newDisclosure])
    (transferCmd newApp [alice, bob] (statusArgs newStatus)
      (mkTransfer newApp alice bob 100.0 [toInterfaceContractId cid | (cid, _) <- holdings]))
  balanceSeenBy bob bob >>= (=== [100.0])
  balanceSeenBy alice alice >>= (=== [149.0])

-- | A pending instruction keeps the officer it was created with, so after
-- the admin replaces the rules, its accept still needs the earlier status
-- and gives the receiver a holding under the earlier officer.
testPendingInstructionKeepsItsOfficer : Script ()
testPendingInstructionKeepsItsOfficer = do
  app@App{..} <- setup
  aliceTok <- mint app alice 10.0
  (aliceArgs, aliceStatus) <- statusFor app alice
  instrCid <- pendingCid =<< submit (actAs alice <> discloseMany [rulesDisclosure])
    (transferCmd app [alice] aliceArgs (mkTransfer app alice bob 7.0 [aliceTok]))
  newOfficer <- allocateParty "newOfficer"
  Some rules <- queryContractId admin rulesCid
  submit admin do archiveCmd rulesCid
  newRulesCid <- submit admin do
    createCmd rules with roles = AppRoles with auditor; complianceOfficer = newOfficer
  newStatus <- submit (actAs newOfficer) do
    exerciseCmd newRulesCid MyRules_OpenAccount with account = basicAccount alice
  newDisclosure <- statusDisclosure app newStatus
  funding <- instructionDisclosures app instrCid
  mustFailWith "account status does not cover this holding" (actAs bob <> discloseMany (newDisclosure :: funding))
    (acceptCmd bob (statusArgs newStatus) instrCid)
  _ <- submit (actAs bob <> discloseMany (aliceStatus :: funding)) (acceptCmd bob aliceArgs instrCid)
  [(_, received)] <- query @MyHolding bob
  received.roles.complianceOfficer === complianceOfficer
  received.holding.amount === 7.0

-- | The README's steps for a new officer. The paused earlier rules refuse a
-- new transfer, and the earlier officer still opens a status through them
-- for carol, who receives a transfer made under the earlier officer. Only
-- that status covers carol's holding, not the one the new officer opens.
-- Carol spends it through the new rules, and bob's holding answers to the
-- new officer.
testPausedEarlierRulesStillOpenStatuses : Script ()
testPausedEarlierRulesStillOpenStatuses = do
  app@App{..} <- setup
  carol <- allocateParty "carol"
  aliceTok <- mint app alice 10.0
  (aliceArgs, _) <- statusFor app alice
  instrCid <- pendingCid =<< submit (actAs alice <> discloseMany [rulesDisclosure])
    (transferCmd app [alice] aliceArgs (mkTransfer app alice carol 7.0 [aliceTok]))
  earlier <- pauseRegistry app
  newOfficer <- allocateParty "newOfficer"
  Some rules <- queryContractId admin earlier.rulesCid
  newRulesCid <- submit admin do
    createCmd rules with
      roles = AppRoles with auditor; complianceOfficer = newOfficer
      paused = False
  Some newDisclosure <- queryDisclosure @MyRules admin newRulesCid
  let newApp = app with rulesCid = newRulesCid; rulesDisclosure = newDisclosure

  aliceChange <- unlockedOf alice
  mustFailWith "registry is paused" (actAs alice <> discloseMany [earlier.rulesDisclosure])
    (transferCmd earlier [alice] aliceArgs (mkTransfer earlier alice bob 1.0 aliceChange))

  carolStatus <- openAccount earlier carol
  carolNewStatus <- submit (actAs newOfficer) do
    exerciseCmd newRulesCid MyRules_OpenAccount with account = basicAccount carol
  accept app alice carol instrCid
  [(carolCid, received)] <- query @MyHolding carol
  received.roles.complianceOfficer === complianceOfficer
  let spendCarol statusCid = transferCmd newApp [carol, bob] (statusArgs statusCid)
        (mkTransfer newApp carol bob 7.0 [toInterfaceContractId carolCid])
      asCarolAndBob = actAs [carol, bob] <> discloseMany [newDisclosure]
  mustFailWith "account status does not cover this holding" asCarolAndBob (spendCarol carolNewStatus)
  _ <- submit asCarolAndBob (spendCarol carolStatus)
  [(_, paid)] <- query @MyHolding bob
  paid.roles.complianceOfficer === newOfficer
  balanceSeenBy bob bob >>= (=== [7.0])

-- | In a batch, each allocation receives only its own authorizer's status,
-- under the key a direct settle uses. Alice sends 10 TOK for bob's 4 USD, so
-- both lock funding. The executors also put alice's status under the plain
-- key, which reaches neither. Swapped statuses fail on the account check,
-- and a frozen bob fails the whole batch though alice is not frozen.
testBatchForwardsEachAuthorizerItsStatus : Script ()
testBatchForwardsEachAuthorizerItsStatus = do
  app@App{..} <- setup
  aliceTok <- mint app alice 10.0
  bobUsd <- mintOf app bob "USD" 4.0
  let tokLeg = mkLeg "leg-tok" alice bob 10.0
      usdLeg = (mkLeg "leg-usd" bob alice 4.0) with instrumentId = "USD"
      allocs cids = map nonIteratedAllocation cids
      legs = [tokLeg, usdLeg]
  aliceAlloc <- allocate app alice (mkSpec app alice [senderSide tokLeg, receiverSide usdLeg] None) [aliceTok]
  bobAlloc <- allocate app bob (mkSpec app bob [receiverSide tokLeg, senderSide usdLeg] None) [bobUsd]
  aliceStatus <- statusOf app alice
  bobStatus <- statusOf app bob
  aliceDisclosure <- statusDisclosure app aliceStatus
  bobDisclosure <- statusDisclosure app bobStatus
  funding <- settlementDisclosures app (allocs [aliceAlloc, bobAlloc])
  -- Disclose only live statuses: a submission that discloses an archived
  -- contract is refused.
  let asExchange statuses = actAs exchange <> discloseMany (funding <> (aliceDisclosure :: statuses))
      batchWith entries = ExtraArgs with
        context = ChoiceContext with values = TextMap.fromList entries
        meta = emptyMetadata

  mustFailWith "account status does not cover this holding" (asExchange [bobDisclosure])
    (settleBatchCmd app legs (allocs [aliceAlloc, bobAlloc]) (batchWith
      [ (batchStatusKey (basicAccount alice), statusValue bobStatus)
      , (batchStatusKey (basicAccount bob), statusValue aliceStatus) ]))

  frozenBob <- freeze app bob
  frozenBobDisclosure <- statusDisclosure app frozenBob
  mustFailWith "account is frozen" (asExchange [frozenBobDisclosure])
    (settleBatchCmd app legs (allocs [aliceAlloc, bobAlloc]) (batchWith
      [ (batchStatusKey (basicAccount alice), statusValue aliceStatus)
      , (batchStatusKey (basicAccount bob), statusValue frozenBob) ]))
  thawedBob <- unfreeze app bob
  thawedBobDisclosure <- statusDisclosure app thawedBob

  tree <- submitTree (asExchange [thawedBobDisclosure])
    (settleBatchCmd app legs (allocs [aliceAlloc, bobAlloc]) (batchWith
      [ (batchStatusKey (basicAccount alice), statusValue aliceStatus)
      , (batchStatusKey (basicAccount bob), statusValue thawedBob)
      , (accountStatusKey, statusValue aliceStatus) ]))
  settleContexts tree ===
    [ (fromInterfaceContractId @MyAllocation aliceAlloc, statusContext aliceStatus)
    , (fromInterfaceContractId @MyAllocation bobAlloc, statusContext thawedBob) ]
  countSpends tree === 2
  balanceSeenBy alice alice >>= (=== [4.0])
  balanceSeenBy bob bob >>= (=== [10.0])

-- | `MyRules` declares no extra observers of a batch settlement.
testSettlementAddsNoBatchObservers : Script ()
testSettlementAddsNoBatchObservers = do
  App{..} <- setup
  Some rules <- queryContractId admin rulesCid
  let batch = AllocationV2.SettlementFactory_SettleBatch with
        settlement
        transferLegs =
          [ mkLeg "leg-tok" alice bob 10.0
          , (mkLeg "leg-usd" bob alice 4.0) with instrumentId = "USD" ]
        allocations = []
        actors = [exchange]
        extraArgs = emptyExtraArgs
  AllocationV2.settlementFactory_settleBatchExtraObservers
    (toInterface @AllocationV2.SettlementFactory rules) batch === []

-- | An allocation that locked nothing consumes no holding, so the batch
-- context needs no status for its authorizer. With only alice's status in
-- the batch context, bob's receiving settle gets an empty context. With only
-- bob's, alice's locked funding finds no status and the batch fails.
testReceiveOnlyAuthorizerNeedsNoStatus : Script ()
testReceiveOnlyAuthorizerNeedsNoStatus = do
  app@App{..} <- setup
  aliceTok <- mint app alice 10.0
  let leg = mkLeg "leg-1" alice bob 10.0
  aliceAlloc <- allocate app alice (mkSpec app alice [senderSide leg] None) [aliceTok]
  bobAlloc <- allocate app bob (mkSpec app bob [receiverSide leg] None) []
  let finalized = map nonIteratedAllocation [aliceAlloc, bobAlloc]
  disclosures <- settlementDisclosures app finalized
  (bobOnlyArgs, bobStatuses) <- batchStatusArgs app [bob]
  mustFailWith ("choice context has no '" <> accountStatusKey <> "' entry")
    (actAs exchange <> discloseMany (disclosures <> bobStatuses))
    (settleBatchCmd app [leg] finalized bobOnlyArgs)
  (aliceOnlyArgs, aliceStatuses) <- batchStatusArgs app [alice]
  tree <- submitTree (actAs exchange <> discloseMany (disclosures <> aliceStatuses))
    (settleBatchCmd app [leg] finalized aliceOnlyArgs)
  aliceStatus <- statusOf app alice
  settleContexts tree ===
    [ (fromInterfaceContractId @MyAllocation aliceAlloc, statusContext aliceStatus)
    , (fromInterfaceContractId @MyAllocation bobAlloc, emptyChoiceContext) ]
  balanceSeenBy bob bob >>= (=== [10.0])

-- | One frozen sender fails the admin's whole instruction expiry batch, and
-- the other sender's instruction stays pending. Without the frozen sender,
-- the batch goes through.
testOneFrozenSenderFailsTheInstructionExpiryBatch : Script ()
testOneFrozenSenderFailsTheInstructionExpiryBatch = do
  app@App{..} <- setup
  aliceTok <- mint app alice 10.0
  bobTok <- mint app bob 5.0
  (aliceArgs, _) <- statusFor app alice
  (bobArgs, _) <- statusFor app bob
  aliceInstr <- pendingCid =<< submit (actAs alice <> discloseMany [rulesDisclosure])
    (transferCmd app [alice] aliceArgs (mkTransfer app alice bob 7.0 [aliceTok]))
  bobInstr <- pendingCid =<< submit (actAs bob <> discloseMany [rulesDisclosure])
    (transferCmd app [bob] bobArgs (mkTransfer app bob alice 5.0 [bobTok]))
  frozenArgs <- statusArgs <$> freeze app alice
  setTime t3
  mustFailWith "account is frozen" (actAs admin)
    (expireInstructionsCmd app [(bobInstr, bobArgs), (aliceInstr, frozenArgs)])
  Some _ <- queryContractId admin (fromInterfaceContractId @MyTransferInstruction bobInstr)
  submit (actAs admin) (expireInstructionsCmd app [(bobInstr, bobArgs)])
  balanceSeenBy bob bob >>= (=== [5.0])

-- | An owner unlock of expired funding is refused while the account is
-- frozen, so it cannot orphan the pending instruction that names the
-- locked holding. Once unfrozen, the same unlock goes through.
testFrozenAccountCannotUnlock : Script ()
testFrozenAccountCannotUnlock = do
  app@App{..} <- setup
  aliceTok <- mint app alice 10.0
  (aliceArgs, _) <- statusFor app alice
  _ <- submit (actAs alice <> discloseMany [rulesDisclosure])
    (transferCmd app [alice] aliceArgs (mkTransfer app alice bob 7.0 [aliceTok]))
  [(lockedCid, _)] <- queryFilter @MyHolding alice (\h -> isSome h.holding.lock)
  -- t4 is past the lock's expiry: t2 plus the one-hour lock grace.
  setTime t4
  frozenStatus <- freeze app alice
  mustFailWith "account is frozen" (actAs alice) do
    exerciseCmd lockedCid MyHolding_OwnerUnlock with statusCid = frozenStatus
  thawed <- unfreeze app alice
  _ <- submit (actAs alice) do exerciseCmd lockedCid MyHolding_OwnerUnlock with statusCid = thawed
  assertNoLocks alice

-- | The admin unlock recreates the holding the same way, so it makes the
-- same freeze check.
testFrozenHoldingCannotAdminUnlock : Script ()
testFrozenHoldingCannotAdminUnlock = do
  app@App{..} <- setup
  aliceTok <- mint app alice 10.0
  (aliceArgs, _) <- statusFor app alice
  _ <- submit (actAs alice <> discloseMany [rulesDisclosure])
    (transferCmd app [alice] aliceArgs (mkTransfer app alice bob 7.0 [aliceTok]))
  [(lockedCid, _)] <- queryFilter @MyHolding alice (\h -> isSome h.holding.lock)
  setTime t4
  frozenStatus <- freeze app alice
  mustFailWith "account is frozen" (actAs admin) do
    exerciseCmd lockedCid MyHolding_AdminUnlock with statusCid = frozenStatus
  thawed <- unfreeze app alice
  _ <- submit (actAs admin) do exerciseCmd lockedCid MyHolding_AdminUnlock with statusCid = thawed
  assertNoLocks alice

-- | A holding with a live lock backs a pending contract that names it by
-- contract id. The freeze replaces only the account's status, so it covers
-- that holding without re-creating it: the receiver's accept and the
-- exchange's settlement both refuse to pay out the frozen account's locked
-- funding. The locked holdings keep their ids, so after the unfreeze the
-- same transfer is accepted and the same allocation settles.
testLockedHoldingCanBeFrozen : Script ()
testLockedHoldingCanBeFrozen = do
  app@App{..} <- setup
  aliceTok <- mint app alice 10.0
  allocTok <- mint app alice 5.0
  (aliceArgs, _) <- statusFor app alice
  instrCid <- pendingCid =<< submit (actAs alice <> discloseMany [rulesDisclosure])
    (transferCmd app [alice] aliceArgs (mkTransfer app alice bob 7.0 [aliceTok]))
  let leg = mkLeg "leg-1" alice bob 5.0
      finalized cids = map nonIteratedAllocation cids
  aliceAlloc <- allocate app alice (mkSpec app alice [senderSide leg] None) [allocTok]
  bobAlloc <- allocate app bob (mkSpec app bob [receiverSide leg] None) []
  locked <- queryFilter @MyHolding alice (\h -> isSome h.holding.lock)
  length locked === 2

  frozenStatus <- freeze app alice
  frozenDisclosure <- statusDisclosure app frozenStatus
  funding <- instructionDisclosures app instrCid
  mustFailWith "account is frozen" (actAs bob <> discloseMany (frozenDisclosure :: funding))
    (acceptCmd bob (statusArgs frozenStatus) instrCid)
  disclosures <- settlementDisclosures app (finalized [aliceAlloc, bobAlloc])
  (batchArgs, statuses) <- batchStatusArgs app [alice, bob]
  mustFailWith "account is frozen" (actAs exchange <> discloseMany (disclosures <> statuses))
    (settleBatchCmd app [leg] (finalized [aliceAlloc, bobAlloc]) batchArgs)

  _ <- unfreeze app alice
  forA_ locked $ \(cid, _) -> do
    Some _ <- queryContractId alice cid
    pure ()
  accept app alice bob instrCid
  _ <- settleBatch app [alice, bob] [leg] (finalized [aliceAlloc, bobAlloc])
  balanceSeenBy bob bob >>= (=== [5.0, 7.0])
  balanceSeenBy alice alice >>= (=== [3.0])

-- Pause switch
---------------

-- | Only the pauser can pause. While paused, the transfer and allocation
-- factories, mint, and burn are refused. After unpausing, with the
-- new disclosure, the transfer goes through.
testPauseBlocksFactories : Script ()
testPauseBlocksFactories = do
  app0@App{..} <- setup
  aliceTok <- mint app0 alice 10.0
  burnMe <- mint app0 alice 1.0
  (aliceArgs, _) <- statusFor app0 alice
  submitMustFail (actAs admin) do exerciseCmd rulesCid MyRules_Pause
  submitMustFail (actAs complianceOfficer) do exerciseCmd rulesCid MyRules_Pause
  app <- pauseRegistry app0

  mustFailWith "registry is paused" (actAs alice <> discloseMany [app.rulesDisclosure])
    (transferCmd app [alice] aliceArgs (mkTransfer app alice bob 7.0 [aliceTok]))
  mustFailWith "registry is paused" (actAs alice <> discloseMany [app.rulesDisclosure])
    (allocateCmd app app.settlement alice (mkSpec app alice [senderSide (mkLeg "leg-1" alice bob 7.0)] None) [aliceTok] aliceArgs)
  mustFailWith "registry is paused" (actAs admin) (offerMintCmd app alice 1.0)
  mustFailWith "registry is paused" (actAs [admin, alice] <> discloseMany [app.rulesDisclosure])
    (burnCmd app alice 1.0 aliceArgs burnMe)
  balanceSeenBy alice alice >>= (=== [1.0, 10.0])

  app2 <- unpauseRegistry app
  _ <- submit (actAs [alice, bob] <> discloseMany [app2.rulesDisclosure])
    (transferCmd app2 [alice, bob] aliceArgs (mkTransfer app2 alice bob 7.0 [aliceTok]))
  balanceSeenBy bob bob >>= (=== [7.0])

-- | The settlement factory is paused too, so allocations made before the
-- pause cannot settle until the registry is unpaused.
testPauseBlocksSettlement : Script ()
testPauseBlocksSettlement = do
  app0@App{..} <- setup
  aliceTok <- mint app0 alice 10.0
  let leg = mkLeg "leg-1" alice bob 10.0
  aliceAlloc <- allocate app0 alice (mkSpec app0 alice [senderSide leg] None) [aliceTok]
  bobAlloc <- allocate app0 bob (mkSpec app0 bob [receiverSide leg] None) []
  app <- pauseRegistry app0
  (batchArgs, statuses) <- batchStatusArgs app [alice, bob]
  mustFailWith "registry is paused" (actAs exchange <> discloseMany (app.rulesDisclosure :: statuses))
    (settleBatchCmd app [leg] (map nonIteratedAllocation [aliceAlloc, bobAlloc]) batchArgs)

-- | A paused registry cannot be paused again.
testPausedRegistryCannotBePausedAgain : Script ()
testPausedRegistryCannotBePausedAgain = do
  app0 <- setup
  app <- pauseRegistry app0
  mustFailWith "registry is already paused" (actAs app.pauser) do
    exerciseCmd app.rulesCid MyRules_Pause

-- | A registry that is not paused cannot be unpaused.
testUnpausedRegistryCannotBeUnpaused : Script ()
testUnpausedRegistryCannotBeUnpaused = do
  App{..} <- setup
  mustFailWith "registry is not paused" (actAs pauser) do
    exerciseCmd rulesCid MyRules_Unpause

-- Fee on transfer
------------------

-- | With a 1% fee, instructing a transfer of 100 pays 1 to the treasury at
-- once and locks 100; the receiver gets 100 on accept. Inputs that cover the
-- amount but not the fee are refused.
testTransferFeeGoesToTreasury : Script ()
testTransferFeeGoesToTreasury = do
  app@App{..} <- setupWith 100
  aliceTok <- mint app alice 250.0
  (aliceArgs, _) <- statusFor app alice
  result <- submit (actAs alice <> discloseMany [rulesDisclosure])
    (transferCmd app [alice] aliceArgs (mkTransfer app alice bob 100.0 [aliceTok]))
  instrCid <- pendingCid result
  balanceSeenBy admin admin >>= (=== [1.0])
  balanceSeenBy alice alice >>= (=== [100.0, 149.0])
  accept app alice bob instrCid
  balanceSeenBy bob bob >>= (=== [100.0])
  balanceSeenBy alice alice >>= (=== [149.0])
  -- 149 covers a transfer of 149 but not its 1.49 fee.
  [(changeCid, _)] <- query @MyHolding alice
  submitMustFail (actAs alice <> discloseMany [rulesDisclosure])
    (transferCmd app [alice] aliceArgs (mkTransfer app alice bob 149.0 [toInterfaceContractId @HoldingV2.Holding changeCid]))

-- | The fee is two workflow calls: the fee leg consumes both inputs, the
-- main transfer consumes the fee leg's change. Three spends, one transfer.
testFeeComposesTwoWorkflowCalls : Script ()
testFeeComposesTwoWorkflowCalls = do
  app@App{..} <- setupWith 100
  in1 <- mint app alice 40.0
  in2 <- mint app alice 60.0
  (aliceArgs, _) <- statusFor app alice
  tree <- submitTree (actAs [alice, bob] <> discloseMany [rulesDisclosure])
    (transferCmd app [alice, bob] aliceArgs (mkTransfer app alice bob 50.0 [in1, in2]))
  countSpends tree === 3
  balanceSeenBy admin admin >>= (=== [0.5])
  balanceSeenBy alice alice >>= (=== [49.5])
  balanceSeenBy bob bob >>= (=== [50.0])

-- | Each event of a transfer and its fee leg names the workflow as its
-- reason, whatever reason the sender's `meta` claims, and each leg side
-- carries that `meta`.
testFeeEventsNameTheWorkflow : Script ()
testFeeEventsNameTheWorkflow = do
  app@App{..} <- setupWith 100
  aliceTok <- mint app alice 100.0
  let claimed = reasonToMeta "tokens minted"
        (Metadata with values = TextMap.fromList [("example.com/memo", "rent")])
  (aliceArgs, _) <- statusFor app alice
  tree <- submitTree (actAs [alice, bob] <> discloseMany [rulesDisclosure])
    (transferCmd app [alice, bob] aliceArgs ((mkTransfer app alice bob 50.0 [aliceTok]) with meta = claimed))
  let evs = holdingsChangeEvents tree
  map (.account) evs === map basicAccount [alice, admin, alice, bob]
  forA_ evs $ \ev -> do
    ev.extraArgs.meta === reasonToMeta "transfer completed" emptyMetadata
    map (.meta) ev.transferLegSides === [claimed]

-- | A burn pays no fee: the treasury receives nothing and the change keeps
-- the full remainder.
testBurnPaysNoFee : Script ()
testBurnPaysNoFee = do
  app@App{..} <- setupWith 100
  aliceTok <- mint app alice 100.0
  (aliceArgs, _) <- statusFor app alice
  _ <- submit (actAs [admin, alice] <> discloseMany [rulesDisclosure]) (burnCmd app alice 40.0 aliceArgs aliceTok)
  balanceSeenBy admin admin >>= (=== [])
  balanceSeenBy alice alice >>= (=== [60.0])

-- | The fee is a share of the transfer amount, so it must lie between 0 and
-- 10000 basis points inclusive.
testTransferFeeMustBeInRange : Script ()
testTransferFeeMustBeInRange = do
  App{..} <- setup
  Some rules <- queryContractId admin rulesCid
  submitMustFail admin do createCmd rules with transferFeeBps = -1
  submitMustFail admin do createCmd rules with transferFeeBps = 10001
  _ <- submit admin do createCmd rules with transferFeeBps = 10000
  pure ()

-- Registry policy
------------------

-- | The consumer's own rule runs before the workflow: an allocation naming
-- an executor outside the allowlist is refused at the factory.
testExecutorAllowlist : Script ()
testExecutorAllowlist = do
  app@App{..} <- setup
  rogue <- allocateParty "rogue"
  aliceTok <- mint app alice 10.0
  (aliceArgs, _) <- statusFor app alice
  let leg = mkLeg "leg-1" alice bob 10.0
      rogueSettlement = settlement with executors = [rogue]
  mustFailWith "a settlement executor is not approved" (actAs alice <> discloseMany [rulesDisclosure])
    (allocateCmd app rogueSettlement alice (mkSpec app alice [senderSide leg] None) [aliceTok] aliceArgs)
  _ <- allocate app alice (mkSpec app alice [senderSide leg] None) [aliceTok]
  pure ()

-- | The allowlist is checked again at settlement, so allocations made before
-- the admin dropped an executor cannot settle through the new rules.
testSettlementChecksExecutorAllowlist : Script ()
testSettlementChecksExecutorAllowlist = do
  app0@App{..} <- setup
  aliceTok <- mint app0 alice 10.0
  let leg = mkLeg "leg-1" alice bob 10.0
  aliceAlloc <- allocate app0 alice (mkSpec app0 alice [senderSide leg] None) [aliceTok]
  bobAlloc <- allocate app0 bob (mkSpec app0 bob [receiverSide leg] None) []
  Some rules <- queryContractId admin rulesCid
  submit admin do archiveCmd rulesCid
  newRulesCid <- submit admin do createCmd rules with allowedExecutors = []
  Some disclosure <- queryDisclosure @MyRules admin newRulesCid
  let app = app0 with rulesCid = newRulesCid; rulesDisclosure = disclosure
  (batchArgs, statuses) <- batchStatusArgs app [alice, bob]
  mustFailWith "a settlement executor is not approved" (actAs exchange <> discloseMany (disclosure :: statuses))
    (settleBatchCmd app [leg] (map nonIteratedAllocation [aliceAlloc, bobAlloc]) batchArgs)

-- Expiry and cleanup
---------------------

-- | Alice's pending transfer of 7 to bob and her allocation of 5. Both expire
-- at t2, and both funding locks expire one lock grace later.
lockAliceFunds : App -> Script (ContractId TransferInstructionV2.TransferInstruction, ContractId AllocationV2.Allocation)
lockAliceFunds app@App{..} = do
  transferInput <- mint app alice 10.0
  allocationInput <- mint app alice 5.0
  (aliceArgs, _) <- statusFor app alice
  result <- submit (actAs alice <> discloseMany [rulesDisclosure])
    (transferCmd app [alice] aliceArgs (mkTransfer app alice bob 7.0 [transferInput]))
  instrCid <- pendingCid result
  allocCid <- allocate app alice (mkSpec app alice [senderSide (mkLeg "leg-1" alice bob 5.0)] None) [allocationInput]
  pure (instrCid, allocCid)

-- | All of `owner`'s holdings are unlocked.
assertNoLocks : Party -> Script ()
assertNoLocks owner = do
  holdings <- query @MyHolding owner
  all (\(_, h) -> isNone h.holding.lock) holdings === True

-- | Past t2 the admin expires the instruction and the allocation in batches
-- through the rules contract, and the locked funds return to alice.
testAdminExpiryReturnsFunds : Script ()
testAdminExpiryReturnsFunds = do
  app@App{..} <- setup
  (instrCid, allocCid) <- lockAliceFunds app
  (aliceArgs, _) <- statusFor app alice
  setTime t3
  submit (actAs admin) (expireInstructionsCmd app [(instrCid, aliceArgs)])
  submit (actAs admin) (expireAllocationsCmd app [(allocCid, aliceArgs)])
  balanceSeenBy alice alice >>= (=== [3.0, 5.0, 7.0])
  assertNoLocks alice

-- | `ExtraArgs` that clear the `expire-lock` flag, so an admin expiry leaves
-- the funding untouched. Splice's key, spelled out.
skipFunding : ExtraArgs
skipFunding = ExtraArgs with
  context = ChoiceContext with values = TextMap.fromList [("expire-lock", AV_Bool False)]
  meta = emptyMetadata

-- | Once the funding locks expire, alice unlocks her own holdings and the
-- admin expires the instruction and allocation that still reference them
-- with the `expire-lock` flag cleared. Both end with the standard result,
-- and the same calls fail before the locks expire.
testOwnerUnlockThenExpiryWithFlagCleared : Script ()
testOwnerUnlockThenExpiryWithFlagCleared = do
  app@App{..} <- setup
  (instrCid, allocCid) <- lockAliceFunds app
  let instrTemplateCid = fromInterfaceContractId @MyTransferInstruction instrCid
      expireInstr = exerciseCmd instrTemplateCid MyTransferInstruction_Expire with extraArgs = skipFunding
      cancelAlloc = exerciseCmd allocCid AllocationV2.Allocation_Cancel with actors = [admin]; extraArgs = skipFunding
  -- t3 is past both expiries, before the locks expire.
  setTime t3
  mustFailWith "strictly before deadline 'lockExpiresAt'" (actAs admin) expireInstr
  mustFailWith "strictly before deadline 'allocation lockExpiresAt'" (actAs admin) cancelAlloc
  setTime t4
  aliceStatus <- statusOf app alice
  holdings <- query @MyHolding alice
  forA_ [cid | (cid, h) <- holdings, isSome h.holding.lock] $ \cid ->
    submit (actAs alice) do exerciseCmd cid MyHolding_OwnerUnlock with statusCid = aliceStatus
  balanceSeenBy alice alice >>= (=== [3.0, 5.0, 7.0])
  assertNoLocks alice
  instrResult <- submit (actAs admin) expireInstr
  instrResult.output === TransferInstructionV2.TransferInstructionResult_Failed
  instrResult.senderChangeCids === []
  allocResult <- submit (actAs admin) cancelAlloc
  allocResult.output === AllocationV2.AllocationResult_Cancelled
  allocResult.authorizerHoldingCids === TextMap.empty
  queryContractId admin instrTemplateCid >>= (=== None)
  queryContractId admin (fromInterfaceContractId @MyAllocation allocCid) >>= (=== None)
  balanceSeenBy alice alice >>= (=== [3.0, 5.0, 7.0])

-- | A flag cleared while the funding is still locked leaves it locked; the
-- admin unlock returns it.
testAdminUnlockAfterEarlyClearedFlag : Script ()
testAdminUnlockAfterEarlyClearedFlag = do
  app@App{..} <- setup
  (instrCid, _) <- lockAliceFunds app
  setTime t4
  _ <- submit (actAs admin) do
    exerciseCmd rulesCid MyRules_ExpireTransferInstructions with
      expireArgs = [(fromInterfaceContractId @MyTransferInstruction instrCid, MyTransferInstruction_Expire with extraArgs = skipFunding)]
  [(lockedCid, locked)] <- queryFilter @MyHolding alice (\h -> isSome h.holding.lock && h.holding.amount == 7.0)
  aliceStatus <- statusOf app alice
  _ <- submit (actAs admin) do exerciseCmd lockedCid MyHolding_AdminUnlock with statusCid = aliceStatus
  [(_, unlocked)] <- queryFilter @MyHolding alice (\h -> isNone h.holding.lock && h.holding.amount == 7.0)
  unlocked.holding.account === locked.holding.account
  unlocked.roles === locked.roles

-- | The signatories can archive a holding and the rules contract directly.
testSignatoriesArchive : Script ()
testSignatoriesArchive = do
  app@App{..} <- setup
  aliceTok <- mint app alice 10.0
  submit (actAs [admin, alice]) do archiveCmd (fromInterfaceContractId @MyHolding aliceTok)
  submit (actAs admin) do archiveCmd rulesCid
  balanceSeenBy alice alice >>= (=== [])

-- Trust boundary
-----------------

-- | The consumer's `fundHolding` pins the template, so a foreign
-- `Holding` claiming this admin is refused as funding.
template ForeignHolding with
    attacker : Party
    claimedView : HoldingV2.HoldingView
  where
    signatory attacker
    interface instance HoldingV2.Holding for ForeignHolding where
      view = claimedView

testForeignHoldingRefused : Script ()
testForeignHoldingRefused = do
  app@App{..} <- setup
  attacker <- allocateParty "attacker"
  forgedCid <- submit attacker do
    createCmd ForeignHolding with
      attacker
      claimedView = HoldingV2.HoldingView with
        account = basicAccount attacker
        instrumentId = HoldingV2.InstrumentId with admin; id = "TOK"
        amount = 1000000.0
        lock = None
        meta = emptyMetadata
  mustFailWith "holding is not a MyHolding" (actAs attacker <> discloseMany [rulesDisclosure])
    (transferCmd app [attacker] emptyExtraArgs (mkTransfer app attacker attacker 1000000.0
      [toInterfaceContractId @HoldingV2.Holding forgedCid]))
  balanceSeenBy attacker attacker >>= (=== [])

-- | An `Allocation` the registry never created, whose view claims this
-- registry. Its choice bodies fail, so a refusal from the registry shows the
-- registry never ran them with its authority.
template ForeignAllocation with
    attacker : Party
    claimedView : AllocationV2.AllocationView
    observers : [Party]
  where
    signatory attacker
    observer observers
    interface instance AllocationV2.Allocation for ForeignAllocation where
      view = claimedView
      allocation_settleExtraObservers _ = []
      allocation_cancelExtraObservers _ = []
      allocation_withdrawExtraObservers _ = []
      allocation_settleImpl _ _ = fail "foreign settle body ran"
      allocation_withdrawImpl _ _ = fail "foreign withdraw body ran"
      allocation_cancelImpl _ _ = fail "foreign cancel body ran"

-- | A forged allocation by `attacker` for `sides`, visible to the admin and
-- the exchange, and already expired.
forgeAllocation : App -> Party -> [AllocationV2.TransferLegSide] -> Script (ContractId AllocationV2.Allocation)
forgeAllocation app@App{..} attacker sides = do
  cid <- submit attacker do
    createCmd ForeignAllocation with
      attacker
      observers = [admin, exchange]
      claimedView = AllocationV2.AllocationView with
        originalAllocationCid = None
        settlement
        allocation = mkSpec app attacker sides None
        holdingCids = []
        createdAt = t0
        numIterations = 0
        expiresAt = Some t0
        availableActions = Map.empty
        meta = emptyMetadata
  pure (toInterfaceContractId cid)

-- | A forged sender-side allocation would pay bob from funds the attacker
-- never locked. Settlement accepts only `MyAllocation`s.
testForeignAllocationRefusedAtSettlement : Script ()
testForeignAllocationRefusedAtSettlement = do
  app@App{..} <- setup
  attacker <- allocateParty "attacker"
  let leg = mkLeg "leg-1" attacker bob 10.0
  forged <- forgeAllocation app attacker [senderSide leg]
  bobAlloc <- allocate app bob (mkSpec app bob [receiverSide leg] None) []
  mustFailWith "allocation is not an accepted implementation" (actAs exchange <> discloseMany [rulesDisclosure])
    (settleBatchCmd app [leg] (map nonIteratedAllocation [forged, bobAlloc]) emptyExtraArgs)

-- | Expiry would run the forged allocation's cancel body with the admin's
-- authority. It accepts only `MyAllocation`s.
testForeignAllocationRefusedAtExpiry : Script ()
testForeignAllocationRefusedAtExpiry = do
  app@App{..} <- setup
  attacker <- allocateParty "attacker"
  forged <- forgeAllocation app attacker [senderSide (mkLeg "leg-1" attacker bob 10.0)]
  mustFailWith "allocation is not an accepted implementation" (actAs admin)
    (expireAllocationsCmd app [(forged, emptyExtraArgs)])

-- | The registry only expires its own instructions. Its admin can fetch
-- another registry's instruction when it is the receiver of that transfer.
testExpireTransferInstructionsRefusesOtherRegistry : Script ()
testExpireTransferInstructionsRefusesOtherRegistry = do
  app@App{..} <- setup
  otherAdmin <- allocateParty "otherAdmin"
  Some rules <- queryContractId admin rulesCid
  otherRulesCid <- submit otherAdmin do createCmd rules with config = rules.config with admin = otherAdmin
  Some otherDisclosure <- queryDisclosure @MyRules otherAdmin otherRulesCid
  let other = app with admin = otherAdmin; rulesCid = otherRulesCid; rulesDisclosure = otherDisclosure
  _ <- openAccount other alice
  aliceTok <- mint other alice 10.0
  (aliceArgs, _) <- statusFor other alice
  instrCid <- pendingCid =<< submit (actAs alice <> discloseMany [otherDisclosure])
    (transferCmd other [alice] aliceArgs (mkTransfer other alice admin 7.0 [aliceTok]))
  setTime t3
  mustFailWith "'transfer.instrumentId.admin' is not equal to" (actAs admin)
    (expireInstructionsCmd app [(instrCid, emptyExtraArgs)])

-- Rebalancing
--------------

mergeCmd : ContractId MyAccountStatus -> ContractId HoldingV2.Holding -> [ContractId HoldingV2.Holding]
  -> Commands (ContractId HoldingV2.Holding)
mergeCmd statusCid cid inputs =
  exerciseCmd (fromInterfaceContractId @MyHolding cid) MyHolding_Merge with statusCid; inputHoldingCids = inputs

splitCmd : ContractId MyAccountStatus -> ContractId HoldingV2.Holding -> [Decimal] -> Commands [ContractId HoldingV2.Holding]
splitCmd statusCid cid amounts =
  exerciseCmd (fromInterfaceContractId @MyHolding cid) MyHolding_Split with statusCid; amounts

-- | A frozen account's holdings can be neither merged nor split, whichever
-- holding is exercised. Once the account is unfrozen, the same merge goes
-- through and its input runs the spend.
testFrozenAccountCannotRebalance : Script ()
testFrozenAccountCannotRebalance = do
  app@App{..} <- setup
  aliceTok <- mint app alice 10.0
  other <- mint app alice 5.0
  frozen <- freeze app alice
  mustFailWith "account is frozen" (actAs alice) (mergeCmd frozen aliceTok [other])
  mustFailWith "account is frozen" (actAs alice) (mergeCmd frozen other [aliceTok])
  mustFailWith "account is frozen" (actAs alice) (splitCmd frozen aliceTok [4.0, 6.0])
  thawed <- unfreeze app alice
  (mergedCid, tree) <- submitResultAndTree (actAs alice) (mergeCmd thawed other [aliceTok])
  countSpends tree === 1
  Some merged <- queryContractId alice (fromInterfaceContractId @MyHolding mergedCid)
  merged.holding.amount === 15.0
  merged.roles.auditor === auditor

-- | Merges and splits do not go through the rules contract, so the pause
-- does not stop them and they pay no fee, while a self-transfer for the
-- same rebalance is paused and charged. The auditor is an informee of both
-- events, through `eventObservers`.
testRebalanceBypassesRegistryPolicy : Script ()
testRebalanceBypassesRegistryPolicy = do
  app <- setupWith 100
  let App{..} = app
  in1 <- mint app alice 40.0
  in2 <- mint app alice 60.0
  aliceStatus <- statusOf app alice
  let aliceArgs = statusArgs aliceStatus
  paused <- pauseRegistry app
  mustFailWith "registry is paused" (actAs alice <> discloseMany [paused.rulesDisclosure])
    (transferCmd paused [alice] aliceArgs (mkTransfer paused alice alice 100.0 [in1, in2]))
  (mergedCid, mergeTree) <- submitResultAndTree (actAs alice) (mergeCmd aliceStatus in1 [in2])
  auditorSeesEvents auditor 1 mergeTree
  (parts, splitTree) <- submitResultAndTree (actAs alice) (splitCmd aliceStatus mergedCid [30.0, 70.0])
  auditorSeesEvents auditor 1 splitTree
  length parts === 2
  balanceSeenBy alice alice >>= (=== [30.0, 70.0])
  balanceSeenBy admin admin >>= (=== [])
  live <- unpauseRegistry paused
  _ <- submit (actAs alice <> discloseMany [live.rulesDisclosure])
    (transferCmd live [alice] aliceArgs (mkTransfer live alice alice 99.0 parts))
  balanceSeenBy admin admin >>= (=== [0.99])

-- | The merged holding carries the exercised holding's roles, so a merge
-- refuses an input of other roles: otherwise a holder could move value
-- away from the auditor and compliance officer it was issued under. A
-- registry with a new auditor issues holdings that merge only among
-- themselves.
testMergeRefusesInputsOfOtherRoles : Script ()
testMergeRefusesInputsOfOtherRoles = do
  app@App{..} <- setup
  newAuditor <- allocateParty "newAuditor"
  Some rules <- queryContractId admin rulesCid
  newRulesCid <- submit admin do createCmd rules with roles = rules.roles with auditor = newAuditor
  Some newDisclosure <- queryDisclosure @MyRules admin newRulesCid
  let reissued = app with rulesCid = newRulesCid; rulesDisclosure = newDisclosure
  oldTok <- mint app alice 10.0
  newTok <- mint reissued alice 5.0
  newTok2 <- mint reissued alice 1.0
  -- Both registries share the compliance officer, so one status covers both.
  aliceStatus <- statusOf app alice
  mustFailWith "input holding carries other roles" (actAs alice) (mergeCmd aliceStatus oldTok [newTok])
  mustFailWith "input holding carries other roles" (actAs alice) (mergeCmd aliceStatus newTok [oldTok])
  mergedCid <- submit (actAs alice) (mergeCmd aliceStatus newTok [newTok2])
  Some merged <- queryContractId alice (fromInterfaceContractId @MyHolding mergedCid)
  merged.roles.auditor === newAuditor
  merged.holding.amount === 6.0
  -- Naming the exercised holding as an input still gets the body's refusal.
  mustFailWith "merge inputs must be distinct" (actAs alice) (mergeCmd aliceStatus oldTok [oldTok])

-- | A forged holding passes the roles check, which skips anything that is
-- not a `MyHolding`, and the spend refuses it.
testMergeRefusesForeignInput : Script ()
testMergeRefusesForeignInput = do
  app@App{..} <- setup
  attacker <- allocateParty "attacker"
  attackerStatus <- openAccount app attacker
  genuine <- mint app attacker 1.0
  forgedCid <- submit attacker do
    createCmd ForeignHolding with
      attacker
      claimedView = HoldingV2.HoldingView with
        account = basicAccount attacker
        instrumentId = HoldingV2.InstrumentId with admin; id = "TOK"
        amount = 1000000.0
        lock = None
        meta = emptyMetadata
  mustFailWith "holding is not a MyHolding" (actAs attacker)
    (mergeCmd attackerStatus genuine [toInterfaceContractId @HoldingV2.Holding forgedCid])
  balanceSeenBy attacker attacker >>= (=== [1.0])
