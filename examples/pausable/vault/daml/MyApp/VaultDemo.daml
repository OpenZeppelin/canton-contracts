-- | The lifecycle of `MyApp.Vault.Vault`, as a runnable script.
module MyApp.VaultDemo where

import DA.Assert ((===))
import Daml.Script

import qualified OpenZeppelin.Api.PausableV1 as Pausable
import MyApp.Vault

-- | Normal operation, an emergency stop, and the return to normal operation.
demo : Script ()
demo = script do
  admin <- allocateParty "admin"
  owner <- allocateParty "owner"

  vault <- submit (actAs [admin, owner]) do
    createCmd Vault with admin, owner, balance = 100.0, paused = False

  -- Unpaused, the gated choice runs. A non-positive amount is refused by the
  -- vault's own checks, which have nothing to do with pausing.
  vault <- submit owner do exerciseCmd vault Vault_Withdraw with amount = 40.0
  Left (FailureStatusError e) <- trySubmit owner do
    exerciseCmd vault Vault_Withdraw with amount = -10.0
  e === eNonPositiveAmount

  -- The admin stops the vault.
  vault <- submit admin do exerciseCmd vault Vault_Pause

  -- Off-ledger tooling reads the flag through the interface view, whatever
  -- template implements it.
  Some v <- queryInterfaceContractId owner (toInterfaceContractId @Pausable.Pausable vault)
  v === Pausable.PausableView with paused = True

  -- The gated choice now refuses to start.
  Left (FailureStatusError e) <- trySubmit owner do
    exerciseCmd vault Vault_Withdraw with amount = 10.0
  e === Pausable.eEnforcedPause

  -- The escape hatch carries no guard, so it stays open: the owner takes the
  -- remaining balance out while the vault is paused.
  (vault, payout) <- submit owner do exerciseCmd vault Vault_Redeem
  Some p <- queryContractId owner payout
  p.amount === 60.0
  p.recipient === owner

  -- Pausing twice fails with eEnforcedPause.
  Left (FailureStatusError e) <- trySubmit admin do
    exerciseCmd vault Vault_Pause
  e === Pausable.eEnforcedPause

  -- The recovery path runs only while paused.
  (vault, _) <- submit admin do exerciseCmd vault Vault_EmergencyDrain

  -- Back to normal operation.
  vault <- submit admin do exerciseCmd vault Vault_Unpause
  isPausedNow <- queryContractId admin vault
  fmap Pausable.isPaused isPausedNow === Some False

  -- Unpausing twice fails with eExpectedPause, and the paused-only path is
  -- closed again.
  Left (FailureStatusError e) <- trySubmit admin do
    exerciseCmd vault Vault_Unpause
  e === Pausable.eExpectedPause
  Left (FailureStatusError e) <- trySubmit admin do
    exerciseCmd vault Vault_EmergencyDrain
  e === Pausable.eExpectedPause

  pure ()
