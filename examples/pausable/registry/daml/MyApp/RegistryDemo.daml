-- | The lifecycle of `MyApp.Registry.Registry`, as a runnable script.
module MyApp.RegistryDemo where

import DA.Assert ((===))
import DA.Time (addRelTime, hours)
import Daml.Script

import qualified OpenZeppelin.PausableV1 as Pausable
import MyApp.Registry

-- | A pause that records its reason, and an unpause that clears it.
demo : Script ()
demo = script do
  admin <- allocateParty "admin"
  now <- getTime
  let until = addRelTime now (hours 6)

  registry <- submit admin do
    createCmd Registry with
      admin
      paused = False
      pauseReason = None
      pauseUntil = None

  registry <- submit admin do
    exerciseCmd registry Registry_Register with entry = "first"

  -- One transaction sets the flag and the metadata that reports it.
  registry <- submit admin do
    exerciseCmd registry Registry_Pause with
      reason = Some "incident 42"
      until = Some until

  Some r <- queryContractId admin registry
  r.paused === True
  r.pauseReason === Some "incident 42"
  r.pauseUntil === Some until

  -- The frozen view still carries the flag alone.
  Some v <- queryInterfaceContractId admin (toInterfaceContractId @Pausable.Pausable registry)
  v === Pausable.PausableView with paused = True

  submitMustFail admin do
    exerciseCmd registry Registry_Register with entry = "second"

  -- Unpausing clears what the pause recorded.
  registry <- submit admin do exerciseCmd registry Registry_Unpause
  Some r <- queryContractId admin registry
  r.paused === False
  r.pauseReason === None
  r.pauseUntil === None

  registry <- submit admin do
    exerciseCmd registry Registry_Register with entry = "second"

  pure ()
