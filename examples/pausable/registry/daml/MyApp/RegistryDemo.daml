-- | The lifecycle of `MyApp.Registry.Registry`, as a runnable script.
module MyApp.RegistryDemo where

import DA.Assert ((===))
import DA.Time (addRelTime, hours)
import Daml.Script

import qualified OpenZeppelin.Api.PausableV1 as Pausable
import MyApp.Registry

-- | A pause that records its reason, and an unpause that clears it.
demo : Script ()
demo = script do
  admin <- allocateParty "admin"
  auditor <- allocateParty "auditor"
  now <- getTime
  let until = addRelTime now (hours 6)

  registry <- submit admin do
    createCmd Registry with
      admin
      auditor
      paused = False
      pauseReason = None
      pauseUntil = None
      entries = []

  registry <- submit admin do
    exerciseCmd registry Registry_Register with entry = "first"

  -- An empty entry is refused by the registry's own check, which has nothing
  -- to do with pausing.
  Left (FailureStatusError e) <- trySubmit admin do
    exerciseCmd registry Registry_Register with entry = ""
  e === eEmptyEntry

  -- One transaction sets the flag and the metadata that reports it.
  registry <- submit admin do
    exerciseCmd registry Registry_Pause with
      reason = Some "incident 42"
      until = Some until

  Some r <- queryContractId admin registry
  r.paused === True
  r.pauseReason === Some "incident 42"
  r.pauseUntil === Some until

  -- The frozen view still carries the flag alone, and an observer reads it
  -- without any choice.
  Some v <- queryInterfaceContractId auditor
    (toInterfaceContractId @Pausable.Pausable registry)
  v === Pausable.PausableView with paused = True

  -- The refused registration changes nothing.
  Left (FailureStatusError e) <- trySubmit admin do
    exerciseCmd registry Registry_Register with entry = "second"
  e === Pausable.eEnforcedPause
  r.entries === ["first"]

  -- Unpausing clears what the pause recorded.
  registry <- submit admin do exerciseCmd registry Registry_Unpause
  Some r <- queryContractId admin registry
  r.paused === False
  r.pauseReason === None
  r.pauseUntil === None

  -- And the registration lands.
  registry <- submit admin do
    exerciseCmd registry Registry_Register with entry = "second"
  Some r <- queryContractId admin registry
  r.entries === ["second", "first"]

  pure ()
