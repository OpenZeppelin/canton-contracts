module HelloWorld.Proof where

import Daml.Script
import HelloWorld.HelloWorld

-- M0 LocalNet proof only. This script uploads the proof package through the
-- Daml Script gRPC path, allocates the proof parties, creates the hello-world
-- Greeting from the production package, and exercises the consuming archive
-- choice.
helloWorldProof : Script ()
helloWorldProof = script do
  issuer <- allocatePartyByHint (PartyIdHint "m0-issuer")
  recipient <- allocatePartyByHint (PartyIdHint "m0-recipient")
  debug $ "allocated issuer=" <> show issuer <> " recipient=" <> show recipient
  greeting <- submit issuer do
    createCmd Greeting with
      issuer = issuer
      recipient = recipient
      message = "M0 LocalNet hello-world proof"
  debug $ "created Greeting contractId=" <> show greeting
  submit issuer do
    exerciseCmd greeting ArchiveGreeting
  debug "archived Greeting via ArchiveGreeting"
