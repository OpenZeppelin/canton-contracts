-- | OpenZeppelin Timelock - a mandatory delay between the proposal of a
-- privileged operation and its execution.
--
-- Three interfaces:
--
-- * `Timelock`, on the consumer's timelock template: the delay policy, the
--   pending operations, and the choices that apply or drop one of them.
-- * `Operation`, on each operation template: who may execute and cancel, and
--   the choices those parties call.
-- * `Timelocked`, on each operation template: when the operation is ready and
--   when it expires.
--
-- The consumer writes the schedule choices and the `apply` method. The
-- schedule functions and the time guards for consumer choices live in the
-- `openzeppelin-timelock-v1` package, module `OpenZeppelin.TimelockV1`.
module OpenZeppelin.Api.TimelockV1
  ( TimelockedView (..)
  , Timelocked
  , Pending
  , TimelockConfig (..)
  , TimelockView (..)
  , OperationView (..)
  , DropReason (..)
  , Timelock
  , apply
  , unschedule
  , Timelock_Apply (..)
  , Timelock_Drop (..)
  , Operation
  , Operation_Execute (..)
  , Operation_Cancel (..)
  , Operation_Cleanup (..)
  , eInvalidAuthority
  , eNotPending
  , eNotExecutor
  , eNotCanceller
  , eOperationRetained
  , eNotReady
  , eExpired
  , eNotExpired
  ) where

import DA.Action (unless, when)
import DA.Fail (FailureCategory (..), FailureStatus (..), failWithStatus)
import DA.List (delete)
import DA.Optional (whenSome)
import qualified DA.TextMap as TextMap
import DA.Time (RelTime, isLedgerTimeGE, isLedgerTimeLT)

-- | When a scheduled operation may execute.
data TimelockedView = TimelockedView with
    readyAt : Time
      -- ^ The earliest ledger time at which the operation may execute.
    expiresAt : Optional Time
      -- ^ The ledger time from which the operation may no longer execute, or
      --   `None` when the operation stays executable until it is archived.
  deriving (Eq, Show)

-- | The schedule of an operation. Implement it on every operation template,
-- beside `Operation`, with the two fields that the schedule choice stored:
--
-- ```
-- interface instance Timelocked for LimitChange where
--   view = TimelockedView with readyAt, expiresAt
-- ```
--
-- Off-ledger readers query it to list operations and their times without
-- knowing the operation template. The interface has no choices.
interface Timelocked where
  viewtype TimelockedView

-- | The operations that a timelock scheduled and has not yet applied or
-- dropped. Hold it as a field of the timelock template, initialize it empty,
-- and add to it only in the schedule choices, with `addPending`.
-- `Timelock_Apply` and `Timelock_Drop` refuse an operation that the list does
-- not hold, so an operation created outside the schedule choices has no
-- effect.
type Pending = [ContractId Timelocked]

-- | The delay policy. Hold it as a field of the timelock template and check
-- it with `isValidConfig` in the `ensure` clause. To change it, schedule the
-- new policy as an operation under the current one.
data TimelockConfig = TimelockConfig with
    minDelay : RelTime
      -- ^ The shortest delay a schedule may request, zero or greater. Zero
      --   disables the delay.
    gracePeriod : Optional RelTime
      -- ^ How long after `readyAt` an operation stays executable, positive
      --   when set. `None` keeps an operation executable until it is
      --   archived.
  deriving (Eq, Show)

-- | The state of a timelock that the lifecycle choices read.
data TimelockView = TimelockView with
    authority : Party
      -- ^ A signatory of the timelock and of every operation it schedules.
    config : TimelockConfig
      -- ^ The delay policy in force.
    pending : Pending
      -- ^ The operations that may still be applied, cancelled, or cleaned
      --   up.
  deriving (Eq, Show)

-- | Who may execute and cancel an operation.
data OperationView = OperationView with
    executors : Optional [Party]
      -- ^ The parties that may call `Operation_Execute`. `None` lets any
      --   party that holds the operation and the timelock execute.
    cancellers : [Party]
      -- ^ The parties that may call `Operation_Cancel`.
  deriving (Eq, Show)

-- | Why `Timelock_Drop` removes a pending operation.
data DropReason
  = CancelOperation
    -- ^ The actor must be a canceller named on the operation.
  | CleanupOperation
    -- ^ The operation must have expired. Any actor may clean it up.
  deriving (Eq, Show)

-- | The timelock: the contract that holds the delay policy and the pending
-- operations, and applies an operation to the governed state once it is
-- ready. Implement it on a template with a `TimelockConfig` field and a
-- `Pending` field, and write the schedule choices on that template.
--
-- `Timelock_Apply` and `Timelock_Drop` check the operation and then call the
-- `apply` or `unschedule` method, which creates the successor timelock. Both
-- choices consume the timelock, so its contract id changes on every schedule,
-- apply, cancel, and cleanup.
--
-- Requirements:
--
-- * `authority` signs the timelock and every operation. The choices fail with
--   `eInvalidAuthority` otherwise.
-- * The operation's signatories are signatories of the timelock, so that the
--   timelock can archive the operation.
-- * The successor that a method creates holds the given pending list. The
--   choices fail with `eOperationRetained` when it still holds the operation.
-- * Executors and cancellers can see the timelock, as stakeholders or by
--   explicit disclosure.
interface Timelock where
  viewtype TimelockView

  apply : Operation -> Pending -> Update (ContractId Timelock)
    -- ^ Apply the operation's parameters to the governed state, and create
    --   the successor timelock with the given pending list. Dispatch on the
    --   operation's template with `fromInterface`. `Timelock_Apply` calls it
    --   after it checks the operation and archives it.

  unschedule : Pending -> Update (ContractId Timelock)
    -- ^ Create the successor timelock with the given pending list.
    --   `Timelock_Drop` calls it after it checks the operation and archives
    --   it.

  -- Apply a pending operation. Fails unless the operation is pending, the
  -- actor is an executor, and the operation is ready.
  choice Timelock_Apply : ContractId Timelock
    with
      actor : Party
      op : ContractId Operation
    controller actor
    do
      pending' <- takePending op (view this).pending
      opValue <- fetch op
      requireAuthority this opValue
      requireExecutor actor (view opValue)
      requireReady opValue
      archive op
      new <- apply this opValue pending'
      requireDropped op new
      pure new

  -- Remove a pending operation without applying it. Fails unless the
  -- operation is pending and the `reason` holds.
  choice Timelock_Drop : ContractId Timelock
    with
      actor : Party
      op : ContractId Operation
      reason : DropReason
    controller actor
    do
      pending' <- takePending op (view this).pending
      opValue <- fetch op
      requireAuthority this opValue
      case reason of
        CancelOperation -> requireCanceller actor (view opValue)
        CleanupOperation -> requireExpired opValue
      archive op
      new <- unschedule this pending'
      requireDropped op new
      pure new

-- | A scheduled operation. Implement it, with `Timelocked`, on one template
-- per operation kind. The template's fields are the operation's typed
-- parameters, which the timelock's `apply` reads.
--
-- Executors, cancellers, and cleanup actors call the choices on the
-- operation, with the current timelock as `target`. Each choice forwards the
-- actor to `Timelock_Apply` or `Timelock_Drop`, which does the checks.
--
-- Requirements:
--
-- * Create the operation in a schedule choice on the timelock, so that it
--   carries the timelock's `authority` and enters the pending list.
-- * Make the executors and cancellers stakeholders, or disclose the operation
--   to them.
interface Operation requires Timelocked where
  viewtype OperationView

  -- Execute the operation on `target`. The actor must be an executor.
  nonconsuming choice Operation_Execute : ContractId Timelock
    with
      actor : Party
      target : ContractId Timelock
    controller actor
    do
      exercise target Timelock_Apply with actor, op = self

  -- Cancel the operation. The actor must be a canceller.
  nonconsuming choice Operation_Cancel : ContractId Timelock
    with
      actor : Party
      target : ContractId Timelock
    controller actor
    do
      exercise target Timelock_Drop with actor, op = self, reason = CancelOperation

  -- Remove the operation after it expires. Any actor may call it.
  nonconsuming choice Operation_Cleanup : ContractId Timelock
    with
      actor : Party
      target : ContractId Timelock
    controller actor
    do
      exercise target Timelock_Drop with actor, op = self, reason = CleanupOperation

-- Fail with `eInvalidAuthority` unless the declared authority signs both
-- contracts.
requireAuthority : Timelock -> Operation -> Update ()
requireAuthority target op = do
  let authority = (view target).authority
  unless (authority `elem` signatory target && authority `elem` signatory op)
    (failWithStatus eInvalidAuthority)

-- Fail with `eNotExecutor` unless `actor` may execute under the view.
requireExecutor : Party -> OperationView -> Update ()
requireExecutor actor v =
  unless (optional True (actor `elem`) v.executors) (failWithStatus eNotExecutor)

-- Fail with `eNotCanceller` unless `actor` may cancel under the view.
requireCanceller : Party -> OperationView -> Update ()
requireCanceller actor v =
  unless (actor `elem` v.cancellers) (failWithStatus eNotCanceller)

-- Fail with `eOperationRetained` when the successor still lists the operation.
requireDropped : ContractId Operation -> ContractId Timelock -> Update ()
requireDropped op new = do
  successor <- fetch new
  when (toInterfaceContractId @Timelocked op `elem` (view successor).pending)
    (failWithStatus eOperationRetained)

-- Remove the operation from the pending list, or fail with `eNotPending`.
takePending : ContractId Operation -> Pending -> Update Pending
takePending op pending = do
  let cid = toInterfaceContractId @Timelocked op
  unless (cid `elem` pending) (failWithStatus eNotPending)
  pure (delete cid pending)

-- Fail with `eNotReady` before `readyAt`, and with `eExpired` at or after
-- `expiresAt`.
requireReady : Operation -> Update ()
requireReady op = do
  let v = view (toInterface @Timelocked op)
  ready <- isLedgerTimeGE v.readyAt
  unless ready (failWithStatus eNotReady)
  whenSome v.expiresAt $ \expiresAt -> do
    live <- isLedgerTimeLT expiresAt
    unless live (failWithStatus eExpired)

-- Fail with `eNotExpired` unless `expiresAt` is set and has passed.
requireExpired : Operation -> Update ()
requireExpired op = do
  let v = view (toInterface @Timelocked op)
  case v.expiresAt of
    None -> failWithStatus eNotExpired
    Some expiresAt -> do
      expired <- isLedgerTimeGE expiresAt
      unless expired (failWithStatus eNotExpired)

-- Failure statuses. Each reaches the Ledger API as a `DAML_FAILURE` error
-- carrying the `errorId` below, so a client matches on the id. A later
-- submission can succeed after `eNotReady` and `eNotExpired`; `eExpired` is
-- final.

-- | Raised when `authority` does not sign both the timelock and the operation.
-- `errorId`: `openzeppelin.com/timelock-invalid-authority`.
eInvalidAuthority : FailureStatus
eInvalidAuthority = timelockFailure "invalid-authority" InvalidIndependentOfSystemState
  "Timelock: the authority must sign both the target and the operation"

-- | Raised when the timelock's pending list does not hold the operation: the
-- operation was created outside a schedule choice, was already applied or
-- dropped, or belongs to another timelock.
-- `errorId`: `openzeppelin.com/timelock-not-pending`.
eNotPending : FailureStatus
eNotPending = timelockFailure "not-pending" InvalidGivenCurrentSystemStateOther
  "Timelock: the operation is not pending on this contract"

-- | Raised when `Operation_Execute`'s actor is outside the view's executors.
-- `errorId`: `openzeppelin.com/timelock-not-executor`.
eNotExecutor : FailureStatus
eNotExecutor = timelockFailure "not-executor" InvalidIndependentOfSystemState
  "Timelock: the actor is not an executor of this operation"

-- | Raised when `Operation_Cancel`'s actor is outside the view's cancellers.
-- `errorId`: `openzeppelin.com/timelock-not-canceller`.
eNotCanceller : FailureStatus
eNotCanceller = timelockFailure "not-canceller" InvalidIndependentOfSystemState
  "Timelock: the actor is not a canceller of this operation"

-- | Raised when `apply` or `unschedule` creates a successor whose pending list
-- still holds the operation.
-- `errorId`: `openzeppelin.com/timelock-operation-retained`.
eOperationRetained : FailureStatus
eOperationRetained = timelockFailure "operation-retained" InvalidIndependentOfSystemState
  "Timelock: the successor still lists the operation as pending"

-- | Raised when an operation executes before `readyAt`.
-- `errorId`: `openzeppelin.com/timelock-not-ready`.
eNotReady : FailureStatus
eNotReady = timelockFailure "not-ready" InvalidGivenCurrentSystemStateOther
  "Timelock: the operation is not ready"

-- | Raised when an operation executes at or after `expiresAt`.
-- `errorId`: `openzeppelin.com/timelock-expired`.
eExpired : FailureStatus
eExpired = timelockFailure "expired" InvalidGivenCurrentSystemStateOther
  "Timelock: the operation has expired"

-- | Raised when a cleanup runs before `expiresAt`, or on an operation without one.
-- `errorId`: `openzeppelin.com/timelock-not-expired`.
eNotExpired : FailureStatus
eNotExpired = timelockFailure "not-expired" InvalidGivenCurrentSystemStateOther
  "Timelock: the operation has not expired"

timelockFailure : Text -> FailureCategory -> Text -> FailureStatus
timelockFailure name category message = FailureStatus with
  errorId = "openzeppelin.com/timelock-" <> name
  category
  message
  meta = TextMap.empty
