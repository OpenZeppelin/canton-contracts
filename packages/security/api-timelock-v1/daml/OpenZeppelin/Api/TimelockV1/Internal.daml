-- | Internal types for `OpenZeppelin.Api.TimelockV1`. The lifecycle functions
-- of `OpenZeppelin.TimelockV1` import this module; a timelock template does
-- not.
module OpenZeppelin.Api.TimelockV1.Internal where

-- | Evidence that a lifecycle function of `OpenZeppelin.TimelockV1` ran its
-- checks. `applyImpl` and `dropImpl` return it, and `Timelock_Apply` and
-- `Timelock_Drop` unwrap it, so a method body that skips the lifecycle
-- function does not compile.
data Checked a = Checked with
    successor : a
      -- ^ What the lifecycle function returns: the successor timelock.
