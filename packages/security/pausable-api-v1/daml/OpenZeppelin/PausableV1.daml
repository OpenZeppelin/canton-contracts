-- | OpenZeppelin Pausable - an emergency-stop switch for Daml templates.
--
-- The Daml translation of `Pausable.sol`. In Solidity, `Pausable` is inherited:
-- the flag is a field of the contract that it protects, and gated functions
-- carry the `whenNotPaused` modifier. The Daml analogue of that inheritance is
-- an interface instance, so this package defines the `Pausable` interface and
-- the guards, and the implementing template holds the flag.
--
-- Keeping the flag on the protected template is what makes the guard sound. The
-- state cannot be substituted, because it is not a separate contract that a
-- caller passes in; it is a field of the very contract the caller is exercising.
-- No extra fetch, no extra disclosure, and no extra authority delegation.
--
-- # Solidity correspondence
--
-- | `Pausable.sol`        | This module                                |
-- |-----------------------|--------------------------------------------|
-- | `bool _paused`        | `PausableView.paused`                      |
-- | `paused()`            | `Pausable_Paused`, `isPaused`, or the view |
-- | `whenNotPaused`       | `whenNotPaused`                            |
-- | `whenPaused`          | `whenPaused`                               |
-- | `_pause()`            | `Pausable_Pause`                           |
-- | `_unpause()`          | `Pausable_Unpause`                         |
-- | `EnforcedPause()`     | `eEnforcedPause`                           |
-- | `ExpectedPause()`     | `eExpectedPause`                           |
-- | `Paused`/`Unpaused`   | the exercise node in the transaction tree  |
--
-- Solidity emits `Paused(account)` and `Unpaused(account)` because storage
-- writes are otherwise invisible. Daml needs no such event: exercising
-- `Pausable_Pause` is itself a node in the transaction tree, recorded with its
-- actor and timestamp and delivered to every stakeholder.
--
-- # Interfaces are frozen
--
-- Daml interfaces are not SCU-upgradeable, so this package defines the
-- interface and no templates. Implementations live in consuming packages.
module OpenZeppelin.PausableV1 where

-- | The pause state of an implementing contract.
--
-- `pauser` is the authority over the switch. It is a single `Party` field, so a
-- deployment that wants several pausers points it at a party that represents
-- the group. A consumer that needs role-based pausing keeps `pauser` as its
-- break-glass authority and adds its own guarded choice that calls
-- `setPausedImpl`.
data PausableView = PausableView with
    pauser : Party
      -- ^ The authority that may pause and unpause.
    paused : Bool
      -- ^ Whether the contract is currently paused.
  deriving (Eq, Show)

-- | The pause switch. A template implements this to gain `Pausable_Pause`,
-- `Pausable_Unpause`, and `Pausable_Paused`, and to use the guards below.
--
-- Signatories, observers, and disclosure: this interface adds none. It inherits
--   whatever the implementing template already defines, which is why it costs
--   no additional privacy surface.
-- Controllers: `pauser` controls `Pausable_Pause` and `Pausable_Unpause`;
--   `Pausable_Paused` is controlled by its `actor` argument, so any party that
--   can see the contract may read the flag.
-- Authorization assumptions: only `pauser` can flip the switch. The implementing
--   template's own signatories authorize the successor contract.
-- Archival behavior: `Pausable_Pause` and `Pausable_Unpause` are consuming. They
--   archive the current contract and create its successor through
--   `setPausedImpl`.
-- Failure modes: pausing while paused fails with `eEnforcedPause`; unpausing
--   while unpaused fails with `eExpectedPause`. This matches Solidity, where
--   `_pause` carries `whenNotPaused` and `_unpause` carries `whenPaused`.
-- Upgrade and migration assumptions: interfaces are frozen for the life of the
--   package. `PausableView` gains no fields after 1.0.
interface Pausable where
  viewtype PausableView

  -- | Re-create the implementing contract with a new value of the flag.
  --
  -- The one obligation an implementer takes on. It must preserve every other
  -- field, so that pausing changes the flag and nothing else:
  --
  -- > setPausedImpl newPaused =
  -- >   toInterfaceContractId <$> create this with paused = newPaused
  setPausedImpl : Bool -> Update (ContractId Pausable)

  -- | Pause the contract. Fails if it is already paused.
  choice Pausable_Pause : ContractId Pausable
    controller (view this).pauser
    do
      whenNotPaused this
      setPausedImpl this True

  -- | Unpause the contract. Fails if it is not paused.
  choice Pausable_Unpause : ContractId Pausable
    controller (view this).pauser
    do
      whenPaused this
      setPausedImpl this False

  -- | Read the flag. The `paused()` getter.
  --
  -- Controlled by its own `actor`, so any party that can see the contract may
  -- call it. Reading the interface view off the ledger API gives the same
  -- answer without a transaction; this choice exists for code that must read
  -- the flag from inside a workflow.
  nonconsuming choice Pausable_Paused : Bool
    with
      actor : Party
        -- ^ The party asking. Authorizes the read and appears in the tree.
    controller actor
    do
      pure (view this).paused

-- | Fail unless the contract is unpaused. The `whenNotPaused` modifier.
--
-- Accepts an implementing template or a `Pausable` value, so the same guard
-- serves a consumer's choice and this interface's own choices.
--
-- > choice Vault_Withdraw : ContractId Vault
-- >   with amount : Int
-- >   controller holder
-- >   do
-- >     whenNotPaused this
-- >     create this with balance = balance - amount
whenNotPaused : (HasToInterface t Pausable) => t -> Update ()
whenNotPaused x = assertMsg eEnforcedPause (not (isPaused x))

-- | Fail unless the contract is paused. The `whenPaused` modifier.
-- Use it on recovery choices that may run only during an incident.
whenPaused : (HasToInterface t Pausable) => t -> Update ()
whenPaused x = assertMsg eExpectedPause (isPaused x)

-- | `paused()` as a pure function, for a choice that branches on the flag
-- rather than refusing to run.
isPaused : (HasToInterface t Pausable) => t -> Bool
isPaused x = (view (toInterface @Pausable x)).paused

-- Error messages. The Solidity custom errors, as text.

-- | Raised when an operation requires the contract to be unpaused.
eEnforcedPause : Text
eEnforcedPause = "Pausable: enforced pause"

-- | Raised when an operation requires the contract to be paused.
eExpectedPause : Text
eExpectedPause = "Pausable: expected pause"
