-- | Internal helpers for `OpenZeppelin.Api.PausableV1`.
module OpenZeppelin.Api.PausableV1.Internal where

import DA.Fail (FailureCategory, FailureStatus (..))
import qualified DA.TextMap as TextMap

-- | Build a `FailureStatus` under the `openzeppelin.com/pausable-` error id
-- prefix.
pausableFailure : Text -> FailureCategory -> Text -> FailureStatus
pausableFailure name category message = FailureStatus with
  errorId = "openzeppelin.com/pausable-" <> name
  category
  message
  meta = TextMap.empty
