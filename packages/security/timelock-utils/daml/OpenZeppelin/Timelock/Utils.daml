-- | OpenZeppelin Timelock - the lifecycle functions, the schedule functions,
-- the pending-list functions, the time guards, and the failure statuses for
-- the interfaces in `OpenZeppelin.Api.TimelockV1`.
--
-- The timelock template implements the `applyImpl` and `dropImpl` methods
-- with the lifecycle functions:
--
-- ```
-- interface instance Timelock for TreasuryTimelock where
--   view = TimelockView with authority = admin; config; pending
--   apply op pending' = ...
--   unschedule pending' = toInterfaceContractId <$> create this with pending = pending'
--   applyImpl self arg = applyOperation (toInterface @Timelock this) self arg
--   dropImpl self arg = dropOperation (toInterface @Timelock this) self arg
-- ```
--
-- The consumer's schedule choice validates the policy, computes the schedule
-- with `scheduleAt` or `scheduleAfter`, creates the operation, and records it
-- with `addPending`:
--
-- ```
-- choice TreasuryTimelock_ScheduleLimit : (ContractId TreasuryTimelock, ContractId LimitChange)
--   with newLimit : Decimal; readyAt : Time
--   controller proposer
--   do
--     s <- scheduleAt config readyAt
--     op <- create LimitChange with
--       admin; proposer; executor; newLimit
--       readyAt = s.readyAt; expiresAt = s.expiresAt
--     t <- create this with pending = addPending op pending
--     pure (t, op)
-- ```
module OpenZeppelin.Timelock.Utils
  ( applyOperation
  , dropOperation
  , isValidConfig
  , requireValidConfig
  , scheduleAt
  , scheduleAfter
  , addPending
  , takePending
  , requireReady
  , requireExpired
  , isReadyAt
  , isExpiredAt
  , invalidConfigFailure
  , delayTooShortFailure
  , invalidAuthorityFailure
  , notPendingFailure
  , notExecutorFailure
  , notCancellerFailure
  , pendingMismatchFailure
  , notReadyFailure
  , expiredFailure
  , notExpiredFailure
  ) where

import DA.Action (unless)
import DA.Fail (failWithStatus)
import DA.List (delete)
import DA.Optional (whenSome)
import DA.Time (RelTime, addRelTime, isLedgerTimeGE, isLedgerTimeLE, isLedgerTimeLT, microseconds)

import OpenZeppelin.Api.TimelockV1
import OpenZeppelin.Timelock.Utils.Internal

-- | The body of `Timelock_Apply`: apply a pending operation. Call it from the
-- timelock's `applyImpl` method with the timelock as `target`.
--
-- Fails with `notPendingFailure` unless `target`'s pending list holds the
-- operation, with `invalidAuthorityFailure` unless `authority` signs both
-- contracts and every signatory of the operation signs `target`, with
-- `notExecutorFailure` unless `actor` is an executor, and with
-- `notReadyFailure` or `expiredFailure` outside the operation's time bounds.
-- Then archives the operation and `self`, calls `apply` with the reduced
-- pending list, and fails with `pendingMismatchFailure` unless the successor
-- holds exactly that list.
applyOperation : Timelock -> ContractId Timelock -> Timelock_Apply -> Update (ContractId Timelock)
applyOperation target self Timelock_Apply{..} = do
  pending' <- takePending op (view target).pending
  opValue <- fetch op
  requireAuthority target opValue
  requireExecutor actor (view opValue)
  requireReady opValue
  archive op
  archive self
  new <- apply target opValue pending'
  requireSuccessorPending pending' new
  pure new

-- | The body of `Timelock_Drop`: remove a pending operation without applying
-- it. Call it from the timelock's `dropImpl` method with the timelock as
-- `target`.
--
-- Fails as `applyOperation` does on the pending list and the authority. For
-- `CancelOperation`, fails with `notCancellerFailure` unless `actor` is a
-- canceller. For `CleanupOperation`, fails with `notExpiredFailure` unless the
-- operation has expired. Then archives the operation and `self`, calls
-- `unschedule` with the reduced pending list, and fails with
-- `pendingMismatchFailure` unless the successor holds exactly that list.
dropOperation : Timelock -> ContractId Timelock -> Timelock_Drop -> Update (ContractId Timelock)
dropOperation target self Timelock_Drop{..} = do
  pending' <- takePending op (view target).pending
  opValue <- fetch op
  requireAuthority target opValue
  case reason of
    CancelOperation -> requireCanceller actor (view opValue)
    CleanupOperation -> requireExpired opValue
  archive op
  archive self
  new <- unschedule target pending'
  requireSuccessorPending pending' new
  pure new

-- | Whether a policy produces executable operations: `minDelay` is zero or
-- greater, and `gracePeriod`, when set, is positive. Call it in the timelock
-- template's `ensure` clause.
isValidConfig : TimelockConfig -> Bool
isValidConfig config =
  config.minDelay >= zero && optional True (> zero) config.gracePeriod
  where zero = microseconds 0

-- | Fail with `invalidConfigFailure` unless `isValidConfig` holds. Call it on
-- the proposed policy in the choice that schedules a policy change.
requireValidConfig : TimelockConfig -> Update ()
requireValidConfig config = unless (isValidConfig config) (failWithStatus invalidConfigFailure)

-- | Compute the schedule of an operation that becomes ready at `readyAt`, and
-- store the returned fields on the operation.
--
-- Fails with `invalidConfigFailure` when `isValidConfig` rejects the policy,
-- and with `delayTooShortFailure` unless the ledger time is at least
-- `config.minDelay` before `readyAt`. The check is a ledger-time bound, so the
-- transaction's ledger time stays free within it.
scheduleAt : TimelockConfig -> Time -> Update TimelockedView
scheduleAt config readyAt = do
  requireValidConfig config
  early <- isLedgerTimeLE (addRelTime readyAt (negate config.minDelay))
  unless early (failWithStatus delayTooShortFailure)
  pure TimelockedView with
    readyAt
    expiresAt = fmap (addRelTime readyAt) config.gracePeriod

-- | Compute the schedule of an operation that becomes ready `delay` after the
-- transaction's ledger time. It calls `getTime`, which fixes the ledger time
-- of the transaction; use `scheduleAt` when the proposer knows the target
-- time.
--
-- Fails with `invalidConfigFailure` when `isValidConfig` rejects the policy,
-- and with `delayTooShortFailure` unless `delay` is at least `config.minDelay`.
scheduleAfter : TimelockConfig -> RelTime -> Update TimelockedView
scheduleAfter config delay = do
  requireValidConfig config
  unless (delay >= config.minDelay) (failWithStatus delayTooShortFailure)
  now <- getTime
  let readyAt = addRelTime now delay
  pure TimelockedView with
    readyAt
    expiresAt = fmap (addRelTime readyAt) config.gracePeriod

-- | Record a newly created operation in the timelock's pending list. Call it
-- in the schedule choice on the operation that the choice created.
addPending : HasToInterface t Timelocked => ContractId t -> Pending -> Pending
addPending op pending = toInterfaceContractId @Timelocked op :: pending

-- | Remove an operation from the pending list, and fail with
-- `notPendingFailure` when the list does not hold it. Call it first in an apply
-- choice that you write yourself.
takePending : HasToInterface t Timelocked => ContractId t -> Pending -> Update Pending
takePending op pending = do
  let cid = toInterfaceContractId @Timelocked op
  unless (cid `elem` pending) (failWithStatus notPendingFailure)
  pure (delete cid pending)

-- | Fail unless the operation may execute now: the ledger time is at or after
-- `readyAt` and, when `expiresAt` is set, before it. Fails with
-- `notReadyFailure` before `readyAt` and with `expiredFailure` at or after
-- `expiresAt`.
requireReady : HasToInterface t Timelocked => t -> Update ()
requireReady x = do
  let v = view (toInterface @Timelocked x)
  ready <- isLedgerTimeGE v.readyAt
  unless ready (failWithStatus notReadyFailure)
  whenSome v.expiresAt $ \expiresAt -> do
    live <- isLedgerTimeLT expiresAt
    unless live (failWithStatus expiredFailure)

-- | Fail with `notExpiredFailure` unless `expiresAt` is set and the ledger time
-- is at or after it.
requireExpired : HasToInterface t Timelocked => t -> Update ()
requireExpired x = do
  let v = view (toInterface @Timelocked x)
  case v.expiresAt of
    None -> failWithStatus notExpiredFailure
    Some expiresAt -> do
      expired <- isLedgerTimeGE expiresAt
      unless expired (failWithStatus notExpiredFailure)

-- | Whether the operation may execute at `now`: `readyAt <= now`, and
-- `now < expiresAt` when `expiresAt` is set.
isReadyAt : HasToInterface t Timelocked => Time -> t -> Bool
isReadyAt now x =
  let v = view (toInterface @Timelocked x)
  in v.readyAt <= now && optional True (now <) v.expiresAt

-- | Whether the operation has expired at `now`: `expiresAt` is set and
-- `expiresAt <= now`.
isExpiredAt : HasToInterface t Timelocked => Time -> t -> Bool
isExpiredAt now x =
  let v = view (toInterface @Timelocked x)
  in optional False (<= now) v.expiresAt
