-- | The default holding template and the operations record the other
-- default templates pass to the workflows.
module OpenZeppelin.TokenCIP112V1.Holding where

import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.TokenStandard.Utils

import OpenZeppelin.TokenCIP112WorkflowsV1.Holding
import OpenZeppelin.TokenCIP112V1.Base

-- | A holding maintained jointly by the instrument admin and the account
-- parties. Lock holders observe the contract so they can settle or release
-- the locked funds. Regular accounts only: special (ownerless) accounts
-- never hold.
--
-- Disclosure: the contract and its `HoldingV2.Holding` view are visible to
-- the admin, the account parties, and the current lock holders. Creating a
-- holding requires the admin's and every account party's authority, so
-- holdings only ever appear through registry choices.
template TokenHolding with
    holding : HoldingV2.HoldingView
  where
    signatory holding.instrumentId.admin, accountParties holding.instrumentId.admin holding.account
    observer lockHolders holding.lock
    ensure isValidHoldingView holding

    choice TokenHolding_OwnerUnlock : ContractId HoldingV2.Holding
      -- ^ Reclaim a holding whose lock has expired. Fails while the lock is
      -- live or indefinite. The admin's authority for the event comes from
      -- this template's signatories, so the account parties exercise alone.
      controller accountParties holding.instrumentId.admin holding.account
      do holdingOwnerUnlockImpl (defaultHoldingOps holding.instrumentId.admin)
           (toInterfaceContractId self) holding

    interface instance HoldingV2.Holding for TokenHolding where
      view = holding

-- | The operations the default templates run the workflows with: create
-- `TokenHolding`, consume by archiving a pinned `TokenHolding`, and emit
-- through a transient `TokenEventLog`.
defaultHoldingOps : Party -> HoldingOps
defaultHoldingOps admin = HoldingOps with
  createHolding = \v -> toInterfaceContractId <$> create TokenHolding with holding = v
  consumeHolding = consumeByArchive @TokenHolding
  withEventLog = withTempEventLog admin
  eventObservers = const []
