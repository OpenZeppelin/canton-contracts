-- Contains code from Splice (https://github.com/canton-network/splice), modified by OpenZeppelin.

-- | The default registry rules contract: transfer factory, allocation
-- factory, and settlement factory on a single long-lived admin contract, plus
-- admin mint offers and cleanup (expiry) operations. Burns are transfers to
-- the CIP-0112 burn account. Every body is a utils-package function applied
-- to this package's templates.
module OpenZeppelin.Token.Cip112.V1.Registry where

import DA.Foldable (forA_)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.Api.Token.AllocationInstructionV2 qualified as AllocationInstructionV2
import Splice.Api.Token.TransferInstructionV2 qualified as TransferInstructionV2
import Splice.TokenStandard.Utils

import OpenZeppelin.Token.Cip112.TypesV1
import OpenZeppelin.Token.Cip112.Utils.Holding
import OpenZeppelin.Token.Cip112.Utils.Transfer
import OpenZeppelin.Token.Cip112.Utils.Allocation
import OpenZeppelin.Token.Cip112.Utils.Registry
import OpenZeppelin.Token.Cip112.V1.Holding
import OpenZeppelin.Token.Cip112.V1.Transfer
import OpenZeppelin.Token.Cip112.V1.Allocation

-- | The registry's policy and entry-point contract, signed by the admin
-- alone. Consumers obtain it by explicit disclosure; the factory choices are
-- nonconsuming, so concurrent workflows never contend on it.
template TokenRules with
    config : RegistryConfig
  where
    signatory config.admin
    ensure isValidRegistryConfig config

    interface instance AllocationV2.SettlementFactory for TokenRules where
      view = AllocationV2.SettlementFactoryView with admin = config.admin; meta = emptyMetadata
      settlementFactory_publicFetchImpl = publicFetchDefaultImpl this
      -- No extra observers: batch participants must not learn about the
      -- other allocations being settled.
      settlementFactory_settleBatchExtraObservers _ = []
      settlementFactory_settleBatchImpl self arg =
        settleBatchImpl (pinAllocationTo @TokenAllocation) config.admin self arg

    interface instance AllocationInstructionV2.AllocationFactory for TokenRules where
      view = AllocationInstructionV2.AllocationFactoryView with admin = config.admin; meta = emptyMetadata
      allocationFactory_publicFetchImpl = publicFetchDefaultImpl this
      allocationFactory_allocateExtraObservers = privateAssetAllocateExtraObservers
      allocationFactory_allocateImpl _self arg =
        allocationFactoryImpl config (rulesOps config) createAllocation arg

    interface instance TransferInstructionV2.TransferFactory for TokenRules where
      view = TransferInstructionV2.TransferFactoryView with admin = config.admin; meta = emptyMetadata
      transferFactory_publicFetchImpl = publicFetchDefaultImpl this
      transferFactory_transferExtraObservers = transferFactoryV2_privateAsset_transferExtraObserversDefaultImpl
      transferFactory_transferImpl _self arg =
        transferFactoryImpl config (rulesOps config) createInstruction arg

    nonconsuming choice TokenRules_ExpireAllocations : ()
      -- ^ Batched admin expiry of stale allocations through the standard
      -- cancel choice, each pinned to `TokenAllocation`.
      with
        cancelArgs : [(ContractId AllocationV2.Allocation, AllocationV2.Allocation_Cancel)]
        observers : [Party]
      observer observers
      controller config.admin
      do expireAllocationsImpl (pinAllocationTo @TokenAllocation) config.admin cancelArgs

    nonconsuming choice TokenRules_OfferMint : ContractId TransferInstructionV2.TransferInstruction
      -- ^ Offer new holdings to a regular account: a pending transfer
      -- instruction from the CIP-0112 mint account, which the receiver's
      -- account parties accept or reject.
      with
        receiver : HoldingV2.Account
        instrumentId : Text
        amount : Decimal
        requestedAt : Time
        executeBefore : Time
        reason : Text
      controller config.admin
      do offerMintImpl config createInstruction receiver instrumentId amount requestedAt executeBefore reason

    nonconsuming choice TokenRules_ExpireTransferInstructions : ()
      -- ^ Batched admin expiry of stale transfer instructions. Template-typed
      -- on purpose: the registry only ever expires its own instructions.
      with
        instructionCids : [ContractId TokenTransferInstruction]
        observers : [Party]
      observer observers
      controller config.admin
      do
        forA_ instructionCids $ \cid -> do
          _ <- ownInstruction config cid
          _ <- exercise cid TokenTransferInstruction_Expire
          pure ()

    -- Admin wallet actions. The admin is the only account party of the
    -- CIP-0112 mint and burn accounts, so it acts on pending contracts as a
    -- wallet: it accepts or rejects a burn request, withdraws a mint offer,
    -- withdraws a special-account allocation, and cancels an allocation it
    -- executes. A standard interface choice runs the body of whichever
    -- template implements it, with the admin's authority. Each choice below
    -- fetches the contract by this package's template first, so the admin's
    -- authority only ever reaches this package's choice bodies.

    nonconsuming choice TokenRules_AcceptTransferInstruction : TransferInstructionV2.TransferInstructionResult
      -- ^ Accept, as the admin, a `TokenTransferInstruction` of this
      -- registry, such as a burn request.
      with
        instructionCid : ContractId TokenTransferInstruction
        extraArgs : ExtraArgs
      controller config.admin
      do
        iid <- ownInstruction config instructionCid
        exercise iid TransferInstructionV2.TransferInstruction_Accept with
          actors = [config.admin]; extraArgs

    nonconsuming choice TokenRules_RejectTransferInstruction : TransferInstructionV2.TransferInstructionResult
      -- ^ Reject, as the admin, a `TokenTransferInstruction` of this
      -- registry, such as a burn request.
      with
        instructionCid : ContractId TokenTransferInstruction
        extraArgs : ExtraArgs
      controller config.admin
      do
        iid <- ownInstruction config instructionCid
        exercise iid TransferInstructionV2.TransferInstruction_Reject with
          actors = [config.admin]; extraArgs

    nonconsuming choice TokenRules_WithdrawTransferInstruction : TransferInstructionV2.TransferInstructionResult
      -- ^ Withdraw, as the admin, a `TokenTransferInstruction` of this
      -- registry, such as a mint offer.
      with
        instructionCid : ContractId TokenTransferInstruction
        extraArgs : ExtraArgs
      controller config.admin
      do
        iid <- ownInstruction config instructionCid
        exercise iid TransferInstructionV2.TransferInstruction_Withdraw with
          actors = [config.admin]; extraArgs

    nonconsuming choice TokenRules_WithdrawAllocation : AllocationV2.AllocationResult
      -- ^ Withdraw, as the admin, a `TokenAllocation` of this registry, such
      -- as a mint-account or burn-account allocation.
      with
        allocationCid : ContractId TokenAllocation
        extraArgs : ExtraArgs
      controller config.admin
      do
        iid <- ownAllocation config allocationCid
        exercise iid AllocationV2.Allocation_Withdraw with
          actors = [config.admin]; extraArgs

    nonconsuming choice TokenRules_CancelAllocation : AllocationV2.AllocationResult
      -- ^ Cancel, as the admin, a `TokenAllocation` of this registry: at any
      -- time when the admin is its only settlement executor, otherwise after
      -- its `expiresAt`.
      with
        allocationCid : ContractId TokenAllocation
        extraArgs : ExtraArgs
      controller config.admin
      do
        iid <- ownAllocation config allocationCid
        exercise iid AllocationV2.Allocation_Cancel with
          actors = [config.admin]; extraArgs

-- | Fetch a transfer instruction by this package's template and require that
-- it belongs to this registry.
ownInstruction
  : RegistryConfig -> ContractId TokenTransferInstruction
  -> Update (ContractId TransferInstructionV2.TransferInstruction)
ownInstruction config cid = do
  instr <- fetch cid
  requireMatchExpected ("transfer.instrumentId.admin", instr.state.transfer.instrumentId.admin) config.admin
  pure (toInterfaceContractId cid)

-- | Fetch an allocation by this package's template and require that it
-- belongs to this registry.
ownAllocation
  : RegistryConfig -> ContractId TokenAllocation
  -> Update (ContractId AllocationV2.Allocation)
ownAllocation config cid = do
  alloc <- fetch cid
  requireMatchExpected ("allocation.admin", alloc.state.allocation.admin) config.admin
  pure (toInterfaceContractId cid)

rulesOps : RegistryConfig -> HoldingOps
rulesOps config = defaultHoldingOps config.admin

createInstruction : CreateTransferInstruction
createInstruction s = toInterfaceContractId <$> create TokenTransferInstruction with state = s

createAllocation : CreateAllocation
createAllocation s = toInterfaceContractId <$> create TokenAllocation with state = s
