-- | Registry workflow: the settlement-factory body and the admin mint and
-- cleanup operations a rules contract exposes as choices.
module OpenZeppelin.Token.Cip112.Utils.Registry where

import DA.Assert (assertDeadlineExceeded)
import DA.Foldable (forA_)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.Api.Token.TransferInstructionV2 qualified as TransferInstructionV2
import Splice.TokenStandard.Utils

import OpenZeppelin.Token.Cip112.TypesV1
import OpenZeppelin.Token.Cip112.Utils.Holding (addRelTimeSaturating)
import OpenZeppelin.Token.Cip112.Utils.Transfer
import OpenZeppelin.Token.Cip112.Utils.Allocation

-- | `settlementFactory_settleBatchImpl`: pin every allocation to template
-- `t` with `pinAllocationTo`, running `check` on each, then run the
-- vendored exact-cover settlement. A batch settles allocations of one
-- template only.
--
-- `select` decides which part of the batch's choice context reaches each
-- allocation's `Allocation_Settle`, and from there its `deliverHolding`
-- calls. It receives the allocation's view and the batch context. The batch
-- metadata never reaches an allocation. `\_ _ -> emptyChoiceContext`
-- forwards nothing, so a `deliverHolding` rule that requires a context entry
-- then refuses every batch settlement.
--
-- Each authorizer sees its own `Allocation_Settle` with that choice's
-- arguments. The batch exercise, whose context may describe other
-- authorizers' trades, stays with the factory's signatories and the
-- executors under two rules:
--
-- 1. Keep the factory's `settlementFactory_settleBatchExtraObservers`
--    empty. Otherwise each party it returns sees the whole batch, as every
--    leg's account parties do under the vendored
--    `settlementFactoryV2_publicAsset_settleBatchExtraObserversDefaultImpl`.
--    An executor that is also an authorizer sees the whole batch.
-- 2. Have `select` forward only the entries for the view's
--    `allocation.authorizer`. A `select` that forwards every entry shows
--    each authorizer the others' entries.
--
-- Information meant for every participant belongs in `SettlementInfo.meta`,
-- which each authorizer already sees and agreed to. The executors write the
-- batch context, so an operation that reads a forwarded entry checks the
-- contract it names, as for any other context.
--
-- The vendored default validates each `FinalizedAllocation`'s extra legs but
-- not its `nextIterationFunding`; the `validateNextIterationArgs` call in
-- `allocationSettleImpl` is the effective guard for that field.
settleBatchImpl
  : forall t. (HasEnsure t, HasFromInterface t AllocationV2.Allocation, HasToInterface t AllocationV2.Allocation)
  => (t -> Update ())
  -> (AllocationV2.AllocationView -> ChoiceContext -> ChoiceContext)
  -> Party -> ContractId AllocationV2.SettlementFactory
  -> AllocationV2.SettlementFactory_SettleBatch
  -> Update AllocationV2.SettlementFactory_SettleBatchResult
settleBatchImpl check select admin self arg = do
  require "a settlement batch must cover at least one transfer leg"
    (not (null arg.transferLegs))
  let selectedArgs allocView settleArg = pure ExtraArgs with
        context = select allocView settleArg.extraArgs.context
        meta = emptyMetadata
  forA_ arg.allocations $ \finalizedAlloc -> pinAllocationTo @t check finalizedAlloc.allocationCid
  settlementFactoryV2_settleBatchDefaultImpl selectedArgs admin self arg

-- | Body of a batched admin-expiry choice: `pinAllocationTo` pins each
-- allocation to template `t` and runs `check` on it, and actors, admin, and
-- expiry are re-verified per allocation independently of the cancel
-- implementation. Each cancel's `extraArgs.context` reaches the
-- allocation's `returnHolding`, and one refusal fails the whole batch.
--
-- The "Trust boundary" section of the package `README.md` says when the
-- choice that runs this body may have observers.
expireAllocationsImpl
  : forall t. (HasEnsure t, HasFromInterface t AllocationV2.Allocation, HasToInterface t AllocationV2.Allocation)
  => (t -> Update ()) -> Party
  -> [(ContractId AllocationV2.Allocation, AllocationV2.Allocation_Cancel)]
  -> Update ()
expireAllocationsImpl check admin cancelArgs =
  forA_ cancelArgs $ \(allocCid, cancelArg) -> do
    requireMatchExpected ("cancelArg.actors", cancelArg.actors) [admin]
    v <- pinAllocationTo @t check allocCid
    requireMatchExpected ("allocation.admin", v.allocation.admin) admin
    case v.expiresAt of
      None -> fail "cannot expire an allocation without an expiry time"
      Some expiresAt -> assertDeadlineExceeded "allocation.expiresAt" expiresAt
    _ <- exercise allocCid cancelArg
    pure ()

-- | Body of an admin-controlled mint choice: a pending transfer instruction
-- from the CIP-0112 mint account to `receiver`. The receiver's account
-- parties accept it to create the holding, or reject it. It locks nothing.
offerMintImpl
  : RegistryConfig -> CreateTransferInstruction -> HoldingV2.Account -> Text -> Decimal
  -> Time -> Time -> Text
  -> Update (ContractId TransferInstructionV2.TransferInstruction)
offerMintImpl config createInstruction receiver instrumentId amount requestedAt executeBefore reason = do
  let transfer = TransferInstructionV2.Transfer with
        sender = mintAccount
        receiver
        amount
        instrumentId = HoldingV2.InstrumentId with admin = config.admin; id = instrumentId
        requestedAt
        executeBefore
        inputHoldingCids = []
        meta = reasonToMeta reason emptyMetadata
  validateTransfer config transfer
  require "mint receiver must be a regular account" (isRegularAccount receiver)
  createInstruction TransferInstructionState with
    transfer
    lockedHoldingCids = []
    expiresAt = executeBefore
    lockExpiresAt = executeBefore `addRelTimeSaturating` config.lockGrace
