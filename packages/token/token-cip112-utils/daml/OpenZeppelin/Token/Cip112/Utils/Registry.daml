-- | Registry workflow: the settlement-factory body and the admin cleanup
-- operations a rules contract exposes as choices.
module OpenZeppelin.Token.Cip112.Utils.Registry where

import DA.Assert (assertDeadlineExceeded)
import DA.Foldable (forA_)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.TokenStandard.Utils

import OpenZeppelin.Token.Cip112.Utils.Allocation

-- | `settlementFactory_settleBatchImpl`: pin every allocation to an accepted
-- implementation, then run the vendored exact-cover settlement. No part of
-- the batch's `extraArgs` reaches the allocations' `Allocation_Settle`.
--
-- The vendored default validates each `FinalizedAllocation`'s extra legs but
-- not its `nextIterationFunding`; the `validateNextIterationArgs` call in
-- `allocationSettleImpl` is the effective guard for that field.
settleBatchImpl
  : PinAllocation -> Party -> ContractId AllocationV2.SettlementFactory
  -> AllocationV2.SettlementFactory_SettleBatch
  -> Update AllocationV2.SettlementFactory_SettleBatchResult
settleBatchImpl pin admin self arg = do
  require "a settlement batch must cover at least one transfer leg"
    (not (null arg.transferLegs))
  -- Each authorizer witnesses its own `Allocation_Settle`, so nothing from
  -- the batch's arguments should reach it: they may describe other authorizers'
  -- trades, and the allocation bodies read neither context nor metadata.
  -- Information meant for every participant belongs in `SettlementInfo.meta`,
  -- which each authorizer already sees and agreed to.
  let redactedBatchArgs _allocView _settleArg = pure ExtraArgs with
        context = emptyChoiceContext
        meta = emptyMetadata
  forA_ arg.allocations $ \finalizedAlloc -> pin finalizedAlloc.allocationCid
  settlementFactoryV2_settleBatchDefaultImpl redactedBatchArgs admin self arg

-- | Body of a batched admin-expiry choice: each allocation is pinned, and
-- actors, admin, and expiry are re-verified per allocation independently of
-- the cancel implementation.
expireAllocationsImpl
  : PinAllocation -> Party
  -> [(ContractId AllocationV2.Allocation, AllocationV2.Allocation_Cancel)]
  -> Update ()
expireAllocationsImpl pin admin cancelArgs =
  forA_ cancelArgs $ \(allocCid, cancelArg) -> do
    requireMatchExpected ("cancelArg.actors", cancelArg.actors) [admin]
    v <- pin allocCid
    requireMatchExpected ("allocation.admin", v.allocation.admin) admin
    case v.expiresAt of
      None -> fail "cannot expire an allocation without an expiry time"
      Some t -> assertDeadlineExceeded "allocation.expiresAt" t
    _ <- exercise allocCid cancelArg
    pure ()
