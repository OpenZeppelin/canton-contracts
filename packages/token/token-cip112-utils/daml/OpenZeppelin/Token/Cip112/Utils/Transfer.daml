-- | Transfer workflow: the transfer-factory body and the choice bodies of a
-- pending transfer instruction, over a `TransferInstructionState` payload
-- and a `HoldingOps` record supplied by the template owner.
module OpenZeppelin.Token.Cip112.Utils.Transfer where

import DA.Action (unless)
import DA.Assert (assertDeadlineExceeded, assertWithinDeadline)
import DA.List (dedupSort)
import DA.Map qualified as Map
import DA.Optional (fromOptional)
import DA.TextMap qualified as TextMap
import DA.Time (isLedgerTimeGE)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.TransferEventsV2 qualified as TransferEventsV2
import Splice.Api.Token.TransferInstructionV2 qualified as TransferInstructionV2
import Splice.TokenStandard.Utils

import OpenZeppelin.Token.Cip112.TypesV1
import OpenZeppelin.Token.Cip112.Utils.Holding

-- | Constructor of the owner's transfer-instruction template.
type CreateTransferInstruction =
  TransferInstructionState -> Update (ContractId TransferInstructionV2.TransferInstruction)

-- | The `ensure` predicate of a transfer-instruction template.
isValidTransferInstructionState : TransferInstructionState -> Bool
isValidTransferInstructionState s =
  isValidTransferV2 s.transfer
  -- A mint offer comes from the CIP-0112 mint account and locks nothing.
  -- Every other offer is funded by locked holdings of a regular account, and
  -- a burn request goes to the CIP-0112 burn account.
  && (if s.transfer.sender == mintAccount
        then isRegularAccount s.transfer.receiver && null s.lockedHoldingCids
        else isRegularAccount s.transfer.sender && not (null s.lockedHoldingCids)
          && (isRegularAccount s.transfer.receiver || s.transfer.receiver == burnAccount))
  && lockOutlivesExpiry s.expiresAt s.lockExpiresAt

-- | The standard view of a pending instruction. Joint actor sets: paying out
-- needs all receiver account parties; returning funds needs all sender
-- account parties.
transferInstructionView : TransferInstructionState -> TransferInstructionV2.TransferInstructionView
transferInstructionView s = TransferInstructionV2.TransferInstructionView with
  originalInstructionCid = None
  transfer = s.transfer
  expiresAt = Some s.expiresAt
  availableActions = Map.fromList
    [ (TransferInstructionV2.TIA_Accept, [receiverParties s.transfer])
    , (TransferInstructionV2.TIA_Reject, [receiverParties s.transfer])
    , (TransferInstructionV2.TIA_Withdraw, [senderParties s.transfer])
    ]
  meta = s.transfer.meta

senderParties : TransferInstructionV2.Transfer -> [Party]
senderParties transfer = accountParties transfer.instrumentId.admin transfer.sender

receiverParties : TransferInstructionV2.Transfer -> [Party]
receiverParties transfer = accountParties transfer.instrumentId.admin transfer.receiver

-- Instruction choice bodies
----------------------------

-- | `transferInstruction_acceptImpl`: consume the locked funding, return any
-- surplus to the sender, pay the receiver.
transferAcceptImpl
  : HoldingOps h -> ContractId TransferInstructionV2.TransferInstruction -> TransferInstructionState
  -> TransferInstructionV2.TransferInstruction_Accept
  -> Update TransferInstructionV2.TransferInstructionResult
transferAcceptImpl ops self s arg = do
  archiveAndCheckActors self arg.actors [receiverParties s.transfer]
  assertWithinDeadline "transfer.executeBefore" s.transfer.executeBefore
  let admin = s.transfer.instrumentId.admin
      transfer = s.transfer
  (lockedAmounts, lockedSources) <-
    debitHoldings (consumeLockedHolding ops arg.extraArgs.context admin transfer.sender) s.lockedHoldingCids
  -- A mint offer locks nothing: the admin's signature on it authorizes the
  -- new holding.
  unless (transfer.sender == mintAccount) $
    require' ("locked funding for " <> transfer.instrumentId.id,
        fromOptional 0.0 (TextMap.lookup transfer.instrumentId.id lockedAmounts))
      isGreaterOrEqualR ("transfer.amount", transfer.amount)
  -- Return every unit of locked funding that is not the transferred amount,
  -- including any balance in a different instrument.
  senderChangeCids <- returnLockedSurplus ops transfer lockedAmounts lockedSources
  receiverHoldingCids <- payReceiver ops (sourcesFor transfer.instrumentId.id lockedSources)
    transfer s.lockedHoldingCids senderChangeCids
  pure TransferInstructionV2.TransferInstructionResult with
    output = TransferInstructionV2.TransferInstructionResult_Completed with receiverHoldingCids
    senderChangeCids
    meta = transfer.meta

-- | `transferInstruction_rejectImpl`.
transferRejectImpl
  : HoldingOps h -> ContractId TransferInstructionV2.TransferInstruction -> TransferInstructionState
  -> TransferInstructionV2.TransferInstruction_Reject
  -> Update TransferInstructionV2.TransferInstructionResult
transferRejectImpl ops self s arg = do
  archiveAndCheckActors self arg.actors [receiverParties s.transfer]
  returnFundsToSender ops arg.extraArgs.context s "transfer rejected"

-- | `transferInstruction_withdrawImpl`.
transferWithdrawImpl
  : HoldingOps h -> ContractId TransferInstructionV2.TransferInstruction -> TransferInstructionState
  -> TransferInstructionV2.TransferInstruction_Withdraw
  -> Update TransferInstructionV2.TransferInstructionResult
transferWithdrawImpl ops self s arg = do
  archiveAndCheckActors self arg.actors [senderParties s.transfer]
  returnFundsToSender ops arg.extraArgs.context s "transfer withdrawn"

-- | Body of a consuming admin-expiry choice. It fails before `expiresAt`,
-- then reads the `expire-lock` flag. On `True` it returns the locked funds
-- to the sender. On `False` it ends the instruction without touching them,
-- and only once `lockExpiresAt` has passed. Both end with
-- `TransferInstructionResult_Failed`. `extraArgs.context` reaches
-- `returnHolding` for every locked holding.
transferExpireImpl
  : HoldingOps h -> TransferInstructionState -> ExtraArgs
  -> Update TransferInstructionV2.TransferInstructionResult
transferExpireImpl ops s extraArgs = do
  assertDeadlineExceeded "expiresAt" s.expiresAt
  expireLock <- expireLockFromContext extraArgs.context
  if expireLock
    then returnFundsToSender ops extraArgs.context s "transfer instruction expired"
    else do
      assertDeadlineExceeded "lockExpiresAt" s.lockExpiresAt
      pure TransferInstructionV2.TransferInstructionResult with
        output = TransferInstructionV2.TransferInstructionResult_Failed
        senderChangeCids = []
        meta = s.transfer.meta

-- Factory body
---------------

-- | `transferFactory_transferImpl`: check the actors, then execute. The
-- sender's account parties jointly initiate; including the receiver's account
-- parties completes the transfer in one step, which shows them the sender's
-- consumed inputs and change holding.
transferFactoryImpl
  : RegistryConfig -> HoldingOps h -> CreateTransferInstruction
  -> TransferInstructionV2.TransferFactory_Transfer
  -> Update TransferInstructionV2.TransferInstructionResult
transferFactoryImpl config ops createInstruction arg = do
  let receivers = dedupSort (receiverParties arg.transfer)
      senders = dedupSort (senderParties arg.transfer)
      bothSides = dedupSort (senderParties arg.transfer <> receiverParties arg.transfer)
      actors = dedupSort arg.actors
  checkActors arg.actors [senders, bothSides]
  executeTransfer config ops arg.extraArgs.context createInstruction (all (`elem` actors) receivers) arg.transfer

-- | Validate, debit the sender's inputs, and either complete in one step or
-- lock the transfer amount and create a pending instruction. The caller is
-- responsible for authorization: the debit needs the sender's and the admin's
-- authority, and the one-step path also creates the receiver's holding. The
-- receiver's account parties, whose authority that holding needs, witness
-- the sender's consumed inputs and change holding.
-- `context` reaches `fundHolding` for every input. The inputs are the
-- sources of the sender's change, the locked funding, and a one-step
-- transfer's receiver holding.
--
-- A transfer to the CIP-0112 burn account is a burn.
executeTransfer
  : RegistryConfig -> HoldingOps h -> ChoiceContext -> CreateTransferInstruction -> Bool
  -> TransferInstructionV2.Transfer
  -> Update TransferInstructionV2.TransferInstructionResult
executeTransfer config ops context createInstruction oneStep transfer = do
  let admin = config.admin
  validateTransfer config transfer
  require "transfer sender must be a regular account" (isRegularAccount transfer.sender)
  require "transfer receiver must be a regular account or the burn account"
    (isRegularAccount transfer.receiver || transfer.receiver == burnAccount)

  (inputAmounts, inputSources) <-
    debitHoldings (consumeUnlockedHolding ops context admin transfer.sender) transfer.inputHoldingCids
  funded <- case TextMap.toList inputAmounts of
    [(instrumentId, amount)] | instrumentId == transfer.instrumentId.id -> pure amount
    [] -> fail "transfer requires input holdings to fund it"
    _ -> fail "input holdings must all match the transfer's instrument"
  require' ("funding for " <> transfer.instrumentId.id, funded)
    isGreaterOrEqualR ("transfer.amount", transfer.amount)
  let sources = sourcesFor transfer.instrumentId.id inputSources
  senderChangeCids <-
    if funded > transfer.amount
      then (:: []) <$> newHolding ops sources admin transfer.sender transfer.instrumentId.id (funded - transfer.amount) None
      else pure []

  if oneStep
    then do
      receiverHoldingCids <- payReceiver ops sources transfer transfer.inputHoldingCids senderChangeCids
      pure TransferInstructionV2.TransferInstructionResult with
        output = TransferInstructionV2.TransferInstructionResult_Completed with receiverHoldingCids
        senderChangeCids
        meta = transfer.meta
    else do
      -- The admin is the only lock holder, so the owner's unlock after expiry
      -- involves only the participants of the holding's signatories, and the
      -- receiver gets the locked funding by explicit disclosure. The lock
      -- outlives the instruction's own expiry, or both are `maxTime`, so the
      -- admin's expiry path always runs before the funding is re-spendable.
      let instructionExpiresAt = transfer.executeBefore
          lockExpiresAt = instructionExpiresAt `addRelTimeSaturating` config.lockGrace
          lock = HoldingV2.Lock with
            holders = [admin]
            expiresAt = Some lockExpiresAt
            expiresAfter = None
            context = Some $ if transfer.receiver == burnAccount
              then "pending burn"
              else "pending transfer to " <> partyToText (regularAccountOwner transfer.receiver)
      lockedCid <- newHolding ops sources admin transfer.sender transfer.instrumentId.id transfer.amount (Some lock)
      instructionCid <- createInstruction TransferInstructionState with
        transfer = transfer with inputHoldingCids = [lockedCid]
        lockedHoldingCids = [lockedCid]
        expiresAt = instructionExpiresAt
        lockExpiresAt
      emitHoldingsChange ops admin transfer.sender []
        transfer.inputHoldingCids
        (lockedCid :: senderChangeCids)
        []
        "lock holdings for transfer"
      pure TransferInstructionV2.TransferInstructionResult with
        output = TransferInstructionV2.TransferInstructionResult_Pending with
          transferInstructionCid = instructionCid
        senderChangeCids
        meta = transfer.meta

-- | The checks every new transfer instruction passes: the registry's admin,
-- a well-formed transfer, and an execution window within `maxTTL` of ledger
-- time.
--
-- No check calls `getTime`. See "Time bounds" in the package `README.md`.
validateTransfer : RegistryConfig -> TransferInstructionV2.Transfer -> Update ()
validateTransfer config transfer = do
  requireMatchExpected ("transfer.instrumentId.admin", transfer.instrumentId.admin) config.admin
  require "transfer must be well formed" (isValidTransferV2 transfer)
  assertDeadlineExceeded "transfer.requestedAt" transfer.requestedAt
  assertWithinDeadline "transfer.executeBefore" transfer.executeBefore
  -- executeBefore - maxTTL <= ledger time
  windowWithinTTL <- isLedgerTimeGE (transfer.executeBefore `addRelTimeSaturating` negate config.maxTTL)
  require "transfer execution window exceeds the registry's maximum TTL" windowWithinTTL
  -- ledger time <= requestedAt + maxTTL
  requestWithinTTL <- isLedgerTimeAtMost (transfer.requestedAt `addRelTimeSaturating` config.maxTTL)
  require "transfer requestedAt is older than the registry's maximum TTL" requestWithinTTL

-- | Pay out any locked funding beyond the transferred amount, per
-- instrument, so accepting can never destroy value. Each surplus holding's
-- sources are the locked holdings of its instrument.
returnLockedSurplus
  : HoldingOps h -> TransferInstructionV2.Transfer -> TextMap.TextMap Decimal
  -> TextMap.TextMap [h]
  -> Update [ContractId HoldingV2.Holding]
returnLockedSurplus ops transfer lockedAmounts lockedSources = do
  let admin = transfer.instrumentId.admin
  changes <- forA (TextMap.toList lockedAmounts) $ \(instrumentId, amount) -> do
    let surplus =
          if instrumentId == transfer.instrumentId.id then amount - transfer.amount else amount
    if surplus > 0.0
      then (:: []) <$> newHolding ops (sourcesFor instrumentId lockedSources)
        admin transfer.sender instrumentId surplus None
      else pure []
  pure (concat changes)

-- | Create the receiver's holding and log the transfer event. `inputCids`
-- are the holdings consumed to fund it and `sources` their states in the
-- transfer's instrument. A burn creates no holding.
payReceiver
  : HoldingOps h -> [h] -> TransferInstructionV2.Transfer
  -> [ContractId HoldingV2.Holding] -> [ContractId HoldingV2.Holding]
  -> Update [ContractId HoldingV2.Holding]
payReceiver ops sources transfer inputCids senderChangeCids = do
  let admin = transfer.instrumentId.admin
  receiverHoldingCids <-
    if transfer.receiver == burnAccount
      then pure []
      else (:: []) <$> newHolding ops sources admin transfer.receiver transfer.instrumentId.id transfer.amount None
  ops.withEventLog $ \eventLogCid ->
    logTransferEvents ops eventLogCid (transfer with inputHoldingCids = inputCids)
      senderChangeCids receiverHoldingCids
  pure receiverHoldingCids

-- | Log the transfer events of the vendored `logTransfer`: one account-local
-- event for a self-transfer, otherwise a sender-side and a receiver-side
-- event. Each event adds the owner's extra observers and, in its
-- `extraArgs.meta`, the reason `tokens minted` for a transfer from the
-- CIP-0112 mint account, `tokens burned` for one to the burn account, and
-- `transfer completed` otherwise. Each leg side carries the transfer's
-- `meta`, including its reason.
-- https://github.com/canton-network/splice/blob/8460154135f39019b8bb370c9c1321ff13c9bb10/token-standard/splice-token-standard-utils/daml/Splice/TokenStandard/Utils/Internal/Events.daml#L149-L193
logTransferEvents
  : HoldingOps h -> ContractId TransferEventsV2.EventLog -> TransferInstructionV2.Transfer
  -> [ContractId HoldingV2.Holding] -> [ContractId HoldingV2.Holding]
  -> Update ()
logTransferEvents ops eventLogCid transfer senderOutputHoldingCids receiverOutputHoldingCids = do
  let admin = transfer.instrumentId.admin
      leg side otherside = TransferEventsV2.TransferLegSide with
        transferLegId = ""
        side
        otherside
        instrumentId = transfer.instrumentId.id
        amount = transfer.amount
        meta = transfer.meta
      transferIn = leg TransferEventsV2.ReceiverSide transfer.sender
      transferOut = leg TransferEventsV2.SenderSide transfer.receiver
      reason
        | transfer.sender == mintAccount = "tokens minted"
        | transfer.receiver == burnAccount = "tokens burned"
        | otherwise = "transfer completed"
      extraArgs = ExtraArgs with context = emptyChoiceContext; meta = reasonToMeta reason emptyMetadata
  if transfer.sender == transfer.receiver
    then
      logHoldingsChange eventLogCid TransferEventsV2.EventLog_HoldingsChange with
        admin
        account = transfer.sender
        inputHoldingCids = transfer.inputHoldingCids
        transferLegSides = [transferOut, transferIn]
        outputHoldingCids = senderOutputHoldingCids ++ receiverOutputHoldingCids
        observers = eventObserversFor ops admin transfer.sender
        extraArgs
    else do
      logHoldingsChange eventLogCid TransferEventsV2.EventLog_HoldingsChange with
        admin
        account = transfer.sender
        inputHoldingCids = transfer.inputHoldingCids
        transferLegSides = [transferOut]
        outputHoldingCids = senderOutputHoldingCids
        observers = eventObserversFor ops admin transfer.sender
        extraArgs
      logHoldingsChange eventLogCid TransferEventsV2.EventLog_HoldingsChange with
        admin
        account = transfer.receiver
        inputHoldingCids = []
        transferLegSides = [transferIn]
        outputHoldingCids = receiverOutputHoldingCids
        observers = eventObserversFor ops admin transfer.receiver
        extraArgs

-- | Release the locked funding to the sender and log the change.
returnFundsToSender
  : HoldingOps h -> ChoiceContext -> TransferInstructionState -> Text
  -> Update TransferInstructionV2.TransferInstructionResult
returnFundsToSender ops context s reason = do
  let admin = s.transfer.instrumentId.admin
  holdings <- unlockHoldings ops context admin s.transfer.sender s.lockedHoldingCids
  let senderChangeCids = concat (textMapValues holdings)
  emitHoldingsChange ops admin s.transfer.sender [] s.lockedHoldingCids senderChangeCids [] reason
  pure TransferInstructionV2.TransferInstructionResult with
    output = TransferInstructionV2.TransferInstructionResult_Failed
    senderChangeCids
    meta = s.transfer.meta
