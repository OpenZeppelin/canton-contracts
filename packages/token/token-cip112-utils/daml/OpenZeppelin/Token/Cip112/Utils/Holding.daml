{-# LANGUAGE AllowAmbiguousTypes #-}
-- | Holding operations shared by every CIP-0112 workflow.
--
-- This package names no template. Everything that creates, consumes, or
-- emits an event through a contract goes through a `HoldingOps` record the
-- template owner builds inside a choice body. The record holds functions, so
-- it cannot be stored in a contract payload: a template that completes a
-- workflow later (accept, settle, expire) re-supplies its ops when that
-- choice runs.
--
-- Trust boundary: the workflows trust nothing they did not just create. A
-- caller-supplied holding id only ever enters through `fundHolding`, and the
-- workflows consume the funding they locked through `deliverHolding` or
-- `returnHolding`. Each must establish that the contract is an accepted
-- implementation before the workflow credits its amount. `consumeByArchive`
-- is the safe default; an interface `fetch` followed by an interface
-- `archive` is not.
module OpenZeppelin.Token.Cip112.Utils.Holding where

import DA.Assert (assertDeadlineExceeded)
import DA.Foldable (forA_)
import DA.List (dedupSort)
import DA.Optional (isNone, isSome)
import DA.TextMap qualified as TextMap
import DA.Time (RelTime, addRelTime, subTime, convertMicrosecondsToRelTime)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.TransferEventsV2 qualified as TransferEventsV2
import Splice.TokenStandard.Utils

import OpenZeppelin.Token.Cip112.TypesV1

-- Registry configuration
--------------------------

-- | The `ensure` predicate of a rules contract holding a `RegistryConfig`.
isValidRegistryConfig : RegistryConfig -> Bool
isValidRegistryConfig c =
  c.maxTTL > convertMicrosecondsToRelTime 0
  && c.lockGrace > convertMicrosecondsToRelTime 0

-- Operations supplied by the template owner
--------------------------------------------

-- | What a workflow needs from the template owner. Not serializable.
--
-- Three operations consume holdings, one per direction the value moves:
-- `fundHolding` for inputs a caller supplies, `deliverHolding` for locked
-- funding paid out, and `returnHolding` for locked funding given back to its
-- owner. Each is both the accepted-implementation policy and the spend rule
-- for its paths, and each takes the `ChoiceContext` the submitter passed to
-- the choice the workflow runs in, followed by the holding id. All three
-- share one law: fail unless the contract is an accepted implementation,
-- then remove the holding from the ledger and return the view it had.
--
-- A rule in `deliverHolding` or `returnHolding` runs on funding the workflow
-- locked itself. A refusal in one leaves the other's paths open, and a
-- refusal in both holds the funds until the lock expires. After that the
-- owner recovers them through the holding's owner-unlock choice, or by
-- passing the holding to a factory, which runs `fundHolding`. A rule that
-- must hold them longer is also checked in that choice and in `fundHolding`.
-- Put a rule in `deliverHolding` or `returnHolding` only if a known party
-- can lift it without re-creating the locked holding, such as a compliance
-- officer lifting a freeze kept on a separate per-account contract. A
-- pending instruction or allocation names its locked holdings by id, so it
-- can neither pay out nor return a holding that was replaced. A rule that
-- should only stop new spending, such as a minimum holding age, belongs in
-- `fundHolding` alone: the workflow creates locked funding, change, and
-- returned holdings when it runs, so each of them is new.
--
-- A rule that tracks live registry state reads the current policy contract
-- from the context, and the operation checks the contract it fetches: its
-- template, its signatories, and that it covers this holding's admin and
-- account. Neither of the two simpler designs follows the registry. A value
-- copied into the holding when it is created stays fixed after the registry
-- changes it, and a policy contract id stored in the holding fails every
-- spend once the registry replaces that contract.
data HoldingOps = HoldingOps with
    createHolding : HoldingV2.HoldingView -> Update (ContractId HoldingV2.Holding)
      -- ^ Create a holding from its standard view. Law: the created
      -- contract's `Holding` view equals the argument, and its signatories
      -- include `view.instrumentId.admin` and the account parties. Extra
      -- template fields come from the closure that builds the record.
    fundHolding : ChoiceContext -> ContractId HoldingV2.Holding -> Update HoldingV2.HoldingView
      -- ^ Consume a caller-supplied input holding that funds a new transfer
      -- or allocation, through `consumeUnlockedHolding`: the inputs of
      -- `transferFactoryImpl` and `executeTransfer`, including a one-step
      -- transfer and a burn, and of `allocationFactoryImpl`. A refusal fails
      -- the factory call and leaves every input untouched.
    deliverHolding : ChoiceContext -> ContractId HoldingV2.Holding -> Update HoldingV2.HoldingView
      -- ^ Consume locked funding to pay it out, through
      -- `consumeLockedHolding`: `transferAcceptImpl`, including the admin's
      -- accept of a burn request, and `allocationSettleImpl`. Both consume
      -- all of the locked funding here, including any part that stays with
      -- its owner: an accept's surplus, a settlement's payout to the
      -- authorizer, and a reserve rolled into the next iteration. A refusal
      -- blocks accept and settle; every return path still runs.
      -- `settleBatchImpl` passes each `Allocation_Settle` an empty context,
      -- so a rule that requires a context entry refuses every batch
      -- settlement.
    returnHolding : ChoiceContext -> ContractId HoldingV2.Holding -> Update HoldingV2.HoldingView
      -- ^ Consume locked funding to return it to its owner, through
      -- `unlockHoldings`: `transferRejectImpl`, `transferWithdrawImpl`,
      -- `transferExpireImpl`, `allocationWithdrawImpl`, and
      -- `allocationCancelImpl`. A refusal blocks every one of those paths;
      -- accept and settle still run. `expireAllocationsImpl` cancels its
      -- allocations in turn, so one refusal fails the whole batch.
    withEventLog : (ContractId TransferEventsV2.EventLog -> Update ()) -> Update ()
      -- ^ Run one emission against an `EventLog` host. The default templates
      -- supply a transient host created and archived within the transaction.
    eventObservers : HoldingV2.Account -> [Party]
      -- ^ Extra informees of every `EventLog_HoldingsChange` the workflows
      -- emit for the account, added to the account parties and any
      -- executors. An auditor or regulator who must see the standard event
      -- stream, not only the holdings, goes here. `const []` adds nobody.

-- | Consume by archiving, pinned to template `t`: `fetchFromInterface @t`
-- fails on every other implementation, so a foreign `Holding` whose view
-- claims this admin never reaches the workflow's accounting.
consumeByArchive
  : forall t. (HasFromInterface t HoldingV2.Holding, HasToInterface t HoldingV2.Holding, HasArchive t)
  => ContractId HoldingV2.Holding -> Update HoldingV2.HoldingView
consumeByArchive cid = do
  fetched <- fetchFromInterface @t cid
  case fetched of
    None -> fail "holding is not an accepted implementation"
    Some (tcid, t) -> do
      archive tcid
      pure (view (toInterface @HoldingV2.Holding t))

-- | An operations record whose three consumption operations are all
-- `consumeByArchive @t`: every path accepts exactly template `t`, ignores
-- the context, and applies no spend rule. The other operations are the
-- arguments. Override a consumption operation with `with` to add a rule to
-- its paths only.
holdingOpsFor
  : forall t. (HasFromInterface t HoldingV2.Holding, HasToInterface t HoldingV2.Holding, HasArchive t)
  => (HoldingV2.HoldingView -> Update (ContractId HoldingV2.Holding))
  -> ((ContractId TransferEventsV2.EventLog -> Update ()) -> Update ())
  -> (HoldingV2.Account -> [Party])
  -> HoldingOps
holdingOpsFor createHolding withEventLog eventObservers = HoldingOps with
  createHolding
  fundHolding = \_ -> consumeByArchive @t
  deliverHolding = \_ -> consumeByArchive @t
  returnHolding = \_ -> consumeByArchive @t
  withEventLog
  eventObservers

-- Creation-time invariants
---------------------------

-- | The `ensure` predicate of a holding template: positive amount, a regular
-- (owned) account, and no `expiresAfter` lock, whose earlier-of-two-bounds
-- expiry this package does not model.
isValidHoldingView : HoldingV2.HoldingView -> Bool
isValidHoldingView holding =
  holding.amount > 0.0
  && isSome holding.account.owner
  && optional True (isNone . (.expiresAfter)) holding.lock

lockHolders : Optional HoldingV2.Lock -> [Party]
lockHolders lock = case lock of
  None -> []
  Some l -> l.holders

mkHoldingView
  : Party -> HoldingV2.Account -> Text -> Decimal -> Optional HoldingV2.Lock
  -> HoldingV2.HoldingView
mkHoldingView admin account instrumentId amount lock = HoldingV2.HoldingView with
  account
  instrumentId = HoldingV2.InstrumentId with admin; id = instrumentId
  amount
  lock
  meta = emptyMetadata

-- | Create a holding through the owner's constructor.
newHolding
  : HoldingOps -> Party -> HoldingV2.Account -> Text -> Decimal -> Optional HoldingV2.Lock
  -> Update (ContractId HoldingV2.Holding)
newHolding ops admin account instrumentId amount lock =
  ops.createHolding (mkHoldingView admin account instrumentId amount lock)

-- Choice bodies
----------------

-- | Body of a consuming owner-unlock choice on a holding template: the lock
-- has expired, so recreate the holding unlocked and emit an account-local
-- `EventLog_HoldingsChange` naming the consumed holding and its replacement.
-- `self` is the holding being exercised; the choice itself archives it.
--
-- None of the consumption operations runs here, so a rule that must block
-- an owner unlock, such as a freeze, is checked inside the holding's own
-- choice before it calls this body.
holdingOwnerUnlockImpl
  : HoldingOps -> ContractId HoldingV2.Holding -> HoldingV2.HoldingView
  -> Update (ContractId HoldingV2.Holding)
holdingOwnerUnlockImpl ops self holding = do
  lock <- case holding.lock of
    None -> fail "holding is not locked"
    Some l -> pure l
  case lock.expiresAt of
    None -> fail "holding is locked indefinitely and cannot be unlocked by its owner"
    Some expiresAt -> assertDeadlineExceeded "lock expiresAt" expiresAt
  newCid <- ops.createHolding (holding with lock = None)
  emitHoldingsChange ops holding.instrumentId.admin holding.account [] [self] [newCid] []
    "expired lock released by owner"
  pure newCid

-- Consumption
--------------

-- | Consume locked funding to pay it out, through `deliverHolding`, after
-- validating its identity. `context` is the context of the choice the
-- workflow runs in.
consumeLockedHolding
  : HoldingOps -> ChoiceContext -> Party -> HoldingV2.Account -> ContractId HoldingV2.Holding
  -> Update HoldingV2.HoldingView
consumeLockedHolding ops context admin expectedAccount cid =
  ops.deliverHolding context cid >>= checkLockedHolding admin expectedAccount

-- | The identity checks on a consumed locked holding: this admin, the
-- expected account, and a lock.
checkLockedHolding
  : Party -> HoldingV2.Account -> HoldingV2.HoldingView -> Update HoldingV2.HoldingView
checkLockedHolding admin expectedAccount h = do
  require' ("inputHolding.instrumentId.admin", h.instrumentId.admin) isEqualR ("admin", admin)
  require' ("inputHolding.account", h.account) isEqualR ("expectedAccount", expectedAccount)
  require "input holding must be locked" (isSome h.lock)
  pure h

-- | Consume a caller-supplied input holding through `fundHolding` after
-- validating its identity. A holding whose lock has expired is accepted,
-- giving a combined unlock-and-use; unexpired or indefinite locks are
-- rejected. `context` is the context of the choice the workflow runs in.
consumeUnlockedHolding
  : HoldingOps -> ChoiceContext -> Party -> HoldingV2.Account -> ContractId HoldingV2.Holding
  -> Update HoldingV2.HoldingView
consumeUnlockedHolding ops context admin expectedAccount cid = do
  h <- ops.fundHolding context cid
  require' ("inputHolding.instrumentId.admin", h.instrumentId.admin) isEqualR ("admin", admin)
  require' ("inputHolding.account", h.account) isEqualR ("expectedAccount", expectedAccount)
  forA_ h.lock $ \lock -> case lock.expiresAt of
    None -> fail "input holding is locked indefinitely and cannot fund an allocation"
    Some expiresAt -> assertDeadlineExceeded "input holding lock expiresAt" expiresAt
  pure h

-- | Consume input holdings and tally the value they carried per instrument.
debitHoldings
  : (ContractId HoldingV2.Holding -> Update HoldingV2.HoldingView)
  -> [ContractId HoldingV2.Holding]
  -> Update (TextMap.TextMap Decimal)
debitHoldings consume cids = do
  amounts <- forA cids $ \cid -> do
    h <- consume cid
    pure (h.instrumentId.id, h.amount)
  pure (TextMap.fromListWithR (+) amounts)

-- | Release locked holdings back to their account through `returnHolding`,
-- returning the new unlocked holdings keyed by instrument id. `context` is
-- the context of the choice the workflow runs in.
unlockHoldings
  : HoldingOps -> ChoiceContext -> Party -> HoldingV2.Account -> [ContractId HoldingV2.Holding]
  -> Update (TextMap.TextMap [ContractId HoldingV2.Holding])
unlockHoldings ops context admin expectedAccount cids = do
  unlocked <- forA cids $ \cid -> do
    h <- ops.returnHolding context cid >>= checkLockedHolding admin expectedAccount
    newCid <- ops.createHolding (h with lock = None)
    pure (h.instrumentId.id, [newCid])
  pure (TextMap.fromListWithR (++) unlocked)

-- Events and bounds
--------------------

-- | Emit a holdings-change event. `logHoldingsChange` suppresses events that
-- are empty or on special (mint/burn) accounts.
emitHoldingsChange
  : HoldingOps -> Party -> HoldingV2.Account -> [Party]
  -> [ContractId HoldingV2.Holding] -> [ContractId HoldingV2.Holding]
  -> [TransferEventsV2.TransferLegSide] -> Text
  -> Update ()
emitHoldingsChange ops admin account executors inputs outputs legSides reason =
  ops.withEventLog $ \eventLogCid ->
    logHoldingsChange eventLogCid TransferEventsV2.EventLog_HoldingsChange with
      admin
      account
      inputHoldingCids = inputs
      outputHoldingCids = outputs
      transferLegSides = legSides
      observers = eventObserversFor ops admin account <> executors
      extraArgs = ExtraArgs with
        context = emptyChoiceContext
        meta = reasonToMeta reason emptyMetadata

-- | The informees of an event on an account: the account parties plus the
-- owner's extra observers, deduplicated.
eventObserversFor : HoldingOps -> Party -> HoldingV2.Account -> [Party]
eventObserversFor ops admin account =
  dedupSort (accountParties admin account <> ops.eventObservers account)

-- | Storage bound for a pending contract: at most `maxTTL` from now, capped
-- by the workflow deadline, saturating at `maxTime` instead of overflowing.
computeStorageExpiry : RelTime -> Time -> Optional Time -> Time
computeStorageExpiry maxTTL now deadline =
    optional identity min deadline candidate
  where
    candidate
      | maxTime `subTime` now <= maxTTL = maxTime
      | otherwise = now `addRelTime` maxTTL
