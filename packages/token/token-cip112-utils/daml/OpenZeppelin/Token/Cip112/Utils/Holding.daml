{-# LANGUAGE AllowAmbiguousTypes #-}
-- | Holding operations shared by every CIP-0112 workflow.
--
-- This package names no template. Everything that creates, consumes, or
-- emits an event through a contract goes through a `HoldingOps` record the
-- template owner builds inside a choice body. The record holds functions, so
-- it cannot be stored in a contract payload: a template that completes a
-- workflow later (accept, settle, expire) re-supplies its ops when that
-- choice runs.
--
-- Trust boundary: the workflows trust nothing they did not just create. A
-- caller-supplied holding id only ever enters through `consumeHolding`,
-- which must establish that the contract is an accepted implementation
-- before the workflow credits its amount. `consumeByArchive` is the safe
-- default; an interface `fetch` followed by an interface `archive` is not.
module OpenZeppelin.Token.Cip112.Utils.Holding where

import DA.Assert (assertDeadlineExceeded)
import DA.Foldable (forA_)
import DA.List (dedupSort)
import DA.Optional (fromOptional, isNone, isSome)
import DA.TextMap qualified as TextMap
import DA.Time (RelTime, addRelTime, subTime, convertMicrosecondsToRelTime)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.TransferEventsV2 qualified as TransferEventsV2
import Splice.TokenStandard.Utils

import OpenZeppelin.Token.Cip112.TypesV1

-- Registry configuration
--------------------------

-- | The `ensure` predicate of a rules contract holding a `RegistryConfig`.
isValidRegistryConfig : RegistryConfig -> Bool
isValidRegistryConfig c =
  c.maxTTL > convertMicrosecondsToRelTime 0
  && c.lockGrace > convertMicrosecondsToRelTime 0

-- Operations supplied by the template owner
--------------------------------------------

-- | What a workflow needs from the template owner. Not serializable.
--
-- `h` is the owner's per-holding state, typically the consumed template
-- value. The workflows never read it: they take it from `consumeHolding` and
-- hand it back to `createHolding` as the sources of each holding they
-- create. Template fields outside the standard view, such as a tag or an
-- issue date, can therefore carry over when a workflow re-creates a holding.
data HoldingOps h = HoldingOps with
    createHolding : [h] -> HoldingV2.HoldingView -> Update (ContractId HoldingV2.Holding)
      -- ^ Create a holding from its standard view. Law: the created
      -- contract's `Holding` view equals the view argument, and its
      -- signatories include `view.instrumentId.admin` and the account
      -- parties. The first argument lists the states of the new holding's
      -- sources: the holdings consumed in the same step whose value funds
      -- it, all in the view's instrument. In a transfer, the sender's inputs
      -- or locked holdings fund the sender's change, the locked holding, and
      -- the receiver's holding. In an allocation, the authorizer's inputs or
      -- locked holdings fund its locked funds, change, reserve, and payout.
      -- A release or an owner unlock passes the one holding it replaces.
      -- Every holding a step creates in one instrument gets the same list,
      -- in the order the holdings were consumed, whatever its amount. A
      -- source may belong to an account other than the view's, as on a
      -- transfer receiver's holding. The list is empty for a mint and for a
      -- settlement payout funded only by net credit, because the workflow
      -- never names the counterparties' holdings behind that credit. Only
      -- the mint adds supply. State therefore does not follow value through
      -- a settlement: a settlement receiver's payout has no sources, and a
      -- payout that mixes locked funds with net credit names only the
      -- authorizer's holdings. Fields found in neither the view nor the
      -- sources, such as roles, come from the closure that builds the
      -- record.
    consumeHolding : ContractId HoldingV2.Holding -> Update (HoldingV2.HoldingView, h)
      -- ^ Remove a holding from the ledger and return the view and state it
      -- had. Law: fails unless the contract is an accepted implementation.
      -- This is the accepted-implementation policy and the spend hook in one
      -- place: archive by default, or a custom spend choice.
    withEventLog : (ContractId TransferEventsV2.EventLog -> Update ()) -> Update ()
      -- ^ Run one emission against an `EventLog` host. The default templates
      -- supply a transient host created and archived within the transaction.
    eventObservers : HoldingV2.Account -> [Party]
      -- ^ Extra informees of every `EventLog_HoldingsChange` the workflows
      -- emit for the account, added to the account parties and any
      -- executors. An auditor or regulator who must see the standard event
      -- stream, not only the holdings, goes here. `const []` adds nobody.

-- | Consume by archiving, pinned to template `t`: `fetchFromInterface @t`
-- fails on every other implementation, so a foreign `Holding` whose view
-- claims this admin never reaches the workflow's accounting. The state is
-- the archived template value.
consumeByArchive
  : forall t. (HasFromInterface t HoldingV2.Holding, HasToInterface t HoldingV2.Holding, HasArchive t)
  => ContractId HoldingV2.Holding -> Update (HoldingV2.HoldingView, t)
consumeByArchive cid = do
  fetched <- fetchFromInterface @t cid
  case fetched of
    None -> fail "holding is not an accepted implementation"
    Some (tcid, t) -> do
      archive tcid
      pure (view (toInterface @HoldingV2.Holding t), t)

-- Creation-time invariants
---------------------------

-- | The `ensure` predicate of a holding template: positive amount, a regular
-- (owned) account, and no `expiresAfter` lock, whose earlier-of-two-bounds
-- expiry this package does not model.
isValidHoldingView : HoldingV2.HoldingView -> Bool
isValidHoldingView holding =
  holding.amount > 0.0
  && isSome holding.account.owner
  && optional True (isNone . (.expiresAfter)) holding.lock

lockHolders : Optional HoldingV2.Lock -> [Party]
lockHolders lock = case lock of
  None -> []
  Some l -> l.holders

mkHoldingView
  : Party -> HoldingV2.Account -> Text -> Decimal -> Optional HoldingV2.Lock
  -> HoldingV2.HoldingView
mkHoldingView admin account instrumentId amount lock = HoldingV2.HoldingView with
  account
  instrumentId = HoldingV2.InstrumentId with admin; id = instrumentId
  amount
  lock
  meta = emptyMetadata

-- | Create a holding through the owner's constructor, funded by `sources`.
newHolding
  : HoldingOps h -> [h] -> Party -> HoldingV2.Account -> Text -> Decimal -> Optional HoldingV2.Lock
  -> Update (ContractId HoldingV2.Holding)
newHolding ops sources admin account instrumentId amount lock =
  ops.createHolding sources (mkHoldingView admin account instrumentId amount lock)

-- Choice bodies
----------------

-- | Body of a consuming owner-unlock choice on a holding template: the lock
-- has expired, so recreate the holding unlocked and emit an account-local
-- `EventLog_HoldingsChange` naming the consumed holding and its replacement.
-- `self` is the holding being exercised, which the choice itself archives,
-- and `state` is its owner's state, the replacement's only source.
holdingOwnerUnlockImpl
  : HoldingOps h -> ContractId HoldingV2.Holding -> HoldingV2.HoldingView -> h
  -> Update (ContractId HoldingV2.Holding)
holdingOwnerUnlockImpl ops self holding state = do
  lock <- case holding.lock of
    None -> fail "holding is not locked"
    Some l -> pure l
  case lock.expiresAt of
    None -> fail "holding is locked indefinitely and cannot be unlocked by its owner"
    Some expiresAt -> assertDeadlineExceeded "lock expiresAt" expiresAt
  newCid <- ops.createHolding [state] (holding with lock = None)
  emitHoldingsChange ops holding.instrumentId.admin holding.account [] [self] [newCid] []
    "expired lock released by owner"
  pure newCid

-- Consumption
--------------

-- | Consume a locked input holding after validating its identity.
consumeLockedHolding
  : HoldingOps h -> Party -> HoldingV2.Account -> ContractId HoldingV2.Holding
  -> Update (HoldingV2.HoldingView, h)
consumeLockedHolding ops admin expectedAccount cid = do
  (h, state) <- ops.consumeHolding cid
  require' ("inputHolding.instrumentId.admin", h.instrumentId.admin) isEqualR ("admin", admin)
  require' ("inputHolding.account", h.account) isEqualR ("expectedAccount", expectedAccount)
  require "input holding must be locked" (isSome h.lock)
  pure (h, state)

-- | Consume an unlocked input holding after validating its identity. A
-- holding whose lock has expired is accepted, giving a combined
-- unlock-and-use; unexpired or indefinite locks are rejected.
consumeUnlockedHolding
  : HoldingOps h -> Party -> HoldingV2.Account -> ContractId HoldingV2.Holding
  -> Update (HoldingV2.HoldingView, h)
consumeUnlockedHolding ops admin expectedAccount cid = do
  (h, state) <- ops.consumeHolding cid
  require' ("inputHolding.instrumentId.admin", h.instrumentId.admin) isEqualR ("admin", admin)
  require' ("inputHolding.account", h.account) isEqualR ("expectedAccount", expectedAccount)
  forA_ h.lock $ \lock -> case lock.expiresAt of
    None -> fail "input holding is locked indefinitely and cannot fund an allocation"
    Some expiresAt -> assertDeadlineExceeded "input holding lock expiresAt" expiresAt
  pure (h, state)

-- | Consume input holdings and tally, per instrument, the value they carried
-- and their states.
debitHoldings
  : (ContractId HoldingV2.Holding -> Update (HoldingV2.HoldingView, h))
  -> [ContractId HoldingV2.Holding]
  -> Update (TextMap.TextMap Decimal, TextMap.TextMap [h])
debitHoldings consume cids = do
  consumed <- forA cids consume
  pure
    ( TextMap.fromListWithR (+) [(h.instrumentId.id, h.amount) | (h, _) <- consumed]
    , TextMap.fromListWithR (++) [(h.instrumentId.id, [state]) | (h, state) <- consumed]
    )

-- | The states `debitHoldings` tallied for one instrument.
sourcesFor : Text -> TextMap.TextMap [h] -> [h]
sourcesFor instrumentId sources = fromOptional [] (TextMap.lookup instrumentId sources)

-- | Release locked holdings back to their account, returning the new unlocked
-- holdings keyed by instrument id.
unlockHoldings
  : HoldingOps h -> Party -> HoldingV2.Account -> [ContractId HoldingV2.Holding]
  -> Update (TextMap.TextMap [ContractId HoldingV2.Holding])
unlockHoldings ops admin expectedAccount cids = do
  unlocked <- forA cids $ \cid -> do
    (h, state) <- consumeLockedHolding ops admin expectedAccount cid
    newCid <- ops.createHolding [state] (h with lock = None)
    pure (h.instrumentId.id, [newCid])
  pure (TextMap.fromListWithR (++) unlocked)

-- Events and bounds
--------------------

-- | Emit a holdings-change event. `logHoldingsChange` suppresses events that
-- are empty or on special (mint/burn) accounts.
emitHoldingsChange
  : HoldingOps h -> Party -> HoldingV2.Account -> [Party]
  -> [ContractId HoldingV2.Holding] -> [ContractId HoldingV2.Holding]
  -> [TransferEventsV2.TransferLegSide] -> Text
  -> Update ()
emitHoldingsChange ops admin account executors inputs outputs legSides reason =
  ops.withEventLog $ \eventLogCid ->
    logHoldingsChange eventLogCid TransferEventsV2.EventLog_HoldingsChange with
      admin
      account
      inputHoldingCids = inputs
      outputHoldingCids = outputs
      transferLegSides = legSides
      observers = eventObserversFor ops admin account <> executors
      extraArgs = ExtraArgs with
        context = emptyChoiceContext
        meta = reasonToMeta reason emptyMetadata

-- | The informees of an event on an account: the account parties plus the
-- owner's extra observers, deduplicated.
eventObserversFor : HoldingOps h -> Party -> HoldingV2.Account -> [Party]
eventObserversFor ops admin account =
  dedupSort (accountParties admin account <> ops.eventObservers account)

-- | Storage bound for a pending contract: at most `maxTTL` from now, capped
-- by the workflow deadline, saturating at `maxTime` instead of overflowing.
computeStorageExpiry : RelTime -> Time -> Optional Time -> Time
computeStorageExpiry maxTTL now deadline =
    optional identity min deadline candidate
  where
    candidate
      | maxTime `subTime` now <= maxTTL = maxTime
      | otherwise = now `addRelTime` maxTTL
