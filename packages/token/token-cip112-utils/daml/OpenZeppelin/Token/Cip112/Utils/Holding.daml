{-# LANGUAGE AllowAmbiguousTypes #-}
-- | Holding operations shared by every CIP-0112 workflow.
--
-- This package names no template. Everything that creates, consumes, or
-- emits an event through a contract goes through a `HoldingOps` record the
-- template owner builds inside a choice body. The record holds functions, so
-- it cannot be stored in a contract payload: a template that completes a
-- workflow later (accept, settle, expire) re-supplies its ops when that
-- choice runs.
--
-- Trust boundary: the workflows trust nothing they did not just create. A
-- caller-supplied holding id only ever enters through `fundHolding`, and the
-- workflows consume the funding they locked through `deliverHolding` or
-- `returnHolding`. Each must establish that the contract is an accepted
-- implementation before the workflow credits its amount. `consumeByArchive`
-- is the safe default; an interface `fetch` followed by an interface
-- `archive` is not.
module OpenZeppelin.Token.Cip112.Utils.Holding where

import DA.Assert (assertDeadlineExceeded)
import DA.Foldable (forA_)
import DA.List (dedupSort)
import DA.Optional (fromOptional, isNone, isSome)
import DA.TextMap qualified as TextMap
import DA.Time (RelTime, addRelTime, subTime, convertMicrosecondsToRelTime)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.TransferEventsV2 qualified as TransferEventsV2
import Splice.TokenStandard.Utils

import OpenZeppelin.Token.Cip112.TypesV1

-- Registry configuration
--------------------------

-- | The `ensure` predicate of a rules contract holding a `RegistryConfig`.
isValidRegistryConfig : RegistryConfig -> Bool
isValidRegistryConfig c =
  c.maxTTL > convertMicrosecondsToRelTime 0
  && c.lockGrace > convertMicrosecondsToRelTime 0

-- Operations supplied by the template owner
--------------------------------------------

-- | What a workflow needs from the template owner. Not serializable.
--
-- `h` is the owner's per-holding state, usually the holding template.
--
-- A refusal in `deliverHolding` or `returnHolding` leaves the other's paths
-- open, and a refusal in both holds the locked funds until the lock
-- expires. Put a rule in either only if a known party can lift it without
-- re-creating the locked holding, such as a compliance officer lifting a
-- freeze kept on a separate per-account contract. A pending instruction or
-- allocation names its locked holdings by id, so keep a holding's contract
-- id until its lock expires.
--
-- Keep a restriction that must hold while funds are in flight, such as a
-- compliance freeze, on a separate per-account contract. A field set on the
-- account's unlocked holdings is missing from the funds already locked and
-- from the funds the account receives, because neither has those holdings
-- as a source.
--
-- A rule that tracks live registry state reads the current policy contract
-- from the context, and the operation checks the contract it fetches: its
-- template, its signatories, and that it covers this holding's admin and
-- account. The submitter writes the context, so the operation fails when
-- the entry is missing, and the contract's presence is what permits the
-- spend: a context cannot show that a contract is absent. The submitter
-- also chooses which contract to pass, so the registry keeps one live
-- policy contract for each admin and account.
data HoldingOps h = HoldingOps with
    createHolding : [h] -> HoldingV2.HoldingView -> Update (ContractId HoldingV2.Holding)
      -- ^ Create a holding from its sources and its standard view. The
      -- sources are the states of the holdings consumed in the same step
      -- whose value funds the new one, all in the view's instrument, in the
      -- order they were consumed. Receives each source as `fundHolding`,
      -- `deliverHolding`, or `returnHolding` returned it, or as the
      -- owner-unlock choice passed it, then creates a contract whose
      -- `Holding` view equals the view argument and whose signatories
      -- include `view.instrumentId.admin` and the account parties. A
      -- transfer's inputs fund the sender's change, the locked funding of a
      -- pending transfer, and the receiver's holding of a one-step transfer.
      -- An accept's locked funding funds the surplus returned to the sender
      -- and the receiver's holding. An allocation's inputs fund its locked
      -- funding and the change. A settlement passes only its locked funding
      -- to the next-iteration reserve and the authorizer's payout, so state
      -- follows value through a transfer but not through a settlement. A
      -- reject, withdraw, expiry, cancel, or owner unlock passes only the
      -- locked holding the new holding replaces. A minted holding, and a
      -- settlement's reserve or payout in an instrument without locked
      -- funding, have no sources. A template field outside the view survives
      -- re-creation only if this operation derives it from the sources.
      -- Every other field resets to the closure's value. The holdings a
      -- factory, accept, or settlement creates in one instrument all get the
      -- same sources, whatever their amounts, and the submitter orders a
      -- factory's inputs. Derive a field as the sources' most restrictive
      -- value, such as the latest issue date, not the first source's or a
      -- sum. A transfer receiver's sources belong to the sender, so compare
      -- each source's account with the view's before carrying a field
      -- between accounts.
    fundHolding : ChoiceContext -> ContractId HoldingV2.Holding -> Update (HoldingV2.HoldingView, h)
      -- ^ Consume a caller-supplied input holding that funds a new transfer
      -- or allocation, through `consumeUnlockedHolding`: the inputs of
      -- `transferFactoryImpl` and `executeTransfer`, including a one-step
      -- transfer and a burn, and of `allocationFactoryImpl`. Fails unless the
      -- contract is an accepted implementation, then removes the holding from
      -- the ledger and returns the view and state it had. An input may be a
      -- holding whose lock has expired, such as the funding of an instruction
      -- or allocation that never completed, so a rule that must hold locked
      -- funds after the lock expires is also checked here. Put a rule that
      -- only stops new spending, such as a minimum holding age, here.
    deliverHolding : ChoiceContext -> ContractId HoldingV2.Holding -> Update (HoldingV2.HoldingView, h)
      -- ^ Consume locked funding to pay it out, through
      -- `consumeLockedHolding`: `transferAcceptImpl`, including the admin's
      -- accept of a burn request, and `allocationSettleImpl`. Both consume
      -- all of the locked funding here, including any part that stays with
      -- its owner: an accept's surplus, a settlement's payout to the
      -- authorizer, and a reserve rolled into the next iteration. Fails
      -- unless the contract is an accepted implementation, then removes the
      -- holding from the ledger and returns the view and state it had.
      -- `settleBatchImpl` passes each `Allocation_Settle` an empty context,
      -- so a rule that requires a context entry refuses every batch
      -- settlement.
    returnHolding : ChoiceContext -> ContractId HoldingV2.Holding -> Update (HoldingV2.HoldingView, h)
      -- ^ Consume locked funding to return it to its owner, through
      -- `unlockHoldings`: `transferRejectImpl`, `transferWithdrawImpl`,
      -- `transferExpireImpl`, `allocationWithdrawImpl`, and
      -- `allocationCancelImpl`. Fails unless the contract is an accepted
      -- implementation, then removes the holding from the ledger and returns
      -- the view and state it had.
    withEventLog : (ContractId TransferEventsV2.EventLog -> Update ()) -> Update ()
      -- ^ Run one emission against an `EventLog` host. The default templates
      -- supply a transient host created and archived within the transaction.
    eventObservers : HoldingV2.Account -> [Party]
      -- ^ Extra informees of every `EventLog_HoldingsChange` the workflows
      -- emit for the account, added to the account parties and any
      -- executors. An auditor or regulator who must see the standard event
      -- stream, not only the holdings, goes here. `const []` adds nobody.
      -- Every party listed must stay hosted with the packages vetted, or
      -- each workflow that emits for the account fails, owner unlock
      -- included.

-- | Consume by archiving, pinned to template `t`: `fetchFromInterface @t`
-- fails on every other implementation, so a foreign `Holding` whose view
-- claims this admin never reaches the workflow's accounting. The state is
-- the archived template value.
consumeByArchive
  : forall t. (HasFromInterface t HoldingV2.Holding, HasToInterface t HoldingV2.Holding, HasArchive t)
  => ContractId HoldingV2.Holding -> Update (HoldingV2.HoldingView, t)
consumeByArchive cid = do
  fetched <- fetchFromInterface @t cid
  case fetched of
    None -> fail "holding is not an accepted implementation"
    Some (tcid, t) -> do
      archive tcid
      pure (view (toInterface @HoldingV2.Holding t), t)

-- | Build an operations record from `createHolding`, `withEventLog`, and
-- `eventObservers`, with `consumeByArchive @t` as all three consumption
-- operations. Override one of them with `with` to add a rule to its paths.
holdingOpsFor
  : forall t. (HasFromInterface t HoldingV2.Holding, HasToInterface t HoldingV2.Holding, HasArchive t)
  => ([t] -> HoldingV2.HoldingView -> Update (ContractId HoldingV2.Holding))
  -> ((ContractId TransferEventsV2.EventLog -> Update ()) -> Update ())
  -> (HoldingV2.Account -> [Party])
  -> HoldingOps t
holdingOpsFor createHolding withEventLog eventObservers = HoldingOps with
  createHolding
  fundHolding = \_ -> consumeByArchive @t
  deliverHolding = \_ -> consumeByArchive @t
  returnHolding = \_ -> consumeByArchive @t
  withEventLog
  eventObservers

-- Creation-time invariants
---------------------------

-- | The `ensure` predicate of a holding template: positive amount, a regular
-- (owned) account, and no `expiresAfter` lock, whose earlier-of-two-bounds
-- expiry this package does not model.
isValidHoldingView : HoldingV2.HoldingView -> Bool
isValidHoldingView holding =
  holding.amount > 0.0
  && isSome holding.account.owner
  && optional True (isNone . (.expiresAfter)) holding.lock

lockHolders : Optional HoldingV2.Lock -> [Party]
lockHolders lock = case lock of
  None -> []
  Some l -> l.holders

mkHoldingView
  : Party -> HoldingV2.Account -> Text -> Decimal -> Optional HoldingV2.Lock
  -> HoldingV2.HoldingView
mkHoldingView admin account instrumentId amount lock = HoldingV2.HoldingView with
  account
  instrumentId = HoldingV2.InstrumentId with admin; id = instrumentId
  amount
  lock
  meta = emptyMetadata

-- | Create a holding through the owner's constructor, funded by `sources`.
newHolding
  : HoldingOps h -> [h] -> Party -> HoldingV2.Account -> Text -> Decimal -> Optional HoldingV2.Lock
  -> Update (ContractId HoldingV2.Holding)
newHolding ops sources admin account instrumentId amount lock =
  ops.createHolding sources (mkHoldingView admin account instrumentId amount lock)

-- Choice bodies
----------------

-- | Body of a consuming owner-unlock choice on a holding template: the lock
-- has expired, so recreate the holding unlocked and emit an account-local
-- `EventLog_HoldingsChange` naming the consumed holding and its replacement.
-- `self` is the holding being exercised, which the choice itself archives,
-- and `state` is that holding's state, the replacement's only source.
--
-- Check a rule that must block an owner unlock, such as a freeze, in the
-- holding's choice before it calls this body. Otherwise the owner can
-- unlock a frozen holding once its lock expires.
holdingOwnerUnlockImpl
  : HoldingOps h -> ContractId HoldingV2.Holding -> HoldingV2.HoldingView -> h
  -> Update (ContractId HoldingV2.Holding)
holdingOwnerUnlockImpl ops self holding state = do
  lock <- case holding.lock of
    None -> fail "holding is not locked"
    Some l -> pure l
  case lock.expiresAt of
    None -> fail "holding is locked indefinitely and cannot be unlocked by its owner"
    Some expiresAt -> assertDeadlineExceeded "lock expiresAt" expiresAt
  newCid <- ops.createHolding [state] (holding with lock = None)
  emitHoldingsChange ops holding.instrumentId.admin holding.account [] [self] [newCid] []
    "expired lock released by owner"
  pure newCid

-- Consumption
--------------

-- | Consume locked funding through `deliverHolding` to pay it out, then
-- check its admin, its account, and that it is locked. `context` is the
-- context of the choice the workflow runs in.
consumeLockedHolding
  : HoldingOps h -> ChoiceContext -> Party -> HoldingV2.Account -> ContractId HoldingV2.Holding
  -> Update (HoldingV2.HoldingView, h)
consumeLockedHolding ops context admin expectedAccount cid =
  ops.deliverHolding context cid >>= checkLockedHolding admin expectedAccount

-- | The identity checks on a consumed locked holding: this admin, the
-- expected account, and a lock.
checkLockedHolding
  : Party -> HoldingV2.Account -> (HoldingV2.HoldingView, h) -> Update (HoldingV2.HoldingView, h)
checkLockedHolding admin expectedAccount consumed@(h, _) = do
  require' ("inputHolding.instrumentId.admin", h.instrumentId.admin) isEqualR ("admin", admin)
  require' ("inputHolding.account", h.account) isEqualR ("expectedAccount", expectedAccount)
  require "input holding must be locked" (isSome h.lock)
  pure consumed

-- | Consume a caller-supplied input holding through `fundHolding`, then
-- check its admin and account. A holding whose lock has expired is
-- accepted, giving a combined unlock-and-use; unexpired or indefinite locks
-- are rejected. `context` is the context of the choice the workflow runs in.
consumeUnlockedHolding
  : HoldingOps h -> ChoiceContext -> Party -> HoldingV2.Account -> ContractId HoldingV2.Holding
  -> Update (HoldingV2.HoldingView, h)
consumeUnlockedHolding ops context admin expectedAccount cid = do
  consumed@(h, _) <- ops.fundHolding context cid
  require' ("inputHolding.instrumentId.admin", h.instrumentId.admin) isEqualR ("admin", admin)
  require' ("inputHolding.account", h.account) isEqualR ("expectedAccount", expectedAccount)
  forA_ h.lock $ \lock -> case lock.expiresAt of
    None -> fail "input holding is locked indefinitely and cannot fund an allocation"
    Some expiresAt -> assertDeadlineExceeded "input holding lock expiresAt" expiresAt
  pure consumed

-- | Consume input holdings and tally, per instrument, the value they carried
-- and their states in the order they were consumed.
debitHoldings
  : (ContractId HoldingV2.Holding -> Update (HoldingV2.HoldingView, h))
  -> [ContractId HoldingV2.Holding]
  -> Update (TextMap.TextMap Decimal, TextMap.TextMap [h])
debitHoldings consume cids = do
  consumed <- forA cids consume
  pure
    ( TextMap.fromListWithR (+) [(h.instrumentId.id, h.amount) | (h, _) <- consumed]
      -- `fromListWithL (++)` prepends each state, so reversing once restores
      -- the consumption order in linear time.
    , reverse <$> TextMap.fromListWithL (++) [(h.instrumentId.id, [state]) | (h, state) <- consumed]
    )

-- | Look up the states `debitHoldings` tallied for one instrument, or `[]`
-- when the step consumed nothing in it.
sourcesFor : Text -> TextMap.TextMap [h] -> [h]
sourcesFor instrumentId sources = fromOptional [] (TextMap.lookup instrumentId sources)

-- | Release locked holdings back to their account through `returnHolding`,
-- returning the new unlocked holdings keyed by instrument id. Each
-- replacement's only source is the holding it replaces. `context` is the
-- context of the choice the workflow runs in.
unlockHoldings
  : HoldingOps h -> ChoiceContext -> Party -> HoldingV2.Account -> [ContractId HoldingV2.Holding]
  -> Update (TextMap.TextMap [ContractId HoldingV2.Holding])
unlockHoldings ops context admin expectedAccount cids = do
  unlocked <- forA cids $ \cid -> do
    (h, state) <- ops.returnHolding context cid >>= checkLockedHolding admin expectedAccount
    newCid <- ops.createHolding [state] (h with lock = None)
    pure (h.instrumentId.id, [newCid])
  pure (TextMap.fromListWithR (++) unlocked)

-- Events and bounds
--------------------

-- | Emit a holdings-change event. `logHoldingsChange` suppresses events that
-- are empty or on special (mint/burn) accounts.
emitHoldingsChange
  : HoldingOps h -> Party -> HoldingV2.Account -> [Party]
  -> [ContractId HoldingV2.Holding] -> [ContractId HoldingV2.Holding]
  -> [TransferEventsV2.TransferLegSide] -> Text
  -> Update ()
emitHoldingsChange ops admin account executors inputs outputs legSides reason =
  ops.withEventLog $ \eventLogCid ->
    logHoldingsChange eventLogCid TransferEventsV2.EventLog_HoldingsChange with
      admin
      account
      inputHoldingCids = inputs
      outputHoldingCids = outputs
      transferLegSides = legSides
      observers = eventObserversFor ops admin account <> executors
      extraArgs = ExtraArgs with
        context = emptyChoiceContext
        meta = reasonToMeta reason emptyMetadata

-- | The informees of an event on an account: the account parties plus the
-- owner's extra observers, deduplicated.
eventObserversFor : HoldingOps h -> Party -> HoldingV2.Account -> [Party]
eventObserversFor ops admin account =
  dedupSort (accountParties admin account <> ops.eventObservers account)

-- | Storage bound for a pending contract: at most `maxTTL` from now, capped
-- by the workflow deadline, saturating at `maxTime` instead of overflowing.
computeStorageExpiry : RelTime -> Time -> Optional Time -> Time
computeStorageExpiry maxTTL now deadline =
    optional identity min deadline candidate
  where
    candidate
      | maxTime `subTime` now <= maxTTL = maxTime
      | otherwise = now `addRelTime` maxTTL
