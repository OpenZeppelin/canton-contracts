-- | Registry workflow: the settlement-factory body and the admin supply and
-- cleanup operations a rules contract exposes as choices.
module OpenZeppelin.TokenCIP112WorkflowsV1.Registry where

import DA.Assert (assertDeadlineExceeded)
import DA.Foldable (forA_)
import DA.Optional (isNone, isSome)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.TokenStandard.Utils

import OpenZeppelin.TokenCIP112WorkflowsV1.Holding
import OpenZeppelin.TokenCIP112WorkflowsV1.Allocation

-- | `settlementFactory_settleBatchImpl`: pin every allocation to an accepted
-- implementation, then run the vendored exact-cover settlement. The batch's
-- choice context is redacted from what the authorizers witness.
--
-- The vendored default validates each `FinalizedAllocation`'s extra legs but
-- not its `nextIterationFunding`; the `validateNextIterationArgs` call in
-- `allocationSettleImpl` is the effective guard for that field.
settleBatchImpl
  : PinAllocation -> Party -> ContractId AllocationV2.SettlementFactory
  -> AllocationV2.SettlementFactory_SettleBatch
  -> Update AllocationV2.SettlementFactory_SettleBatchResult
settleBatchImpl pin admin self arg = do
  require "a settlement batch must cover at least one transfer leg"
    (not (null arg.transferLegs))
  let perAllocationExtraArgs _allocView _settleArg = pure ExtraArgs with
        context = emptyChoiceContext
        meta = arg.extraArgs.meta
  forA_ arg.allocations $ \finalizedAlloc -> pin finalizedAlloc.allocationCid
  settlementFactoryV2_settleBatchDefaultImpl perAllocationExtraArgs admin self arg

-- | Body of a batched admin-expiry choice: each allocation is pinned, and
-- actors, admin, and expiry are re-verified per allocation independently of
-- the cancel implementation.
expireAllocationsImpl
  : PinAllocation -> Party
  -> [(ContractId AllocationV2.Allocation, AllocationV2.Allocation_Cancel)]
  -> Update ()
expireAllocationsImpl pin admin cancelArgs =
  forA_ cancelArgs $ \(allocCid, cancelArg) -> do
    requireMatchExpected ("cancelArg.actors", cancelArg.actors) [admin]
    v <- pin allocCid
    requireMatchExpected ("allocation.admin", v.allocation.admin) admin
    case v.expiresAt of
      None -> fail "cannot expire an allocation without an expiry time"
      Some t -> assertDeadlineExceeded "allocation.expiresAt" t
    _ <- exercise allocCid cancelArg
    pure ()

-- | Body of a mint choice controlled by the admin and the account parties:
-- issue a holding and emit the standard mint event.
mintImpl
  : HoldingOps -> Party -> HoldingV2.Account -> Text -> Decimal -> Text
  -> Update (ContractId HoldingV2.Holding)
mintImpl ops admin account instrumentId amount reason = do
  require "mint amount must be positive" (amount > 0.0)
  require "mint target must be a regular account" (isSome account.owner)
  holdingCid <- newHolding ops admin account instrumentId amount None
  ops.withEventLog $ \eventLogCid ->
    logMintEvent ops eventLogCid account amount
      (HoldingV2.InstrumentId with admin; id = instrumentId)
      (reasonToMeta reason emptyMetadata)
      [holdingCid]
  pure holdingCid

-- | Body of a burn choice controlled by the admin and the account parties:
-- consume an unlocked holding and emit the standard burn event. The account
-- is a choice argument because the controller set has to be known before
-- the holding can be read; it is then checked against the holding itself.
burnImpl
  : HoldingOps -> Party -> ContractId HoldingV2.Holding -> HoldingV2.Account -> Text
  -> Update ()
burnImpl ops admin holdingCid account reason = do
  h <- ops.consumeHolding holdingCid
  requireMatchExpected ("holding.instrumentId.admin", h.instrumentId.admin) admin
  requireMatchExpected ("holding.account", h.account) account
  require "cannot burn a locked holding" (isNone h.lock)
  ops.withEventLog $ \eventLogCid ->
    logBurnEvent ops eventLogCid h.account h.amount h.instrumentId
      (reasonToMeta reason emptyMetadata)
      [holdingCid]
