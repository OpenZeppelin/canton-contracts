-- | A resource-scoped authorization credential for Canton applications.
-- Protected choices bind the actor as controller and derive requirements from trusted state.
module OpenZeppelin.ScopedAuthorizationGrantV1
  ( AuthorizationScope(..)
  , AuthorizationRequirement(..)
  , HasAuthorizationPolicy(..)
  , AuthorizationGrant(..)
  , AuthorizationGrant_Use(..)
  , AuthorizationGrant_Revoke(..)
  , AuthorizationGrant_Renounce(..)
  , Authorization(..)
  , checkAuthorization
  , requireAuthorization
  , checkPermission
  , requirePermission
  , requireAuthorityOrGrant
  , authorizationContextKey
  ) where

import qualified DA.Fail as Fail
import qualified OpenZeppelin.ScopedAuthorizationGrantV1.Internal as Internal

-- | The resource and permission a grant covers. Every field matches exactly.
-- `resourceInstanceCid` can bind one contract instance. Epoch-based invalidation
-- requires increasing the expected `policyEpoch` without reusing earlier values.
data AuthorizationScope = AuthorizationScope with
    namespace : Text
    resourceType : Text
    resourceId : Text
    permission : Text
    policyEpoch : Int
      -- ^ Nonnegative policy version.
    resourceInstanceCid : Optional (ContractId ())
      -- ^ `Some` binds the scope to one contract; `None` uses logical identity only.
  deriving (Eq, Show, Serializable)

-- | Expected policy, derived from protected state rather than caller input.
data AuthorizationRequirement = AuthorizationRequirement with
    expectedAuthority : Party
    expectedScope : AuthorizationScope
  deriving (Eq, Show)

-- | Derive a requirement from a resource and an application-defined permission.
-- Use trusted state with its matching contract ID; the class does not fetch or authenticate it.
class HasAuthorizationPolicy resource permission where
  authorizationRequirement
    : resource -> ContractId resource -> permission -> AuthorizationRequirement

-- | Apply the resource's policy through `checkAuthorization`, without recording use.
-- Returns the grant or first mismatch; fetch failures still abort.
-- Pass trusted state and its ID. Protected choices must require the actor's authority.
checkPermission
  : HasAuthorizationPolicy resource permission
  => resource
  -> ContractId resource
  -> permission
  -> Authorization
  -> Update (Either Fail.FailureStatus AuthorizationGrant)
checkPermission resource cid permission authorization =
  checkAuthorization authorization (authorizationRequirement resource cid permission)

-- | Apply the resource's policy through `requireAuthorization`.
-- Pass `this`/`self` or fetched state with its ID, and a permission selected by the choice.
-- The protected choice must make `authorization.actor` a controller.
requirePermission
  : HasAuthorizationPolicy resource permission
  => resource
  -> ContractId resource
  -> permission
  -> Authorization
  -> Update AuthorizationGrant
requirePermission resource cid permission authorization =
  requireAuthorization authorization (authorizationRequirement resource cid permission)

-- | An authority-signed permission for one grantee and exact scope.
-- The authority signs and revokes; the grantee observes, records use, or renounces.
-- Use preserves the grant; revoke, renounce, and the authority's Archive consume it.
-- Other readers need disclosure. Creation requires a nonnegative epoch and
-- a well-formed validity window.
-- Consumers must bind the actor and derive trusted policy; see the package README.
-- Validity bounds use ledger time, subject to synchronizer record-time tolerance.
-- Unreleased 0.x API; no upgrade compatibility baseline is published.
template AuthorizationGrant
  with
    authority : Party
    grantee : Party
    scope : AuthorizationScope
    validFrom : Optional Time
      -- ^ Inclusive lower ledger-time bound, or unbounded when `None`.
    validUntil : Optional Time
      -- ^ Exclusive upper ledger-time bound, or unbounded when `None`.
  where
    ensure scope.policyEpoch >= 0
      && Internal.validityWindowIsWellFormed validFrom validUntil
    signatory authority
    observer grantee

    -- Records use within the validity window without consuming the grant.
    -- Actor and policy matching belong to `requireAuthorization`;
    -- this event alone does not prove a protected effect.
    nonconsuming choice AuthorizationGrant_Use : ()
      controller grantee
      do
        result <- Internal.checkValidityWindow validFrom validUntil
        Internal.requireSuccess result

    choice AuthorizationGrant_Revoke : ()
      controller authority
      do pure ()

    choice AuthorizationGrant_Renounce : ()
      controller grantee
      do pure ()

-- | Inputs presented to a protected choice. The choice makes `actor` its
-- controller; validation binds the fetched grant's grantee to that actor.
data Authorization = Authorization with
    actor : Party
    grantCid : ContractId AuthorizationGrant
  deriving (Eq, Show, Serializable)

-- | Check the grant's actor, authority, scope, and validity window without recording use.
-- Returns the fetched grant or the first mismatch. Unavailable or archived grants abort on fetch.
-- The protected choice must require the actor's authority and derive trusted policy.
checkAuthorization
  : Authorization
  -> AuthorizationRequirement
  -> Update (Either Fail.FailureStatus AuthorizationGrant)
checkAuthorization authorization requirement = do
  grant <- fetch authorization.grantCid
  case checkGrantMatches authorization.actor requirement grant of
    Left status -> pure (Left status)
    Right () -> do
      validity <- Internal.checkValidityWindow grant.validFrom grant.validUntil
      pure (grant <$ validity)

-- | Validate and return the fetched grant after exercising Use.
-- Call on the protected operation's committed path; a caught exception can roll back the event.
-- Every success records Use. If the expected authority must also act without a grant,
-- use `requireAuthorityOrGrant`.
requireAuthorization : Authorization -> AuthorizationRequirement -> Update AuthorizationGrant
requireAuthorization authorization requirement = do
  grant <- fetch authorization.grantCid
  Internal.requireSuccess (checkGrantMatches authorization.actor requirement grant)
  exercise authorization.grantCid AuthorizationGrant_Use
  pure grant

-- | Accept the expected authority acting directly, or validate a presented grant.
-- Without a grant, `actor` must be the expected authority; no fetch or Use occurs.
-- A presented grant goes through `requireAuthorization`, even when the actor is the authority.
-- The protected choice must make `actor` a controller and derive trusted policy.
requireAuthorityOrGrant
  : Party
  -> Optional (ContractId AuthorizationGrant)
  -> AuthorizationRequirement
  -> Update (Optional AuthorizationGrant)
requireAuthorityOrGrant actor presentedGrant requirement = case presentedGrant of
  None -> do
    Internal.requireSuccess $ Internal.checkCondition
      (Internal.grantRequired requirement.expectedAuthority actor)
      (actor == requirement.expectedAuthority)
    pure None
  Some grantCid ->
    Some <$> requireAuthorization (Authorization with actor; grantCid) requirement

checkGrantMatches
  : Party -> AuthorizationRequirement -> AuthorizationGrant -> Either Fail.FailureStatus ()
checkGrantMatches actor requirement grant = do
  Internal.checkCondition
    (Internal.authorityMismatch requirement.expectedAuthority grant.authority)
    (grant.authority == requirement.expectedAuthority)
  Internal.checkCondition
    (Internal.granteeMismatch actor grant.grantee)
    (grant.grantee == actor)
  Internal.checkCondition
    (Internal.scopeMismatch
      [ ("namespace", grant.scope.namespace == requirement.expectedScope.namespace)
      , ("resourceType", grant.scope.resourceType == requirement.expectedScope.resourceType)
      , ("resourceId", grant.scope.resourceId == requirement.expectedScope.resourceId)
      , ("permission", grant.scope.permission == requirement.expectedScope.permission)
      , ("policyEpoch", grant.scope.policyEpoch == requirement.expectedScope.policyEpoch)
      , ("resourceInstanceCid", grant.scope.resourceInstanceCid == requirement.expectedScope.resourceInstanceCid)
      ])
    (grant.scope == requirement.expectedScope)

-- | Key for a grant contract ID in an extensible choice context, such as a
-- Splice `ChoiceContext`. The value is caller input: convert it to
-- `ContractId AuthorizationGrant` and validate it through a guard.
authorizationContextKey : Text
authorizationContextKey = "openzeppelin.com/scoped-authorization-grant"
