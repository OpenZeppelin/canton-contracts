-- | Tests for the CIP-0112 token package (packages/token/token-cip112-v1),
-- driven through the standard interfaces. Scenario setup and
-- interface-driving helpers live in `OpenZeppelin.Token.Cip112.V1.Test.Fixtures`.
module OpenZeppelin.Token.Cip112.V1.Test where

import DA.Assert ((===), (=/=))
import DA.Date (date, Month(Jan))
import DA.Foldable (forA_)
import DA.List (sort)
import DA.Time (addRelTime, days, hours, minutes, time)
import Daml.Script

import DA.Map qualified as Map
import DA.Optional (isSome)
import DA.TextMap qualified as TextMap

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.Api.Token.AllocationInstructionV2 qualified as AllocationInstructionV2
import Splice.Api.Token.TransferEventsV2 qualified as TransferEventsV2
import Splice.Api.Token.TransferInstructionV2 qualified as TransferInstructionV2
import Splice.TokenStandard.Utils (basicAccount, burnAccount, mintAccount, reasonFromMeta, reasonToMeta, senderSide, receiverSide, nonIteratedAllocation)

import OpenZeppelin.Token.Cip112.TypesV1 (RegistryConfig(..))
import OpenZeppelin.Token.Cip112.V1.Allocation
import OpenZeppelin.Token.Cip112.V1.Holding
import OpenZeppelin.Token.Cip112.V1.Registry
import OpenZeppelin.Token.Cip112.V1.Transfer
import OpenZeppelin.Token.Cip112.V1.Test.ForeignAllocation (mustFailWith)
import OpenZeppelin.Token.Cip112.V1.Test.Fixtures

-- | Happy path: two-leg DvP with net funding. Alice sends 10 and receives 4,
-- so only 6 is locked; Bob nets +6 and locks nothing. After settlement Alice
-- holds her 4.0 change and Bob holds 6.0.
testNetSettlementHappyPath : Script ()
testNetSettlementHappyPath = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0

  aliceResult <- allocate s alice [senderSide legAliceToBob, receiverSide legBobToAlice] [aliceInput]
  aliceAllocCid <- completedCid aliceResult
  -- Net funding: 6.0 locked, 4.0 returned as change.
  aliceHoldings <- query @TokenHolding alice
  sort [h.holding.amount | (_, h) <- aliceHoldings] === [4.0, 6.0]

  bobResult <- allocate s bob [receiverSide legAliceToBob, senderSide legBobToAlice] []
  bobAllocCid <- completedCid bobResult

  _ <- settleBatch s [legAliceToBob, legBobToAlice] [aliceAllocCid, bobAllocCid] emptyExtraArgs

  aliceAfter <- holdingAmounts alice
  aliceAfter === [4.0]
  bobAfter <- holdingAmounts bob
  bobAfter === [6.0]

-- | Conservation: a sender whose inputs do not cover the net debit fails
-- closed at allocation time.
testUnderfundedSenderFails : Script ()
testUnderfundedSenderFails = do
  s@Scenario{..} <- setup
  smallInput <- mint admin alice 5.0
  submitMustFail (actAs alice <> discloseMany [rulesDisclosure]) do
    exerciseCmd (toInterfaceContractId @AllocationInstructionV2.AllocationFactory rulesCid)
      AllocationInstructionV2.AllocationFactory_Allocate with
        settlement
        allocation = mkAllocationSpec admin alice [senderSide legAliceToBob]
        requestedAt = t0
        inputHoldingCids = [toInterfaceContractId @HoldingV2.Holding smallInput]
        extraArgs = emptyExtraArgs
        actors = [alice]

-- | Exact cover: a batch that presents the legs but is missing the
-- counterparty's allocation is rejected.
testMissingAuthorizationFails : Script ()
testMissingAuthorizationFails = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  aliceResult <- allocate s alice [senderSide legAliceToBob, receiverSide legBobToAlice] [aliceInput]
  aliceAllocCid <- completedCid aliceResult
  submitMustFail (actAs app <> discloseMany [rulesDisclosure]) do
    exerciseCmd (toInterfaceContractId @AllocationV2.SettlementFactory rulesCid)
      AllocationV2.SettlementFactory_SettleBatch with
        settlement
        transferLegs = [legAliceToBob, legBobToAlice]
        allocations = [nonIteratedAllocation aliceAllocCid]
        actors = [app]
        extraArgs = emptyExtraArgs

-- | Exact cover, other direction: a batch carrying an allocation whose legs are
-- not in the presented leg set is rejected.
testSuperfluousAuthorizationFails : Script ()
testSuperfluousAuthorizationFails = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  aliceResult <- allocate s alice [senderSide legAliceToBob, receiverSide legBobToAlice] [aliceInput]
  aliceAllocCid <- completedCid aliceResult
  bobResult <- allocate s bob [receiverSide legAliceToBob, senderSide legBobToAlice] []
  bobAllocCid <- completedCid bobResult
  -- Present only leg-1 while the allocations authorize both legs.
  submitMustFail (actAs app <> discloseMany [rulesDisclosure]) do
    exerciseCmd (toInterfaceContractId @AllocationV2.SettlementFactory rulesCid)
      AllocationV2.SettlementFactory_SettleBatch with
        settlement
        transferLegs = [legAliceToBob]
        allocations = [nonIteratedAllocation aliceAllocCid, nonIteratedAllocation bobAllocCid]
        actors = [app]
        extraArgs = emptyExtraArgs

-- | Withdraw: the authorizer releases an uncommitted allocation and gets the
-- locked funds back.
testWithdrawReleasesFunds : Script ()
testWithdrawReleasesFunds = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  aliceResult <- allocate s alice [senderSide legAliceToBob] [aliceInput]
  aliceAllocCid <- completedCid aliceResult
  _ <- submit (actAs alice) do
    exerciseCmd aliceAllocCid AllocationV2.Allocation_Withdraw with
      actors = [alice]
      extraArgs = emptyExtraArgs
  aliceAfter <- holdingAmounts alice
  aliceAfter === [10.0]

-- | Executor cancel returns funds; admin cancel is refused while the allocation
-- is live and accepted once its expiry has passed.
testCancelPaths : Script ()
testCancelPaths = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  aliceResult <- allocate s alice [senderSide legAliceToBob] [aliceInput]
  aliceAllocCid <- completedCid aliceResult
  -- Admin cannot cancel a live allocation.
  submitMustFail (actAs admin) do
    exerciseCmd aliceAllocCid AllocationV2.Allocation_Cancel with
      actors = [admin]
      extraArgs = emptyExtraArgs
  -- Executors may cancel at any time.
  _ <- submit (actAs app) do
    exerciseCmd aliceAllocCid AllocationV2.Allocation_Cancel with
      actors = [app]
      extraArgs = emptyExtraArgs
  aliceAfter <- holdingAmounts alice
  aliceAfter === [10.0]

  -- Admin batch expiry after the deadline, via the rules contract.
  input2 <- mint admin bob 5.0
  bobResult <- allocateSpec s bob (mkAllocationSpec admin bob [senderSide (mkTransferLeg "leg-9" bob alice 5.0)]) [input2]
  bobAllocCid <- completedCid bobResult
  setTime t3
  _ <- submit (actAs admin <> discloseMany [rulesDisclosure]) do
    exerciseCmd rulesCid TokenRules_ExpireAllocations with
      cancelArgs =
        [ (bobAllocCid, AllocationV2.Allocation_Cancel with actors = [admin]; extraArgs = emptyExtraArgs) ]
      observers = []
  bobAfter <- holdingAmounts bob
  bobAfter === [5.0]

-- Iterated settlement
----------------------

settleBatchFinalizedCmd
  : Scenario -> [AllocationV2.TransferLeg] -> [AllocationV2.FinalizedAllocation]
  -> Commands AllocationV2.SettlementFactory_SettleBatchResult
settleBatchFinalizedCmd Scenario{..} legs finalized =
  exerciseCmd (toInterfaceContractId @AllocationV2.SettlementFactory rulesCid)
    AllocationV2.SettlementFactory_SettleBatch with
      settlement
      transferLegs = legs
      allocations = finalized
      actors = [app]
      extraArgs = emptyExtraArgs

settleBatchFinalized
  : Scenario -> [AllocationV2.TransferLeg] -> [AllocationV2.FinalizedAllocation]
  -> Script AllocationV2.SettlementFactory_SettleBatchResult
settleBatchFinalized s legs finalized =
  submit (actAs s.app <> discloseMany [s.rulesDisclosure]) (settleBatchFinalizedCmd s legs finalized)

settledNext : AllocationV2.AllocationResult -> Script (Optional (ContractId AllocationV2.Allocation))
settledNext result = case result.output of
  AllocationV2.AllocationResult_Settled cid -> pure cid
  other -> abort ("expected settled allocation, got: " <> show other)

-- | An iterated allocation spec: no upfront legs, executors specify them per
-- iteration up to the reserved funding.
mkIteratedSpec : Party -> Party -> Optional (TextMap.TextMap Decimal) -> AllocationV2.AllocationSpecification
mkIteratedSpec admin authorizer reserve =
  (mkAllocationSpec admin authorizer []) with nextIterationFunding = reserve

-- | Iterated settlement over two iterations: Alice deposits 10 TOK, Bob
-- enables iterated settlement with no reserve. The executor settles a 3 TOK
-- trade, both sides rolling into successor allocations, then a 1 TOK trade
-- back that ends both chains and releases all funds unlocked.
testIteratedSettlementLifecycle : Script ()
testIteratedSettlementLifecycle = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  aliceResult <- allocateSpec s alice
    (mkIteratedSpec admin alice (Some (TextMap.fromList [("TOK", 10.0)]))) [aliceInput]
  aliceAllocCid <- completedCid aliceResult
  bobResult <- allocateSpec s bob (mkIteratedSpec admin bob (Some TextMap.empty)) []
  bobAllocCid <- completedCid bobResult

  -- First iteration: alice sends 3 to bob; alice rolls her 7 change into the
  -- next iteration, bob rolls his incoming 3.
  let leg1 = mkTransferLeg "it-1" alice bob 3.0
  r1 <- settleBatchFinalized s [leg1]
    [ AllocationV2.FinalizedAllocation with
        allocationCid = aliceAllocCid
        extraTransferLegSides = [senderSide leg1]
        nextIterationFunding = Some (TextMap.fromList [("TOK", 7.0)])
    , AllocationV2.FinalizedAllocation with
        allocationCid = bobAllocCid
        extraTransferLegSides = [receiverSide leg1]
        nextIterationFunding = Some (TextMap.fromList [("TOK", 3.0)])
    ]
  [aliceR1, bobR1] <- pure r1.allocationSettleResults
  Some aliceAlloc2 <- settledNext aliceR1
  Some bobAlloc2 <- settledNext bobR1
  aliceMid <- holdingAmounts alice
  aliceMid === [7.0]
  bobMid <- holdingAmounts bob
  bobMid === [3.0]

  -- The successor tracks the chain: iteration count bumped, original cid
  -- pinned, legs cleared, reservation carried.
  Some v <- queryInterfaceContractId @AllocationV2.Allocation alice aliceAlloc2
  v.numIterations === 1
  v.originalAllocationCid === Some aliceAllocCid
  v.allocation.transferLegSides === []
  v.allocation.nextIterationFunding === Some (TextMap.fromList [("TOK", 7.0)])

  -- Second iteration: bob sends 1 back; no further iterations, so every
  -- balance is released unlocked.
  let leg2 = mkTransferLeg "it-2" bob alice 1.0
  r2 <- settleBatchFinalized s [leg2]
    [ AllocationV2.FinalizedAllocation with
        allocationCid = aliceAlloc2
        extraTransferLegSides = [receiverSide leg2]
        nextIterationFunding = None
    , AllocationV2.FinalizedAllocation with
        allocationCid = bobAlloc2
        extraTransferLegSides = [senderSide leg2]
        nextIterationFunding = None
    ]
  [aliceR2, bobR2] <- pure r2.allocationSettleResults
  None <- settledNext aliceR2
  None <- settledNext bobR2
  aliceAfter <- holdingAmounts alice
  aliceAfter === [8.0]
  bobAfter <- holdingAmounts bob
  bobAfter === [2.0]
  assertNoLocks alice
  assertNoLocks bob

-- | Iterated-settlement bounds: a zero reserve entry and an under-funded
-- reserve are rejected at allocation; a reservation exceeding the settlement
-- proceeds is rejected at settle time; extra legs and reservations on a
-- non-iterated allocation are rejected.
testIteratedSettlementBounds : Script ()
testIteratedSettlementBounds = do
  s@Scenario{..} <- setup
  -- Enabling iterated settlement without a reserve is `Some TextMap.empty`; a
  -- zero entry is a caller error.
  submitMustFail (actAs alice <> discloseMany [rulesDisclosure]) do
    exerciseCmd (toInterfaceContractId @AllocationInstructionV2.AllocationFactory rulesCid)
      AllocationInstructionV2.AllocationFactory_Allocate with
        settlement
        allocation = mkIteratedSpec admin alice (Some (TextMap.fromList [("TOK", 0.0)]))
        requestedAt = t0
        inputHoldingCids = []
        extraArgs = emptyExtraArgs
        actors = [alice]
  -- The reserve is locked upfront, so it must be funded like net leg debits.
  smallInput <- mint admin alice 5.0
  submitMustFail (actAs alice <> discloseMany [rulesDisclosure]) do
    exerciseCmd (toInterfaceContractId @AllocationInstructionV2.AllocationFactory rulesCid)
      AllocationInstructionV2.AllocationFactory_Allocate with
        settlement
        allocation = mkIteratedSpec admin alice (Some (TextMap.fromList [("TOK", 6.0)]))
        requestedAt = t0
        inputHoldingCids = [toInterfaceContractId @HoldingV2.Holding smallInput]
        extraArgs = emptyExtraArgs
        actors = [alice]

  aliceResult <- allocateSpec s alice
    (mkIteratedSpec admin alice (Some (TextMap.fromList [("TOK", 5.0)]))) [smallInput]
  aliceAllocCid <- completedCid aliceResult
  bobResult <- allocateSpec s bob (mkIteratedSpec admin bob (Some TextMap.empty)) []
  bobAllocCid <- completedCid bobResult

  -- Reserving more than the proceeds fails closed: 5 locked minus 3 sent
  -- leaves 2, less than the requested 3.
  let leg = mkTransferLeg "bd-1" alice bob 3.0
  submitMustFail (actAs app <> discloseMany [rulesDisclosure])
    (settleBatchFinalizedCmd s [leg]
      [ AllocationV2.FinalizedAllocation with
          allocationCid = aliceAllocCid
          extraTransferLegSides = [senderSide leg]
          nextIterationFunding = Some (TextMap.fromList [("TOK", 3.0)])
      , AllocationV2.FinalizedAllocation with
          allocationCid = bobAllocCid
          extraTransferLegSides = [receiverSide leg]
          nextIterationFunding = None
      ])

  -- A non-iterated allocation accepts neither extra legs nor a reservation.
  aliceInput2 <- mint admin alice 10.0
  aliceNonIterResult <- allocate s alice [senderSide legAliceToBob] [aliceInput2]
  aliceNonIter <- completedCid aliceNonIterResult
  bobNonIterResult <- allocate s bob [receiverSide legAliceToBob] []
  bobNonIter <- completedCid bobNonIterResult
  let extraLeg = mkTransferLeg "bd-2" alice bob 1.0
  submitMustFail (actAs app <> discloseMany [rulesDisclosure])
    (settleBatchFinalizedCmd s [legAliceToBob, extraLeg]
      [ AllocationV2.FinalizedAllocation with
          allocationCid = aliceNonIter
          extraTransferLegSides = [senderSide extraLeg]
          nextIterationFunding = None
      , nonIteratedAllocation bobNonIter
      ])
  submitMustFail (actAs app <> discloseMany [rulesDisclosure])
    (settleBatchFinalizedCmd s [legAliceToBob]
      [ AllocationV2.FinalizedAllocation with
          allocationCid = aliceNonIter
          extraTransferLegSides = []
          nextIterationFunding = Some TextMap.empty
      , nonIteratedAllocation bobNonIter
      ])

-- | A successor allocation is a plain allocation: the authorizer's account
-- parties withdraw it and recover the reserved funds unlocked.
testIteratedSuccessorWithdraw : Script ()
testIteratedSuccessorWithdraw = do
  s@Scenario{..} <- setup
  input <- mint admin alice 10.0
  aliceResult <- allocateSpec s alice
    (mkIteratedSpec admin alice (Some (TextMap.fromList [("TOK", 10.0)]))) [input]
  aliceAllocCid <- completedCid aliceResult
  bobResult <- allocateSpec s bob (mkIteratedSpec admin bob (Some TextMap.empty)) []
  bobAllocCid <- completedCid bobResult
  let leg = mkTransferLeg "wd-1" alice bob 4.0
  r <- settleBatchFinalized s [leg]
    [ AllocationV2.FinalizedAllocation with
        allocationCid = aliceAllocCid
        extraTransferLegSides = [senderSide leg]
        nextIterationFunding = Some (TextMap.fromList [("TOK", 6.0)])
    , AllocationV2.FinalizedAllocation with
        allocationCid = bobAllocCid
        extraTransferLegSides = [receiverSide leg]
        nextIterationFunding = None
    ]
  [aliceR, bobR] <- pure r.allocationSettleResults
  Some aliceAlloc2 <- settledNext aliceR
  None <- settledNext bobR
  bobAfter <- holdingAmounts bob
  bobAfter === [4.0]
  _ <- submit (actAs alice) do
    exerciseCmd aliceAlloc2 AllocationV2.Allocation_Withdraw with
      actors = [alice]
      extraArgs = emptyExtraArgs
  aliceAfter <- holdingAmounts alice
  aliceAfter === [6.0]
  assertNoLocks alice

-- Transfer instructions
------------------------

-- | Two-step transfer: the sender instructs (locking the amount, change
-- returned), the receiver accepts and gets the holding.
testTransferTwoStep : Script ()
testTransferTwoStep = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  result <- instructTransfer s [alice] (mkTransfer s alice bob 7.0 [aliceInput])
  instrCid <- pendingCid result
  -- 3.0 change unlocked, 7.0 locked pending acceptance.
  aliceMid <- holdingAmounts alice
  aliceMid === [3.0, 7.0]

  -- Wallets see who can act on the pending instruction, and the view points at
  -- the live locked funding rather than the consumed inputs.
  Some instrView <- queryInterfaceContractId @TransferInstructionV2.TransferInstruction bob instrCid
  Map.lookup TransferInstructionV2.TIA_Accept instrView.availableActions === Some [[bob]]
  Map.lookup TransferInstructionV2.TIA_Withdraw instrView.availableActions === Some [[alice]]
  instrView.transfer.inputHoldingCids =/= map (toInterfaceContractId @HoldingV2.Holding) [aliceInput]

  -- The admin can see the instruction but is not the receiver, so cannot accept.
  submitMustFail (actAs admin) do
    exerciseCmd instrCid TransferInstructionV2.TransferInstruction_Accept with
      actors = [admin]
      extraArgs = emptyExtraArgs

  _ <- submit (actAs bob) do
    exerciseCmd instrCid TransferInstructionV2.TransferInstruction_Accept with
      actors = [bob]
      extraArgs = emptyExtraArgs
  aliceAfter <- holdingAmounts alice
  aliceAfter === [3.0]
  bobAfter <- holdingAmounts bob
  bobAfter === [7.0]
  assertNoLocks alice
  assertNoLocks bob

-- | One-step transfer: actors covering both accounts complete immediately,
-- with no pending instruction and no lock.
testTransferOneStep : Script ()
testTransferOneStep = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  result <- instructTransfer s [alice, bob] (mkTransfer s alice bob 7.0 [aliceInput])
  _ <- completedHoldings result
  aliceAfter <- holdingAmounts alice
  aliceAfter === [3.0]
  bobAfter <- holdingAmounts bob
  bobAfter === [7.0]
  assertNoLocks alice

-- | Both events of a completed transfer carry the transfer's own reason in
-- their `extraArgs`, or name the workflow when the transfer has none.
testTransferEventReason : Script ()
testTransferEventReason = do
  s@Scenario{..} <- setup
  input1 <- mint admin alice 10.0
  input2 <- mint admin alice 10.0
  let withReason = (mkTransfer s alice bob 4.0 [input1]) with meta = reasonToMeta "rent" emptyMetadata
  [(_, tree1), (_, tree2)] <- forA [withReason, mkTransfer s alice bob 4.0 [input2]] $ \transfer ->
    submitResultAndTree (actAs [alice, bob] <> discloseMany [rulesDisclosure]) $
      exerciseCmd (toInterfaceContractId @TransferInstructionV2.TransferFactory rulesCid)
        TransferInstructionV2.TransferFactory_Transfer with
          transfer; actors = [alice, bob]; extraArgs = emptyExtraArgs
  map (reasonFromMeta . (.extraArgs.meta)) (holdingsChangeEvents tree1) === ["rent", "rent"]
  map (reasonFromMeta . (.extraArgs.meta)) (holdingsChangeEvents tree2) === ["transfer completed", "transfer completed"]
  -- A mint without a reason names the workflow too.
  mintTree <- submitTree (actAs [admin, bob] <> discloseMany [rulesDisclosure]) $
    mintCmd s [admin, bob] ((mintTransfer s bob 1.0) with meta = emptyMetadata)
  map (reasonFromMeta . (.extraArgs.meta)) (holdingsChangeEvents mintTree) === ["tokens minted"]

-- | Reject and withdraw both return the locked funds to the sender.
testTransferRejectAndWithdraw : Script ()
testTransferRejectAndWithdraw = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  rejected <- instructTransfer s [alice] (mkTransfer s alice bob 7.0 [aliceInput])
  rejectedCid <- pendingCid rejected
  _ <- submit (actAs bob) do
    exerciseCmd rejectedCid TransferInstructionV2.TransferInstruction_Reject with
      actors = [bob]
      extraArgs = emptyExtraArgs
  assertNoLocks alice

  aliceHoldings <- query @TokenHolding alice
  withdrawn <- instructTransfer s [alice] (mkTransfer s alice bob 7.0 (map fst aliceHoldings))
  withdrawnCid <- pendingCid withdrawn
  _ <- submit (actAs alice) do
    exerciseCmd withdrawnCid TransferInstructionV2.TransferInstruction_Withdraw with
      actors = [alice]
      extraArgs = emptyExtraArgs
  assertNoLocks alice
  aliceAfter <- holdingAmounts alice
  sum aliceAfter === 10.0

-- | Withdraw has no deadline. After `executeBefore`, while the lock is still
-- live, the sender's parties recover the funds alone; accept already fails
-- here (`testTransferGuards`).
testTransferWithdrawAfterDeadline : Script ()
testTransferWithdrawAfterDeadline = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  result <- instructTransfer s [alice] (mkTransfer s alice bob 7.0 [aliceInput])
  instrCid <- pendingCid result
  -- Past executeBefore (t2), before the lock expires at t2 plus lockGrace.
  setTime t3
  _ <- submit (actAs alice) do
    exerciseCmd instrCid TransferInstructionV2.TransferInstruction_Withdraw with
      actors = [alice]
      extraArgs = emptyExtraArgs
  assertNoLocks alice
  aliceAfter <- holdingAmounts alice
  sum aliceAfter === 10.0

-- | Guards: underfunded transfers and expired execution windows fail closed.
testTransferGuards : Script ()
testTransferGuards = do
  s@Scenario{..} <- setup
  smallInput <- mint admin alice 5.0
  -- Underfunded: inputs do not cover the transfer amount.
  submitMustFail (actAs alice <> discloseMany [rulesDisclosure]) do
    exerciseCmd (toInterfaceContractId @TransferInstructionV2.TransferFactory rulesCid)
      TransferInstructionV2.TransferFactory_Transfer with
        transfer = mkTransfer s alice bob 7.0 [smallInput]
        actors = [alice]
        extraArgs = emptyExtraArgs
  -- executeBefore not in the future fails at the factory.
  submitMustFail (actAs alice <> discloseMany [rulesDisclosure]) do
    exerciseCmd (toInterfaceContractId @TransferInstructionV2.TransferFactory rulesCid)
      TransferInstructionV2.TransferFactory_Transfer with
        transfer = (mkTransfer s alice bob 5.0 [smallInput]) with executeBefore = t1
        actors = [alice]
        extraArgs = emptyExtraArgs
  -- Accepting after executeBefore fails; the sender's lock has expired.
  result <- instructTransfer s [alice] (mkTransfer s alice bob 5.0 [smallInput])
  instrCid <- pendingCid result
  setTime t2
  submitMustFail (actAs bob) do
    exerciseCmd instrCid TransferInstructionV2.TransferInstruction_Accept with
      actors = [bob]
      extraArgs = emptyExtraArgs

-- | Admin expiry: only after the storage bound has passed, and the funds
-- return to the sender.
testTransferAdminExpiry : Script ()
testTransferAdminExpiry = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  result <- instructTransfer s [alice] (mkTransfer s alice bob 7.0 [aliceInput])
  instrCid <- pendingCid result
  let templateCid = fromInterfaceContractId @TokenTransferInstruction instrCid
  -- Not yet expired: the admin cannot reclaim early.
  submitMustFail (actAs admin) do
    exerciseCmd templateCid TokenTransferInstruction_Expire
  setTime t3
  -- Batched expiry through the rules contract, mirroring allocation expiry.
  _ <- submit (actAs admin <> discloseMany [rulesDisclosure]) do
    exerciseCmd rulesCid TokenRules_ExpireTransferInstructions with
      instructionCids = [templateCid]
      observers = []
  assertNoLocks alice
  aliceAfter <- holdingAmounts alice
  sum aliceAfter === 10.0

-- Adversarial and boundary scenarios
------------------------------------

-- | `Allocation_Settle` outside the batch factory succeeds for admin plus
-- executors, bypassing the factory's exact-cover check. Unchanged from the
-- single-package version: this documents the admin trust assumption.
testDirectSettleAllowed : Script ()
testDirectSettleAllowed = do
  s@Scenario{..} <- setup
  -- Bob's receiver-side-only allocation locks nothing; settling it alone
  -- creates 10 TOK from nothing.
  bobResult <- allocate s bob [receiverSide legAliceToBob] []
  bobAllocCid <- completedCid bobResult
  _ <- submit (actAs admin <> actAs app) do
    exerciseCmd bobAllocCid AllocationV2.Allocation_Settle with
      actors = [admin, app]
      extraTransferLegSides = []
      nextIterationFunding = None
      extraArgs = emptyExtraArgs
  bobAfter <- holdingAmounts bob
  bobAfter === [10.0]

-- | A settlement deadline beyond the registry's maxTTL is rejected
-- outright, so `expiresAt` can never precede the deadline and the admin can
-- never expire a live allocation.
testDeadlineBoundedByMaxTTL : Script ()
testDeadlineBoundedByMaxTTL = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  let farSpec = (mkAllocationSpec admin alice [senderSide legAliceToBob]) with
        settlementDeadline = Some (time (date 2027 Jan 1) 0 0 0)
  submitMustFail (actAs alice <> discloseMany [rulesDisclosure]) do
    exerciseCmd (toInterfaceContractId @AllocationInstructionV2.AllocationFactory rulesCid)
      AllocationInstructionV2.AllocationFactory_Allocate with
        settlement
        allocation = farSpec
        requestedAt = t0
        inputHoldingCids = [toInterfaceContractId @HoldingV2.Holding aliceInput]
        extraArgs = emptyExtraArgs
        actors = [alice]

-- | A committed allocation without a settlement deadline could never be
-- withdrawn, so creating one is refused.
testCommittedRequiresDeadline : Script ()
testCommittedRequiresDeadline = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  let badSpec = (mkAllocationSpec admin alice [senderSide legAliceToBob]) with
        committed = True
        settlementDeadline = None
  mustFailWith "a committed allocation requires a settlement deadline" (actAs alice <> discloseMany [rulesDisclosure]) do
    exerciseCmd (toInterfaceContractId @AllocationInstructionV2.AllocationFactory rulesCid)
      AllocationInstructionV2.AllocationFactory_Allocate with
        settlement
        allocation = badSpec
        requestedAt = t0
        inputHoldingCids = [toInterfaceContractId @HoldingV2.Holding aliceInput]
        extraArgs = emptyExtraArgs
        actors = [alice]

-- | The funding lock outlives the instruction's own expiry, so the
-- admin's expiry path always has a window in which it is guaranteed to work,
-- and once the lock does expire the sender can self-recover.
testLockGraceAndOwnerUnlock : Script ()
testLockGraceAndOwnerUnlock = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  result <- instructTransfer s [alice] (mkTransfer s alice bob 7.0 [aliceInput])
  instrCid <- pendingCid result
  let templateCid = fromInterfaceContractId @TokenTransferInstruction instrCid

  -- Just past executeBefore: the lock has NOT yet expired, so the locked
  -- holding cannot be re-spent as an input.
  setTime t3
  lockedHoldings <- query @TokenHolding alice
  let lockedCids = [cid | (cid, h) <- lockedHoldings, isSome h.holding.lock]
  submitMustFail (actAs alice <> discloseMany [rulesDisclosure]) do
    exerciseCmd (toInterfaceContractId @TransferInstructionV2.TransferFactory rulesCid)
      TransferInstructionV2.TransferFactory_Transfer with
        transfer = (mkTransfer s alice bob 7.0 lockedCids) with
          requestedAt = t3
          executeBefore = t4
        actors = [alice]
        extraArgs = emptyExtraArgs
  -- And the owner cannot unlock early either.
  forA_ lockedCids $ \cid ->
    submitMustFail (actAs alice <> actAs admin) do
      exerciseCmd cid TokenHolding_OwnerUnlock

  -- After the grace window the owner can always self-recover, which is what
  -- makes admin GC safe.
  setTime t4
  forA_ lockedCids $ \cid ->
    submit (actAs alice <> actAs admin) do
      exerciseCmd cid TokenHolding_OwnerUnlock
  assertNoLocks alice
  aliceAfter <- holdingAmounts alice
  sum aliceAfter === 10.0

  -- The instruction shell now references an archived holding, so the normal
  -- fund-returning paths fail — and admin GC is the escape hatch that keeps it
  -- from being permanently unremovable.
  submitMustFail (actAs admin) do
    exerciseCmd templateCid TokenTransferInstruction_Expire
  _ <- submit (actAs admin) do
    exerciseCmd templateCid TokenTransferInstruction_AdminGC
  gcd <- queryContractId admin templateCid
  gcd === None

-- | Owner unlock is a holdings change like any other (CIP-0112 §4.3.5): it
-- emits one account-local `EventLog_HoldingsChange` naming the archived
-- holding as input and its unlocked replacement as output, with no transfer
-- legs, so event-driven wallets drop the stale contract id. The account
-- parties exercise it alone; the admin's authority for the event comes from
-- the holding's signatories.
testOwnerUnlockEmitsHoldingsChange : Script ()
testOwnerUnlockEmitsHoldingsChange = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  _ <- instructTransfer s [alice] (mkTransfer s alice bob 7.0 [aliceInput])
  lockedHoldings <- query @TokenHolding alice
  lockedCid <- case [cid | (cid, h) <- lockedHoldings, isSome h.holding.lock] of
    [cid] -> pure cid
    cids -> abort ("expected exactly one locked holding, got " <> show (length cids))
  setTime t4
  (newCid, tree) <- submitResultAndTree (actAs alice) do
    exerciseCmd lockedCid TokenHolding_OwnerUnlock
  ev <- expectOneHoldingsChange tree
  ev.admin === admin
  ev.account === basicAccount alice
  ev.inputHoldingCids === [toInterfaceContractId @HoldingV2.Holding lockedCid]
  ev.outputHoldingCids === [newCid]
  ev.transferLegSides === []
  assertMsg "the account parties must observe the event" (alice `elem` ev.observers)
  assertNoLocks alice

-- | A lock carrying `expiresAfter` is rejected at creation, since the
-- package's expiry checks only model `expiresAt`.
testExpiresAfterRejected : Script ()
testExpiresAfterRejected = do
  Scenario{..} <- setup
  submitMustFail (actAs admin <> actAs alice) do
    createCmd TokenHolding with
      holding = HoldingV2.HoldingView with
        account = basicAccount alice
        instrumentId = HoldingV2.InstrumentId with admin; id = "TOK"
        amount = 5.0
        lock = Some HoldingV2.Lock with
          holders = [admin]
          expiresAt = None
          expiresAfter = Some (hours 1)
          context = None
        meta = emptyMetadata

-- | A self-transfer completes in one step rather than creating a pending
-- instruction the sender would have to accept from themselves.
testSelfTransferOneStep : Script ()
testSelfTransferOneStep = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  result <- instructTransfer s [alice] (mkTransfer s alice alice 4.0 [aliceInput])
  _ <- completedHoldings result
  aliceAfter <- holdingAmounts alice
  sort aliceAfter === [4.0, 6.0]
  assertNoLocks alice

-- | A self-transfer of the full input value consolidates multiple holdings
-- into a single one, with no change holding and no pending instruction.
testSelfTransferConsolidates : Script ()
testSelfTransferConsolidates = do
  s@Scenario{..} <- setup
  input1 <- mint admin alice 3.0
  input2 <- mint admin alice 7.0
  result <- instructTransfer s [alice] (mkTransfer s alice alice 10.0 [input1, input2])
  _ <- completedHoldings result
  aliceAfter <- holdingAmounts alice
  aliceAfter === [10.0]
  assertNoLocks alice

-- Delivery-vs-mint and delivery-vs-burn
----------------------------------------

-- | An allocation spec authorized by a special account.
specialSpec : Party -> HoldingV2.Account -> [AllocationV2.TransferLegSide] -> AllocationV2.AllocationSpecification
specialSpec admin account sides = (mkAllocationSpec admin admin sides) with authorizer = account

allocateSpecCmd
  : Scenario -> [Party] -> AllocationV2.AllocationSpecification
  -> Commands AllocationInstructionV2.AllocationInstructionResult
allocateSpecCmd Scenario{..} actors spec =
  exerciseCmd (toInterfaceContractId @AllocationInstructionV2.AllocationFactory rulesCid)
    AllocationInstructionV2.AllocationFactory_Allocate with
      settlement
      allocation = spec
      requestedAt = t0
      inputHoldingCids = []
      extraArgs = emptyExtraArgs
      actors

instrumentHoldings : Party -> Script [(Text, Decimal)]
instrumentHoldings owner = do
  holdings <- query @TokenHolding owner
  pure (sort [ (h.holding.instrumentId.id, h.holding.amount)
             | (_, h) <- holdings, h.holding.account.owner == Some owner ])

-- | The legs of a transaction's holdings-change events on `account` whose
-- other side is `otherside`, as (side, instrument, amount).
legsAgainst
  : HoldingV2.Account -> HoldingV2.Account -> TransactionTree
  -> [(TransferEventsV2.TransferSide, Text, Decimal)]
legsAgainst account otherside tree =
  [ (l.side, l.instrumentId, l.amount)
  | e <- holdingsChangeEvents tree, e.account == account
  , l <- e.transferLegSides, l.otherside == otherside ]

-- | Delivery-vs-mint: Alice pays Bob 50 USD and receives 10 TOK minted in the
-- same batch. The admin's mint-account allocation locks nothing; Alice's
-- event names the mint account as the other side, and no event is emitted on
-- the mint account itself.
testDeliveryVsMint : Script ()
testDeliveryVsMint = do
  s@Scenario{..} <- setup
  aliceUsd <- mintOf admin alice "USD" 50.0
  let mintLeg = (mkTransferLeg "mint-1" alice alice 10.0) with sender = mintAccount
      payLeg = (mkTransferLeg "pay-1" alice bob 50.0) with instrumentId = "USD"

  adminAllocCid <- completedCid =<< allocateSpec s admin (specialSpec admin mintAccount [senderSide mintLeg]) []
  Some adminView <- queryInterfaceContractId @AllocationV2.Allocation admin adminAllocCid
  adminView.holdingCids === []
  aliceAllocCid <- completedCid =<< allocate s alice [receiverSide mintLeg, senderSide payLeg] [aliceUsd]
  bobAllocCid <- completedCid =<< allocate s bob [receiverSide payLeg] []

  tree <- submitTree (actAs app <> discloseMany [rulesDisclosure]) $
    settleBatchFinalizedCmd s [mintLeg, payLeg] (map nonIteratedAllocation [adminAllocCid, aliceAllocCid, bobAllocCid])

  aliceAfter <- instrumentHoldings alice
  aliceAfter === [("TOK", 10.0)]
  bobAfter <- instrumentHoldings bob
  bobAfter === [("USD", 50.0)]
  legsAgainst (basicAccount alice) mintAccount tree === [(TransferEventsV2.ReceiverSide, "TOK", 10.0)]
  [e | e <- holdingsChangeEvents tree, e.account == mintAccount] === []

-- | Delivery-vs-burn: Alice redeems 10 TOK for 50 USD from Bob. The admin's
-- burn-account allocation locks nothing and receives nothing; Alice's event
-- names the burn account as the other side.
testDeliveryVsBurn : Script ()
testDeliveryVsBurn = do
  s@Scenario{..} <- setup
  aliceTok <- mint admin alice 10.0
  bobUsd <- mintOf admin bob "USD" 50.0
  let burnLeg = (mkTransferLeg "burn-1" alice alice 10.0) with receiver = burnAccount
      payLeg = (mkTransferLeg "pay-1" bob alice 50.0) with instrumentId = "USD"

  adminAllocCid <- completedCid =<< allocateSpec s admin (specialSpec admin burnAccount [receiverSide burnLeg]) []
  aliceAllocCid <- completedCid =<< allocate s alice [senderSide burnLeg, receiverSide payLeg] [aliceTok]
  bobAllocCid <- completedCid =<< allocate s bob [senderSide payLeg] [bobUsd]

  tree <- submitTree (actAs app <> discloseMany [rulesDisclosure]) $
    settleBatchFinalizedCmd s [burnLeg, payLeg] (map nonIteratedAllocation [adminAllocCid, aliceAllocCid, bobAllocCid])

  aliceAfter <- instrumentHoldings alice
  aliceAfter === [("USD", 50.0)]
  bobAfter <- instrumentHoldings bob
  bobAfter === []
  legsAgainst (basicAccount alice) burnAccount tree === [(TransferEventsV2.SenderSide, "TOK", 10.0)]
  [e | e <- holdingsChangeEvents tree, e.account == burnAccount] === []

-- | Only the admin authors a special-account allocation, only for the mint
-- and burn accounts, and only in the direction that creates or destroys
-- supply.
testSpecialAuthorizerRestrictions : Script ()
testSpecialAuthorizerRestrictions = do
  s@Scenario{..} <- setup
  let mintLeg = (mkTransferLeg "mint-1" alice alice 10.0) with sender = mintAccount
      toMintLeg = (mkTransferLeg "to-mint" alice alice 10.0) with receiver = mintAccount
      fromBurnLeg = (mkTransferLeg "from-burn" alice alice 10.0) with sender = burnAccount
      otherSpecial = HoldingV2.Account with owner = None; provider = None; id = "cip-112/other"
      asAdmin = actAs admin <> discloseMany [rulesDisclosure]
  -- `accountParties` resolves a special account to the admin alone.
  submitMustFail (actAs alice <> discloseMany [rulesDisclosure]) $
    allocateSpecCmd s [alice] (specialSpec admin mintAccount [senderSide mintLeg])
  mustFailWith "a mint-account allocation may only authorize sender sides" asAdmin $
    allocateSpecCmd s [admin] (specialSpec admin mintAccount [receiverSide toMintLeg])
  mustFailWith "a burn-account allocation may only authorize receiver sides" asAdmin $
    allocateSpecCmd s [admin] (specialSpec admin burnAccount [senderSide fromBurnLeg])
  mustFailWith "allocation authorizer must be a regular, mint, or burn account" asAdmin $
    allocateSpecCmd s [admin] (specialSpec admin otherSpecial [senderSide mintLeg])

-- | The netting ignores the amount on a mint-account sender side, so exact
-- cover is what bounds the mint: a receiver allocation for more than the
-- admin authorized settles under neither amount.
testMintAllocationBoundsAmount : Script ()
testMintAllocationBoundsAmount = do
  s@Scenario{..} <- setup
  let mintLeg = (mkTransferLeg "mint-1" alice alice 10.0) with sender = mintAccount
      inflatedLeg = mintLeg with amount = 100.0
  adminAllocCid <- completedCid =<< allocateSpec s admin (specialSpec admin mintAccount [senderSide mintLeg]) []
  aliceAllocCid <- completedCid =<< allocate s alice [receiverSide inflatedLeg] []
  forA_ [mintLeg, inflatedLeg] $ \leg ->
    submitMustFail (actAs app <> discloseMany [rulesDisclosure]) $
      settleBatchFinalizedCmd s [leg] (map nonIteratedAllocation [adminAllocCid, aliceAllocCid])
  aliceAfter <- holdingAmounts alice
  aliceAfter === []

-- | A mint-account allocation holds nothing, so withdraw, executor cancel,
-- and admin expiry archive it without creating or releasing any holding.
testMintAllocationLifecycle : Script ()
testMintAllocationLifecycle = do
  s@Scenario{..} <- setup
  let mintLeg = (mkTransferLeg "mint-1" alice alice 10.0) with sender = mintAccount
      newMintAllocation = completedCid =<< allocateSpec s admin (specialSpec admin mintAccount [senderSide mintLeg]) []
      cancel actors = AllocationV2.Allocation_Cancel with actors; extraArgs = emptyExtraArgs

  withdrawnCid <- newMintAllocation
  Some v <- queryInterfaceContractId @AllocationV2.Allocation admin withdrawnCid
  Map.lookup AllocationV2.AA_Withdraw v.availableActions === Some [[admin]]
  _ <- submit (actAs admin) do
    exerciseCmd withdrawnCid AllocationV2.Allocation_Withdraw with
      actors = [admin]
      extraArgs = emptyExtraArgs

  cancelledCid <- newMintAllocation
  _ <- submit (actAs app) do exerciseCmd cancelledCid (cancel [app])

  expiredCid <- newMintAllocation
  setTime t3
  _ <- submit (actAs admin <> discloseMany [rulesDisclosure]) do
    exerciseCmd rulesCid TokenRules_ExpireAllocations with
      cancelArgs = [(expiredCid, cancel [admin])]
      observers = []

  allocations <- queryInterface @AllocationV2.Allocation admin
  allocations === []
  holdings <- query @TokenHolding admin
  holdings === []

-- | An empty batch is refused rather than succeeding as a no-op.
testEmptyBatchRefused : Script ()
testEmptyBatchRefused = do
  Scenario{..} <- setup
  submitMustFail (actAs app <> discloseMany [rulesDisclosure]) do
    exerciseCmd (toInterfaceContractId @AllocationV2.SettlementFactory rulesCid)
      AllocationV2.SettlementFactory_SettleBatch with
        settlement
        transferLegs = []
        allocations = []
        actors = [app]
        extraArgs = emptyExtraArgs

-- | The advertised withdraw actor set is exactly what the choice body
-- accepts (the authorizer's full account-party set).
testAvailableActionsMatchImpl : Script ()
testAvailableActionsMatchImpl = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  aliceResult <- allocate s alice [senderSide legAliceToBob] [aliceInput]
  aliceAllocCid <- completedCid aliceResult
  Some v <- queryInterfaceContractId @AllocationV2.Allocation alice aliceAllocCid
  Map.lookup AllocationV2.AA_Withdraw v.availableActions === Some [[alice]]
  Map.lookup AllocationV2.AA_Settle v.availableActions === Some [[admin, app]]

-- | The allocation-side admin GC mirrors the transfer-side one: unavailable
-- while the funding lock is live, and once the lock has expired the shell can
-- be removed while the authorizer self-recovers the funding.
testAllocationAdminGC : Script ()
testAllocationAdminGC = do
  s@Scenario{..} <- setup
  aliceInput <- mint admin alice 10.0
  aliceResult <- allocate s alice [senderSide legAliceToBob] [aliceInput]
  aliceAllocCid <- completedCid aliceResult
  let templateCid = fromInterfaceContractId @TokenAllocation aliceAllocCid
  submitMustFail (actAs admin) do
    exerciseCmd templateCid TokenAllocation_AdminGC
  -- t4 is past lockExpiresAt (settlementDeadline t2 + lockGrace 1h).
  setTime t4
  _ <- submit (actAs admin) do
    exerciseCmd templateCid TokenAllocation_AdminGC
  gcd <- queryContractId admin templateCid
  gcd === None
  lockedHoldings <- query @TokenHolding alice
  forA_ [cid | (cid, h) <- lockedHoldings, isSome h.holding.lock] $ \cid ->
    submit (actAs alice <> actAs admin) do
      exerciseCmd cid TokenHolding_OwnerUnlock
  aliceAfter <- holdingAmounts alice
  aliceAfter === [10.0]

-- | The registry rules contract is archivable by its signatory, so stale
-- configuration does not accumulate on the ledger.
testHousekeepingArchives : Script ()
testHousekeepingArchives = do
  admin <- allocateParty "admin"
  setTime t1
  rulesCid <- submit admin do
    createCmd TokenRules with
      config = RegistryConfig with
        admin
        maxTTL = days 90
        lockGrace = hours 1
  submit admin do archiveCmd rulesCid

-- | Registry misconfiguration is refused: a non-positive maxTTL or lockGrace
-- would let the admin expire everything immediately.
testRulesConfigValidated : Script ()
testRulesConfigValidated = do
  admin <- allocateParty "admin"
  setTime t1
  let base = RegistryConfig with
        admin
        maxTTL = days 90
        lockGrace = hours 1
  submitMustFail admin do createCmd TokenRules with config = base with maxTTL = minutes 0
  submitMustFail admin do createCmd TokenRules with config = base with lockGrace = minutes 0

-- Mint offers
--------------

-- | Issuance is a pending transfer from the mint account. The admin offers
-- alone and nothing is created or locked until the receiver accepts. The
-- accept emits one event, on the receiver's account, naming the mint account
-- as the other side.
testOfferMintAccepted : Script ()
testOfferMintAccepted = do
  s@Scenario{..} <- setup
  offerCid <- submit (actAs admin) (offerMintCmd s alice 25.0)
  aliceBefore <- holdingAmounts alice
  aliceBefore === []
  Some v <- queryInterfaceContractId @TransferInstructionV2.TransferInstruction alice offerCid
  v.transfer.sender === mintAccount
  v.transfer.inputHoldingCids === []
  Map.lookup TransferInstructionV2.TIA_Accept v.availableActions === Some [[alice]]
  Map.lookup TransferInstructionV2.TIA_Withdraw v.availableActions === Some [[admin]]

  (result, tree) <- submitResultAndTree (actAs alice) (acceptCmd alice offerCid)
  [holdingCid] <- completedHoldings result
  aliceAfter <- holdingAmounts alice
  aliceAfter === [25.0]
  mintEvent <- expectOneHoldingsChange tree
  mintEvent.account === basicAccount alice
  mintEvent.inputHoldingCids === []
  mintEvent.outputHoldingCids === [holdingCid]
  map (.side) mintEvent.transferLegSides === [TransferEventsV2.ReceiverSide]
  map (.otherside) mintEvent.transferLegSides === [mintAccount]
  map (.amount) mintEvent.transferLegSides === [25.0]
  -- The offer's reason explains the change.
  reasonFromMeta mintEvent.extraArgs.meta === "mint"

-- | A mint offer that is not accepted creates nothing: the receiver rejects
-- it, the admin withdraws it, and once `executeBefore` has passed it can no
-- longer be accepted and the admin expires it.
testOfferMintNotAccepted : Script ()
testOfferMintNotAccepted = do
  s@Scenario{..} <- setup
  rejectedCid <- submit (actAs admin) (offerMintCmd s alice 10.0)
  _ <- submit (actAs alice) do
    exerciseCmd rejectedCid TransferInstructionV2.TransferInstruction_Reject with
      actors = [alice]
      extraArgs = emptyExtraArgs
  withdrawnCid <- submit (actAs admin) (offerMintCmd s alice 10.0)
  _ <- submit (actAs admin) do
    exerciseCmd withdrawnCid TransferInstructionV2.TransferInstruction_Withdraw with
      actors = [admin]
      extraArgs = emptyExtraArgs
  expiredCid <- submit (actAs admin) (offerMintCmd s alice 10.0)
  setTime t3
  submitMustFail (actAs alice) (acceptCmd alice expiredCid)
  _ <- submit (actAs admin <> discloseMany [rulesDisclosure]) do
    exerciseCmd rulesCid TokenRules_ExpireTransferInstructions with
      instructionCids = [fromInterfaceContractId @TokenTransferInstruction expiredCid]
      observers = []
  instructions <- queryInterface @TransferInstructionV2.TransferInstruction alice
  instructions === []
  aliceAfter <- holdingAmounts alice
  aliceAfter === []

-- | Only the admin offers a mint, and the offer passes the same bounds as
-- any transfer.
testOfferMintAuthorityAndBounds : Script ()
testOfferMintAuthorityAndBounds = do
  s@Scenario{..} <- setup
  let transfer = mintTransfer s alice 10.0
  -- Only the admin acts for the mint account. The receiver alone cannot
  -- mint, in one step or two.
  forA_ [[alice], [alice, bob]] $ \actors ->
    submitMustFail (actAs actors <> discloseMany [rulesDisclosure]) (mintCmd s actors transfer)
  submitMustFail (actAs alice <> discloseMany [rulesDisclosure]) (mintCmd s [admin] transfer)
  -- Actors outside both accounts are refused.
  submitMustFail (actAs [admin, alice, bob] <> discloseMany [rulesDisclosure])
    (mintCmd s [admin, alice, bob] transfer)
  mustFailWith "transfer must be well formed" (actAs admin) $
    mintCmd s [admin] (transfer with amount = 0.0)
  mustFailWith "transfer execution window exceeds the registry's maximum TTL" (actAs admin) $
    mintCmd s [admin] (transfer with executeBefore = t1 `addRelTime` days 91)

-- | One-step mint: the admin and the receiver acting together create the
-- holding at once, with no pending instruction. One event, on the
-- receiver's account, names the mint account as the other side.
testMintOneStep : Script ()
testMintOneStep = do
  s@Scenario{..} <- setup
  (result, tree) <- submitResultAndTree (actAs [admin, alice] <> discloseMany [rulesDisclosure])
    (mintCmd s [admin, alice] (mintTransfer s alice 10.0))
  [_] <- completedHoldings result
  result.senderChangeCids === []
  aliceAfter <- holdingAmounts alice
  aliceAfter === [10.0]
  assertNoLocks alice
  instructions <- query @TokenTransferInstruction admin
  instructions === []
  mintEvent <- expectOneHoldingsChange tree
  mintEvent.account === basicAccount alice
  mintEvent.inputHoldingCids === []
  map (.side) mintEvent.transferLegSides === [TransferEventsV2.ReceiverSide]
  map (.otherside) mintEvent.transferLegSides === [mintAccount]
  reasonFromMeta mintEvent.extraArgs.meta === "mint"

-- Burn
-------

burnCmd
  : Scenario -> [Party] -> TransferInstructionV2.Transfer
  -> Commands TransferInstructionV2.TransferInstructionResult
burnCmd Scenario{..} actors transfer =
  exerciseCmd (toInterfaceContractId @TransferInstructionV2.TransferFactory rulesCid)
    TransferInstructionV2.TransferFactory_Transfer with transfer; actors; extraArgs = emptyExtraArgs

-- | A burn request is a transfer to the burn account. The owner requests
-- alone, locking the amount; the admin, the burn account's only party,
-- accepts in a separate submission. The accept creates no holding and emits
-- one event, on the owner's account, naming the burn account as the other
-- side.
testBurnRequestAccepted : Script ()
testBurnRequestAccepted = do
  s@Scenario{..} <- setup
  input <- mint admin alice 10.0
  requestCid <- pendingCid =<< instructTransfer s [alice] (burnTransfer s alice 4.0 [input])
  aliceMid <- holdingAmounts alice
  aliceMid === [4.0, 6.0]
  Some v <- queryInterfaceContractId @TransferInstructionV2.TransferInstruction admin requestCid
  Map.lookup TransferInstructionV2.TIA_Accept v.availableActions === Some [[admin]]
  Map.lookup TransferInstructionV2.TIA_Withdraw v.availableActions === Some [[alice]]
  lockedHoldings <- query @TokenHolding alice
  [l.context | (_, h) <- lockedHoldings, Some l <- [h.holding.lock]] === [Some "pending burn"]

  (result, tree) <- submitResultAndTree (actAs admin) (acceptCmd admin requestCid)
  completedHoldings result >>= (=== [])
  aliceAfter <- holdingAmounts alice
  aliceAfter === [6.0]
  burnEvent <- expectOneHoldingsChange tree
  burnEvent.account === basicAccount alice
  burnEvent.inputHoldingCids === v.transfer.inputHoldingCids
  burnEvent.outputHoldingCids === []
  map (.side) burnEvent.transferLegSides === [TransferEventsV2.SenderSide]
  map (.otherside) burnEvent.transferLegSides === [burnAccount]
  map (.amount) burnEvent.transferLegSides === [4.0]
  -- The request carries no reason, so the event names the workflow.
  reasonFromMeta burnEvent.extraArgs.meta === "tokens burned"

-- | The owner and the admin acting together burn in one step: the input is
-- consumed, the change returned, and one event explains both.
testBurnOneStep : Script ()
testBurnOneStep = do
  s@Scenario{..} <- setup
  input <- mint admin alice 10.0
  (result, tree) <- submitResultAndTree (actAs [alice, admin] <> discloseMany [rulesDisclosure])
    (burnCmd s [alice, admin] (burnTransfer s alice 4.0 [input]))
  completedHoldings result >>= (=== [])
  aliceAfter <- holdingAmounts alice
  aliceAfter === [6.0]
  assertNoLocks alice
  burnEvent <- expectOneHoldingsChange tree
  burnEvent.inputHoldingCids === [toInterfaceContractId @HoldingV2.Holding input]
  burnEvent.outputHoldingCids === result.senderChangeCids
  map (.otherside) burnEvent.transferLegSides === [burnAccount]

-- | The admin expires a stale burn request like any other instruction: after
-- `executeBefore` it can no longer be accepted, and expiry returns the locked
-- amount to the holder.
testBurnRequestAdminExpiry : Script ()
testBurnRequestAdminExpiry = do
  s@Scenario{..} <- setup
  input <- mint admin alice 10.0
  requestCid <- pendingCid =<< instructTransfer s [alice] (burnTransfer s alice 4.0 [input])
  setTime t3
  submitMustFail (actAs admin) (acceptCmd admin requestCid)
  _ <- submit (actAs admin <> discloseMany [rulesDisclosure]) do
    exerciseCmd rulesCid TokenRules_ExpireTransferInstructions with
      instructionCids = [fromInterfaceContractId @TokenTransferInstruction requestCid]
      observers = []
  aliceAfter <- holdingAmounts alice
  aliceAfter === [4.0, 6.0]
  assertNoLocks alice

-- | A burn request that is not accepted returns the funds: the admin rejects
-- it or the owner withdraws it. The admin cannot burn a holding alone, and a
-- holding locked for another workflow cannot fund a burn.
testBurnRequestNotAccepted : Script ()
testBurnRequestNotAccepted = do
  s@Scenario{..} <- setup
  input <- mint admin alice 10.0
  submitMustFail (actAs admin <> discloseMany [rulesDisclosure])
    (burnCmd s [admin] (burnTransfer s alice 10.0 [input]))

  rejectedCid <- pendingCid =<< instructTransfer s [alice] (burnTransfer s alice 10.0 [input])
  _ <- submit (actAs admin) do
    exerciseCmd rejectedCid TransferInstructionV2.TransferInstruction_Reject with
      actors = [admin]
      extraArgs = emptyExtraArgs
  [(returned, _)] <- query @TokenHolding alice
  withdrawnCid <- pendingCid =<< instructTransfer s [alice] (burnTransfer s alice 10.0 [returned])
  _ <- submit (actAs alice) do
    exerciseCmd withdrawnCid TransferInstructionV2.TransferInstruction_Withdraw with
      actors = [alice]
      extraArgs = emptyExtraArgs
  aliceAfter <- holdingAmounts alice
  aliceAfter === [10.0]
  assertNoLocks alice

  [(unlocked, _)] <- query @TokenHolding alice
  _ <- instructTransfer s [alice] (mkTransfer s alice bob 4.0 [unlocked])
  lockedHoldings <- query @TokenHolding alice
  forA_ [cid | (cid, h) <- lockedHoldings, isSome h.holding.lock] $ \lockedCid ->
    submitMustFail (actAs [alice, admin] <> discloseMany [rulesDisclosure])
      (burnCmd s [alice, admin] (burnTransfer s alice 4.0 [lockedCid]))
