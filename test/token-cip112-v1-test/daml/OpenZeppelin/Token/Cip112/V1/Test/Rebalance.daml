-- | Rebalancing outside the registry: `TokenHolding_Merge` and
-- `TokenHolding_Split`, checked against the rules of the bodies in
-- `OpenZeppelin.Token.Cip112.Utils.Holding`: value is conserved, the event
-- carries no transfer legs, only the account parties act, inputs must match
-- the exercised holding's admin, account, and instrument, live locks are
-- refused on every input, and the exercised holding carries no lock at all.
module OpenZeppelin.Token.Cip112.V1.Test.Rebalance where

import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.List (dedup)
import DA.Optional (isSome, optionalToList)
import DA.TextMap qualified as TextMap
import DA.Time (addRelTime, microseconds)
import Daml.Script

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.TransferInstructionV2 qualified as TransferInstructionV2
import Splice.TokenStandard.Utils (basicAccount, reasonFromMeta)

import OpenZeppelin.Token.Cip112.V1.Holding
import OpenZeppelin.Token.Cip112.V1.Transfer
import OpenZeppelin.Token.Cip112.V1.Test.Fixtures
import OpenZeppelin.Token.Cip112.V1.Test.ForeignAllocation (mustFailWith)
import OpenZeppelin.Token.Cip112.V1.Test.Guard (holdingIn, lockedBy)

asHolding : ContractId TokenHolding -> ContractId HoldingV2.Holding
asHolding = toInterfaceContractId

mergeCmd : ContractId TokenHolding -> [ContractId TokenHolding] -> Commands (ContractId HoldingV2.Holding)
mergeCmd cid inputs = exerciseCmd cid TokenHolding_Merge with inputHoldingCids = map asHolding inputs

splitCmd : ContractId TokenHolding -> [Decimal] -> Commands [ContractId HoldingV2.Holding]
splitCmd cid amounts = exerciseCmd cid TokenHolding_Split with amounts

-- | Alice's locked holding from a pending transfer of 7 to bob, funded by a
-- fresh 10. The admin is the only lock holder; the lock expires at `t2`
-- plus the one-hour grace, before `t4`.
aliceLockedHolding : Scenario -> Script (ContractId TokenHolding)
aliceLockedHolding s = snd <$> alicePendingTransfer s

-- | The pending transfer behind `aliceLockedHolding`, and its locked
-- holding.
alicePendingTransfer : Scenario -> Script (ContractId TokenTransferInstruction, ContractId TokenHolding)
alicePendingTransfer s@Scenario{..} = do
  input <- mint admin alice 10.0
  instrCid <- pendingCid =<< instructTransfer s [alice] (mkTransfer s alice bob 7.0 [input])
  locked <- queryFilter @TokenHolding alice (\h -> isSome h.holding.lock)
  case locked of
    [(cid, _)] -> pure (fromInterfaceContractId @TokenTransferInstruction instrCid, cid)
    other -> abort ("expected one locked holding, got " <> show (length other))

-- | An unlocked "TOK" holding created directly by its signatories, in any
-- account and with any metadata.
holdingWith : Scenario -> HoldingV2.Account -> Decimal -> Metadata -> Script (ContractId TokenHolding)
holdingWith Scenario{..} account amount meta =
  submit (actAs (dedup (admin :: optionalToList account.owner <> optionalToList account.provider))) do
    createCmd TokenHolding with
      holding = HoldingV2.HoldingView with
        account
        instrumentId = HoldingV2.InstrumentId with admin; id = "TOK"
        amount
        lock = None
        meta

-- | A holding in alice's second account: the same parties, another id.
aliceSavings : Scenario -> Decimal -> Script (ContractId TokenHolding)
aliceSavings s amount =
  holdingWith s (HoldingV2.Account with owner = Some s.alice; provider = None; id = "savings") amount emptyMetadata

-- | An account with a provider as well as an owner.
custody : Party -> Party -> HoldingV2.Account
custody owner provider = HoldingV2.Account with owner = Some owner; provider = Some provider; id = "custody"

-- | A merge consumes the exercised holding and every input, creates one
-- holding with the summed amount, and emits one account-local event with
-- no transfer legs that names every consumed holding.
testMergeConsolidates : Script ()
testMergeConsolidates = do
  Scenario{..} <- setup
  h1 <- mint admin alice 3.0
  h2 <- mint admin alice 4.0
  h3 <- mint admin alice 5.0
  (mergedCid, tree) <- submitResultAndTree (actAs alice) (mergeCmd h1 [h2, h3])
  holdingAmounts alice >>= (=== [12.0])
  Some merged <- queryInterfaceContractId @HoldingV2.Holding alice mergedCid
  merged.amount === 12.0
  merged.lock === None
  ev <- expectOneHoldingsChange tree
  ev.admin === admin
  ev.account === basicAccount alice
  ev.inputHoldingCids === map asHolding [h1, h2, h3]
  ev.outputHoldingCids === [mergedCid]
  ev.transferLegSides === []
  reasonFromMeta ev.extraArgs.meta === "holdings merged"
  assertMsg "the account parties must observe the event" (alice `elem` ev.observers)

-- | A split creates one holding per amount, in order, and emits one
-- account-local event with no transfer legs. Splitting is the inverse of
-- merging: the parts merge back into the original amount.
testSplitPartitions : Script ()
testSplitPartitions = do
  Scenario{..} <- setup
  h <- mint admin alice 10.0
  (parts, tree) <- submitResultAndTree (actAs alice) (splitCmd h [2.0, 3.0, 5.0])
  length parts === 3
  partAmounts <- forA parts $ \cid -> do
    Some v <- queryInterfaceContractId @HoldingV2.Holding alice cid
    pure v.amount
  partAmounts === [2.0, 3.0, 5.0]
  ev <- expectOneHoldingsChange tree
  ev.inputHoldingCids === [asHolding h]
  ev.outputHoldingCids === parts
  ev.transferLegSides === []
  reasonFromMeta ev.extraArgs.meta === "holding split"
  [p1, p2, p3] <- pure (map (fromInterfaceContractId @TokenHolding) parts)
  _ <- submit (actAs alice) (mergeCmd p3 [p1, p2])
  holdingAmounts alice >>= (=== [10.0])

-- | Only the account parties control the choices: the admin signs every
-- holding but cannot rebalance one alone, and another holder cannot see the
-- holding to try.
testRebalanceNeedsTheAccountParties : Script ()
testRebalanceNeedsTheAccountParties = do
  Scenario{..} <- setup
  h1 <- mint admin alice 3.0
  h2 <- mint admin alice 4.0
  mustFailWith "requires authorizers" (actAs admin) (mergeCmd h1 [h2])
  mustFailWith "requires authorizers" (actAs admin) (splitCmd h1 [1.0, 2.0])
  mustFailWith "Could not find contract" (actAs bob) (mergeCmd h1 [h2])
  mustFailWith "Could not find contract" (actAs bob) (splitCmd h1 [1.0, 2.0])
  holdingAmounts alice >>= (=== [3.0, 4.0])

-- | On an account with a provider, the owner alone and the provider alone
-- are refused, although the body holds both parties' authority as
-- signatories of the holding. Together they merge and split.
testRebalanceNeedsBothAccountParties : Script ()
testRebalanceNeedsBothAccountParties = do
  s@Scenario{..} <- setup
  provider <- allocateParty "provider"
  h1 <- holdingWith s (custody alice provider) 3.0 emptyMetadata
  h2 <- holdingWith s (custody alice provider) 4.0 emptyMetadata
  forA_ [alice, provider] $ \p -> do
    mustFailWith "requires authorizers" (actAs p) (mergeCmd h1 [h2])
    mustFailWith "requires authorizers" (actAs p) (splitCmd h1 [1.0, 2.0])
  merged <- submit (actAs [alice, provider]) (mergeCmd h1 [h2])
  parts <- submit (actAs [alice, provider]) (splitCmd (fromInterfaceContractId merged) [2.0, 5.0])
  views <- forA parts $ \cid -> do
    Some v <- queryInterfaceContractId @HoldingV2.Holding provider cid
    pure (v.account, v.amount)
  views === [(custody alice provider, 2.0), (custody alice provider, 5.0)]

-- | The exercised holding carries no lock: a live lock is refused, and so is
-- an expired one, which would otherwise carry over to the merged holding.
-- As an input of a merge on an unlocked holding, the same expired-lock
-- holding is accepted and the merged holding is unlocked. As with an owner
-- unlock, the pending transfer that named it then fails to return its
-- funding, and the admin's garbage collection removes it.
testRebalanceRefusesALockedHolding : Script ()
testRebalanceRefusesALockedHolding = do
  s@Scenario{..} <- setup
  (instrCid, locked) <- alicePendingTransfer s
  unlocked <- mint admin alice 1.0
  mustFailWith "holding is locked" (actAs alice) (mergeCmd locked [unlocked])
  mustFailWith "holding is locked" (actAs alice) (splitCmd locked [3.0, 4.0])
  setTime t4
  mustFailWith "holding is locked" (actAs alice) (mergeCmd locked [unlocked])
  mustFailWith "holding is locked" (actAs alice) (splitCmd locked [3.0, 4.0])
  _ <- submit (actAs alice) (mergeCmd unlocked [locked])
  assertNoLocks alice
  -- 3 of change from the transfer's funding, then 1 + 7 merged.
  holdingAmounts alice >>= (=== [3.0, 8.0])
  mustFailWith "Could not find contract" (actAs alice) do
    exerciseCmd (toInterfaceContractId @TransferInstructionV2.TransferInstruction instrCid)
      TransferInstructionV2.TransferInstruction_Withdraw with actors = [alice]; extraArgs = emptyExtraArgs
  mustFailWith "Could not find contract" (actAs admin) do exerciseCmd instrCid TokenTransferInstruction_Expire
  _ <- submit (actAs admin) do exerciseCmd instrCid TokenTransferInstruction_AdminGC
  queryContractId admin instrCid >>= (=== None)
  holdingAmounts alice >>= (=== [3.0, 8.0])

-- | An input with a live lock is refused, so a merge never consumes funding
-- a pending transfer or allocation still names.
testMergeRefusesALiveLockedInput : Script ()
testMergeRefusesALiveLockedInput = do
  s@Scenario{..} <- setup
  locked <- aliceLockedHolding s
  unlocked <- mint admin alice 1.0
  mustFailWith "input holding lock expiresAt" (actAs alice) (mergeCmd unlocked [locked])
  Some _ <- queryContractId alice locked
  pure ()

-- | An input is refused one microsecond before its lock's `expiresAt` and
-- accepted from `expiresAt` on.
testMergeInputLockBoundary : Script ()
testMergeInputLockBoundary = do
  Scenario{..} <- setup
  h <- mint admin alice 1.0
  input <- holdingIn admin (basicAccount alice) "TOK" 5.0 (lockedBy [admin] (Some t2))
  setTime (t2 `addRelTime` microseconds (-1))
  mustFailWith "input holding lock expiresAt" (actAs alice) (mergeCmd h [input])
  setTime t2
  _ <- submit (actAs alice) (mergeCmd h [input])
  holdingAmounts alice >>= (=== [6.0])

-- | The merge body holds the admin's authority, so archiving a holding
-- whose account parties are all within it raises no authorization error:
-- the admin's own holding, or one alice owns with the admin as provider.
-- The account check refuses both, and both stay active.
testMergeRefusesInputsTheAdminSigns : Script ()
testMergeRefusesInputsTheAdminSigns = do
  s@Scenario{..} <- setup
  h <- mint admin alice 1.0
  treasury <- mint admin admin 50.0
  Some treasuryDisclosure <- queryDisclosure admin treasury
  mustFailWith "'inputHolding.account' is not equal to" (actAs alice <> discloseMany [treasuryDisclosure])
    (mergeCmd h [treasury])
  custodied <- holdingWith s (custody alice admin) 9.0 emptyMetadata
  mustFailWith "'inputHolding.account' is not equal to" (actAs alice) (mergeCmd h [custodied])
  Some _ <- queryContractId admin treasury
  Some _ <- queryContractId alice custodied
  holdingAmounts alice >>= (=== [1.0, 9.0])

-- | Every input must share the exercised holding's instrument, account, and
-- admin. The refusals name the field, so they cannot pass for an
-- authorization failure: the other account belongs to the same parties, and
-- alice is the only signatory of a holding she issues to herself. Another
-- admin's holding fails sooner: the merge body holds only this holding's
-- signatories' authority, so archiving it fails for want of the other
-- admin, even when that admin submits too.
testMergeRefusesMismatchedInputs : Script ()
testMergeRefusesMismatchedInputs = do
  s@Scenario{..} <- setup
  h <- mint admin alice 3.0
  other <- mintOf admin alice "OTHER" 4.0
  mustFailWith "'inputHolding.instrumentId.id' is not equal to" (actAs alice) (mergeCmd h [other])
  savings <- aliceSavings s 4.0
  mustFailWith "'inputHolding.account' is not equal to" (actAs alice) (mergeCmd h [savings])
  otherAdmin <- allocateParty "otherAdmin"
  foreignTok <- mint otherAdmin alice 4.0
  mustFailWith "requires authorizers" (actAs [alice, otherAdmin]) (mergeCmd h [foreignTok])
  selfIssued <- holdingIn alice (basicAccount alice) "TOK" 1000000.0 None
  mustFailWith "'inputHolding.instrumentId.admin' is not equal to" (actAs alice) (mergeCmd h [selfIssued])
  holdingAmounts alice >>= (=== [3.0, 4.0, 4.0, 4.0, 1000000.0])

-- | A merge needs at least one input, and the inputs must be distinct and
-- exclude the exercised holding, so no holding is counted twice.
testMergeRefusesBadInputLists : Script ()
testMergeRefusesBadInputLists = do
  Scenario{..} <- setup
  h1 <- mint admin alice 3.0
  h2 <- mint admin alice 4.0
  mustFailWith "merge requires at least one input holding" (actAs alice) (mergeCmd h1 [])
  mustFailWith "merge inputs must be distinct" (actAs alice) (mergeCmd h1 [h1])
  mustFailWith "merge inputs must be distinct" (actAs alice) (mergeCmd h1 [h2, h2])
  holdingAmounts alice >>= (=== [3.0, 4.0])

-- | A split's amounts are at least two, each positive, and sum to the
-- holding's amount exactly, so a split neither creates nor destroys value.
testSplitRefusesBadAmounts : Script ()
testSplitRefusesBadAmounts = do
  Scenario{..} <- setup
  h <- mint admin alice 10.0
  mustFailWith "split requires at least two amounts" (actAs alice) (splitCmd h [])
  mustFailWith "split requires at least two amounts" (actAs alice) (splitCmd h [10.0])
  mustFailWith "split amounts must be positive" (actAs alice) (splitCmd h [10.0, 0.0])
  mustFailWith "split amounts must be positive" (actAs alice) (splitCmd h [12.0, -2.0])
  mustFailWith "'sum of split amounts' is not equal to" (actAs alice) (splitCmd h [4.0, 5.0])
  mustFailWith "'sum of split amounts' is not equal to" (actAs alice) (splitCmd h [4.0, 7.0])
  -- The smallest Decimal step still counts.
  mustFailWith "'sum of split amounts' is not equal to" (actAs alice) (splitCmd h [4.0, 6.0000000001])
  _ <- submit (actAs alice) (splitCmd h [9.9999999999, 0.0000000001])
  holdingAmounts alice >>= (=== [0.0000000001, 9.9999999999])

-- | A merge keeps the exercised holding's `meta` and drops the input's, and
-- a split copies the `meta` onto every part.
testRebalanceKeepsTheExercisedView : Script ()
testRebalanceKeepsTheExercisedView = do
  s@Scenario{..} <- setup
  let tagged t = Metadata with values = TextMap.fromList [("tag", t)]
  exercised <- holdingWith s (basicAccount alice) 3.0 (tagged "exercised")
  input <- holdingWith s (basicAccount alice) 4.0 (tagged "input")
  merged <- submit (actAs alice) (mergeCmd exercised [input])
  Some mergedView <- queryInterfaceContractId @HoldingV2.Holding alice merged
  mergedView.meta === tagged "exercised"
  parts <- submit (actAs alice) (splitCmd (fromInterfaceContractId merged) [3.5, 3.5])
  forA_ parts $ \cid -> do
    Some v <- queryInterfaceContractId @HoldingV2.Holding alice cid
    (v.amount, v.meta) === (3.5, tagged "exercised")
