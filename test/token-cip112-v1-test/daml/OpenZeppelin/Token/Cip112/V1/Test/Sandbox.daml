-- | Sandbox validation for the token package: mint offers, transfers,
-- querying, burn requests, and what each authorizer of a batch settlement
-- witnesses, against a real Canton ledger over the Ledger API.
-- `scripts/check-sandbox.sh` runs each script over gRPC against a static-time
-- sandbox; the same scripts also run under `dpm test` on the in-memory
-- ledger.
--
-- Every script allocates fresh parties and pins the clock to `t1`, so the
-- scripts compose in any order on one forward-only static-time ledger.
module OpenZeppelin.Token.Cip112.V1.Test.Sandbox where

import DA.Assert ((===))
import DA.TextMap qualified as TextMap
import Daml.Script

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.Api.Token.TransferInstructionV2 qualified as TransferInstructionV2
import Splice.TokenStandard.Utils (basicAccount, nonIteratedAllocation, receiverSide, senderSide)

import OpenZeppelin.Token.Cip112.V1.Allocation (TokenAllocation)
import OpenZeppelin.Token.Cip112.V1.Holding (TokenHolding)
import OpenZeppelin.Token.Cip112.V1.Test.AuthorizerContext
import OpenZeppelin.Token.Cip112.V1.Test.Fixtures

-- | Token creation and querying: holdings appear in owner queries, and the
-- balance view is projection-scoped, so one owner cannot read another
-- owner's holding.
sandboxMintAndQuery : Script ()
sandboxMintAndQuery = do
  s@Scenario{..} <- setupPrefixed "mintandquery-"
  aliceCid <- mint admin alice 100.0
  bobCid <- mint admin bob 50.0
  aliceAmounts <- holdingAmounts alice
  aliceAmounts === [100.0]
  bobAmounts <- holdingAmounts bob
  bobAmounts === [50.0]
  bobViewOfAlice <- queryContractId bob aliceCid
  bobViewOfAlice === None
  aliceViewOfBob <- queryContractId alice bobCid
  aliceViewOfBob === None

-- | Transfer over the standard interface: one step with both sides acting,
-- two steps with the receiver accepting a pending instruction.
sandboxTransferLifecycle : Script ()
sandboxTransferLifecycle = do
  s@Scenario{..} <- setupPrefixed "transferlifecycle-"
  input1 <- mint admin alice 10.0
  oneStep <- instructTransfer s [alice, bob] (mkTransfer s alice bob 7.0 [input1])
  _ <- completedHoldings oneStep
  input2 <- mint admin alice 5.0
  twoStep <- instructTransfer s [alice] (mkTransfer s alice bob 2.0 [input2])
  instrCid <- pendingCid twoStep
  funding <- instructionDisclosures admin instrCid
  _ <- submit (actAs bob <> discloseMany funding) do
    exerciseCmd instrCid TransferInstructionV2.TransferInstruction_Accept with
      actors = [bob]
      extraArgs = emptyExtraArgs
  aliceAfter <- holdingAmounts alice
  aliceAfter === [3.0, 3.0]
  bobAfter <- holdingAmounts bob
  bobAfter === [2.0, 7.0]
  assertNoLocks alice
  assertNoLocks bob

-- | A mint offer from the admin, accepted by the receiver in a separate
-- submission, then a burn request from the holder, accepted by the admin in a
-- separate submission.
sandboxMintAndBurn : Script ()
sandboxMintAndBurn = do
  s@Scenario{..} <- setupPrefixed "mintandburn-"
  offerCid <- submit (actAs admin) (offerMintCmd s alice 10.0)
  [mintedCid] <- completedHoldings =<< submit (actAs alice) (acceptCmd alice offerCid)
  aliceMinted <- holdingAmounts alice
  aliceMinted === [10.0]
  requestCid <- pendingCid =<< instructTransfer s [alice]
    (burnTransfer s alice 10.0 [fromInterfaceContractId @TokenHolding mintedCid])
  _ <- submit (actAs admin) (acceptCmd admin requestCid)
  aliceAfter <- holdingAmounts alice
  aliceAfter === []

-- | The contracts a party must and must not witness. Contract ids are
-- coerced to one type so the list serializes as JSON.
data Witnessing = Witnessing with
    party : Party
    witnessed : [ContractId ()]
    hidden : [ContractId ()]
  deriving (Eq, Show)

-- | A batch settlement shows each authorizer its own entry of the batch
-- context and nothing else. Alice sends Bob 10 TOK for 4 USD through a
-- factory whose selector keys on the authorizer. The batch context holds an
-- entry for Alice, one for Bob, and one for neither, each the id of a
-- contract only the admin knows. The executor's tree shows each
-- `Allocation_Settle` carrying its own authorizer's entry.
--
-- Daml Script reads a transaction only as its submitter, the executor, so
-- the script returns what each authorizer must witness, its settled
-- allocation and its payout, and the entries it must not see anywhere.
-- `scripts/check-sandbox.sh` reads each authorizer's own transactions from
-- the JSON Ledger API and checks them against that list.
sandboxSettleBatchContextWitnesses : Script [Witnessing]
sandboxSettleBatchContextWitnesses = do
  s@Scenario{..} <- setupPrefixed "settlecontext-"
  (factoryCid, factoryDisclosure) <- createAuthorizerContextRules admin
  let legUsd = (mkTransferLeg "leg-usd" bob alice 4.0) with instrumentId = "USD"
  aliceInput <- mint admin alice 10.0
  bobInput <- mintOf admin bob "USD" 4.0
  aliceAlloc <- completedCid =<< allocate s alice [senderSide legAliceToBob, receiverSide legUsd] [aliceInput]
  bobAlloc <- completedCid =<< allocate s bob [receiverSide legAliceToBob, senderSide legUsd] [bobInput]
  aliceEntry <- newEntry admin "alice"
  bobEntry <- newEntry admin "bob"
  batchEntry <- newEntry admin "batch"
  funding <- allocationDisclosures admin [aliceAlloc, bobAlloc]
  (result, tree) <- submitResultAndTree (actAs app <> discloseMany (factoryDisclosure :: funding)) do
    exerciseCmd (toInterfaceContractId @AllocationV2.SettlementFactory factoryCid)
      AllocationV2.SettlementFactory_SettleBatch with
        settlement
        transferLegs = [legAliceToBob, legUsd]
        allocations = map nonIteratedAllocation [aliceAlloc, bobAlloc]
        actors = [app]
        extraArgs = ExtraArgs with
          context = ChoiceContext $ TextMap.fromList
            [ (authorizerKey (basicAccount alice), entryValue aliceEntry)
            , (authorizerKey (basicAccount bob), entryValue bobEntry)
            , ("venue.example/batch-only", entryValue batchEntry) ]
          meta = emptyMetadata
  let settles = concatMap allocationSettlesWithCid tree.rootEvents
      contextOf cid = (.extraArgs.context.values) <$> lookup (fromInterfaceContractId @TokenAllocation cid) settles
  contextOf aliceAlloc === Some (TextMap.fromList [(entryKey, entryValue aliceEntry)])
  contextOf bobAlloc === Some (TextMap.fromList [(entryKey, entryValue bobEntry)])
  [aliceResult, bobResult] <- pure result.allocationSettleResults
  Some [alicePayout] <- pure (TextMap.lookup "USD" aliceResult.authorizerHoldingCids)
  Some [bobPayout] <- pure (TextMap.lookup "TOK" bobResult.authorizerHoldingCids)
  holdingAmounts alice >>= (=== [4.0])
  holdingAmounts bob >>= (=== [10.0])

  let anyCid : ContractId t -> ContractId ()
      anyCid = coerceContractId
  pure
    [ Witnessing with
        party = alice
        witnessed = [anyCid aliceAlloc, anyCid alicePayout]
        hidden = [anyCid bobEntry, anyCid batchEntry]
    , Witnessing with
        party = bob
        witnessed = [anyCid bobAlloc, anyCid bobPayout]
        hidden = [anyCid aliceEntry, anyCid batchEntry]
    ]
