-- | Sandbox validation for the token package: mint offers, transfers,
-- querying, burn requests, merges and splits, and what each authorizer of a
-- batch settlement witnesses, against a real Canton ledger over the Ledger
-- API.
-- `scripts/check-sandbox.sh` runs each script over gRPC against a static-time
-- sandbox; the same scripts also run under `dpm test` on the in-memory
-- ledger.
--
-- Every script allocates fresh parties and pins the clock to `t1`.
-- `sandboxBatchExpiryWitnesses` then sets the clock to `t3` and must run
-- last. The other scripts run in any order on one static-time ledger.
module OpenZeppelin.Token.Cip112.V1.Test.Sandbox where

import DA.Assert ((===))
import DA.Optional (optionalToList)
import DA.TextMap qualified as TextMap
import Daml.Script

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.Api.Token.TransferInstructionV2 qualified as TransferInstructionV2
import Splice.TokenStandard.Utils (basicAccount, nonIteratedAllocation, receiverSide, senderSide)

import OpenZeppelin.Token.Cip112.V1.Allocation (TokenAllocation)
import OpenZeppelin.Token.Cip112.V1.Holding (TokenHolding, TokenHolding_Merge(..), TokenHolding_Split(..))
import OpenZeppelin.Token.Cip112.V1.Registry
import OpenZeppelin.Token.Cip112.V1.Test.AuthorizerContext
import OpenZeppelin.Token.Cip112.V1.Transfer (TokenTransferInstruction, TokenTransferInstruction_Expire(..))
import OpenZeppelin.Token.Cip112.V1.Test.Fixtures

-- | Token creation and querying: holdings appear in owner queries, and the
-- balance view is projection-scoped, so one owner cannot read another
-- owner's holding.
sandboxMintAndQuery : Script ()
sandboxMintAndQuery = do
  s@Scenario{..} <- setupPrefixed "mintandquery-"
  aliceCid <- mint admin alice 100.0
  bobCid <- mint admin bob 50.0
  aliceAmounts <- holdingAmounts alice
  aliceAmounts === [100.0]
  bobAmounts <- holdingAmounts bob
  bobAmounts === [50.0]
  bobViewOfAlice <- queryContractId bob aliceCid
  bobViewOfAlice === None
  aliceViewOfBob <- queryContractId alice bobCid
  aliceViewOfBob === None

-- | Transfer over the standard interface: one step with both sides acting,
-- two steps with the receiver accepting a pending instruction.
sandboxTransferLifecycle : Script ()
sandboxTransferLifecycle = do
  s@Scenario{..} <- setupPrefixed "transferlifecycle-"
  input1 <- mint admin alice 10.0
  oneStep <- instructTransfer s [alice, bob] (mkTransfer s alice bob 7.0 [input1])
  _ <- completedHoldings oneStep
  input2 <- mint admin alice 5.0
  twoStep <- instructTransfer s [alice] (mkTransfer s alice bob 2.0 [input2])
  instrCid <- pendingCid twoStep
  funding <- instructionDisclosures admin instrCid
  _ <- submit (actAs bob <> discloseMany funding) do
    exerciseCmd instrCid TransferInstructionV2.TransferInstruction_Accept with
      actors = [bob]
      extraArgs = emptyExtraArgs
  aliceAfter <- holdingAmounts alice
  aliceAfter === [3.0, 3.0]
  bobAfter <- holdingAmounts bob
  bobAfter === [2.0, 7.0]
  assertNoLocks alice
  assertNoLocks bob

-- | A mint offer from the admin, accepted by the receiver in a separate
-- submission, then a burn request from the holder, accepted by the admin in a
-- separate submission.
sandboxMintAndBurn : Script ()
sandboxMintAndBurn = do
  s@Scenario{..} <- setupPrefixed "mintandburn-"
  offerCid <- submit (actAs admin) (offerMintCmd s alice 10.0)
  [mintedCid] <- completedHoldings =<< submit (actAs alice) (acceptCmd alice offerCid)
  aliceMinted <- holdingAmounts alice
  aliceMinted === [10.0]
  requestCid <- pendingCid =<< instructTransfer s [alice]
    (burnTransfer s alice 10.0 [fromInterfaceContractId @TokenHolding mintedCid])
  _ <- submit (actAs admin) (acceptCmd admin requestCid)
  aliceAfter <- holdingAmounts alice
  aliceAfter === []

-- | The contracts a party must and must not witness. Contract ids are
-- coerced to one type so the list serializes as JSON.
data Witnessing = Witnessing with
    party : Party
    witnessed : [ContractId ()]
    hidden : [ContractId ()]
  deriving (Eq, Show)

-- | Batched admin expiry shows each party only its own items. Two
-- allocations with different executors expire in one batch, and so do two
-- transfer instructions with different receivers.
--
-- Returns what each executor and receiver must and must not witness.
-- `scripts/check-sandbox.sh` checks the returned list, as `CONTRIBUTING.md`
-- explains.
sandboxBatchExpiryWitnesses : Script [Witnessing]
sandboxBatchExpiryWitnesses = do
  s@Scenario{..} <- setupPrefixed "batchexpiry-"
  app2 <- allocateParty "batchexpiry-app2"
  carol <- allocateParty "batchexpiry-carol"
  dave <- allocateParty "batchexpiry-dave"
  -- Alice's allocation is executed by `app`, Bob's by `app2`.
  aliceAllocInput <- mint admin alice 10.0
  aliceAlloc <- completedCid =<< allocate s alice [senderSide legAliceToBob] [aliceAllocInput]
  bobAllocInput <- mint admin bob 4.0
  let s2 = s with settlement = settlement with executors = [app2]; id = "settlement-2"
  bobAlloc <- completedCid =<< allocate s2 bob [senderSide legBobToAlice] [bobAllocInput]
  aliceInstrInput <- mint admin alice 3.0
  aliceInstr <- pendingCid =<< instructTransfer s [alice] (mkTransfer s alice carol 3.0 [aliceInstrInput])
  bobInstrInput <- mint admin bob 2.0
  bobInstr <- pendingCid =<< instructTransfer s [bob] (mkTransfer s bob dave 2.0 [bobInstrInput])
  setTime t3

  let cancel = AllocationV2.Allocation_Cancel with actors = [admin]; extraArgs = emptyExtraArgs
  allocTree <- submitTree (actAs admin <> discloseMany [rulesDisclosure]) do
    exerciseCmd rulesCid TokenRules_ExpireAllocations with
      cancelArgs = [(aliceAlloc, cancel), (bobAlloc, cancel)]
  aliceReleased <- releasedBy (fromInterfaceContractId @TokenAllocation aliceAlloc) allocTree
  bobReleased <- releasedBy (fromInterfaceContractId @TokenAllocation bobAlloc) allocTree

  let aliceInstrCid = fromInterfaceContractId @TokenTransferInstruction aliceInstr
      bobInstrCid = fromInterfaceContractId @TokenTransferInstruction bobInstr
  instrTree <- submitTree (actAs admin <> discloseMany [rulesDisclosure]) do
    exerciseCmd rulesCid TokenRules_ExpireTransferInstructions with
      expireArgs =
        [ (aliceInstrCid, TokenTransferInstruction_Expire with extraArgs = emptyExtraArgs)
        , (bobInstrCid, TokenTransferInstruction_Expire with extraArgs = emptyExtraArgs) ]
  aliceReturned <- releasedBy aliceInstrCid instrTree
  bobReturned <- releasedBy bobInstrCid instrTree

  aliceAfter <- holdingAmounts alice
  aliceAfter === [3.0, 10.0]
  bobAfter <- holdingAmounts bob
  bobAfter === [2.0, 4.0]
  assertNoLocks alice
  assertNoLocks bob

  let anyCid : ContractId t -> ContractId ()
      anyCid = coerceContractId
      aliceAllocItem = [anyCid aliceAlloc, anyCid aliceReleased]
      bobAllocItem = [anyCid bobAlloc, anyCid bobReleased]
      aliceInstrItem = [anyCid aliceInstr, anyCid aliceReturned]
      bobInstrItem = [anyCid bobInstr, anyCid bobReturned]
  pure
    [ Witnessing with party = app; witnessed = aliceAllocItem; hidden = bobAllocItem
    , Witnessing with party = app2; witnessed = bobAllocItem; hidden = aliceAllocItem
    , Witnessing with party = carol; witnessed = aliceInstrItem; hidden = bobInstrItem
    , Witnessing with party = dave; witnessed = bobInstrItem; hidden = aliceInstrItem
    ]

-- | The one holding created under the exercise on `cid` in `tree`: what an
-- allocation's cancel or an instruction's expiry releases. Fails if the
-- tree holds no exercise on `cid`.
releasedBy : Template t => ContractId t -> TransactionTree -> Script (ContractId TokenHolding)
releasedBy cid tree = case concatMap (createdUnder cid False) tree.rootEvents of
  [holdingCid] -> pure holdingCid
  cids -> abort ("expected one released holding, got " <> show (length cids))

-- | The holdings created below an exercise on `cid`, once `inside` it.
-- Recursion lives at the top level because Daml rejects recursive local
-- bindings.
createdUnder : Template t => ContractId t -> Bool -> TreeEvent -> [ContractId TokenHolding]
createdUnder _ inside (CreatedEvent c)
  | inside = optionalToList (fromAnyContractId @TokenHolding c.contractId)
  | otherwise = []
createdUnder cid inside (ExercisedEvent ex) =
  concatMap (createdUnder cid (inside || fromAnyContractId ex.contractId == Some cid)) ex.childEvents

-- | A batch settlement shows each authorizer its own entry of the batch
-- context and nothing else. Alice sends Bob 10 TOK for 4 USD through a
-- factory whose selector keys on the authorizer. The batch context holds an
-- entry for Alice, one for Bob, and one for neither, each the id of a
-- contract only the admin knows.
--
-- Returns what each authorizer must and must not witness.
-- `scripts/check-sandbox.sh` checks the returned list, as `CONTRIBUTING.md`
-- explains.
sandboxSettleBatchContextWitnesses : Script [Witnessing]
sandboxSettleBatchContextWitnesses = do
  s@Scenario{..} <- setupPrefixed "settlecontext-"
  (factoryCid, factoryDisclosure) <- createAuthorizerContextRules admin
  let legUsd = (mkTransferLeg "leg-usd" bob alice 4.0) with instrumentId = "USD"
  aliceInput <- mint admin alice 10.0
  bobInput <- mintOf admin bob "USD" 4.0
  aliceAlloc <- completedCid =<< allocate s alice [senderSide legAliceToBob, receiverSide legUsd] [aliceInput]
  bobAlloc <- completedCid =<< allocate s bob [receiverSide legAliceToBob, senderSide legUsd] [bobInput]
  aliceEntry <- newEntry admin "alice"
  bobEntry <- newEntry admin "bob"
  batchEntry <- newEntry admin "batch"
  funding <- allocationDisclosures admin [aliceAlloc, bobAlloc]
  (result, tree) <- submitResultAndTree (actAs app <> discloseMany (factoryDisclosure :: funding)) do
    exerciseCmd (toInterfaceContractId @AllocationV2.SettlementFactory factoryCid)
      AllocationV2.SettlementFactory_SettleBatch with
        settlement
        transferLegs = [legAliceToBob, legUsd]
        allocations = map nonIteratedAllocation [aliceAlloc, bobAlloc]
        actors = [app]
        extraArgs = ExtraArgs with
          context = ChoiceContext $ TextMap.fromList
            [ (authorizerKey (basicAccount alice), entryValue aliceEntry)
            , (authorizerKey (basicAccount bob), entryValue bobEntry)
            , ("venue.example/batch-only", entryValue batchEntry) ]
          meta = emptyMetadata
  let settles = concatMap allocationSettlesWithCid tree.rootEvents
      contextOf cid = (.extraArgs.context.values) <$> lookup (fromInterfaceContractId @TokenAllocation cid) settles
  contextOf aliceAlloc === Some (TextMap.fromList [(entryKey, entryValue aliceEntry)])
  contextOf bobAlloc === Some (TextMap.fromList [(entryKey, entryValue bobEntry)])
  [aliceResult, bobResult] <- pure result.allocationSettleResults
  Some [alicePayout] <- pure (TextMap.lookup "USD" aliceResult.authorizerHoldingCids)
  Some [bobPayout] <- pure (TextMap.lookup "TOK" bobResult.authorizerHoldingCids)
  holdingAmounts alice >>= (=== [4.0])
  holdingAmounts bob >>= (=== [10.0])

  let anyCid : ContractId t -> ContractId ()
      anyCid = coerceContractId
  pure
    [ Witnessing with
        party = alice
        witnessed = [anyCid aliceAlloc, anyCid alicePayout]
        hidden = [anyCid bobEntry, anyCid batchEntry]
    , Witnessing with
        party = bob
        witnessed = [anyCid bobAlloc, anyCid bobPayout]
        hidden = [anyCid aliceEntry, anyCid batchEntry]
    ]

-- | The account parties rebalance outside the registry: two holdings merge
-- into one, which then splits into two other amounts.
sandboxMergeAndSplit : Script ()
sandboxMergeAndSplit = do
  Scenario{..} <- setupPrefixed "mergeandsplit-"
  h1 <- mint admin alice 3.0
  h2 <- mint admin alice 7.0
  mergedCid <- submit (actAs alice) do
    exerciseCmd h1 TokenHolding_Merge with inputHoldingCids = [toInterfaceContractId h2]
  merged <- holdingAmounts alice
  merged === [10.0]
  _ <- submit (actAs alice) do
    exerciseCmd (fromInterfaceContractId @TokenHolding mergedCid) TokenHolding_Split with amounts = [4.0, 6.0]
  aliceAfter <- holdingAmounts alice
  aliceAfter === [4.0, 6.0]
  assertNoLocks alice
