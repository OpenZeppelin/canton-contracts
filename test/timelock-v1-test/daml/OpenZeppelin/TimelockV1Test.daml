-- | Tests for `OpenZeppelin.TimelockV1`: the schedule functions, the
-- pending-list functions, the guards, and the failure statuses.
module OpenZeppelin.TimelockV1Test where

import DA.Assert ((===))
import DA.Fail (FailureStatus)
import DA.Time (addRelTime, days, hours, minutes, microseconds)
import Daml.Script

import OpenZeppelin.Api.TimelockV1
import OpenZeppelin.TimelockV1
import OpenZeppelin.TimelockV1TestFixtures

data Fixture = Fixture with
  caller : Party
  probe : ContractId Probe
  t0 : Time

setup : Script Fixture
setup = do
  caller <- allocateParty "caller"
  probe <- submit caller do createCmd Probe with caller
  t0 <- getTime
  pure Fixture with ..

oneDayWeekGrace : TimelockConfig
oneDayWeekGrace = TimelockConfig with minDelay = days 1, gracePeriod = Some (days 7)

-- | Create a `Scheduled` operation and return it as a `Timelocked`.
scheduled : Fixture -> Time -> Optional Time -> Script (ContractId Timelocked)
scheduled Fixture{..} readyAt expiresAt = toInterfaceContractId <$> submit caller do
  createCmd Scheduled with owner = caller, readyAt, expiresAt

-- A failure reaches the submitter as the library's `FailureStatus`, whole:
-- id, category, message, and metadata.
isFailureWith : FailureStatus -> SubmitError -> Bool
isFailureWith status (FailureStatusError actual) = actual == status
isFailureWith _ _ = False

expectFailure : FailureStatus -> Either SubmitError a -> Script ()
expectFailure status (Left e) = assertMsg ("expected " <> status.errorId) (isFailureWith status e)
expectFailure status (Right _) = fail ("expected " <> status.errorId <> " but the submission succeeded")

-- Scheduling
-------------------------------------------------------

-- | `scheduleAt` stores the requested `readyAt` and derives `expiresAt` from
-- the grace period.
test_scheduleAtDerivesTheView : Script ()
test_scheduleAtDerivesTheView = script do
  Fixture{..} <- setup
  let readyAt = addRelTime t0 (days 2)
  v <- submit caller do
    exerciseCmd probe Probe_ScheduleAt with config = oneDayWeekGrace, readyAt
  v === TimelockedView with readyAt, expiresAt = Some (addRelTime readyAt (days 7))

-- | `scheduleAfter` measures the delay from the ledger time.
test_scheduleAfterDerivesTheView : Script ()
test_scheduleAfterDerivesTheView = script do
  Fixture{..} <- setup
  v <- submit caller do
    exerciseCmd probe Probe_ScheduleAfter with config = oneDayWeekGrace, delay = days 3
  v.readyAt === addRelTime t0 (days 3)
  v.expiresAt === Some (addRelTime t0 (days 10))

-- | A `readyAt` closer than `minDelay` is refused. INV-1.
test_scheduleAtRejectsShortDelay : Script ()
test_scheduleAtRejectsShortDelay = script do
  Fixture{..} <- setup
  r <- trySubmit caller do
    exerciseCmd probe Probe_ScheduleAt with
      config = oneDayWeekGrace, readyAt = addRelTime t0 (hours 23)
  expectFailure eDelayTooShort r

-- | A `readyAt` exactly `minDelay` away is accepted: the bound is inclusive.
test_scheduleAtAcceptsExactMinDelay : Script ()
test_scheduleAtAcceptsExactMinDelay = script do
  Fixture{..} <- setup
  _ <- submit caller do
    exerciseCmd probe Probe_ScheduleAt with
      config = oneDayWeekGrace, readyAt = addRelTime t0 (days 1)
  pure ()

-- | A relative delay shorter than `minDelay` is refused. INV-1.
test_scheduleAfterRejectsShortDelay : Script ()
test_scheduleAfterRejectsShortDelay = script do
  Fixture{..} <- setup
  r <- trySubmit caller do
    exerciseCmd probe Probe_ScheduleAfter with config = oneDayWeekGrace, delay = hours 1
  expectFailure eDelayTooShort r

-- | No grace period means no expiry.
test_noGracePeriodNeverExpires : Script ()
test_noGracePeriodNeverExpires = script do
  Fixture{..} <- setup
  let config = TimelockConfig with minDelay = days 1, gracePeriod = None
  v <- submit caller do
    exerciseCmd probe Probe_ScheduleAt with config, readyAt = addRelTime t0 (days 1)
  v.expiresAt === None

-- | A `readyAt` at the maximum time fails: `expiresAt` cannot be computed, so
-- `Time` arithmetic aborts the transaction.
test_scheduleNearMaxTimeFails : Script ()
test_scheduleNearMaxTimeFails = script do
  Fixture{..} <- setup
  submitMustFail caller do
    exerciseCmd probe Probe_ScheduleAt with config = oneDayWeekGrace, readyAt = maxBound

-- Policy validation
-------------------------------------------------------

-- | A zero grace period leaves no ledger time at which an operation is ready,
-- so the schedule refuses the policy instead of creating a stillborn
-- operation. INV-7.
test_zeroGracePeriodRejected : Script ()
test_zeroGracePeriodRejected = script do
  Fixture{..} <- setup
  let config = TimelockConfig with minDelay = days 1, gracePeriod = Some (hours 0)
  r <- trySubmit caller do
    exerciseCmd probe Probe_ScheduleAt with config, readyAt = addRelTime t0 (days 1)
  expectFailure eInvalidConfig r
  r2 <- trySubmit caller do
    exerciseCmd probe Probe_ScheduleAfter with config, delay = days 1
  expectFailure eInvalidConfig r2

-- | A negative minimum delay would widen the acceptance window instead of
-- disabling the delay, so it is refused. INV-7.
test_negativeMinDelayRejected : Script ()
test_negativeMinDelayRejected = script do
  Fixture{..} <- setup
  let config = TimelockConfig with minDelay = negate (hours 1), gracePeriod = None
  r <- trySubmit caller do
    exerciseCmd probe Probe_ScheduleAt with config, readyAt = t0
  expectFailure eInvalidConfig r

-- | Both fields at zero is the most extreme misconfiguration. INV-7.
test_bothZeroRejected : Script ()
test_bothZeroRejected = script do
  Fixture{..} <- setup
  let config = TimelockConfig with minDelay = hours 0, gracePeriod = Some (hours 0)
  r <- trySubmit caller do
    exerciseCmd probe Probe_ScheduleAt with config, readyAt = t0
  expectFailure eInvalidConfig r
  r2 <- trySubmit caller do
    exerciseCmd probe Probe_RequireValidConfig with config
  expectFailure eInvalidConfig r2
  isValidConfig (TimelockConfig with minDelay = hours 0, gracePeriod = Some (microseconds 1)) === True
  isValidConfig (TimelockConfig with minDelay = hours 0, gracePeriod = None) === True

-- The pending list
-------------------------------------------------------

-- | `addPending` records an operation, and `takePending` removes it or fails
-- with `eNotPending`. INV-3.
test_takePendingRequiresMembership : Script ()
test_takePendingRequiresMembership = script do
  f@Fixture{..} <- setup
  op <- scheduled f t0 None
  other <- scheduled f t0 None
  let pending = addPending op []
  pending === [op]
  rest <- submit caller do
    exerciseCmd probe Probe_TakePending with op, pending
  rest === []
  r <- trySubmit caller do
    exerciseCmd probe Probe_TakePending with op = other, pending
  expectFailure eNotPending r

-- Guards
-------------------------------------------------------

-- | The pure predicates agree with the guards at the boundaries.
test_purePredicatesMatchTheGuards : Script ()
test_purePredicatesMatchTheGuards = script do
  Fixture{..} <- setup
  let readyAt = addRelTime t0 (days 2)
      expiresAt = addRelTime readyAt (days 7)
      op = Scheduled with owner = caller; readyAt; expiresAt = Some expiresAt
  isReadyAt t0 op === False
  isReadyAt (addRelTime readyAt (negate (minutes 1))) op === False
  isReadyAt readyAt op === True
  isReadyAt (addRelTime expiresAt (negate (minutes 1))) op === True
  isReadyAt expiresAt op === False
  isExpiredAt readyAt op === False
  isExpiredAt expiresAt op === True
  isExpiredAt expiresAt (op with expiresAt = None) === False

-- | `requireReady` fails before `readyAt` and at `expiresAt`, and accepts a
-- bare `Timelocked`. The check changes nothing.
test_requireReadyBounds : Script ()
test_requireReadyBounds = script do
  f@Fixture{..} <- setup
  target <- scheduled f (addRelTime t0 (days 2)) (Some (addRelTime t0 (days 9)))
  r <- trySubmit caller do exerciseCmd probe Probe_RequireReady with target
  expectFailure eNotReady r
  ready <- submit caller do
    exerciseCmd probe Probe_IsReadyAt with target, at = addRelTime t0 (days 2)
  ready === True
  passTime (days 2)
  submit caller do exerciseCmd probe Probe_RequireReady with target
  passTime (days 7)
  r2 <- trySubmit caller do exerciseCmd probe Probe_RequireReady with target
  expectFailure eExpired r2
  Some _ <- queryInterfaceContractId caller target
  pure ()

-- | `requireExpired` fails before `expiresAt` and on an operation without one.
test_requireExpiredBounds : Script ()
test_requireExpiredBounds = script do
  f@Fixture{..} <- setup
  expiring <- scheduled f t0 (Some (addRelTime t0 (days 1)))
  lasting <- scheduled f t0 None
  r <- trySubmit caller do exerciseCmd probe Probe_RequireExpired with target = expiring
  expectFailure eNotExpired r
  r2 <- trySubmit caller do exerciseCmd probe Probe_RequireExpired with target = lasting
  expectFailure eNotExpired r2
  passTime (days 1)
  submit caller do exerciseCmd probe Probe_RequireExpired with target = expiring

-- | The failure statuses carry stable ids.
test_failureStatusIds : Script ()
test_failureStatusIds = script do
  eDelayTooShort.errorId === "openzeppelin.com/timelock-delay-too-short"
  eInvalidConfig.errorId === "openzeppelin.com/timelock-invalid-config"
