-- | Consumer fixtures: single-party and credential-based pause authority, the
-- sibling-field case, and implementations that break the `setPaused` rule.
module OpenZeppelin.Api.PausableV1TestFixtures where

import DA.Action (unless)
import DA.Fail (FailureCategory (..), FailureStatus (..), failWithStatus)
import qualified DA.TextMap as TextMap

import OpenZeppelin.Api.PausableV1

-- Consumer-side failures, raised with `failWithStatus` so tests match on a
-- stable `errorId`.
fixtureFailure : Text -> Text -> FailureStatus
fixtureFailure name message = FailureStatus with
  errorId = "example.com/pausable-test-" <> name
  category = InvalidGivenCurrentSystemStateOther
  message
  meta = TextMap.empty

eAmountNotPositive : FailureStatus
eAmountNotPositive = fixtureFailure "amount-not-positive" "Vault: amount must be positive"

eInsufficientBalance : FailureStatus
eInsufficientBalance = fixtureFailure "insufficient-balance" "Vault: insufficient balance"

eWrongCredentialIssuer : FailureStatus
eWrongCredentialIssuer = fixtureFailure "wrong-credential-issuer"
  "RoleVault: wrong credential issuer"

eCredentialNotCallers : FailureStatus
eCredentialNotCallers = fixtureFailure "credential-not-callers"
  "RoleVault: credential is not the caller's"

-- | The single-party case: the admin is the pause authority, and the consuming
-- flip choices create what `pause` and `unpause` return.
template Vault
  with
    admin : Party
    holder : Party
    paused : Bool
    balance : Int
  where
    signatory admin
    observer holder
    ensure balance >= 0

    interface instance Pausable for Vault where
      view = PausableView with paused
      setPaused b = toInterface (this with paused = b)

    -- The consumer supplies the authority, the library supplies the flip and
    -- the guard.
    choice Vault_Pause : ContractId Vault
      controller admin
      do
        create =<< pause this

    choice Vault_Unpause : ContractId Vault
      controller admin
      do
        create =<< unpause this

    -- A gated operation.
    choice Vault_Withdraw : ContractId Vault
      with amount : Int
      controller holder
      do
        whenNotPaused this
        unless (amount > 0) (failWithStatus eAmountNotPositive)
        unless (amount <= balance) (failWithStatus eInsufficientBalance)
        create this with balance = balance - amount

    -- A recovery path that runs only while paused.
    choice Vault_EmergencyDrain : ContractId Vault
      controller admin
      do
        whenPaused this
        create this with balance = 0

-- | A credential standing in for an AccessControl `RoleGrant`.
template PauseCredential
  with
    admin : Party
    account : Party
  where
    signatory admin
    observer account

-- | The credential case: the flip choice takes the caller and a credential,
-- checks them in the body, then calls `pause`.
template RoleVault
  with
    admin : Party
    holder : Party
    paused : Bool
  where
    signatory admin
    observer holder

    interface instance Pausable for RoleVault where
      view = PausableView with paused
      setPaused b = toInterface (this with paused = b)

    choice RoleVault_Pause : ContractId RoleVault
      with
        caller : Party
        credCid : ContractId PauseCredential
      controller caller
      do
        cred <- fetch credCid
        unless (cred.admin == admin) (failWithStatus eWrongCredentialIssuer)
        unless (cred.account == caller) (failWithStatus eCredentialNotCallers)
        create =<< pause this

    choice RoleVault_Transfer : ContractId RoleVault
      controller holder
      do
        whenNotPaused this
        create this

-- | The sibling-field case: the flip choice records the pause reason on the
-- value that `pause` returns and creates once.
template Registry
  with
    admin : Party
    paused : Bool
    pauseReason : Optional Text
  where
    signatory admin

    interface instance Pausable for Registry where
      view = PausableView with paused
      setPaused b = toInterface (this with paused = b)

    choice Registry_Pause : ContractId Registry
      with
        reason : Optional Text
      controller admin
      do
        r <- pause this
        create r with pauseReason = reason

    choice Registry_Unpause : ContractId Registry
      controller admin
      do
        r <- unpause this
        create r with pauseReason = None

-- | An unrelated template holding a `ContractId Pausable`. `pause` returns a
-- value, and only the implementing template's signatories can create the
-- successor, so the ledger stays unchanged.
template Rogue
  with
    caller : Party
  where
    signatory caller

    nonconsuming choice Rogue_TryPause : Bool
      with
        target : ContractId Pausable
      controller caller
      do
        p <- fetch target
        -- Yields a value with the flag set. The ledger stays unchanged.
        flipped <- pause p
        pure (isPaused flipped)

-- | Flips from a nonconsuming choice without archiving `self`, so the
-- predecessor stays active beside the successor. The choice kind is the
-- consumer's responsibility.
template LeakyVault
  with
    admin : Party
    paused : Bool
  where
    signatory admin

    interface instance Pausable for LeakyVault where
      view = PausableView with paused
      setPaused b = toInterface (this with paused = b)

    nonconsuming choice LeakyVault_Pause : ContractId LeakyVault
      controller admin
      do
        create =<< pause this

-- Implementations that break the `setPaused` rule
-------------------------------------------------------

-- | Ignores the argument, so the flag never changes. `eFlagNotApplied`
-- catches it.
template BrokenIgnoresFlag
  with
    admin : Party
    paused : Bool
  where
    signatory admin

    interface instance Pausable for BrokenIgnoresFlag where
      view = PausableView with paused
      setPaused _ = toInterface this

    choice BrokenIgnoresFlag_Pause : ContractId BrokenIgnoresFlag
      controller admin
      do
        create =<< pause this

    choice BrokenIgnoresFlag_Unpause : ContractId BrokenIgnoresFlag
      controller admin
      do
        create =<< unpause this

-- | A second implementer, so `Pausable` has more than one inhabitant.
template Decoy
  with
    admin : Party
    paused : Bool
  where
    signatory admin

    interface instance Pausable for Decoy where
      view = PausableView with paused
      setPaused b = toInterface (this with paused = b)

-- | Returns another implementer's template. `eImplementerTypeMismatch`
-- catches it.
template BrokenWrongTemplate
  with
    admin : Party
    paused : Bool
  where
    signatory admin

    interface instance Pausable for BrokenWrongTemplate where
      view = PausableView with paused
      setPaused b = toInterface (Decoy with admin = this.admin, paused = b)

    choice BrokenWrongTemplate_Pause : ContractId BrokenWrongTemplate
      controller admin
      do
        create =<< pause this

    choice BrokenWrongTemplate_Unpause : ContractId BrokenWrongTemplate
      controller admin
      do
        create =<< unpause this
