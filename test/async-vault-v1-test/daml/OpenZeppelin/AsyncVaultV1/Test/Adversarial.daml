-- | Adversarial tests for `OpenZeppelin.AsyncVaultV1`. Each test plays a
-- party that tries to gain at another's cost, or to leave another's funds
-- stuck, and requires the attempt to fail or to gain nothing:
--
-- * a request that does not settle gives its escrow back, whoever ends it
--   and whatever became of the vault's contracts;
-- * nobody settles at a price that is out of date: a requester chooses no
--   price, the operator chooses within the admin's band, and a ledger that
--   has been replaced settles nothing;
-- * rounding and payments made to the custodian outside the vault pay no
--   requester;
-- * closing the deposit gate blocks no exit;
-- * the operator fills no request below its minimum, and none twice;
-- * requests whose transfer legs would share an id are refused by name;
-- * a requester sees its own fill and nobody else's;
-- * a batch that fails leaves every contract and every holding as it was;
-- * the executors take nothing through a request's receipt.
--
-- `testAnExitNeedsTheRulesAndTheOperator` states what the vault does not
-- promise. The tests run against the registry of the fixtures.
module OpenZeppelin.AsyncVaultV1.Test.Adversarial where

import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.List (sort, sortOn)
import DA.Stack (HasCallStack)
import DA.Time (addRelTime, minutes)
import Daml.Script

import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.Api.Token.AllocationInstructionV2 qualified as AllocationInstructionV2
import Splice.TokenStandard.Utils (basicAccount, receiverSide, senderSide)

import OpenZeppelin.AsyncVault.TypesV1
import OpenZeppelin.AsyncVault.Utils.Math
import OpenZeppelin.AsyncVault.Utils.Request
import OpenZeppelin.AsyncVault.Utils.Settlement
import OpenZeppelin.AsyncVaultV1
import OpenZeppelin.AsyncVaultV1.Test.Fixtures

-- Helpers
-------------------------------------------------------

-- | Withdraw an allocation on its registry as its authorizer, alone.
withdrawAllocation : Party -> ContractId AllocationV2.Allocation -> Script ()
withdrawAllocation authorizer allocationCid = do
  _ <- submit authorizer do
    exerciseCmd allocationCid AllocationV2.Allocation_Withdraw with
      actors = [authorizer]
      extraArgs = emptyArgs
  pure ()

-- | Record the custodian's unlocked holdings as the reserves, as the
-- operator.
recordReserves : Fixture -> ContractId VaultLedger -> Script (ContractId VaultLedger)
recordReserves Fixture{..} ledgerCid = do
  pool <- unlockedHoldings config.underlying treasury
  poolShown <- holdingDisclosures config.underlying.admin pool
  submit (actAs operator <> discloseMany poolShown) do
    exerciseCmd ledgerCid VaultLedger_RecordReserves with holdingCids = pool

-- | Require the ledger's records to agree with the holdings: the custodian
-- holds exactly the recorded reserves, and the holders together hold exactly
-- the recorded shares.
conserved : HasCallStack => Fixture -> ContractId VaultLedger -> [Party] -> Script ()
conserved f@Fixture{..} ledgerCid holders = do
  state <- ledgerState f ledgerCid
  balance config.underlying treasury >>= (=== (state.reserves, 0.0))
  held <- forA holders (balance config.share)
  sum (map fst held) + sum (map snd held) === state.totalShares

-- | Require a submission to have been refused, for whatever reason.
refused : (HasCallStack, Show a) => Either SubmitError a -> Script ()
refused = \case
  Left _ -> pure ()
  Right result -> fail ("expected the ledger to refuse, and it returned " <> show result)

-- | Try to settle a batch at parity as the operator, alone, with the locked
-- funding of the escrows named here disclosed. `trySettleBatch` reads every
-- request's escrow, so it cannot build a batch over a request whose escrow
-- is gone.
tryBatchOver
  : Fixture -> ContractId VaultLedger -> [ContractId DepositRequest] -> [ContractId RedeemRequest]
  -> [ContractId AllocationV2.Allocation] -> [ContractId AllocationV2.Allocation]
  -> Script (Either SubmitError VaultLedger_SettleBatchResult)
tryBatchOver Fixture{..} ledgerCid depositCids redeemCids underlyingEscrows shareEscrows = do
  underlyingFunding <- fundingDisclosures config.underlying.admin underlyingEscrows
  shareFunding <- fundingDisclosures config.share.admin shareEscrows
  pool <- unlockedHoldings config.underlying treasury
  poolShown <- holdingDisclosures config.underlying.admin pool
  trySubmit
    (actAs operator <> discloseMany (registryDisclosures <> underlyingFunding <> shareFunding <> poolShown))
    do
      exerciseCmd ledgerCid VaultLedger_SettleBatch with
        price = parity
        depositCids
        redeemCids
        poolHoldingCids = pool
        requestedAt = t0
        args = noArgs

-- | Everything a batch could change: what each party holds, every holding's
-- contract, the ledger, the requests, and their allocations.
data Snapshot = Snapshot with
    balances : [((Decimal, Decimal), (Decimal, Decimal))]
    holdings : [ContractId TestHolding]
    ledger : Optional VaultLedger
    deposits : [(ContractId DepositRequest, DepositRequest)]
    redeems : [(ContractId RedeemRequest, RedeemRequest)]
    allocations : [(ContractId TestAllocation, TestAllocation)]
  deriving (Eq, Show)

snapshot : Fixture -> ContractId VaultLedger -> Script Snapshot
snapshot Fixture{..} ledgerCid = do
  balances <- forA [alice, bob, treasury] $ \party ->
    (,) <$> balance config.underlying party <*> balance config.share party
  underlyingHoldings <- query @TestHolding config.underlying.admin
  shareHoldings <- query @TestHolding config.share.admin
  ledger <- queryContractId operator ledgerCid
  deposits <- query @DepositRequest operator
  redeems <- query @RedeemRequest operator
  allocations <- query @TestAllocation operator
  pure Snapshot with
    balances
    holdings = sort (map fst (underlyingHoldings <> shareHoldings))
    ledger
    deposits = sortOn fst deposits
    redeems = sortOn fst redeems
    allocations = sortOn fst allocations

-- A request that does not settle
-------------------------------------------------------

-- | No way a request ends leaves its escrow locked behind it. The requester
-- cancels long before the deadline and spends the funds in its next
-- submission. The operator ends a request before its deadline only by
-- rejecting it, which gives the escrow back at once: it cannot drop one
-- early. A request the operator never touches is cancelled by its requester
-- after the deadline as before it. A request the operator drops at the
-- deadline leaves its allocations, and the requester withdraws them on the
-- registries, alone.
testNoEndingLeavesTheEscrowLocked : Script ()
testNoEndingLeavesTheEscrowLocked = script do
  f@Fixture{..} <- setup
  ledger <- newLedger f (stateOf 40.0 40.0 parity) parity 0.0
  _ <- giveHolding config.underlying alice 100.0
  _ <- giveHolding config.share alice 40.0
  let later = t2 `addRelTime` minutes 10
      allFree = do
        balance config.underlying alice >>= (=== (100.0, 0.0))
        balance config.share alice >>= (=== (40.0, 0.0))
      allLocked = do
        balance config.underlying alice >>= (=== (0.0, 100.0))
        balance config.share alice >>= (=== (0.0, 40.0))

  -- Cancelled: free in the same transaction, and funding the next request.
  cancelledDeposit <- requestDeposit f alice (depositTerms alice "d1" 100.0)
  cancelledRedeem <- requestRedeem f alice (redeemTerms alice "r1" 40.0)
  allLocked
  submit alice do exerciseCmd cancelledDeposit DepositRequest_Cancel with args = noArgs
  submit alice do exerciseCmd cancelledRedeem RedeemRequest_Cancel with args = noArgs
  allFree

  -- Ended by the operator before the deadline: not dropped, and rejected
  -- with the escrow back in the same transaction.
  rejectedDeposit <- requestDeposit f alice (depositTerms alice "d0" 100.0)
  rejectedRedeem <- requestRedeem f alice (redeemTerms alice "r0" 40.0)
  submitMustFailWith eDeadlineNotPassed $ trySubmit operator do
    exerciseCmd rejectedDeposit DepositRequest_Expire
  submitMustFailWith eDeadlineNotPassed $ trySubmit operator do
    exerciseCmd rejectedRedeem RedeemRequest_Expire
  allLocked
  Some rejectedDepositRequest <- queryContractId operator rejectedDeposit
  Some rejectedRedeemRequest <- queryContractId operator rejectedRedeem
  assetsShown <- fundingDisclosures issuer [rejectedDepositRequest.state.escrowCid]
  submit (actAs operator <> discloseMany assetsShown) do
    exerciseCmd rejectedDeposit DepositRequest_Reject with args = noArgs
  sharesShown <- fundingDisclosures shareAdmin [rejectedRedeemRequest.state.escrowCid]
  submit (actAs operator <> discloseMany sharesShown) do
    exerciseCmd rejectedRedeem RedeemRequest_Reject with args = noArgs
  allFree

  -- Left alone by the operator until the deadline: no batch takes it any
  -- more, and the requester cancels as before.
  ignoredDeposit <- requestDeposit f alice (depositTerms alice "d2" 100.0)
  ignoredRedeem <- requestRedeem f alice (redeemTerms alice "r2" 40.0)
  setTime t2
  submitMustFailWith eRequestExpired (trySettleBatch f ledger parity [ignoredDeposit] [ignoredRedeem])
  submit alice do exerciseCmd ignoredDeposit DepositRequest_Cancel with args = noArgs
  submit alice do exerciseCmd ignoredRedeem RedeemRequest_Cancel with args = noArgs
  allFree

  -- Dropped by the operator at the deadline: the request is gone, and its
  -- allocations are the requester's to withdraw.
  droppedDeposit <- requestDeposit f alice ((depositTerms alice "d3" 100.0) with deadline = later)
  droppedRedeem <- requestRedeem f alice ((redeemTerms alice "r3" 40.0) with deadline = later)
  Some deposit <- queryContractId alice droppedDeposit
  Some redeem <- queryContractId alice droppedRedeem
  setTime later
  submit operator do exerciseCmd droppedDeposit DepositRequest_Expire
  submit operator do exerciseCmd droppedRedeem RedeemRequest_Expire
  allLocked
  forA_
    [ deposit.state.escrowCid, deposit.state.receiptCid
    , redeem.state.escrowCid, redeem.state.receiptCid ]
    (withdrawAllocation alice)
  allFree

-- | A requester needs nothing of the vault to take a pending request back.
-- With the rules archived and the ledger archived, the requester cancels
-- alone, with no contract disclosed.
testRequesterLeavesWithoutTheVault : Script ()
testRequesterLeavesWithoutTheVault = script do
  f@Fixture{..} <- setupSeparate
  ledger <- newEmptyLedger f
  _ <- giveHolding config.underlying alice 100.0
  _ <- giveHolding config.share alice 40.0
  depositCid <- requestDeposit f alice (depositTerms alice "d1" 100.0)
  redeemCid <- requestRedeem f alice (redeemTerms alice "r1" 40.0)
  submit admin do archiveCmd vault
  submit (actAs (ledgerSignatories config)) do archiveCmd ledger
  submit alice do exerciseCmd depositCid DepositRequest_Cancel with args = noArgs
  submit alice do exerciseCmd redeemCid RedeemRequest_Cancel with args = noArgs
  balance config.underlying alice >>= (=== (100.0, 0.0))
  balance config.share alice >>= (=== (40.0, 0.0))

-- A price that is out of date
-------------------------------------------------------

-- | A gain reaches the custodian, and a depositor who knows of it asks for
-- shares at the price from before it. A request names no price and its
-- requester settles nothing, so the price is the one the operator gives the
-- batch. At a price that counts the gain, the request with the old price as
-- its minimum is refused, the same deposit without a minimum buys fewer
-- shares, and selling them returns no more than was paid. The holder from
-- before the gain keeps all of it.
--
-- The operator could settle the request at the old price while the admin's
-- band still allows it. The band is what bounds that.
testDepositorCannotBuyAtAnOldPrice : Script ()
testDepositorCannotBuyAtAnOldPrice = script do
  f@Fixture{..} <- setup
  ledger <- newLedger f (stateOf 1000.0 1000.0 parity) parity 0.1
  _ <- giveHolding config.underlying treasury 1000.0
  _ <- giveHolding config.share alice 1000.0
  _ <- giveHolding config.underlying bob 1000.0
  -- The gain: 50 units for 1000 shares.
  _ <- giveHolding config.underlying treasury 50.0
  let grown = priceOf 21.0 20.0

  atTheOldPrice <- requestDeposit f bob
    ((depositTerms bob "d1" 1000.0) with minSharesOut = Some 1000.0)
  (disclosed, settleAtTheOldPrice) <- settleCmd f ledger parity [atTheOldPrice] []
  submitMustFail (actAs bob <> discloseMany disclosed) settleAtTheOldPrice

  recorded <- recordReserves f ledger
  ledgerState f recorded >>= (=== stateOf 1050.0 1000.0 parity)
  submitMustFailWith eBelowMinimum (trySettleBatch f recorded grown [atTheOldPrice] [])
  submit bob do exerciseCmd atTheOldPrice DepositRequest_Cancel with args = noArgs

  -- 1000 units at 1.05 a share are 952.3809523809 shares.
  atTheBatchPrice <- requestDeposit f bob (depositTerms bob "d2" 1000.0)
  bought <- settleBatch f recorded grown [atTheBatchPrice] []
  bought.batch.depositFills === [fillOf bob "d2" 1000.0 952.3809523809]

  bobOut <- requestRedeem f bob (redeemTerms bob "r1" 952.3809523809)
  aliceOut <- requestRedeem f alice (redeemTerms alice "r1" 1000.0)
  sold <- settleBatch f bought.ledgerCid grown [] [bobOut, aliceOut]
  balance config.underlying bob >>= (=== (999.9999999999, 0.0))
  balance config.underlying alice >>= (=== (1050.0, 0.0))
  sold.batch.state === VaultState with
    reserves = 0.0000000001; totalShares = 0.0; price = grown; batch = 2
  conserved f sold.ledgerCid [alice, bob]

-- | A batch settles on the ledger as it is now, or not at all. A batch the
-- operator prepared before the admin moved the band is refused, and so is
-- its price on the ledger that replaced the one it was built on. Recording
-- the reserves replaces the ledger in the same way. The operator brings no
-- earlier ledger back: it creates none alone.
testNoBatchSettlesOnAReplacedLedger : Script ()
testNoBatchSettlesOnAReplacedLedger = script do
  f@Fixture{..} <- setup
  let old = priceOf 11.0 10.0
      new = priceOf 2.0 1.0
  first <- newLedger f (stateOf 0.0 0.0 parity) parity 0.1
  _ <- giveHolding config.underlying alice 110.0
  depositCid <- requestDeposit f alice (depositTerms alice "d1" 110.0)

  (disclosed, prepared) <- settleCmd f first old [depositCid] []
  second <- submit admin do
    exerciseCmd first VaultLedger_SetPriceBand with newReferencePrice = new; newMaxDeviation = 0.0
  submitMustFail (actAs operator <> discloseMany disclosed) prepared
  submitMustFailWith ePriceOutOfBand (trySettleBatch f second old [depositCid] [])

  (disclosedAgain, preparedAgain) <- settleCmd f second new [depositCid] []
  third <- recordReserves f second
  submitMustFail (actAs operator <> discloseMany disclosedAgain) preparedAgain

  submitMustFail operator do createCmd (ledgerOf f (stateOf 0.0 0.0 parity) parity 0.1)
  query @VaultLedger operator >>= \ledgers -> map fst ledgers === [third]

  settled <- settleBatch f third new [depositCid] []
  settled.batch.depositFills === [fillOf alice "d1" 110.0 55.0]
  balance config.share alice >>= (=== (55.0, 0.0))

-- Rounding and outside payments
-------------------------------------------------------

-- | Rounding pays the pool and never a requester. At a price that does not
-- divide evenly, a deposit split into ten requests buys no more shares than
-- the same deposit in one, and selling every share at the same price
-- returns no more than was paid. What rounding left is in the pool, and
-- after each batch the custodian holds exactly the recorded reserves and
-- the holders exactly the recorded shares.
testRoundingPaysNoRequester : Script ()
testRoundingPaysNoRequester = script do
  f@Fixture{..} <- setup
  let price = priceOf 7.0 3.0
  ledger <- newLedger f (stateOf 0.0 0.0 price) price 0.0
  _ <- giveHolding config.underlying alice 100.0
  _ <- giveHolding config.underlying bob 100.0

  -- 100 units at seven for three are 42.857142857142... shares.
  whole <- requestDeposit f alice (depositTerms alice "whole" 100.0)
  parts <- forA [1 .. 10] $ \number ->
    requestDeposit f bob (depositTerms bob ("part-" <> show number) 10.0)
  bought <- settleBatch f ledger price (whole :: parts) []
  balance config.share alice >>= (=== (42.8571428571, 0.0))
  balance config.share bob >>= (=== (42.857142857, 0.0))
  conserved f bought.ledgerCid [alice, bob]

  aliceOut <- requestRedeem f alice (redeemTerms alice "out" 42.8571428571)
  bobOut <- requestRedeem f bob (redeemTerms bob "out" 42.857142857)
  sold <- settleBatch f bought.ledgerCid price [] [aliceOut, bobOut]
  balance config.underlying alice >>= (=== (99.9999999999, 0.0))
  balance config.underlying bob >>= (=== (99.9999999996, 0.0))
  sold.batch.state === VaultState with
    reserves = 0.0000000005; totalShares = 0.0; price; batch = 2
  conserved f sold.ledgerCid [alice, bob]

-- | A payment made to the custodian outside the vault moves no price. The
-- first depositor takes the smallest share there is and then pays the
-- custodian a large amount. The next depositor is still filled at the price
-- of its batch, in full. The operator cannot price the payment in, before
-- or after it records it: only the admin moves the band. The first
-- depositor's share redeems for what it paid for it, and the payment is the
-- pool's.
testOutsidePaymentMovesNoPrice : Script ()
testOutsidePaymentMovesNoPrice = script do
  f@Fixture{..} <- setup
  ledger <- newEmptyLedger f
  _ <- giveHolding config.underlying bob ulp
  _ <- giveHolding config.underlying alice 100.0

  first <- requestDeposit f bob (depositTerms bob "d1" ulp)
  opened <- settleBatch f ledger parity [first] []
  balance config.share bob >>= (=== (ulp, 0.0))
  -- The payment as the custodian receives it: a holding outside any batch.
  _ <- giveHolding config.underlying treasury 10000.0

  next <- requestDeposit f alice (depositTerms alice "d1" 100.0)
  submitMustFailWith ePriceOutOfBand
    (trySettleBatch f opened.ledgerCid (priceOf 10000.0000000001 ulp) [next] [])
  bought <- settleBatch f opened.ledgerCid parity [next] []
  bought.batch.depositFills === [fillOf alice "d1" 100.0 100.0]
  balance config.share alice >>= (=== (100.0, 0.0))

  recorded <- recordReserves f bought.ledgerCid
  ledgerState f recorded >>= (=== VaultState with
    reserves = 10100.0000000001; totalShares = 100.0000000001; price = parity; batch = 2)
  out <- requestRedeem f bob (redeemTerms bob "r1" ulp)
  submitMustFailWith ePriceOutOfBand
    (trySettleBatch f recorded (priceOf 10100.0000000001 100.0000000001) [] [out])
  _ <- settleBatch f recorded parity [] [out]
  balance config.underlying bob >>= (=== (ulp, 0.0))
  balance config.underlying treasury >>= (=== (10100.0, 0.0))

-- Exits
-------------------------------------------------------

-- | Closing the deposit gate blocks no exit. The admin replaces the rules
-- with ones whose gate admits nobody. A depositor it admitted before opens
-- no new deposit, and still cancels the deposit it had pending, asks to
-- redeem every share, and is paid.
testClosingTheGateBlocksNoExit : Script ()
testClosingTheGateBlocksNoExit = script do
  f@Fixture{..} <- setup
  ledger <- newEmptyLedger f
  open <- submit admin do createCmd AllowList with admin; claimedAdmin = admin; listed = [alice]
  gated <- submit admin do
    createCmd Vault with config; registries; depositGate = Some (toInterfaceContractId open)
  Some openShown <- queryDisclosure @AllowList admin open
  Some gatedShown <- queryDisclosure @Vault admin gated
  let shown = gatedShown :: openShown :: registryDisclosures
  _ <- giveHolding config.underlying alice 150.0
  funds <- unlockedHoldings config.underlying alice
  settledDeposit <- submit (actAs alice <> discloseMany shown)
    (requestDepositCmd gated (depositTerms alice "d1" 100.0) funds)
  first <- settleBatch f ledger parity [settledDeposit] []
  rest <- unlockedHoldings config.underlying alice
  pendingDeposit <- submit (actAs alice <> discloseMany shown)
    (requestDepositCmd gated (depositTerms alice "d2" 50.0) rest)

  submit admin do archiveCmd gated
  closed <- submit admin do createCmd AllowList with admin; claimedAdmin = admin; listed = []
  shut <- submit admin do
    createCmd Vault with config; registries; depositGate = Some (toInterfaceContractId closed)
  Some closedShown <- queryDisclosure @AllowList admin closed
  Some shutShown <- queryDisclosure @Vault admin shut
  let shownNow = shutShown :: closedShown :: registryDisclosures

  submit alice do exerciseCmd pendingDeposit DepositRequest_Cancel with args = noArgs
  balance config.underlying alice >>= (=== (50.0, 0.0))
  free <- unlockedHoldings config.underlying alice
  submitMustFailWith eNotListed $ trySubmit (actAs alice <> discloseMany shownNow)
    (requestDepositCmd shut (depositTerms alice "d3" 50.0) free)

  shares <- unlockedHoldings config.share alice
  redeemCid <- submit (actAs alice <> discloseMany shownNow)
    (requestRedeemCmd shut (redeemTerms alice "r1" 100.0) shares)
  second <- settleBatch f first.ledgerCid parity [] [redeemCid]
  second.batch.state === VaultState with
    reserves = 0.0; totalShares = 0.0; price = parity; batch = 2
  balance config.underlying alice >>= (=== (150.0, 0.0))
  balance config.share alice >>= (=== (0.0, 0.0))

-- | What an exit still needs. A holder asks to redeem on the vault's rules,
-- and only the operator settles the request: not the admin, and not the
-- holder. With the rules archived and none in their place, a holder opens no
-- request. Through all of it the shares stay the holder's, and a pending
-- request is the holder's to cancel.
testAnExitNeedsTheRulesAndTheOperator : Script ()
testAnExitNeedsTheRulesAndTheOperator = script do
  f@Fixture{..} <- setup
  ledger <- newLedger f (stateOf 100.0 100.0 parity) parity 0.0
  _ <- giveHolding config.underlying treasury 100.0
  _ <- giveHolding config.share alice 100.0

  pending <- requestRedeem f alice (redeemTerms alice "r1" 60.0)
  (disclosed, settle) <- settleCmd f ledger parity [] [pending]
  submitMustFailAuthorization (trySubmit (actAs admin <> discloseMany disclosed) settle)
  submitMustFail (actAs alice <> discloseMany disclosed) settle

  submit admin do archiveCmd vault
  rest <- unlockedHoldings config.share alice
  submitMustFail (actAs alice <> discloseMany registryDisclosures)
    (requestRedeemCmd vault (redeemTerms alice "r2" 40.0) rest)

  submit alice do exerciseCmd pending RedeemRequest_Cancel with args = noArgs
  balance config.share alice >>= (=== (100.0, 0.0))
  balance config.underlying treasury >>= (=== (100.0, 0.0))

-- The operator
-------------------------------------------------------

-- | The operator fills no request below its minimum, at any price the band
-- allows. At the price that is worst for each requester, a request that
-- asks for the tenth decimal place more than that price gives is refused,
-- and one that asks for exactly what it gives settles for exactly that. The
-- operator consumes no request with a fill of its own making. From the
-- deadline on a request settles at no price, even one it accepts.
testOperatorCannotFillBelowTheMinimum : Script ()
testOperatorCannotFillBelowTheMinimum = script do
  f@Fixture{..} <- setup
  ledger <- newLedger f (stateOf 1000.0 1000.0 parity) parity 0.1
  _ <- giveHolding config.underlying treasury 1000.0
  _ <- giveHolding config.underlying alice 200.0
  _ <- giveHolding config.share bob 200.0
  -- The ends of the band: 100 units buy 90.9090909090 shares at the upper
  -- end, and 100 shares are paid 90 units at the lower end.
  let dearest = priceOf 11.0 10.0
      cheapest = priceOf 9.0 10.0

  deposit <- requestDeposit f alice
    ((depositTerms alice "d1" 100.0) with minSharesOut = Some 90.9090909091)
  redeem <- requestRedeem f bob
    ((redeemTerms bob "r1" 100.0) with minAssetsOut = Some 90.0000000001)
  submitMustFailWith eBelowMinimum (trySettleBatch f ledger dearest [deposit] [])
  submitMustFailWith eBelowMinimum (trySettleBatch f ledger cheapest [] [redeem])
  submitMustFailAuthorization $ trySubmit operator do
    exerciseCmd deposit DepositRequest_Fill with fill = fillOf alice "d1" 100.0 ulp
  submitMustFailAuthorization $ trySubmit operator do
    exerciseCmd redeem RedeemRequest_Fill with fill = fillOf bob "r1" ulp 100.0
  balance config.underlying alice >>= (=== (100.0, 100.0))
  balance config.share bob >>= (=== (100.0, 100.0))

  exactDeposit <- requestDeposit f alice
    ((depositTerms alice "d2" 100.0) with minSharesOut = Some 90.909090909)
  first <- settleBatch f ledger dearest [exactDeposit] []
  first.batch.depositFills === [fillOf alice "d2" 100.0 90.909090909]
  balance config.share alice >>= (=== (90.909090909, 0.0))
  exactRedeem <- requestRedeem f bob
    ((redeemTerms bob "r2" 100.0) with minAssetsOut = Some 90.0)
  second <- settleBatch f first.ledgerCid cheapest [] [exactRedeem]
  second.batch.redeemFills === [fillOf bob "r2" 90.0 100.0]
  balance config.underlying bob >>= (=== (90.0, 0.0))

  setTime t2
  submitMustFailWith eRequestExpired (trySettleBatch f second.ledgerCid parity [deposit] [redeem])
  balance config.underlying alice >>= (=== (0.0, 100.0))
  balance config.share bob >>= (=== (0.0, 100.0))

-- | The operator counts no request twice: not twice in one batch, and not
-- again in a later one.
testOperatorCannotCountARequestTwice : Script ()
testOperatorCannotCountARequestTwice = script do
  f@Fixture{..} <- setup
  ledger <- newEmptyLedger f
  _ <- giveHolding config.underlying alice 100.0
  depositCid <- requestDeposit f alice (depositTerms alice "d1" 100.0)
  (disclosed, _) <- settleCmd f ledger parity [depositCid] []
  let naming ledgerCid depositCids = exerciseCmd ledgerCid VaultLedger_SettleBatch with
        price = parity
        depositCids
        redeemCids = []
        poolHoldingCids = []
        requestedAt = t0
        args = noArgs
  submitMustFailWith eDuplicateRequest $
    trySubmit (actAs operator <> discloseMany disclosed) (naming ledger [depositCid, depositCid])

  settled <- submit (actAs operator <> discloseMany disclosed) (naming ledger [depositCid])
  submitMustFail (actAs operator <> discloseMany registryDisclosures)
    (naming settled.ledgerCid [depositCid])
  ledgerState f settled.ledgerCid >>= (=== VaultState with
    reserves = 100.0; totalShares = 100.0; price = parity; batch = 1)
  balance config.share alice >>= (=== (100.0, 0.0))
  balance config.underlying treasury >>= (=== (100.0, 0.0))

-- Requests that collide
-------------------------------------------------------

-- | Two requests whose transfer legs would share an id cannot share a
-- batch, and each settles in a batch of its own. One owner arrives at the
-- same ids from two of its accounts when one account's id and label, joined,
-- read as the other's. An id starts with the account's owner, so only an
-- owner's own requests collide: another owner's request from an account and
-- under a label of the same names shares a batch with either.
testCollidingLegIdsCannotShareABatch : Script ()
testCollidingLegIdsCannotShareABatch = script do
  f@Fixture{..} <- setup
  ledger <- newEmptyLedger f
  let held account amount = TestHolding with
        holding = HoldingV2.HoldingView with
          account; instrumentId = config.underlying; amount; lock = None; meta = emptyMetadata
      one = (basicAccount alice) with id = "a/b"
      other = (basicAccount alice) with id = "a"
      bobs = (basicAccount bob) with id = "a"
      from requester label amount fundsCid =
        submit (actAs (requesterParties requester) <> discloseMany disclosures) $
          requestDepositCmd vault
            ((depositTerms alice label amount) with requester)
            [toInterfaceContractId fundsCid]
  oneFunds <- submit (actAs [issuer, alice]) do createCmd (held one 10.0)
  otherFunds <- submit (actAs [issuer, alice]) do createCmd (held other 20.0)
  bobsFunds <- submit (actAs [issuer, bob]) do createCmd (held bobs 40.0)
  requestLegId one "c" underlyingLeg === requestLegId other "b/c" underlyingLeg

  first <- from one "c" 10.0 oneFunds
  second <- from other "b/c" 20.0 otherFunds
  third <- from bobs "b/c" 40.0 bobsFunds
  submitMustFailWith eDuplicateRequest (trySettleBatch f ledger parity [first, second] [])
  submitMustFailWith eDuplicateRequest (trySettleBatch f ledger parity [first, third, second] [])

  together <- settleBatch f ledger parity [first, third] []
  alone <- settleBatch f together.ledgerCid parity [second] []
  alone.batch.state === VaultState with
    reserves = 70.0; totalShares = 70.0; price = parity; batch = 2

-- What each requester sees
-------------------------------------------------------

-- | After a batch that fills a deposit and a redemption, each requester
-- holds what it was filled with and reads nothing of the other: not the
-- other's payout, not a request, not an allocation, and not the ledger that
-- records the batch. The operator has both fills.
--
-- A script reads the contracts a party is a stakeholder of. It does not read
-- what a party's participant is shown, in passing, of a transaction the
-- party takes part in: that is read from the participant itself.
testRequestersSeeOnlyTheirOwnFill : Script ()
testRequestersSeeOnlyTheirOwnFill = script do
  f@Fixture{..} <- setupSeparate
  ledger <- newLedger f (stateOf 30.0 30.0 parity) parity 0.0
  _ <- giveHolding config.underlying treasury 30.0
  _ <- giveHolding config.underlying alice 100.0
  _ <- giveHolding config.share bob 30.0
  depositCid <- requestDeposit f alice (depositTerms alice "d1" 100.0)
  redeemCid <- requestRedeem f bob (redeemTerms bob "r1" 30.0)
  result <- settleBatch f ledger parity [depositCid] [redeemCid]
  result.batch.depositFills === [fillOf alice "d1" 100.0 100.0]
  result.batch.redeemFills === [fillOf bob "r1" 30.0 30.0]
  holds config.share alice (100.0, 0.0)
  holds config.underlying bob (30.0, 0.0)

  alices <- query @TestHolding alice
  bobs <- query @TestHolding bob
  map (\(_, holding) -> (holding.holding.account, holding.holding.amount)) alices
    === [(basicAccount alice, 100.0)]
  map (\(_, holding) -> (holding.holding.account, holding.holding.amount)) bobs
    === [(basicAccount bob, 30.0)]
  forA_ alices $ \(holdingCid, _) -> queryContractId bob holdingCid >>= (=== None)
  forA_ bobs $ \(holdingCid, _) -> queryContractId alice holdingCid >>= (=== None)
  forA_ [alice, bob] $ \requester -> do
    query @DepositRequest requester >>= \found -> length found === 0
    query @RedeemRequest requester >>= \found -> length found === 0
    query @TestAllocation requester >>= \found -> length found === 0
    query @VaultLedger requester >>= \found -> length found === 0

-- A batch that fails
-------------------------------------------------------

-- | A batch that fails leaves every holding, every request, every
-- allocation, and the ledger as they were, wherever in the batch it fails:
--
-- * before anything moves, on a request below its minimum;
-- * on the underlying's registry, for a depositor who took the escrowed
--   assets back and kept the receipt that would be issued the shares;
-- * on the share instrument's registry, after the underlying's registry has
--   settled within the transaction, for a redeemer who took the escrowed
--   shares back and kept the receipt that would be paid.
--
-- Nobody is issued shares for a deposit that was not paid, and nobody is
-- paid for shares that were not burned. The requests that were good all
-- along then settle.
testFailedBatchLeavesEverythingAsItWas : Script ()
testFailedBatchLeavesEverythingAsItWas = script do
  f@Fixture{..} <- setupSeparate
  ledger <- newLedger f (stateOf 500.0 500.0 parity) parity 0.0
  _ <- giveHolding config.underlying treasury 500.0
  _ <- giveHolding config.underlying alice 130.0
  _ <- giveHolding config.share bob 80.0
  depositCid <- requestDeposit f alice (depositTerms alice "d1" 100.0)
  redeemCid <- requestRedeem f bob (redeemTerms bob "r1" 50.0)
  Some deposit <- queryContractId operator depositCid
  Some redeem <- queryContractId operator redeemCid
  let depositEscrow = deposit.state.escrowCid
      redeemEscrow = redeem.state.escrowCid

  demandingCid <- requestDeposit f alice
    ((depositTerms alice "d2" 10.0) with minSharesOut = Some 10.0000000001)
  Some demanding <- queryContractId operator demandingCid
  beforePricing <- snapshot f ledger
  submitMustFailWith eBelowMinimum $
    tryBatchOver f ledger [depositCid, demandingCid] [redeemCid]
      [depositEscrow, demanding.state.escrowCid] [redeemEscrow]
  snapshot f ledger >>= (=== beforePricing)

  unpaidCid <- requestDeposit f alice (depositTerms alice "d3" 20.0)
  Some unpaid <- queryContractId operator unpaidCid
  withdrawAllocation alice unpaid.state.escrowCid
  beforeUnpaid <- snapshot f ledger
  tryBatchOver f ledger [depositCid, unpaidCid] [redeemCid] [depositEscrow] [redeemEscrow] >>= refused
  snapshot f ledger >>= (=== beforeUnpaid)

  unburnedCid <- requestRedeem f bob (redeemTerms bob "r2" 30.0)
  Some unburned <- queryContractId operator unburnedCid
  withdrawAllocation bob unburned.state.escrowCid
  beforeUnburned <- snapshot f ledger
  tryBatchOver f ledger [depositCid] [redeemCid, unburnedCid] [depositEscrow] [redeemEscrow] >>= refused
  snapshot f ledger >>= (=== beforeUnburned)
  balance config.underlying bob >>= (=== (0.0, 0.0))
  balance config.share alice >>= (=== (0.0, 0.0))

  Right settled <- tryBatchOver f ledger [depositCid] [redeemCid] [depositEscrow] [redeemEscrow]
  settled.batch.state === VaultState with
    reserves = 550.0; totalShares = 550.0; price = parity; batch = 1
  balance config.share alice >>= (=== (100.0, 0.0))
  balance config.underlying bob >>= (=== (50.0, 0.0))
  balance config.underlying treasury >>= (=== (550.0, 0.0))

-- The executors
-------------------------------------------------------

-- | The executors take nothing through a receipt. A receipt lets them name
-- what its requester receives, and it holds no funds. With both executors
-- acting and the requester's unlocked holdings disclosed, a leg that sends
-- those holdings to the custodian through the receipt is refused.
testExecutorsTakeNothingThroughAReceipt : Script ()
testExecutorsTakeNothingThroughAReceipt = script do
  f@Fixture{..} <- setup
  _ <- giveHolding config.share alice 40.0
  _ <- giveHolding config.underlying alice 70.0
  redeemCid <- requestRedeem f alice (redeemTerms alice "r1" 40.0)
  Some request <- queryContractId operator redeemCid
  let settlement = vaultSettlement config
      taken = AllocationV2.TransferLeg with
        transferLegId = "taken"
        sender = basicAccount alice
        receiver = config.custodian
        amount = 70.0
        instrumentId = config.underlying.id
        meta = emptyMetadata
  allocated <- submit (actAs treasury <> discloseMany registryDisclosures) do
    exerciseCmd registries.underlyingAllocationFactory
      AllocationInstructionV2.AllocationFactory_Allocate with
        settlement
        allocation = AllocationV2.AllocationSpecification with
          admin = issuer
          authorizer = config.custodian
          transferLegSides = [receiverSide taken]
          settlementDeadline = Some t2
          nextIterationFunding = None
          committed = False
          meta = emptyMetadata
        requestedAt = t0
        inputHoldingCids = []
        extraArgs = emptyArgs
        actors = [treasury]
  custodianSide <- case allocated.output of
    AllocationInstructionV2.AllocationInstructionResult_Completed allocationCid -> pure allocationCid
    other -> abort ("the allocation did not complete: " <> show other)

  free <- unlockedHoldings config.underlying alice
  freeShown <- holdingDisclosures issuer free
  submitMustFail (actAs settlement.executors <> discloseMany (registryDisclosures <> freeShown)) do
    exerciseCmd registries.underlyingSettlementFactory AllocationV2.SettlementFactory_SettleBatch with
      settlement
      transferLegs = [taken]
      allocations =
        [ finalized request.state.receiptCid [senderSide taken]
        , finalized custodianSide [] ]
      actors = settlement.executors
      extraArgs = emptyArgs
  balance config.underlying alice >>= (=== (70.0, 0.0))
  balance config.underlying treasury >>= (=== (0.0, 0.0))
