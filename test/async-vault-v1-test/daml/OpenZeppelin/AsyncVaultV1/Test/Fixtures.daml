-- | Fixtures for the template tests: a minimal Token Standard registry built
-- on the OpenZeppelin CIP-0112 utils, two vault scenarios, and the script
-- helpers that drive the templates of `OpenZeppelin.AsyncVaultV1`.
module OpenZeppelin.AsyncVaultV1.Test.Fixtures where

import DA.Action (unless)
import DA.Assert ((===))
import DA.Date (date, Month(Jan))
import DA.Fail (FailureCategory (..), FailureStatus (..), failWithStatus)
import DA.Optional (isNone, isSome)
import DA.Stack (HasCallStack)
import DA.TextMap qualified as TextMap
import DA.Time (days, hours, milliseconds, time)
import Daml.Script

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.Api.Token.AllocationInstructionV2 qualified as AllocationInstructionV2
import Splice.Api.Token.TransferEventsV2 qualified as TransferEventsV2
import Splice.TokenStandard.Utils (accountParties, basicAccount, eventLog_holdingsChangeDefaultImpl, publicFetchDefaultImpl)

import OpenZeppelin.Token.Cip112.TypesV1
import OpenZeppelin.Token.Cip112.Utils.Holding
import OpenZeppelin.Token.Cip112.Utils.Allocation
import OpenZeppelin.Token.Cip112.Utils.Registry qualified as TokenRegistry

import OpenZeppelin.Api.AsyncVaultV1

import OpenZeppelin.AsyncVault.TypesV1
import OpenZeppelin.AsyncVaultV1

-- Gate
-------------------------------------------------------

eNotListed : FailureStatus
eNotListed = FailureStatus with
  errorId = "test/not-listed"
  category = InvalidIndependentOfSystemState
  message = "the requester is not on the list"
  meta = TextMap.empty

-- | A deposit gate that admits the parties on a list. Its view names
-- `claimedAdmin`.
template AllowList with
    admin : Party
    claimedAdmin : Party
    listed : [Party]
  where
    signatory admin

    interface instance DepositGate for AllowList where
      view = DepositGateView with admin = claimedAdmin
      depositGate_checkImpl _self arg = do
        unless (arg.requester.owner `elem` map Some listed) (failWithStatus eNotListed)
        pure DepositGate_CheckResult with meta = emptyMetadata

-- Registry
-------------------------------------------------------

template TestHolding with
    holding : HoldingV2.HoldingView
  where
    signatory holding.instrumentId.admin, accountParties holding.instrumentId.admin holding.account
    observer lockHolders holding.lock
    ensure isValidHoldingView holding

    interface instance HoldingV2.Holding for TestHolding where
      view = holding

-- | A registry admin's offer to put a holding into an owner's account. The
-- two sign the holding one after the other, so each submits on the
-- participant that hosts it.
template TestMintOffer with
    owner : Party
    holding : HoldingV2.HoldingView
  where
    signatory holding.instrumentId.admin
    observer owner
    ensure holding.account == basicAccount owner && isValidHoldingView holding

    choice TestMintOffer_Accept : ContractId HoldingV2.Holding
      controller owner
      do toInterfaceContractId <$> create TestHolding with holding

-- | Event-log host, created and archived within the emitting transaction.
template TestEventLog with
    admin : Party
  where
    signatory admin

    interface instance TransferEventsV2.EventLog for TestEventLog where
      view = TransferEventsV2.EventLogView with admin; meta = emptyMetadata
      eventLog_holdingsChangeImpl = eventLog_holdingsChangeDefaultImpl admin

holdingOps : Party -> HoldingOps
holdingOps admin = HoldingOps with
  createHolding = \v -> toInterfaceContractId <$> create TestHolding with holding = v
  consumeHolding = consumeByArchive @TestHolding
  withEventLog = \emit -> do
    logCid <- create TestEventLog with admin
    emit (toInterfaceContractId logCid)
    archive logCid
  eventObservers = const []

template TestAllocation with
    state : AllocationState
  where
    signatory state.allocation.admin, accountParties state.allocation.admin state.allocation.authorizer
    observer state.settlement.executors
    ensure isValidAllocationState state

    interface instance AllocationV2.Allocation for TestAllocation where
      view = allocationView state
      allocation_settleExtraObservers _ = observer this
      allocation_cancelExtraObservers _ = observer this
      allocation_withdrawExtraObservers _ = observer this
      allocation_settleImpl self arg =
        allocationSettleImpl (holdingOps state.allocation.admin)
          (\s -> toInterfaceContractId <$> create this with state = s) self state arg
      allocation_withdrawImpl self arg =
        allocationWithdrawImpl (holdingOps state.allocation.admin) self state arg
      allocation_cancelImpl self arg =
        allocationCancelImpl (holdingOps state.allocation.admin) self state arg

-- | A registry's rules contract: allocation factory and settlement factory.
template TestRegistry with
    config : RegistryConfig
  where
    signatory config.admin
    ensure isValidRegistryConfig config

    interface instance AllocationInstructionV2.AllocationFactory for TestRegistry where
      view = AllocationInstructionV2.AllocationFactoryView with admin = config.admin; meta = emptyMetadata
      allocationFactory_publicFetchImpl = publicFetchDefaultImpl this
      allocationFactory_allocateExtraObservers = privateAssetAllocateExtraObservers
      allocationFactory_allocateImpl _self arg =
        allocationFactoryImpl config (holdingOps config.admin)
          (\s -> toInterfaceContractId <$> create TestAllocation with state = s) arg

    interface instance AllocationV2.SettlementFactory for TestRegistry where
      view = AllocationV2.SettlementFactoryView with admin = config.admin; meta = emptyMetadata
      settlementFactory_publicFetchImpl = publicFetchDefaultImpl this
      settlementFactory_settleBatchExtraObservers _ = []
      settlementFactory_settleBatchImpl self arg =
        TokenRegistry.settleBatchImpl (pinAllocationTo @TestAllocation) config.admin self arg

-- Scenario
-------------------------------------------------------

-- | Request time, the scenario's clock, and the requests' deadline.
t0, t1, t2 : Time
t0 = time (date 2026 Jan 1) 0 0 0
t1 = time (date 2026 Jan 1) 0 10 0
t2 = time (date 2026 Jan 1) 0 20 0

-- | The smallest positive `Decimal`.
ulp : Decimal
ulp = 0.0000000001

data Fixture = Fixture with
    admin : Party
    operator : Party
    issuer : Party
      -- ^ Admin of the underlying's registry.
    shareAdmin : Party
      -- ^ Admin of the share instrument's registry.
    treasury : Party
      -- ^ Owner of the custodian account.
    alice : Party
    bob : Party
    config : VaultConfig
    registries : VaultRegistries
    vault : ContractId Vault
    registryDisclosures : [Disclosure]
      -- ^ Both registries, as the operator receives them.
    disclosures : [Disclosure]
      -- ^ The vault and both registries, as a requester receives them.

-- | The participant that hosts the requesters. `scripts/check-sandbox.sh`
-- starts a Canton sandbox with it beside the participant that hosts the
-- vault's parties and the registries. On a ledger with one participant, and
-- on the in-memory ledger, every party is allocated on that one.
requesterNode : ParticipantName
requesterNode = ParticipantName "validator"

-- | A vault whose admin is also the share instrument's admin and the
-- custodian, over the issuer's registry for the underlying.
setup : Script Fixture
setup = setupPrefixed ""

-- | A vault whose share instrument has another admin and whose pool is held
-- by another party.
setupSeparate : Script Fixture
setupSeparate = setupSeparatePrefixed ""

-- | `setup` with a prefix on every party's name. A ledger allocates a name
-- once, so scripts that share one ledger each use their own prefix.
setupPrefixed : Text -> Script Fixture
setupPrefixed prefix = do
  admin <- allocateParty (prefix <> "admin")
  setupWith prefix admin admin admin

-- | `setupSeparate` with a prefix on every party's name.
setupSeparatePrefixed : Text -> Script Fixture
setupSeparatePrefixed prefix = do
  admin <- allocateParty (prefix <> "admin")
  shareAdmin <- allocateParty (prefix <> "registrar")
  treasury <- allocateParty (prefix <> "treasury")
  setupWith prefix admin shareAdmin treasury

setupWith : Text -> Party -> Party -> Party -> Script Fixture
setupWith prefix admin shareAdmin treasury = do
  operator <- allocateParty (prefix <> "operator")
  issuer <- allocateParty (prefix <> "issuer")
  alice <- allocatePartyOn (prefix <> "alice") requesterNode
  bob <- allocatePartyOn (prefix <> "bob") requesterNode
  setTime t1
  underlyingRegistry <- newRegistry issuer
  shareRegistry <- newRegistry shareAdmin
  let config = VaultConfig with
        admin
        operator
        vaultId = "vault-1"
        underlying = HoldingV2.InstrumentId with admin = issuer; id = "USD"
        share = HoldingV2.InstrumentId with admin = shareAdmin; id = "VSHARE"
        custodian = basicAccount treasury
      registries = VaultRegistries with
        underlyingAllocationFactory = toInterfaceContractId underlyingRegistry
        underlyingSettlementFactory = toInterfaceContractId underlyingRegistry
        shareAllocationFactory = toInterfaceContractId shareRegistry
        shareSettlementFactory = toInterfaceContractId shareRegistry
  vault <- submit admin do createCmd Vault with config; registries; depositGate = None
  Some vaultDisclosure <- queryDisclosure @Vault admin vault
  Some underlyingDisclosure <- queryDisclosure @TestRegistry issuer underlyingRegistry
  Some shareDisclosure <- queryDisclosure @TestRegistry shareAdmin shareRegistry
  pure Fixture with
    admin; operator; issuer; shareAdmin; treasury; alice; bob; config; registries; vault
    registryDisclosures = [underlyingDisclosure, shareDisclosure]
    disclosures = [vaultDisclosure, underlyingDisclosure, shareDisclosure]

newRegistry : Party -> Script (ContractId TestRegistry)
newRegistry admin = submit admin do
  createCmd TestRegistry with
    config = RegistryConfig with admin; maxTTL = days 90; lockGrace = hours 1

emptyArgs : ExtraArgs
emptyArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

-- | The test registries and the vault need no extra arguments.
noArgs : RequestArgs
noArgs = RequestArgs with underlying = emptyArgs; share = emptyArgs; vault = emptyArgs

-- | A registry admin's offer of a holding in an owner's basic account.
mintOffer : HoldingV2.InstrumentId -> Party -> Decimal -> TestMintOffer
mintOffer instrumentId owner amount = TestMintOffer with
  owner
  holding = HoldingV2.HoldingView with
    account = basicAccount owner
    instrumentId
    amount
    lock = None
    meta = emptyMetadata

-- | Put a holding into an owner's basic account: the registry's admin offers
-- it and the owner accepts, each in its own submission.
giveHolding : HoldingV2.InstrumentId -> Party -> Decimal -> Script (ContractId HoldingV2.Holding)
giveHolding instrumentId owner amount = do
  offerCid <- submit instrumentId.admin do createCmd (mintOffer instrumentId owner amount)
  visible owner offerCid
  submit owner do exerciseCmd offerCid TestMintOffer_Accept

-- | Wait until a party's participant has a contract. A participant other
-- than the one a transaction was submitted on learns of it a moment later.
visible : (Template t, HasEnsure t) => Party -> ContractId t -> Script ()
visible = seenWithin 100 True

-- | Wait until a party's participant has a contract's archival.
archived : (Template t, HasEnsure t) => Party -> ContractId t -> Script ()
archived = seenWithin 100 False

seenWithin : (Template t, HasEnsure t) => Int -> Bool -> Party -> ContractId t -> Script ()
seenWithin attempts active party cid = do
  found <- queryContractId party cid
  if isSome found == active
    then pure ()
    else if attempts <= 0
      then fail "the transaction did not reach the party's participant"
      else do
        sleep (milliseconds 100)
        seenWithin (attempts - 1) active party cid

-- | Require what an owner holds of an instrument, unlocked and locked, once
-- the owner's participant has learnt of a transaction submitted on another.
holds : HasCallStack => HoldingV2.InstrumentId -> Party -> (Decimal, Decimal) -> Script ()
holds = holdsWithin 100

holdsWithin
  : HasCallStack => Int -> HoldingV2.InstrumentId -> Party -> (Decimal, Decimal) -> Script ()
holdsWithin attempts instrumentId owner expected = do
  actual <- balance instrumentId owner
  if actual == expected || attempts <= 0
    then actual === expected
    else do
      sleep (milliseconds 100)
      holdsWithin (attempts - 1) instrumentId owner expected

-- | What an owner holds of an instrument: unlocked and locked.
balance : HoldingV2.InstrumentId -> Party -> Script (Decimal, Decimal)
balance instrumentId owner = do
  holdings <- query @TestHolding owner
  let mine = [ h.holding | (_, h) <- holdings
             , h.holding.account == basicAccount owner, h.holding.instrumentId == instrumentId ]
  pure (sum [v.amount | v <- mine, isNone v.lock], sum [v.amount | v <- mine, isSome v.lock])

unlockedHoldings : HoldingV2.InstrumentId -> Party -> Script [ContractId HoldingV2.Holding]
unlockedHoldings instrumentId owner = do
  holdings <- query @TestHolding owner
  pure [ toInterfaceContractId cid | (cid, h) <- holdings
       , h.holding.account == basicAccount owner, h.holding.instrumentId == instrumentId
       , isNone h.holding.lock ]

depositTerms : Party -> Text -> Decimal -> DepositTerms
depositTerms requester label assets = DepositTerms with
  requester = basicAccount requester
  label
  assets
  minSharesOut = None
  deadline = t2

redeemTerms : Party -> Text -> Decimal -> RedeemTerms
redeemTerms requester label shares = RedeemTerms with
  requester = basicAccount requester
  label
  shares
  minAssetsOut = None
  deadline = t2

-- | What a request of a requester's basic account was filled with.
fillOf : Party -> Text -> Decimal -> Decimal -> Fill
fillOf requester label assets shares =
  Fill with requester = basicAccount requester; label; assets; shares

requestDepositCmd
  : ContractId Vault -> DepositTerms -> [ContractId HoldingV2.Holding]
  -> Commands (ContractId DepositRequest)
requestDepositCmd vaultCid terms inputHoldingCids =
  exerciseCmd vaultCid Vault_RequestDeposit with terms; inputHoldingCids; requestedAt = t0; args = noArgs

requestRedeemCmd
  : ContractId Vault -> RedeemTerms -> [ContractId HoldingV2.Holding]
  -> Commands (ContractId RedeemRequest)
requestRedeemCmd vaultCid terms inputHoldingCids =
  exerciseCmd vaultCid Vault_RequestRedeem with terms; inputHoldingCids; requestedAt = t0; args = noArgs

-- | Open a deposit request as its requester, alone, funded from every
-- unlocked holding of the underlying the requester has.
requestDeposit : Fixture -> Party -> DepositTerms -> Script (ContractId DepositRequest)
requestDeposit f requester terms = do
  inputs <- unlockedHoldings f.config.underlying requester
  submit (actAs requester <> discloseMany f.disclosures) (requestDepositCmd f.vault terms inputs)

-- | Open a redemption request as its requester, alone.
requestRedeem : Fixture -> Party -> RedeemTerms -> Script (ContractId RedeemRequest)
requestRedeem f requester terms = do
  inputs <- unlockedHoldings f.config.share requester
  submit (actAs requester <> discloseMany f.disclosures) (requestRedeemCmd f.vault terms inputs)

-- | Run a submission and require the ledger to reject it with exactly this
-- status. Any other outcome fails with what arrived instead.
submitMustFailWith
  : (HasCallStack, Show a)
  => FailureStatus -> Script (Either SubmitError a) -> Script ()
submitMustFailWith expected action = action >>= \case
  Left (FailureStatusError actual) -> actual === expected
  other -> fail ("expected " <> show expected <> ", got " <> show other)

-- | Run a submission and require the ledger to reject it for missing
-- authority, before any choice body runs.
submitMustFailAuthorization
  : (HasCallStack, Show a) => Script (Either SubmitError a) -> Script ()
submitMustFailAuthorization action = action >>= \case
  Left (AuthorizationError _) -> pure ()
  other -> fail ("expected an authorization failure, got " <> show other)

-- Ledger
-------------------------------------------------------

priceOf : Decimal -> Decimal -> SharePrice
priceOf priceAssets priceShares = SharePrice with priceAssets; priceShares

-- | One share for one unit of the underlying.
parity : SharePrice
parity = priceOf 1.0 1.0

-- | A state before any batch.
stateOf : Decimal -> Decimal -> SharePrice -> VaultState
stateOf reserves totalShares price = VaultState with reserves; totalShares; price; batch = 0

-- | The ledger of the fixture's vault, with a band of `maxDeviation` around
-- `referencePrice` and batches of up to 25 requests.
ledgerOf : Fixture -> VaultState -> SharePrice -> Decimal -> VaultLedger
ledgerOf Fixture{..} state referencePrice maxDeviation = VaultLedger with
  config; registries; state; referencePrice; maxDeviation; maxBatchSize = 25

-- | Create a ledger with every signatory's authority.
newLedger : Fixture -> VaultState -> SharePrice -> Decimal -> Script (ContractId VaultLedger)
newLedger f state referencePrice maxDeviation =
  submit (actAs (ledgerSignatories f.config)) do
    createCmd (ledgerOf f state referencePrice maxDeviation)

-- | An empty ledger at parity, where the operator settles at parity only.
newEmptyLedger : Fixture -> Script (ContractId VaultLedger)
newEmptyLedger f = newLedger f (stateOf 0.0 0.0 parity) parity 0.0

-- | What a registry serves a settlement's executor: the locked funding of
-- the allocations.
fundingDisclosures : Party -> [ContractId AllocationV2.Allocation] -> Script [Disclosure]
fundingDisclosures registryAdmin allocationCids = do
  holdingCids <- forA allocationCids $ \allocationCid -> do
    Some allocation <- queryInterfaceContractId registryAdmin allocationCid
    pure allocation.holdingCids
  holdingDisclosures registryAdmin (concat holdingCids)

holdingDisclosures : Party -> [ContractId HoldingV2.Holding] -> Script [Disclosure]
holdingDisclosures registryAdmin holdingCids = forA holdingCids $ \holdingCid -> do
  Some disclosure <- queryDisclosure registryAdmin (fromInterfaceContractId @TestHolding holdingCid)
  pure disclosure

-- | The command the operator submits to settle a batch at a price, and the
-- disclosures it needs: the registries, the escrows' locked funding, and the
-- pool.
settleCmd
  : Fixture -> ContractId VaultLedger -> SharePrice -> [ContractId DepositRequest]
  -> [ContractId RedeemRequest]
  -> Script ([Disclosure], Commands VaultLedger_SettleBatchResult)
settleCmd f@Fixture{..} ledgerCid price depositCids redeemCids = do
  deposits <- forA depositCids $ \cid -> do
    visible operator cid
    Some request <- queryContractId operator cid
    pure request.state.escrowCid
  redeems <- forA redeemCids $ \cid -> do
    visible operator cid
    Some request <- queryContractId operator cid
    pure request.state.escrowCid
  underlyingFunding <- fundingDisclosures config.underlying.admin deposits
  shareFunding <- fundingDisclosures config.share.admin redeems
  pool <- unlockedHoldings config.underlying treasury
  poolDisclosures <- holdingDisclosures config.underlying.admin pool
  pure
    ( f.registryDisclosures <> underlyingFunding <> shareFunding <> poolDisclosures
    , exerciseCmd ledgerCid VaultLedger_SettleBatch with
        price; depositCids; redeemCids; poolHoldingCids = pool; requestedAt = t0; args = noArgs )

-- | Settle a batch at a price as the operator, alone.
settleBatch
  : Fixture -> ContractId VaultLedger -> SharePrice -> [ContractId DepositRequest]
  -> [ContractId RedeemRequest] -> Script VaultLedger_SettleBatchResult
settleBatch f ledgerCid price depositCids redeemCids = do
  (disclosed, cmd) <- settleCmd f ledgerCid price depositCids redeemCids
  submit (actAs f.operator <> discloseMany disclosed) cmd

-- | Try to settle a batch at a price as the operator, alone.
trySettleBatch
  : Fixture -> ContractId VaultLedger -> SharePrice -> [ContractId DepositRequest]
  -> [ContractId RedeemRequest] -> Script (Either SubmitError VaultLedger_SettleBatchResult)
trySettleBatch f ledgerCid price depositCids redeemCids = do
  (disclosed, cmd) <- settleCmd f ledgerCid price depositCids redeemCids
  trySubmit (actAs f.operator <> discloseMany disclosed) cmd

-- | The state a ledger contract records.
ledgerState : Fixture -> ContractId VaultLedger -> Script VaultState
ledgerState f ledgerCid = do
  Some ledger <- queryContractId f.operator ledgerCid
  pure ledger.state
