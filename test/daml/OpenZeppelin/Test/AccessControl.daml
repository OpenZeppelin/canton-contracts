-- | Tests for OpenZeppelin.AccessControl: grant/revoke, the requireRole gates
-- (admin / assignee / role), and the typed-wrapper pattern.
module OpenZeppelin.Test.AccessControl where

import DA.Date (date, Month(Jan))
import DA.Time (time)
import Daml.Script

import OpenZeppelin.AccessControl
import OpenZeppelin.Test.Gated

-- | Disclose `cid` (owned by `p`) so a non-stakeholder controller can exercise a
-- choice on it — the off-ledger service's job in production. Used to let a
-- role-admin delegate exercise the admin-signed `RoleAdmin`.
discloseTo : forall t. Template t => Party -> ContractId t -> Script Disclosure
discloseTo p cid = do
  optDisc <- queryDisclosure @t p cid
  case optDisc of
    None -> fail $ "no disclosure for " <> show cid
    Some d -> pure d

-- | A granted minter passes a minter-gated operation.
test_grantedRolePasses : Script ()
test_grantedRolePasses = script do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  roleAdmin <- submit admin do createCmd RoleAdmin with admin
  grant <- submit admin do
    exerciseCmd roleAdmin RoleAdmin_GrantRole with account = alice, role = "MINTER_ROLE"
  check <- submit alice do createCmd RoleCheck with caller = alice, admin, role = "MINTER_ROLE"
  submit alice do exerciseCmd check RoleCheck_Run with grantCid = grant
  pure ()

-- | A grant for the wrong role fails the role gate (A3).
test_wrongRoleFails : Script ()
test_wrongRoleFails = script do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  roleAdmin <- submit admin do createCmd RoleAdmin with admin
  grant <- submit admin do
    exerciseCmd roleAdmin RoleAdmin_GrantRole with account = alice, role = "BURNER_ROLE"
  check <- submit alice do createCmd RoleCheck with caller = alice, admin, role = "MINTER_ROLE"
  submitMustFail alice do exerciseCmd check RoleCheck_Run with grantCid = grant
  pure ()

-- | A grant issued by a different admin fails the admin gate (A1).
test_wrongAdminFails : Script ()
test_wrongAdminFails = script do
  admin <- allocateParty "admin"
  other <- allocateParty "other"
  alice <- allocateParty "alice"
  otherAdmin <- submit other do createCmd RoleAdmin with admin = other
  grant <- submit other do
    exerciseCmd otherAdmin RoleAdmin_GrantRole with account = alice, role = "MINTER_ROLE"
  -- alice presents a grant from `other`, but the resource expects `admin`.
  check <- submit alice do createCmd RoleCheck with caller = alice, admin, role = "MINTER_ROLE"
  submitMustFail alice do exerciseCmd check RoleCheck_Run with grantCid = grant
  pure ()

-- | Impersonation: a caller cannot use a grant naming someone else. Bob's grant
-- is observed only by bob, so alice cannot even fetch it (anti-impersonation is
-- enforced by both visibility and requireRole's assignee check).
test_impersonationFails : Script ()
test_impersonationFails = script do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  roleAdmin <- submit admin do createCmd RoleAdmin with admin
  bobGrant <- submit admin do
    exerciseCmd roleAdmin RoleAdmin_GrantRole with account = bob, role = "MINTER_ROLE"
  check <- submit alice do createCmd RoleCheck with caller = alice, admin, role = "MINTER_ROLE"
  submitMustFail alice do exerciseCmd check RoleCheck_Run with grantCid = bobGrant
  pure ()

-- | A revoked grant no longer authorizes (the grant contract is archived).
test_revokedRoleFails : Script ()
test_revokedRoleFails = script do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  roleAdmin <- submit admin do createCmd RoleAdmin with admin
  grant <- submit admin do
    exerciseCmd roleAdmin RoleAdmin_GrantRole with account = alice, role = "MINTER_ROLE"
  submit admin do exerciseCmd roleAdmin RoleAdmin_RevokeRole with grantCid = grant
  check <- submit alice do createCmd RoleCheck with caller = alice, admin, role = "MINTER_ROLE"
  submitMustFail alice do exerciseCmd check RoleCheck_Run with grantCid = grant
  pure ()

-- | The typed-wrapper pattern: grant and check using a closed role sum mapped to
-- Text ids via `roleId`, keeping compile-time exhaustiveness over the generic core.
test_typedWrapperBridge : Script ()
test_typedWrapperBridge = script do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  roleAdmin <- submit admin do createCmd RoleAdmin with admin
  grant <- submit admin do
    exerciseCmd roleAdmin RoleAdmin_GrantRole with account = alice, role = roleId Minter
  check <- submit alice do createCmd RoleCheck with caller = alice, admin, role = roleId Minter
  submit alice do exerciseCmd check RoleCheck_Run with grantCid = grant
  pure ()

-- Role-admin hierarchy (AL-8): grant/revoke through an admin role
-------------------------------------------------------------------

-- | The `getRoleAdmin` analogue: a holder of the admin role can grant another
-- role through `RoleAdmin_GrantRoleAs`, and the resulting grant authorizes.
test_grantRoleAsAdminRolePasses : Script ()
test_grantRoleAsAdminRolePasses = script do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"   -- holds the admin role
  bob <- allocateParty "bob"       -- receives MINTER from alice
  roleAdmin <- submit admin do createCmd RoleAdmin with admin
  -- alice is granted the DEFAULT_ADMIN_ROLE (the admin role of MINTER_ROLE here).
  aliceGrant <- submit admin do
    exerciseCmd roleAdmin RoleAdmin_GrantRole with account = alice, role = "DEFAULT_ADMIN_ROLE"
  d <- discloseTo @RoleAdmin admin roleAdmin
  bobGrant <- submitWithDisclosures alice [d] do
    exerciseCmd roleAdmin RoleAdmin_GrantRoleAs with
      caller = alice; adminRole = "DEFAULT_ADMIN_ROLE"; adminGrantCid = aliceGrant
      account = bob; role = "MINTER_ROLE"
  check <- submit bob do createCmd RoleCheck with caller = bob, admin, role = "MINTER_ROLE"
  submit bob do exerciseCmd check RoleCheck_Run with grantCid = bobGrant
  pure ()

-- | A caller that does not hold the supplied admin role cannot grant. Alice
-- holds only MINTER_ROLE and presents it as if it were the admin role — the
-- `requireRole` gate (A3) rejects it.
test_grantRoleAsWrongAdminRoleFails : Script ()
test_grantRoleAsWrongAdminRoleFails = script do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  roleAdmin <- submit admin do createCmd RoleAdmin with admin
  aliceMinter <- submit admin do
    exerciseCmd roleAdmin RoleAdmin_GrantRole with account = alice, role = "MINTER_ROLE"
  d <- discloseTo @RoleAdmin admin roleAdmin
  submitWithDisclosuresMustFail alice [d] do
    exerciseCmd roleAdmin RoleAdmin_GrantRoleAs with
      caller = alice; adminRole = "DEFAULT_ADMIN_ROLE"; adminGrantCid = aliceMinter
      account = bob; role = "BURNER_ROLE"
  pure ()

-- | Role-admin-aware revoke: a holder of the admin role revokes another's grant.
test_revokeRoleAsAdminRole : Script ()
test_revokeRoleAsAdminRole = script do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  roleAdmin <- submit admin do createCmd RoleAdmin with admin
  aliceGrant <- submit admin do
    exerciseCmd roleAdmin RoleAdmin_GrantRole with account = alice, role = "DEFAULT_ADMIN_ROLE"
  bobGrant <- submit admin do
    exerciseCmd roleAdmin RoleAdmin_GrantRole with account = bob, role = "MINTER_ROLE"
  d <- discloseTo @RoleAdmin admin roleAdmin
  bobGrantDisc <- discloseTo @RoleGrant admin bobGrant
  submitWithDisclosures alice [d, bobGrantDisc] do
    exerciseCmd roleAdmin RoleAdmin_RevokeRoleAs with
      caller = alice; adminRole = "DEFAULT_ADMIN_ROLE"; adminGrantCid = aliceGrant
      grantCid = bobGrant
  -- bob's grant is archived: it no longer authorizes.
  check <- submit bob do createCmd RoleCheck with caller = bob, admin, role = "MINTER_ROLE"
  submitMustFail bob do exerciseCmd check RoleCheck_Run with grantCid = bobGrant
  pure ()

-- | renounceRole: the grantee gives up its own role; afterwards it no longer
-- authorizes (the grant is archived).
test_renounceRole : Script ()
test_renounceRole = script do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  roleAdmin <- submit admin do createCmd RoleAdmin with admin
  grant <- submit admin do
    exerciseCmd roleAdmin RoleAdmin_GrantRole with account = alice, role = "MINTER_ROLE"
  submit alice do exerciseCmd grant RoleGrant_Renounce
  check <- submit alice do createCmd RoleCheck with caller = alice, admin, role = "MINTER_ROLE"
  submitMustFail alice do exerciseCmd check RoleCheck_Run with grantCid = grant
  pure ()

-- | renounceRole is self-only: a party cannot renounce a grant naming someone
-- else (bob's grant is observed only by bob, so alice cannot exercise it).
test_renounceRoleSelfOnly : Script ()
test_renounceRoleSelfOnly = script do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  roleAdmin <- submit admin do createCmd RoleAdmin with admin
  bobGrant <- submit admin do
    exerciseCmd roleAdmin RoleAdmin_GrantRole with account = bob, role = "MINTER_ROLE"
  submitMustFail alice do exerciseCmd bobGrant RoleGrant_Renounce
  pure ()

-- Timelocked two-step default-admin handoff (AccessControlDefaultAdminRules)
-----------------------------------------------------------------------------

t0 : Time
t0 = time (date 2024 Jan 1) 0 0 0

t1 : Time
t1 = time (date 2024 Jan 2) 0 0 0

-- | The handoff cannot complete before its timelock, and does after. Once
-- accepted, the nominee holds the transferred role.
test_defaultAdminTimelock : Script ()
test_defaultAdminTimelock = script do
  setTime t0
  admin <- allocateParty "admin"
  bob <- allocateParty "bob"
  roleAdmin <- submit admin do createCmd RoleAdmin with admin
  offer <- submit admin do
    exerciseCmd roleAdmin RoleAdmin_BeginDefaultAdminTransfer with
      newAdmin = bob; role = "DEFAULT_ADMIN_ROLE"; effectiveTime = t1
  -- Before the timelock elapses, the nominee cannot accept.
  submitMustFail bob do exerciseCmd offer DefaultAdminTransferOffer_Accept
  -- After the timelock, acceptance succeeds and grants the role.
  setTime t1
  grant <- submit bob do exerciseCmd offer DefaultAdminTransferOffer_Accept
  check <- submit bob do createCmd RoleCheck with caller = bob, admin, role = "DEFAULT_ADMIN_ROLE"
  submit bob do exerciseCmd check RoleCheck_Run with grantCid = grant
  pure ()

-- | The admin can cancel a pending handoff within the window; the nominee then
-- can no longer accept (the offer is archived).
test_defaultAdminTransferCancel : Script ()
test_defaultAdminTransferCancel = script do
  setTime t0
  admin <- allocateParty "admin"
  bob <- allocateParty "bob"
  roleAdmin <- submit admin do createCmd RoleAdmin with admin
  offer <- submit admin do
    exerciseCmd roleAdmin RoleAdmin_BeginDefaultAdminTransfer with
      newAdmin = bob; role = "DEFAULT_ADMIN_ROLE"; effectiveTime = t1
  submit admin do exerciseCmd offer DefaultAdminTransferOffer_Cancel
  setTime t1
  submitMustFail bob do exerciseCmd offer DefaultAdminTransferOffer_Accept
  pure ()

-- | Beginning a handoff to the current admin is rejected.
test_defaultAdminSelfOfferFails : Script ()
test_defaultAdminSelfOfferFails = script do
  admin <- allocateParty "admin"
  roleAdmin <- submit admin do createCmd RoleAdmin with admin
  submitMustFail admin do
    exerciseCmd roleAdmin RoleAdmin_BeginDefaultAdminTransfer with
      newAdmin = admin; role = "DEFAULT_ADMIN_ROLE"; effectiveTime = t1
  pure ()

-- Destruction authority (the implicit Archive choice)
-------------------------------------------------------

-- | Only the admin can destroy the `RoleAdmin` surface; once archived, the
-- grant/revoke entrypoints on the stale cid are gone.
test_roleAdminArchiveRemovesGrantSurface : Script ()
test_roleAdminArchiveRemovesGrantSurface = script do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  roleAdmin <- submit admin do createCmd RoleAdmin with admin
  submitMustFail alice do archiveCmd roleAdmin
  submit admin do archiveCmd roleAdmin
  submitMustFail admin do
    exerciseCmd roleAdmin RoleAdmin_GrantRole with account = alice, role = "MINTER_ROLE"
  pure ()

-- | Only the offering admin can destroy a pending default-admin handoff (the
-- raw-archive equivalent of cancelling it); the nominee cannot, and can no
-- longer accept afterwards even once the timelock elapses.
test_defaultAdminOfferArchiveIsAdminOnly : Script ()
test_defaultAdminOfferArchiveIsAdminOnly = script do
  setTime t0
  admin <- allocateParty "admin"
  bob <- allocateParty "bob"
  roleAdmin <- submit admin do createCmd RoleAdmin with admin
  offer <- submit admin do
    exerciseCmd roleAdmin RoleAdmin_BeginDefaultAdminTransfer with
      newAdmin = bob; role = "DEFAULT_ADMIN_ROLE"; effectiveTime = t1
  submitMustFail bob do archiveCmd offer
  submit admin do archiveCmd offer
  setTime t1
  submitMustFail bob do exerciseCmd offer DefaultAdminTransferOffer_Accept
  pure ()

-- | The RBAC-gated harness contract is destroyed only by its signatory (its
-- cleanup path).
test_roleCheckArchiveIsSignatoryOnly : Script ()
test_roleCheckArchiveIsSignatoryOnly = script do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  check <- submit alice do createCmd RoleCheck with caller = alice, admin, role = "MINTER_ROLE"
  submitMustFail bob do archiveCmd check
  submit alice do archiveCmd check
  None <- queryContractId alice check
  pure ()
