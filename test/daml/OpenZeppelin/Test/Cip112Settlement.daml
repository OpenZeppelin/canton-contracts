      submitMustFail admin do
        exerciseCmd markedAliceAllocation Allocation_SweepD2InFlightSeizure with
          burner = admin
          burnerCapCid = Some wrongCap
      pure ()
    [] -> fail "expected an alice allocation"

-- | A D2 hook with no owner/provider destination is rejected before locked
-- holdings are archived.
test_cip112Settlement_d2SweepMissingDestinationFails : Script ()
test_cip112Settlement_d2SweepMissingDestinationFails = script do
  SettlementScenario{..} <- setupScenario "cip112-d2-missing-destination" False False
  let seizureHook = mkD2Hook "cip112-d2-missing-destination" missingD2CustodianAccount
  (burnerCap, _) <- createBurnerCapability admin admin (Some (usdInstrument admin))
  case allocationCids of
    aliceAllocation :: _ -> do
      markedAliceAllocation <- markD2InFlightSeizure admin aliceAllocation seizureHook
      submitMustFail admin do
        exerciseCmd markedAliceAllocation Allocation_SweepD2InFlightSeizure with
          burner = admin
          burnerCapCid = Some burnerCap
      Some _ <- queryContractId admin markedAliceAllocation
      pure ()
    [] -> fail "expected an alice allocation"

-- | D2 in-flight seizure is a pre-deadline containment path. After the
-- settlement deadline, the experimental sweep path fails closed.
test_cip112Settlement_d2SweepAfterDeadlineFails : Script ()
test_cip112Settlement_d2SweepAfterDeadlineFails = script do
  SettlementScenario{..} <- setupScenario "cip112-d2-after-deadline" False False
  let custodian = mkD2CustodianAccount "cip112-d2-after-deadline" admin
      seizureHook = mkD2Hook "cip112-d2-after-deadline" custodian
  (burnerCap, _) <- createBurnerCapability admin admin (Some (usdInstrument admin))
  case allocationCids of
    aliceAllocation :: _ -> do
      markedAliceAllocation <- markD2InFlightSeizure admin aliceAllocation seizureHook
      setTime t2
      submitMustFail admin do
        exerciseCmd markedAliceAllocation Allocation_SweepD2InFlightSeizure with
          burner = admin
          burnerCapCid = Some burnerCap
      pure ()
    [] -> fail "expected an alice allocation"

-- ---------------------------------------------------------------------------
-- Regression tests for the confirmed settlement findings (F1-F4 + adjacent).
-- ---------------------------------------------------------------------------

-- | F1 (registry substitution): a caller-supplied attester registry whose admin
-- is NOT the settling factory's admin cannot vouch for an attestation. An
-- attacker who mints their own registry (self as admin + self as attester) and a
-- self-signed attestation is rejected — trust is rooted in the factory admin.
test_cip112Settlement_attestedSettleSubstitutedRegistryFails : Script ()
test_cip112Settlement_attestedSettleSubstitutedRegistryFails = script do
  SettlementScenario{..} <- setupScenario "cip112-attest-substreg" True True
  evil <- allocateParty "cip112-attest-substreg-evil"
  -- Registry admin = evil (a party other than the factory admin), listing evil.
  (attestation, registry, discs) <-
    mkAttestation evil evil app [evil] settlement.settlementRef.id [transferLeg.transferLegId] t0 t1
  submitMustFail (actAs app <> discloseMany ([factoryDisclosure] <> discs)) do
    exerciseCmd factory SettlementFactory_SettleBatchWithAttestation with
      settlement
      transferLegs = [transferLeg]
      allocationCids
      actors = [app]
      attestationCid = attestation
      registryCid = registry
  pure ()

-- | F2 (replay): the attestation is CONSUMED on use, so it cannot be replayed.
-- After one successful attested settle the attestation contract is archived.
test_cip112Settlement_attestationSingleUseNoReplay : Script ()
test_cip112Settlement_attestationSingleUseNoReplay = script do
  SettlementScenario{..} <- setupScenario "cip112-attest-replay" True True
  attester <- allocateParty "cip112-attest-replay-attester"
  (attestation, registry, discs) <-
    mkAttestation admin attester admin [attester] settlement.settlementRef.id [transferLeg.transferLegId] t0 t1
  _ <- submit (actAs app <> discloseMany ([factoryDisclosure] <> discs)) do
    exerciseCmd factory SettlementFactory_SettleBatchWithAttestation with
      settlement
      transferLegs = [transferLeg]
      allocationCids
      actors = [app]
      attestationCid = attestation
      registryCid = registry
  archived <- queryContractId attester attestation
  archived === None

-- | F2 (batch binding): an attestation bound to a different transfer-leg id set
-- than the batch's legs is rejected — one attestation authorizes exactly one
-- leg set, not any batch sharing the settlement reference.
test_cip112Settlement_attestedSettleWrongBatchBindingFails : Script ()
test_cip112Settlement_attestedSettleWrongBatchBindingFails = script do
  SettlementScenario{..} <- setupScenario "cip112-attest-wrongbatch" True True
  attester <- allocateParty "cip112-attest-wrongbatch-attester"
  (attestation, registry, discs) <-
    mkAttestation admin attester admin [attester] settlement.settlementRef.id ["some-other-leg"] t0 t1
  submitMustFail (actAs app <> discloseMany ([factoryDisclosure] <> discs)) do
    exerciseCmd factory SettlementFactory_SettleBatchWithAttestation with
      settlement
      transferLegs = [transferLeg]
      allocationCids
      actors = [app]
      attestationCid = attestation
      registryCid = registry
  pure ()

-- | F3 (freeze escape via cancel): a settlement executor cannot cancel an
-- allocation with an active D2 in-flight seizure — funds cannot escape a freeze
-- through the cancel path.
test_cip112Settlement_frozenAllocationCannotCancel : Script ()
test_cip112Settlement_frozenAllocationCannotCancel = script do
  SettlementScenario{..} <- setupScenario "cip112-frozen-cancel" False False
  let custodian = mkD2CustodianAccount "cip112-frozen-cancel" admin
      seizureHook = mkD2Hook "cip112-frozen-cancel" custodian
  case allocationCids of
    aliceAllocation :: _ -> do
      marked <- markD2InFlightSeizure admin aliceAllocation seizureHook
      submitMustFail app do
        exerciseCmd marked Allocation_Cancel with actors = [app]
      pure ()
    [] -> fail "expected an alice allocation"

-- | F3 (freeze self-escape via withdraw): the authorizer being seized cannot
-- withdraw funds out from under an active D2 in-flight seizure.
test_cip112Settlement_frozenAllocationCannotWithdraw : Script ()
test_cip112Settlement_frozenAllocationCannotWithdraw = script do
  SettlementScenario{..} <- setupScenario "cip112-frozen-withdraw" False False
  let custodian = mkD2CustodianAccount "cip112-frozen-withdraw" admin
      seizureHook = mkD2Hook "cip112-frozen-withdraw" custodian
  case allocationCids of
    aliceAllocation :: _ -> do
      marked <- markD2InFlightSeizure admin aliceAllocation seizureHook
      submitMustFail alice do
        exerciseCmd marked Allocation_Withdraw with actors = [alice]
      pure ()
    [] -> fail "expected an alice allocation"

-- | A1 (commitment symmetry): a committed allocation cannot be cancelled by the
-- executor before the settlement deadline, mirroring the authorizer's withdraw.
test_cip112Settlement_committedCancelBeforeDeadlineFails : Script ()
test_cip112Settlement_committedCancelBeforeDeadlineFails = script do
  SettlementScenario{..} <- setupScenario "cip112-committed-cancel" False True
  case allocationCids of
    aliceAllocation :: _ -> do
      submitMustFail app do
        exerciseCmd aliceAllocation Allocation_Cancel with actors = [app]
      pure ()
    [] -> fail "expected an alice allocation"

-- | A2 (unsweepable frozen state): a baseline (windowless) D2 mark placed after
-- the settlement deadline is rejected — no sweep could resolve it, so the frozen
-- state is refused. Post-deadline seizure must use the windowed variant.
test_cip112Settlement_markD2AfterDeadlineFails : Script ()
test_cip112Settlement_markD2AfterDeadlineFails = script do
  SettlementScenario{..} <- setupScenario "cip112-mark-afterdeadline" False False
  let custodian = mkD2CustodianAccount "cip112-mark-afterdeadline" admin
      seizureHook = mkD2Hook "cip112-mark-afterdeadline" custodian
  case allocationCids of
    aliceAllocation :: _ -> do
      setTime t2
      submitMustFail admin do
        exerciseCmd aliceAllocation Allocation_MarkD2InFlightSeizure with
          actors = [admin]
          seizureHook
      pure ()
    [] -> fail "expected an alice allocation"


-- | M1 (binding D1 posture): when a factory mandates node attestation, the plain
-- SettleBatch path is refused and only the attested path settles — the typed D1
-- control is a factory property, not an executor's per-transaction choice.
test_cip112Settlement_attestationMandatoryFactoryBindsPath : Script ()
test_cip112Settlement_attestationMandatoryFactoryBindsPath = script do
  setTime t0
  admin <- allocateParty "cip112-m1-admin"
  app <- allocateParty "cip112-m1-app"
  alice <- allocateParty "cip112-m1-alice"
  bob <- allocateParty "cip112-m1-bob"
  attester <- allocateParty "cip112-m1-attester"
  let aliceAccount = basicAccount alice
      bobAccount = basicAccount bob
      settlement = mkSettlement "cip112-m1" app
      leg = mkLeg "cip112-m1" aliceAccount bobAccount
  factory <- submit admin do
    createCmd SettlementFactory with admin; requiresNodeAttestation = Some True; featureFlag = experimentalFeatureFlag
  Some factoryDisclosure <- queryDisclosure @SettlementFactory admin factory
  aliceHolding <- submit [admin, alice] do
    createCmd ToyHolding with
      admin
      account = aliceAccount
      instrumentId = usdInstrument admin
      amount = 10.0
      lock = None
      meta = emptyMetadata
      featureFlag = experimentalFeatureFlag
  aliceInstruction <- submit (actAs alice <> discloseMany [factoryDisclosure]) do
    exerciseCmd factory SettlementFactory_CreateAllocationInstruction with
      allocation = mkAllocation settlement admin aliceAccount [senderSide leg] False
      requestedAt = t0
      inputHoldingCids = [aliceHolding]
      d1ComplianceHook = None
      actors = [alice]
  aliceResult <- submit alice do exerciseCmd aliceInstruction AllocationInstruction_Accept with actors = [alice]
  aliceAllocation <- case aliceResult of
    AllocationInstructionCompleted cid -> pure cid
    _ -> fail "expected alice allocation instruction to complete"
  bobInstruction <- submit (actAs bob <> discloseMany [factoryDisclosure]) do
    exerciseCmd factory SettlementFactory_CreateAllocationInstruction with
      allocation = mkAllocation settlement admin bobAccount [receiverSide leg] False
      requestedAt = t0
      inputHoldingCids = []
      d1ComplianceHook = None
      actors = [bob]
  bobResult <- submit bob do exerciseCmd bobInstruction AllocationInstruction_Accept with actors = [bob]
  bobAllocation <- case bobResult of
    AllocationInstructionCompleted cid -> pure cid
    _ -> fail "expected bob allocation instruction to complete"
  let allocationCids = [aliceAllocation, bobAllocation]
  -- The attestation-less path is refused on a mandating factory.
  submitMustFail (actAs app <> discloseMany [factoryDisclosure]) do
    exerciseCmd factory SettlementFactory_SettleBatch with
      settlement
      transferLegs = [leg]
      allocationCids
      actors = [app]
      d1ComplianceRef = None
  -- The mandated attested path settles.
  (attestation, registry, discs) <-
    mkAttestation admin attester admin [attester] settlement.settlementRef.id [leg.transferLegId] t0 t1
  receiptCids <- submit (actAs app <> discloseMany ([factoryDisclosure] <> discs)) do
    exerciseCmd factory SettlementFactory_SettleBatchWithAttestation with
      settlement
      transferLegs = [leg]
      allocationCids
      actors = [app]
      attestationCid = attestation
      registryCid = registry
  length receiptCids === 2

-- | M2 (no stranded funds): an admin can release (unmark) an in-flight seizure
-- that will not be swept, restoring the normal lifecycle. A marked allocation
-- blocks withdraw; after unmark the authorizer can withdraw the funds.
test_cip112Settlement_d2UnmarkReleasesFrozenFunds : Script ()
test_cip112Settlement_d2UnmarkReleasesFrozenFunds = script do
  SettlementScenario{..} <- setupScenario "cip112-d2-unmark" False False
  let custodian = mkD2CustodianAccount "cip112-d2-unmark" admin
      seizureHook = mkD2Hook "cip112-d2-unmark" custodian
  case allocationCids of
    aliceAllocation :: _ -> do
      marked <- markD2InFlightSeizure admin aliceAllocation seizureHook
      -- Frozen: withdraw is blocked.
      submitMustFail alice do
        exerciseCmd marked Allocation_Withdraw with actors = [alice]
      -- Admin releases the seizure.
      released <- submit admin do
        exerciseCmd marked Allocation_UnmarkD2InFlightSeizure with actors = [admin]
      -- The authorizer can now withdraw the previously-frozen funds.
      result <- submit alice do
        exerciseCmd released Allocation_Withdraw with actors = [alice]
      case result of
        AllocationWithdrawn returnedHoldingCids -> length returnedHoldingCids === 1
        _ -> fail "expected AllocationWithdrawn"
    [] -> fail "expected an alice allocation"

-- | N1 (SCU-safe binding): `boundTransferLegIds` is an Optional appended field,
-- but an UNBOUND (`None`) attestation is rejected — batch binding is mandatory in
-- practice, so the Optional shape cannot be used to sidestep replay protection.
test_cip112Settlement_attestedSettleUnboundAttestationFails : Script ()
test_cip112Settlement_attestedSettleUnboundAttestationFails = script do
  SettlementScenario{..} <- setupScenario "cip112-attest-unbound" True True
  attester <- allocateParty "cip112-attest-unbound-attester"
  registry <- submit admin do
    createCmd TrustedAttesterRegistry with
      admin
      attesters = [attester]
      featureFlag = experimentalFeatureFlag
  attestation <- submit attester do
    createCmd NodeComplianceAttestation with
      attester
      attestationObservers = [admin]
      settlementRef = settlement.settlementRef.id
      claimKind = "OFAC_CLEARED"
      issuedAt = t0
      expiresAt = t1
      featureFlag = experimentalFeatureFlag
      boundTransferLegIds = None
  Some regDisc <- queryDisclosure @TrustedAttesterRegistry admin registry
  Some attDisc <- queryDisclosure @NodeComplianceAttestation attester attestation
  submitMustFail (actAs app <> discloseMany [factoryDisclosure, regDisc, attDisc]) do
    exerciseCmd factory SettlementFactory_SettleBatchWithAttestation with
      settlement
      transferLegs = [transferLeg]
      allocationCids
      actors = [app]
      attestationCid = attestation
      registryCid = registry
  pure ()

-- Request/instruction lifecycle: reject and withdraw
------------------------------------------------------

-- | Build only the factory and an executor-created allocation request toward
-- alice, for the request-lifecycle tests.
setupRequestScenario : Text -> Script (Party, Party, ContractId AllocationRequest)
setupRequestScenario prefix = do
  setTime t0
  admin <- allocateParty (prefix <> "-admin")
  app <- allocateParty (prefix <> "-app")
  alice <- allocateParty (prefix <> "-alice")
  bob <- allocateParty (prefix <> "-bob")
  let aliceAccount = basicAccount alice
      settlement = mkSettlement prefix app
      leg = mkLeg prefix aliceAccount (basicAccount bob)
  factory <- submit admin do
    createCmd SettlementFactory with
      admin
      requiresNodeAttestation = None
      featureFlag = experimentalFeatureFlag
  Some factoryDisclosure <- queryDisclosure @SettlementFactory admin factory
  request <- submit (actAs app <> discloseMany [factoryDisclosure]) do
    exerciseCmd factory SettlementFactory_CreateAllocationRequest with
      authorizer = aliceAccount
      settlement
      allocations =
        [ RequestedAllocation with
            admin
            transferLegSides = [senderSide leg]
            nextIterationFunding = None
            committed = False
            meta = emptyMetadata
        ]
      requestedAt = t0
      settleAt = Some t1
      actors = [app]
  pure (app, alice, request)

-- | The authorizer rejects a routed allocation request; the request is
-- archived. The executors cannot reject on the authorizer's behalf.
test_cip112Settlement_requestRejectByAuthorizer : Script ()
test_cip112Settlement_requestRejectByAuthorizer = script do
  (app, alice, request) <- setupRequestScenario "cip112-request-reject"
  submitMustFail app do
    exerciseCmd request AllocationRequest_Reject with actors = [app]
  result <- submit alice do
    exerciseCmd request AllocationRequest_Reject with actors = [alice]
  result === AllocationRequestRejected
  None <- queryContractId app request
  pure ()

-- | The executors withdraw their own pending request; the authorizer cannot
-- withdraw on the executors' behalf.
test_cip112Settlement_requestWithdrawByExecutors : Script ()
test_cip112Settlement_requestWithdrawByExecutors = script do
  (app, alice, request) <- setupRequestScenario "cip112-request-withdraw"
  submitMustFail alice do
    exerciseCmd request AllocationRequest_Withdraw with actors = [alice]
  result <- submit app do
    exerciseCmd request AllocationRequest_Withdraw with actors = [app]
  result === AllocationRequestWithdrawn
  None <- queryContractId app request
  pure ()

-- | The authorizer withdraws a pending (not yet accepted) instruction: only
-- the instruction is archived — the input holding is untouched and stays
-- unlocked. Executors cannot withdraw the authorizer's instruction.
test_cip112Settlement_instructionWithdrawLeavesHoldingUnlocked : Script ()
test_cip112Settlement_instructionWithdrawLeavesHoldingUnlocked = script do
  setTime t0
  admin <- allocateParty "cip112-instr-withdraw-admin"
  app <- allocateParty "cip112-instr-withdraw-app"
  alice <- allocateParty "cip112-instr-withdraw-alice"
  bob <- allocateParty "cip112-instr-withdraw-bob"
  let aliceAccount = basicAccount alice
      settlement = mkSettlement "cip112-instr-withdraw" app
      leg = mkLeg "cip112-instr-withdraw" aliceAccount (basicAccount bob)
  factory <- submit admin do
    createCmd SettlementFactory with
      admin
      requiresNodeAttestation = None
      featureFlag = experimentalFeatureFlag
  Some factoryDisclosure <- queryDisclosure @SettlementFactory admin factory
  aliceHolding <- submit [admin, alice] do
    createCmd ToyHolding with
      admin
      account = aliceAccount
      instrumentId = usdInstrument admin
      amount = 10.0
      lock = None
      meta = emptyMetadata
      featureFlag = experimentalFeatureFlag
  instruction <- submit (actAs alice <> discloseMany [factoryDisclosure]) do
    exerciseCmd factory SettlementFactory_CreateAllocationInstruction with
      allocation = mkAllocation settlement admin aliceAccount [senderSide leg] False
      requestedAt = t0
      inputHoldingCids = [aliceHolding]
      d1ComplianceHook = None
      actors = [alice]
  submitMustFail app do
    exerciseCmd instruction AllocationInstruction_Withdraw with actors = [app]
  result <- submit alice do
    exerciseCmd instruction AllocationInstruction_Withdraw with actors = [alice]
  result === AllocationInstructionFailed
  None <- queryContractId alice instruction
  Some holding <- queryContractId alice aliceHolding
  holding.lock === None

-- Destruction authority (the implicit Archive choice)
------------------------------------------------------

-- | A routed request belongs to the executors that signed it: they can
-- raw-archive it (the untyped equivalent of `AllocationRequest_Withdraw`),
-- while the authorizer — an observer — cannot destroy it.
test_cip112Settlement_requestArchiveIsExecutorOnly : Script ()
test_cip112Settlement_requestArchiveIsExecutorOnly = script do
  (app, alice, request) <- setupRequestScenario "cip112-request-archive"
  submitMustFail alice do archiveCmd request
  submit app do archiveCmd request
  None <- queryContractId app request
  pure ()

-- | A pending instruction is co-signed by the instrument admin and the
-- authorizer: neither can unilaterally destroy it; jointly they can, and the
-- not-yet-locked input holding is untouched by the destruction.
test_cip112Settlement_instructionArchiveNeedsAllSignatories : Script ()
test_cip112Settlement_instructionArchiveNeedsAllSignatories = script do
  setTime t0
  admin <- allocateParty "cip112-instr-archive-admin"
  app <- allocateParty "cip112-instr-archive-app"
  alice <- allocateParty "cip112-instr-archive-alice"
  bob <- allocateParty "cip112-instr-archive-bob"
  let aliceAccount = basicAccount alice
      settlement = mkSettlement "cip112-instr-archive" app
      leg = mkLeg "cip112-instr-archive" aliceAccount (basicAccount bob)
  factory <- submit admin do
    createCmd SettlementFactory with
      admin
      requiresNodeAttestation = None
      featureFlag = experimentalFeatureFlag
  Some factoryDisclosure <- queryDisclosure @SettlementFactory admin factory
  aliceHolding <- submit [admin, alice] do
    createCmd ToyHolding with
      admin
      account = aliceAccount
      instrumentId = usdInstrument admin
      amount = 10.0
      lock = None
      meta = emptyMetadata
      featureFlag = experimentalFeatureFlag
  instruction <- submit (actAs alice <> discloseMany [factoryDisclosure]) do
    exerciseCmd factory SettlementFactory_CreateAllocationInstruction with
      allocation = mkAllocation settlement admin aliceAccount [senderSide leg] False
      requestedAt = t0
      inputHoldingCids = [aliceHolding]
      d1ComplianceHook = None
      actors = [alice]
  submitMustFail admin do archiveCmd instruction
  submitMustFail alice do archiveCmd instruction
  submit [admin, alice] do archiveCmd instruction
  None <- queryContractId alice instruction
  Some holding <- queryContractId alice aliceHolding
  holding.lock === None

-- | D2 revocation is structural: the admin (sole signatory) archives the
-- capability, and a sweep presenting the stale capability cid fails. The
-- assignee (observer) cannot destroy its own credential.
test_cip112Settlement_d2ArchivedBurnerCapabilityBlocksSweep : Script ()
test_cip112Settlement_d2ArchivedBurnerCapabilityBlocksSweep = script do
  SettlementScenario{..} <- setupScenario "cip112-d2-cap-archive" False False
  burnerParty <- allocateParty "cip112-d2-cap-archive-burner"
  custodianParty <- allocateParty "cip112-d2-cap-archive-custodian"
  let custodian = mkD2ThirdPartyCustodianAccount "cip112-d2-cap-archive" custodianParty
      seizureHook = mkD2Hook "cip112-d2-cap-archive" custodian
  (burnerCap, _) <- createBurnerCapability admin burnerParty (Some (usdInstrument admin))
  case allocationCids of
    aliceAllocation :: _ -> do
      markedAliceAllocation <- markD2InFlightSeizure admin aliceAllocation seizureHook
      submitMustFail burnerParty do archiveCmd burnerCap
      submit admin do archiveCmd burnerCap
      submitMustFail (actAs [burnerParty, custodianParty] <> readAs [admin]) do
        exerciseCmd markedAliceAllocation Allocation_SweepD2InFlightSeizure with
          burner = burnerParty
          burnerCapCid = Some burnerCap
      pure ()
    [] -> fail "expected an alice allocation"

-- | Neither side can unilaterally destroy a live escrow: the admin alone and
-- the authorizer alone both fail to archive an `Allocation`. All signatories
-- jointly can — and a raw joint archive strands the locked holding (still
-- locked, nothing released), which is why the lifecycle choices (settle,
-- cancel, withdraw) are the real exits.
test_cip112Settlement_allocationArchiveNeedsAllSignatories : Script ()
test_cip112Settlement_allocationArchiveNeedsAllSignatories = script do
  SettlementScenario{..} <- setupScenario "cip112-alloc-archive" False False
  case allocationCids of
    aliceAllocation :: _ -> do
      submitMustFail admin do archiveCmd aliceAllocation
      submitMustFail alice do archiveCmd aliceAllocation
      submit [admin, alice] do archiveCmd aliceAllocation
      None <- queryContractId alice aliceAllocation
      aliceHoldings <- query @ToyHolding alice
      let lockedHoldings = filter (\(_, h) -> h.lock /= None) aliceHoldings
      length lockedHoldings === 1
      pure ()
    [] -> fail "expected an alice allocation"

-- | Only the admin can destroy the factory; the batch entrypoint on the stale
-- cid is gone afterwards.
test_cip112Settlement_factoryArchiveRemovesEntrypoints : Script ()
test_cip112Settlement_factoryArchiveRemovesEntrypoints = script do
  SettlementScenario{..} <- setupScenario "cip112-factory-archive" False False
  submitMustFail app do archiveCmd factory
  submit admin do archiveCmd factory
  submitMustFail (actAs app <> discloseMany [factoryDisclosure]) do
    exerciseCmd factory SettlementFactory_SettleBatch with
      settlement
      transferLegs = [transferLeg]
      allocationCids
      actors = [app]
      d1ComplianceRef = None
  pure ()

-- | Only the registry admin can destroy the attester registry — the archive
-- step of the archive-and-recreate membership change; an attester cannot
-- destroy the trust anchor.
test_cip112Settlement_attesterRegistryArchiveIsAdminOnly : Script ()
test_cip112Settlement_attesterRegistryArchiveIsAdminOnly = script do
  admin <- allocateParty "cip112-att-reg-archive-admin"
  attester <- allocateParty "cip112-att-reg-archive-attester"
  registry <- submit admin do
    createCmd TrustedAttesterRegistry with
      admin
      attesters = [attester]
      featureFlag = experimentalFeatureFlag
  submitMustFail attester do archiveCmd registry
  submit admin do archiveCmd registry
  None <- queryContractId admin registry
  pure ()

-- | An attester revokes an unconsumed attestation by archiving it; the
-- attested settle presenting the stale cid fails. The observing registry
-- admin cannot destroy the attester's attestation.
test_cip112Settlement_archivedAttestationBlocksAttestedSettle : Script ()
test_cip112Settlement_archivedAttestationBlocksAttestedSettle = script do
  SettlementScenario{..} <- setupScenario "cip112-att-archive" True True
  attester <- allocateParty "cip112-att-archive-attester"
  (attestation, registry, discs) <- mkAttestation admin attester admin [attester] settlement.settlementRef.id [transferLeg.transferLegId] t0 t1
  submitMustFail admin do archiveCmd attestation
  submit attester do archiveCmd attestation
  submitMustFail (actAs app <> discloseMany ([factoryDisclosure] <> discs)) do
    exerciseCmd factory SettlementFactory_SettleBatchWithAttestation with
      settlement
      transferLegs = [transferLeg]
      allocationCids
      actors = [app]
      attestationCid = attestation
      registryCid = registry
  pure ()

-- | Settlement audit artifacts are admin-owned: the receipt and the emitted
-- event-log entry can be archived only by the admin that signed them, not by
-- the executors or account parties observing them.
test_cip112Settlement_receiptAndEventLogArchiveIsAdminOnly : Script ()
test_cip112Settlement_receiptAndEventLogArchiveIsAdminOnly = script do
  SettlementScenario{..} <- setupScenario "cip112-receipt-archive" False False
  receiptCids <- submit (actAs app <> discloseMany [factoryDisclosure]) do
    exerciseCmd factory SettlementFactory_SettleBatch with
      settlement
      transferLegs = [transferLeg]
      allocationCids
      actors = [app]
      d1ComplianceRef = None
  case receiptCids of
    receiptCid :: _ -> do
      submitMustFail app do archiveCmd receiptCid
      submit admin do archiveCmd receiptCid
      None <- queryContractId admin receiptCid
      pure ()
    [] -> fail "expected a settlement receipt"
  entries <- query @SettlementEventLogEntry admin
  case entries of
    (entryCid, _) :: _ -> do
      submitMustFail app do archiveCmd entryCid
      submit admin do archiveCmd entryCid
      None <- queryContractId admin entryCid
      pure ()
    [] -> fail "expected a holdings-change event entry"
