  pure ()

-- | Input holdings must match the allocation-side instrument before they can be
-- locked for settlement.
test_cip112Settlement_inputHoldingInstrumentMismatchFails : Script ()
test_cip112Settlement_inputHoldingInstrumentMismatchFails = script do
  setTime t0
  admin <- allocateParty "cip112-input-mismatch-admin"
  app <- allocateParty "cip112-input-mismatch-app"
  alice <- allocateParty "cip112-input-mismatch-alice"
  bob <- allocateParty "cip112-input-mismatch-bob"

  let aliceAccount = basicAccount alice
      bobAccount = basicAccount bob
      settlement = mkSettlement "cip112-input-mismatch" app
      transferLeg = mkLeg "cip112-input-mismatch" aliceAccount bobAccount
      aliceSide = senderSide transferLeg

  factory <- submit admin do
    createCmd SettlementFactory with
      admin
      requiresNodeAttestation = None
      featureFlag = experimentalFeatureFlag
  Some factoryDisclosure <- queryDisclosure @SettlementFactory admin factory

  wrongInstrumentHolding <- submit [admin, alice] do
    createCmd ToyHolding with
      admin
      account = aliceAccount
      instrumentId = InstrumentId with admin; id = "EUR"
      amount = 10.0
      lock = None
      meta = emptyMetadata
      featureFlag = experimentalFeatureFlag

  instruction <- submit (actAs alice <> discloseMany [factoryDisclosure]) do
    exerciseCmd factory SettlementFactory_CreateAllocationInstruction with
      allocation = mkAllocation settlement admin aliceAccount [aliceSide] False
      requestedAt = t0
      inputHoldingCids = [wrongInstrumentHolding]
      d1ComplianceHook = None
      actors = [alice]

  submitMustFail alice do
    exerciseCmd instruction AllocationInstruction_Accept with actors = [alice]
  pure ()

-- | A committed allocation cannot be withdrawn by the authorizer before the
-- settlement deadline.
test_cip112Settlement_committedWithdrawBeforeDeadlineFails : Script ()
test_cip112Settlement_committedWithdrawBeforeDeadlineFails = script do
  SettlementScenario{..} <- setupScenario "cip112-committed" False True
  case allocationCids of
    aliceAllocation :: _ -> do
      submitMustFail alice do
        exerciseCmd aliceAllocation Allocation_Withdraw with actors = [alice]
      pure ()
    [] -> fail "expected an alice allocation"

-- | Only settlement executors can cancel an allocation.
test_cip112Settlement_cancelWrongActorFails : Script ()
test_cip112Settlement_cancelWrongActorFails = script do
  SettlementScenario{..} <- setupScenario "cip112-cancel-wrong-actor" False False
  case allocationCids of
    aliceAllocation :: _ -> do
      submitMustFail alice do
        exerciseCmd aliceAllocation Allocation_Cancel with actors = [alice]
      pure ()
    [] -> fail "expected an alice allocation"

-- | Executor cancellation releases the locked authorizer holding.
test_cip112Settlement_cancelUnlocksHolding : Script ()
test_cip112Settlement_cancelUnlocksHolding = script do
  SettlementScenario{..} <- setupScenario "cip112-cancel" False False
  case allocationCids of
    aliceAllocation :: _ -> do
      result <- submit app do
        exerciseCmd aliceAllocation Allocation_Cancel with actors = [app]
      case result of
        AllocationCancelled returnedHoldingCids -> do
          length returnedHoldingCids === 1
          case returnedHoldingCids of
            returnedCid :: _ -> do
              Some returnedHolding <- queryContractId alice returnedCid
              returnedHolding.lock === None
            [] -> fail "expected an unlocked holding"
        _ -> fail "expected AllocationCancelled"
    [] -> fail "expected an alice allocation"

-- | Only the authorizer account parties can withdraw an allocation.
test_cip112Settlement_withdrawWrongActorFails : Script ()
test_cip112Settlement_withdrawWrongActorFails = script do
  SettlementScenario{..} <- setupScenario "cip112-withdraw-wrong-actor" False False
  case allocationCids of
    aliceAllocation :: _ -> do
      submitMustFail app do
        exerciseCmd aliceAllocation Allocation_Withdraw with actors = [app]
      pure ()
    [] -> fail "expected an alice allocation"

-- | D2 in-flight seizure sweeps locked holdings to the admin-preset custodian
-- destination under a Burner capability. Settlement executors and
-- counterparties do not provide a destination.
test_cip112Settlement_d2InFlightSeizureSweepsLockedHolding : Script ()
test_cip112Settlement_d2InFlightSeizureSweepsLockedHolding = script do
  SettlementScenario{..} <- setupScenario "cip112-d2-sweep" False False
  custodianParty <- allocateParty "cip112-d2-sweep-custodian"
  let custodian = mkD2ThirdPartyCustodianAccount "cip112-d2-sweep" custodianParty
      seizureHook = mkD2Hook "cip112-d2-sweep" custodian
  (burnerCap, _) <- createBurnerCapability admin admin (Some (usdInstrument admin))
  case allocationCids of
    aliceAllocation :: _ -> do
      markedAliceAllocation <- markD2InFlightSeizure admin aliceAllocation seizureHook
      result <- submit [admin, custodianParty] do
        exerciseCmd markedAliceAllocation Allocation_SweepD2InFlightSeizure with
          burner = admin
          burnerCapCid = Some burnerCap
      case result of
        AllocationD2Swept custodianHoldingCids -> do
          length custodianHoldingCids === 1
          case custodianHoldingCids of
            custodianHoldingCid :: _ -> do
              Some custodianHolding <- queryContractId custodianParty custodianHoldingCid
              custodianHolding.account === custodian
              custodianHolding.lock === None
              custodianHolding.amount === 10.0
            [] -> fail "expected a custodian holding"
        _ -> fail "expected AllocationD2Swept"
    [] -> fail "expected an alice allocation"

-- | A delegated Burner capability can sweep to a third-party custodian when the
-- allocation is disclosed and the preset destination co-authorizes receipt.
test_cip112Settlement_d2DelegatedBurnerSweepsToThirdPartyCustodian : Script ()
test_cip112Settlement_d2DelegatedBurnerSweepsToThirdPartyCustodian = script do
  SettlementScenario{..} <- setupScenario "cip112-d2-delegated-sweep" False False
  burner <- allocateParty "cip112-d2-delegated-sweep-burner"
  custodianParty <- allocateParty "cip112-d2-delegated-sweep-custodian"
  let custodian = mkD2ThirdPartyCustodianAccount "cip112-d2-delegated-sweep" custodianParty
      seizureHook = mkD2Hook "cip112-d2-delegated-sweep" custodian
  (burnerCap, _) <- createBurnerCapability admin burner (Some (usdInstrument admin))
  case allocationCids of
    aliceAllocation :: _ -> do
      markedAliceAllocation <- markD2InFlightSeizure admin aliceAllocation seizureHook
      result <- submit (actAs [burner, custodianParty] <> readAs [admin]) do
        exerciseCmd markedAliceAllocation Allocation_SweepD2InFlightSeizure with
          burner
          burnerCapCid = Some burnerCap
      case result of
        AllocationD2Swept custodianHoldingCids -> do
          length custodianHoldingCids === 1
          case custodianHoldingCids of
            custodianHoldingCid :: _ -> do
              Some custodianHolding <- queryContractId custodianParty custodianHoldingCid
              custodianHolding.account === custodian
              custodianHolding.lock === None
              custodianHolding.amount === 10.0
            [] -> fail "expected a custodian holding"
        _ -> fail "expected AllocationD2Swept"
    [] -> fail "expected an alice allocation"

-- | A D2-marked allocation cannot continue through normal settlement. The
-- only resolution path for the in-flight marker is the dedicated sweep choice.
test_cip112Settlement_d2MarkedAllocationCannotSettle : Script ()
test_cip112Settlement_d2MarkedAllocationCannotSettle = script do
  SettlementScenario{..} <- setupScenario "cip112-d2-marked-no-settle" False False
  let custodian = mkD2CustodianAccount "cip112-d2-marked-no-settle" admin
      seizureHook = mkD2Hook "cip112-d2-marked-no-settle" custodian
  case allocationCids of
    aliceAllocation :: bobAllocation :: [] -> do
      markedAliceAllocation <- markD2InFlightSeizure admin aliceAllocation seizureHook
      submitMustFail (actAs app <> discloseMany [factoryDisclosure]) do
        exerciseCmd factory SettlementFactory_SettleBatch with
          settlement
          transferLegs = [transferLeg]
          allocationCids = [markedAliceAllocation, bobAllocation]
          actors = [app]
          d1ComplianceRef = None
      submitMustFail [admin, app] do
        exerciseCmd markedAliceAllocation Allocation_Settle with
          actors = [admin, app]
          settlement
          transferLegs = [transferLeg]
          peerAllocationCids = [bobAllocation]
          peerReceiptCids = []
          d1ComplianceRef = None
      Some _ <- queryContractId admin markedAliceAllocation
      pure ()
    _ -> fail "expected two allocations"

-- | The sweep exerciser must be the party named by the admin-issued Burner
-- capability.
test_cip112Settlement_d2SweepWrongActorFails : Script ()
test_cip112Settlement_d2SweepWrongActorFails = script do
  SettlementScenario{..} <- setupScenario "cip112-d2-wrong-actor" False False
  let custodian = mkD2CustodianAccount "cip112-d2-wrong-actor" admin
      seizureHook = mkD2Hook "cip112-d2-wrong-actor" custodian
  (burnerCap, burnerCapDisclosure) <- createBurnerCapability admin admin (Some (usdInstrument admin))
  case allocationCids of
    aliceAllocation :: _ -> do
      markedAliceAllocation <- markD2InFlightSeizure admin aliceAllocation seizureHook
      submitMustFail (actAs app <> discloseMany [burnerCapDisclosure]) do
        exerciseCmd markedAliceAllocation Allocation_SweepD2InFlightSeizure with
          burner = app
          burnerCapCid = Some burnerCap
      pure ()
    [] -> fail "expected an alice allocation"

-- | A missing Burner capability fails before any locked holding can be swept.
test_cip112Settlement_d2SweepMissingCapabilityFails : Script ()
test_cip112Settlement_d2SweepMissingCapabilityFails = script do
  SettlementScenario{..} <- setupScenario "cip112-d2-missing-cap" False False
  let custodian = mkD2CustodianAccount "cip112-d2-missing-cap" admin
      seizureHook = mkD2Hook "cip112-d2-missing-cap" custodian
  case allocationCids of
    aliceAllocation :: _ -> do
      markedAliceAllocation <- markD2InFlightSeizure admin aliceAllocation seizureHook
      submitMustFail admin do
        exerciseCmd markedAliceAllocation Allocation_SweepD2InFlightSeizure with
          burner = admin
          burnerCapCid = None
      pure ()
    [] -> fail "expected an alice allocation"

-- | A Burner capability for the wrong instrument does not authorize sweeping a
-- USD locked holding.
test_cip112Settlement_d2SweepWrongCapabilityFails : Script ()
test_cip112Settlement_d2SweepWrongCapabilityFails = script do
  SettlementScenario{..} <- setupScenario "cip112-d2-wrong-cap" False False
  let custodian = mkD2CustodianAccount "cip112-d2-wrong-cap" admin
      seizureHook = mkD2Hook "cip112-d2-wrong-cap" custodian
