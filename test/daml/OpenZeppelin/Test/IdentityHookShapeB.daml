-- | Smoke and negative tests for experimental identity hook shape B.
module OpenZeppelin.Test.IdentityHookShapeB where

import DA.Assert ((===))
import DA.Date (date, Month(Jan))
import DA.Time (time)
import Daml.Script

import OpenZeppelin.Experimental.Identity.ShapeB

t0 : Time
t0 = time (date 2026 Jan 1) 0 0 0

t1 : Time
t1 = time (date 2026 Jan 1) 0 1 0

t2 : Time
t2 = time (date 2026 Jan 1) 0 2 0

mintHolding : Party -> [Party] -> Party -> Script (ContractId ToyHolding)
mintHolding registryAdmin trustedIssuers owner = do
  registry <- submit registryAdmin do
    createCmd TrustedIssuerRegistry with
      registryAdmin
      trustedIssuers
      featureFlag = experimentalFeatureFlag
  submit registryAdmin do
    exerciseCmd registry TrustedIssuerRegistry_Mint with owner, amount = 100

createClaim : Party -> Party -> Party -> IdentityClaimKind -> Time -> Text -> Script (ContractId KycClaim)
createClaim claimSigner declaredIssuer subjectParty claimKind validUntil claimId =
  submit claimSigner do
    createCmd KycClaim with
      claimSigner
      declaredIssuer
      subjectParty
      claimKind
      validUntil
      claimId

-- | Candidate B composes a typed KYC_VALIDATED claim and trusted-issuer
-- registry snapshot with the same toy mint and transfer path as candidate A.
test_identityHookShapeB_smokeTransfer : Script ()
test_identityHookShapeB_smokeTransfer = script do
  setTime t0
  registryAdmin <- allocateParty "identity-shape-b-registry-admin"
  trustedIssuer <- allocateParty "identity-shape-b-trusted-issuer"
  alice <- allocateParty "identity-shape-b-alice"
  bob <- allocateParty "identity-shape-b-bob"

  holding <- mintHolding registryAdmin [trustedIssuer] alice
  claim <- createClaim trustedIssuer trustedIssuer bob KYC_VALIDATED t1 "identity-shape-b-kyc-001"
  bobHolding <- submit (actAs [alice, bob]) do
    exerciseCmd holding ToyHolding_Transfer with newOwner = bob, claimCid = claim
  Some transferred <- queryContractId bob bobHolding
  transferred.owner === bob
  transferred.amount === 100
  pure ()

-- | A stale KYC_VALIDATED claim blocks the toy transfer.
test_identityHookShapeB_staleClaimBlocksTransfer : Script ()
test_identityHookShapeB_staleClaimBlocksTransfer = script do
  setTime t0
  registryAdmin <- allocateParty "identity-shape-b-stale-registry-admin"
  trustedIssuer <- allocateParty "identity-shape-b-stale-trusted-issuer"
  alice <- allocateParty "identity-shape-b-stale-alice"
  bob <- allocateParty "identity-shape-b-stale-bob"

  holding <- mintHolding registryAdmin [trustedIssuer] alice
  staleClaim <- createClaim trustedIssuer trustedIssuer bob KYC_VALIDATED t1 "identity-shape-b-stale-001"
  setTime t2
  submitMustFail (actAs [alice, bob]) do
    exerciseCmd holding ToyHolding_Transfer with newOwner = bob, claimCid = staleClaim
  pure ()

-- | A claim for the wrong subject blocks the toy transfer even when issued by a
-- trusted issuer and still within its validity window.
test_identityHookShapeB_wrongSubjectBlocksTransfer : Script ()
test_identityHookShapeB_wrongSubjectBlocksTransfer = script do
  setTime t0
  registryAdmin <- allocateParty "identity-shape-b-subject-registry-admin"
  trustedIssuer <- allocateParty "identity-shape-b-subject-trusted-issuer"
  alice <- allocateParty "identity-shape-b-subject-alice"
  bob <- allocateParty "identity-shape-b-subject-bob"

  holding <- mintHolding registryAdmin [trustedIssuer] alice
  wrongSubject <- createClaim trustedIssuer trustedIssuer alice KYC_VALIDATED t1 "identity-shape-b-wrong-subject-001"
  submitMustFail (actAs [alice, bob]) do
    exerciseCmd holding ToyHolding_Transfer with newOwner = bob, claimCid = wrongSubject
  pure ()

-- | A non-KYC identity claim blocks the toy transfer even when issued by a
-- trusted issuer, bound to the expected subject, and still within its validity
-- window.
test_identityHookShapeB_wrongKindBlocksTransfer : Script ()
test_identityHookShapeB_wrongKindBlocksTransfer = script do
  setTime t0
  registryAdmin <- allocateParty "identity-shape-b-kind-registry-admin"
  trustedIssuer <- allocateParty "identity-shape-b-kind-trusted-issuer"
  alice <- allocateParty "identity-shape-b-kind-alice"
  bob <- allocateParty "identity-shape-b-kind-bob"

  holding <- mintHolding registryAdmin [trustedIssuer] alice
  wrongKind <- createClaim trustedIssuer trustedIssuer bob OTHER_IDENTITY_CLAIM t1 "identity-shape-b-wrong-kind-001"
  submitMustFail (actAs [alice, bob]) do
    exerciseCmd holding ToyHolding_Transfer with newOwner = bob, claimCid = wrongKind
  pure ()

-- | A claim whose Daml signer does not match its declared issuer blocks the toy
-- transfer, preventing a signer from spoofing a trusted issuer field.
test_identityHookShapeB_wrongIssuerBlocksTransfer : Script ()
test_identityHookShapeB_wrongIssuerBlocksTransfer = script do
  setTime t0
  registryAdmin <- allocateParty "identity-shape-b-wrong-issuer-registry-admin"
  trustedIssuer <- allocateParty "identity-shape-b-wrong-issuer-trusted-issuer"
  otherTrustedIssuer <- allocateParty "identity-shape-b-wrong-issuer-other-trusted"
  alice <- allocateParty "identity-shape-b-wrong-issuer-alice"
  bob <- allocateParty "identity-shape-b-wrong-issuer-bob"

  holding <- mintHolding registryAdmin [trustedIssuer, otherTrustedIssuer] alice
  spoofedIssuer <- createClaim otherTrustedIssuer trustedIssuer bob KYC_VALIDATED t1 "identity-shape-b-wrong-issuer-001"
  submitMustFail (actAs [alice, bob]) do
    exerciseCmd holding ToyHolding_Transfer with newOwner = bob, claimCid = spoofedIssuer
  pure ()

-- | A claim from an issuer outside the registry snapshot blocks the toy
-- transfer even when the signer matches the declared issuer.
test_identityHookShapeB_untrustedIssuerBlocksTransfer : Script ()
test_identityHookShapeB_untrustedIssuerBlocksTransfer = script do
  setTime t0
  registryAdmin <- allocateParty "identity-shape-b-untrusted-registry-admin"
  trustedIssuer <- allocateParty "identity-shape-b-untrusted-trusted-issuer"
  untrustedIssuer <- allocateParty "identity-shape-b-untrusted-issuer"
  alice <- allocateParty "identity-shape-b-untrusted-alice"
  bob <- allocateParty "identity-shape-b-untrusted-bob"

  holding <- mintHolding registryAdmin [trustedIssuer] alice
  untrustedClaim <- createClaim untrustedIssuer untrustedIssuer bob KYC_VALIDATED t1 "identity-shape-b-untrusted-001"
  submitMustFail (actAs [alice, bob]) do
    exerciseCmd holding ToyHolding_Transfer with newOwner = bob, claimCid = untrustedClaim
  pure ()
