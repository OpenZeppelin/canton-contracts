-- | Tests for OpenZeppelin.Pausable: flip/read, redundant-change rejection, and
-- the whenNotPaused guard gating an operation.
module OpenZeppelin.Test.Pausable where

import DA.Assert ((===))
import Daml.Script

import OpenZeppelin.Pausable
import OpenZeppelin.Test.Gated

-- | Flip from unpaused to paused, then read it back.
test_setAndGet : Script ()
test_setAndGet = script do
  pauser <- allocateParty "pauser"
  ps <- submit pauser do createCmd PauseState with pauser, paused = False
  ps' <- submit pauser do exerciseCmd ps PauseState_Set with newPaused = True
  paused <- submit pauser do exerciseCmd ps' PauseState_Get
  paused === True

-- | Setting the flag to its current value is rejected.
test_redundantChangeFails : Script ()
test_redundantChangeFails = script do
  pauser <- allocateParty "pauser"
  ps <- submit pauser do createCmd PauseState with pauser, paused = False
  submitMustFail pauser do exerciseCmd ps PauseState_Set with newPaused = False
  pure ()

-- | An operation gated by whenNotPaused proceeds while unpaused.
test_guardAllowsWhenUnpaused : Script ()
test_guardAllowsWhenUnpaused = script do
  pauser <- allocateParty "pauser"
  ps <- submit pauser do createCmd PauseState with pauser, paused = False
  check <- submit pauser do createCmd PauseCheck with party = pauser
  submit pauser do exerciseCmd check PauseCheck_Run with psCid = ps
  pure ()

-- | The same operation is refused once paused.
test_guardBlocksWhenPaused : Script ()
test_guardBlocksWhenPaused = script do
  pauser <- allocateParty "pauser"
  ps <- submit pauser do createCmd PauseState with pauser, paused = False
  psPaused <- submit pauser do exerciseCmd ps PauseState_Set with newPaused = True
  check <- submit pauser do createCmd PauseCheck with party = pauser
  submitMustFail pauser do exerciseCmd check PauseCheck_Run with psCid = psPaused
  pure ()
