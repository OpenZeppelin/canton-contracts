-- | Consumer fixtures: a protected template with a delay policy, one operation
-- template per operation kind, and the authority models a template author can
-- wire around them.
module OpenZeppelin.TimelockV1TestFixtures where

import DA.Action (unless)
import DA.Fail (FailureCategory (..), FailureStatus (..), failWithStatus)
import qualified DA.TextMap as TextMap
import DA.Time (RelTime)

import OpenZeppelin.TimelockV1

-- | A treasury whose spending limit and delay policy change only through
-- timelocked operations. `admin` signs; `proposer` and `executor` are the
-- consumer's answer to who may schedule and who may apply. `treasuryId` is the
-- stable identity that operations bind to, because the contract id changes on
-- every consuming choice.
template Treasury
  with
    admin : Party
    proposer : Party
    executor : Party
    treasuryId : Text
    limit : Decimal
    config : TimelockConfig
  where
    signatory admin
    observer proposer, executor
    ensure limit >= 0.0

    -- Schedule a limit change to become ready at `readyAt`. Nonconsuming, so
    -- scheduling does not change the treasury's contract id.
    nonconsuming choice Treasury_ScheduleLimit : ContractId LimitChange
      with
        newLimit : Decimal
        readyAt : Time
      controller proposer
      do
        s <- scheduleAt config readyAt
        create LimitChange with
          admin; proposer; executor; treasuryId; newLimit
          readyAt = s.readyAt; expiresAt = s.expiresAt

    -- The same operation scheduled by a relative delay.
    nonconsuming choice Treasury_ScheduleLimitAfter : ContractId LimitChange
      with
        newLimit : Decimal
        delay : RelTime
      controller proposer
      do
        s <- scheduleAfter config delay
        create LimitChange with
          admin; proposer; executor; treasuryId; newLimit
          readyAt = s.readyAt; expiresAt = s.expiresAt

    -- Apply a matured limit change. The binding check comes first, the time
    -- guard second, and the effect last.
    choice Treasury_ApplyLimit : ContractId Treasury
      with
        opCid : ContractId LimitChange
      controller executor
      do
        op <- fetch opCid
        unless (op.admin == admin && op.treasuryId == treasuryId)
          (failWithStatus eWrongTarget)
        requireReady op
        archive opCid
        create this with limit = op.newLimit

    -- Self-administration: the delay policy changes only through the timelock
    -- it defines, under the policy in force when the change was scheduled.
    nonconsuming choice Treasury_ScheduleConfig : ContractId ConfigChange
      with
        newConfig : TimelockConfig
        readyAt : Time
      controller proposer
      do
        s <- scheduleAt config readyAt
        create ConfigChange with
          admin; proposer; executor; treasuryId; newConfig
          readyAt = s.readyAt; expiresAt = s.expiresAt

    choice Treasury_ApplyConfig : ContractId Treasury
      with
        opCid : ContractId ConfigChange
      controller executor
      do
        op <- fetch opCid
        unless (op.admin == admin && op.treasuryId == treasuryId)
          (failWithStatus eWrongTarget)
        requireReady op
        archive opCid
        create this with config = op.newConfig

-- | A pending limit change. Signed by `admin` because it is created in a choice
-- on the treasury, so nobody else can forge one. The executor observes it,
-- because the apply choice fetches it; a non-stakeholder executor would need
-- the contract by explicit disclosure instead.
template LimitChange
  with
    admin : Party
    proposer : Party
    executor : Party
    treasuryId : Text
    newLimit : Decimal
    readyAt : Time
    expiresAt : Optional Time
  where
    signatory admin
    observer proposer, executor

    interface instance Timelocked for LimitChange where
      view = TimelockedView with readyAt, expiresAt

    -- The canceller. Here the admin; a consumer may name a proposer, a
    -- guardian, or a credential holder instead.
    choice LimitChange_Cancel : ()
      controller admin
      do pure ()

    -- Anyone may archive an operation that can no longer execute. The
    -- controller is a flexible party, so a non-stakeholder needs the contract
    -- by disclosure.
    choice LimitChange_Cleanup : ()
      with
        cleaner : Party
      controller cleaner
      do requireExpired this

-- | A pending change of the delay policy itself.
template ConfigChange
  with
    admin : Party
    proposer : Party
    executor : Party
    treasuryId : Text
    newConfig : TimelockConfig
    readyAt : Time
    expiresAt : Optional Time
  where
    signatory admin
    observer proposer, executor

    interface instance Timelocked for ConfigChange where
      view = TimelockedView with readyAt, expiresAt

    choice ConfigChange_Cancel : ()
      controller admin
      do pure ()

-- | A stranger's contract for probing the guards on an interface value it can
-- see but does not control.
template Probe
  with
    caller : Party
  where
    signatory caller

    nonconsuming choice Probe_RequireReady : ()
      with
        target : ContractId Timelocked
      controller caller
      do
        op <- fetch target
        requireReady op

    nonconsuming choice Probe_IsReadyAt : Bool
      with
        target : ContractId Timelocked
        at : Time
      controller caller
      do
        op <- fetch target
        pure (isReadyAt at op)

-- | Raised by the fixtures when an operation targets another treasury.
eWrongTarget : FailureStatus
eWrongTarget = FailureStatus with
  errorId = "example.com/treasury-wrong-target"
  category = InvalidIndependentOfSystemState
  message = "Treasury: the operation targets another treasury"
  meta = TextMap.empty
