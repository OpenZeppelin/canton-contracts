-- | Consumer fixtures: the two authority models a template author can wire.
module OpenZeppelin.PausableV1TestSupport where

import OpenZeppelin.PausableV1

-- | The single-party case. The pause authority is one party, so the consumer's
-- choice names it as the controller and calls `pause` with nothing else.
template Vault
  with
    admin : Party
    holder : Party
    paused : Bool
    balance : Int
  where
    signatory admin
    observer holder

    interface instance Pausable for Vault where
      view = PausableView with paused
      setPausedImpl newPaused =
        toInterfaceContractId <$> create this with paused = newPaused

    -- The `external pause() onlyOwner` analogue: the consumer supplies the
    -- authority, the library supplies the flip and the guard.
    choice Vault_Pause : ContractId Pausable
      controller admin
      do
        pause this

    choice Vault_Unpause : ContractId Pausable
      controller admin
      do
        unpause this

    -- Gated in normal operation.
    choice Vault_Withdraw : ContractId Vault
      with amount : Int
      controller holder
      do
        whenNotPaused this
        assertMsg "Vault: insufficient balance" (amount <= balance)
        create this with balance = balance - amount

    -- The mirror image: a recovery path that runs only during an incident.
    choice Vault_EmergencyDrain : ContractId Vault
      controller admin
      do
        whenPaused this
        create this with balance = 0

-- | A credential standing in for an AccessControl `RoleGrant`. Authorization
-- that depends on a contract, which a controller expression cannot read.
template PauseCredential
  with
    admin : Party
    account : Party
  where
    signatory admin
    observer account

-- | The credential case. Its pause authority is "whoever holds a credential",
-- which no single `Party` expresses, so the choice takes the caller and the
-- credential as arguments and checks them before calling `pause`.
template RoleVault
  with
    admin : Party
    holder : Party
    paused : Bool
  where
    signatory admin
    observer holder

    interface instance Pausable for RoleVault where
      view = PausableView with paused
      setPausedImpl newPaused =
        toInterfaceContractId <$> create this with paused = newPaused

    choice RoleVault_Pause : ContractId Pausable
      with
        caller : Party
        credCid : ContractId PauseCredential
      controller caller
      do
        cred <- fetch credCid
        assertMsg "RoleVault: wrong credential issuer" (cred.admin == admin)
        assertMsg "RoleVault: credential is not the caller's" (cred.account == caller)
        pause this

    choice RoleVault_Transfer : ContractId RoleVault
      controller holder
      do
        whenNotPaused this
        create this

-- | An unrelated template that tries to flip another contract's flag through
-- the interface. It compiles, because `setPausedImpl` is a public method, and
-- it fails at runtime, because the successor `create` has no authority here.
template Rogue
  with
    caller : Party
  where
    signatory caller

    nonconsuming choice Rogue_Pause : ContractId Pausable
      with
        target : ContractId Pausable
      controller caller
      do
        p <- fetch target
        pause p
