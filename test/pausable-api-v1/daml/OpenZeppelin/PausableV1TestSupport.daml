-- | Consumer fixtures: the authority models a template author can wire, the
-- sibling-field case, and implementations that break the `setPaused` law.
module OpenZeppelin.PausableV1TestSupport where

import OpenZeppelin.PausableV1

-- | The single-party case. The pause authority is one party, so the consumer's
-- choice names it as the controller and calls `pause` with nothing else.
template Vault
  with
    admin : Party
    holder : Party
    paused : Bool
    balance : Int
  where
    signatory admin
    observer holder

    interface instance Pausable for Vault where
      view = PausableView with paused
      setPaused b = toInterface (this with paused = b)

    -- The `external pause() onlyOwner` analogue: the consumer supplies the
    -- authority, the library supplies the flip and the guard.
    choice Vault_Pause : ContractId Vault
      controller admin
      do
        pause this

    choice Vault_Unpause : ContractId Vault
      controller admin
      do
        unpause this

    -- Gated in normal operation.
    choice Vault_Withdraw : ContractId Vault
      with amount : Int
      controller holder
      do
        whenNotPaused this
        assertMsg "Vault: insufficient balance" (amount <= balance)
        create this with balance = balance - amount

    -- The mirror image: a recovery path that runs only during an incident.
    choice Vault_EmergencyDrain : ContractId Vault
      controller admin
      do
        whenPaused this
        create this with balance = 0

-- | The obligation the library cannot enforce: a flip choice must be
-- consuming. This one is not, so it leaves the unpaused contract live beside
-- its paused copy.
template LeakyVault
  with
    admin : Party
    paused : Bool
  where
    signatory admin

    interface instance Pausable for LeakyVault where
      view = PausableView with paused
      setPaused b = toInterface (this with paused = b)

    nonconsuming choice LeakyVault_Pause : ContractId LeakyVault
      controller admin
      do
        pause this

-- | A credential standing in for an AccessControl `RoleGrant`. Authorization
-- that depends on a contract, which a controller expression cannot read.
template PauseCredential
  with
    admin : Party
    account : Party
  where
    signatory admin
    observer account

-- | The credential case. Its pause authority is "whoever holds a credential",
-- which no single `Party` expresses, so the choice takes the caller and the
-- credential as arguments and checks them before calling `pause`.
template RoleVault
  with
    admin : Party
    holder : Party
    paused : Bool
  where
    signatory admin
    observer holder

    interface instance Pausable for RoleVault where
      view = PausableView with paused
      setPaused b = toInterface (this with paused = b)

    choice RoleVault_Pause : ContractId RoleVault
      with
        caller : Party
        credCid : ContractId PauseCredential
      controller caller
      do
        cred <- fetch credCid
        assertMsg "RoleVault: wrong credential issuer" (cred.admin == admin)
        assertMsg "RoleVault: credential is not the caller's" (cred.account == caller)
        pause this

    choice RoleVault_Transfer : ContractId RoleVault
      controller holder
      do
        whenNotPaused this
        create this

-- | The sibling-field case: a registry that records why a pause is in force in
-- the same transaction as the flip, and clears it on the way out. `paused`
-- stays the only field in the frozen view.
template Registry
  with
    admin : Party
    paused : Bool
    pauseReason : Optional Text
  where
    signatory admin

    interface instance Pausable for Registry where
      view = PausableView with paused
      setPaused b = toInterface (this with paused = b)

    choice Registry_Pause : ContractId Registry
      with
        reason : Optional Text
      controller admin
      do
        pauseWith (\v -> v with pauseReason = reason) this

    choice Registry_Unpause : ContractId Registry
      controller admin
      do
        unpauseWith (\v -> v with pauseReason = None) this

    -- A lambda that undoes the flag the library set. Caught, not silently
    -- accepted.
    choice Registry_PauseButClobberTheFlag : ContractId Registry
      controller admin
      do
        pauseWith (\v -> v with paused = False) this

-- | An unrelated template holding a `ContractId Pausable`. `setPaused` is
-- public, so it can call it - but the method is pure and there is no way to
-- create from an interface value, so it cannot flip anything. `pause` itself
-- does not type check here: it needs `HasCreate t` on a concrete template.
template Rogue
  with
    caller : Party
  where
    signatory caller

    nonconsuming choice Rogue_TryPause : Bool
      with
        target : ContractId Pausable
      controller caller
      do
        p <- fetch target
        -- Yields a value with the flag set, and changes nothing on the ledger.
        pure (view (setPaused p True)).paused

-- Implementations that break the `setPaused` law
-------------------------------------------------------

-- | Ignores the argument, so the flag never changes. The commonest way to wire
-- the interface wrongly, and the reason `eFlagNotApplied` exists.
template BrokenIgnoresFlag
  with
    admin : Party
    paused : Bool
  where
    signatory admin

    interface instance Pausable for BrokenIgnoresFlag where
      view = PausableView with paused
      setPaused _ = toInterface this

    choice BrokenIgnoresFlag_Pause : ContractId BrokenIgnoresFlag
      controller admin
      do
        pause this

-- | A second implementer, so `Pausable` has more than one inhabitant.
template Decoy
  with
    admin : Party
    paused : Bool
  where
    signatory admin

    interface instance Pausable for Decoy where
      view = PausableView with paused
      setPaused b = toInterface (this with paused = b)

-- | Returns someone else's template. The type checks, because `setPaused`
-- returns `Pausable` and any implementer satisfies that.
template BrokenWrongTemplate
  with
    admin : Party
    paused : Bool
  where
    signatory admin

    interface instance Pausable for BrokenWrongTemplate where
      view = PausableView with paused
      setPaused b = toInterface (Decoy with admin = this.admin, paused = b)

    choice BrokenWrongTemplate_Pause : ContractId BrokenWrongTemplate
      controller admin
      do
        pause this
