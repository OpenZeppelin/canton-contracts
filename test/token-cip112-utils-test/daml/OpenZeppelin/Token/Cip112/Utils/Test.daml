-- | Unit tests for the utils package on its own: the pure predicates and
-- bounds, the event-observer merge, and the two pinning builders, each run
-- against a minimal local template it accepts and a foreign template it must
-- refuse. The consumption and expiry bodies are run here too, for the
-- guards that only a consumer's own `HoldingOps` or allocation template can
-- reach, and the transfer and allocation bodies are run with a tagged
-- holding, for the per-holding state the default templates do not have. The
-- full workflows run under `test/token-cip112-v1-test` through the default
-- templates and under `examples/token/token-cip112-custom-test` through a
-- consumer's templates.
module OpenZeppelin.Token.Cip112.Utils.Test where

import DA.Action (unless)
import DA.Assert ((===))
import DA.Date (date, Month(Jan))
import DA.List (dedupSort)
import DA.Map qualified as Map
import DA.Text (intercalate, isInfixOf)
import DA.TextMap qualified as TextMap
import DA.Time (addRelTime, days, hours, minutes, time)
import Daml.Script

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.Api.Token.TransferInstructionV2 qualified as TransferInstructionV2
import Splice.TokenStandard.Utils (accountParties, basicAccount, burnAccount, maxTime, mintAccount, receiverSide, senderSide)
import Splice.Api.Token.AllocationInstructionV2 qualified as AllocationInstructionV2

import OpenZeppelin.Token.Cip112.TypesV1
import OpenZeppelin.Token.Cip112.Utils.Holding
import OpenZeppelin.Token.Cip112.Utils.Transfer
import OpenZeppelin.Token.Cip112.Utils.Allocation
import OpenZeppelin.Token.Cip112.Utils.Registry

t0, t1, t2, t3 : Time
t0 = time (date 2026 Jan 1) 0 0 0
t1 = time (date 2026 Jan 1) 0 10 0
t2 = time (date 2026 Jan 1) 0 20 0
t3 = time (date 2026 Jan 1) 0 30 0

-- Local templates
------------------

-- | The smallest holding the builders accept.
template UnitHolding with
    holding : HoldingV2.HoldingView
  where
    signatory holding.instrumentId.admin, basicOwner holding
    ensure isValidHoldingView holding

    interface instance HoldingV2.Holding for UnitHolding where
      view = holding

-- | A holding with a consumer field outside the standard view. Its owner
-- unlock runs the shared body, so the replacement goes through `taggedOps`.
template TaggedHolding with
    holding : HoldingV2.HoldingView
    tag : Text
  where
    signatory holding.instrumentId.admin, basicOwner holding
    -- A receiver holds the lock on a pending transfer's funding and reads it
    -- when answering the offer.
    observer lockHolders holding.lock
    ensure isValidHoldingView holding

    choice TaggedHolding_OwnerUnlock : ContractId HoldingV2.Holding
      controller basicOwner holding
      do holdingOwnerUnlockImpl taggedOps (toInterfaceContractId self) holding this

    interface instance HoldingV2.Holding for TaggedHolding where
      view = holding

-- | A pending transfer whose bodies run with `taggedOps`.
template TaggedTransferInstruction with
    state : TransferInstructionState
  where
    signatory state.transfer.instrumentId.admin, senderParties state.transfer
    observer receiverParties state.transfer
    ensure isValidTransferInstructionState state

    choice TaggedTransferInstruction_Expire : TransferInstructionV2.TransferInstructionResult
      controller state.transfer.instrumentId.admin
      do transferExpireImpl taggedOps state

    interface instance TransferInstructionV2.TransferInstruction for TaggedTransferInstruction where
      view = transferInstructionView state
      transferInstruction_acceptExtraObservers _ = []
      transferInstruction_rejectExtraObservers _ = []
      transferInstruction_withdrawExtraObservers _ = []
      transferInstruction_acceptImpl self arg = transferAcceptImpl taggedOps self state arg
      transferInstruction_rejectImpl self arg = transferRejectImpl taggedOps self state arg
      transferInstruction_withdrawImpl self arg = transferWithdrawImpl taggedOps self state arg

-- | An allocation whose bodies run with `taggedOps`.
template TaggedAllocation with
    state : AllocationState
  where
    signatory state.allocation.admin, accountParties state.allocation.admin state.allocation.authorizer
    observer state.settlement.executors
    ensure isValidAllocationState state

    interface instance AllocationV2.Allocation for TaggedAllocation where
      view = allocationView state
      allocation_settleExtraObservers _ = []
      allocation_cancelExtraObservers _ = []
      allocation_withdrawExtraObservers _ = []
      allocation_settleImpl self arg = allocationSettleImpl taggedOps createTaggedAllocation self state arg
      allocation_withdrawImpl self arg = allocationWithdrawImpl taggedOps self state arg
      allocation_cancelImpl self arg = allocationCancelImpl taggedOps self state arg

-- | A holding signed by someone else entirely, claiming any view it likes.
template ForeignHolding with
    attacker : Party
    claimedView : HoldingV2.HoldingView
  where
    signatory attacker
    interface instance HoldingV2.Holding for ForeignHolding where
      view = claimedView

-- | The smallest allocation `pinAllocationTo` accepts; its choices are never
-- exercised here.
template UnitAllocation with
    claimedView : AllocationV2.AllocationView
    admin : Party
  where
    signatory admin
    interface instance AllocationV2.Allocation for UnitAllocation where
      view = claimedView
      allocation_settleExtraObservers _ = []
      allocation_cancelExtraObservers _ = []
      allocation_withdrawExtraObservers _ = []
      allocation_settleImpl _ _ = fail "not exercised in this test"
      allocation_withdrawImpl _ _ = fail "not exercised in this test"
      allocation_cancelImpl _ _ = fail "not exercised in this test"

template ForeignAllocation with
    claimedView : AllocationV2.AllocationView
    attacker : Party
  where
    signatory attacker
    interface instance AllocationV2.Allocation for ForeignAllocation where
      view = claimedView
      allocation_settleExtraObservers _ = []
      allocation_cancelExtraObservers _ = []
      allocation_withdrawExtraObservers _ = []
      allocation_settleImpl _ _ = fail "not exercised in this test"
      allocation_withdrawImpl _ _ = fail "not exercised in this test"
      allocation_cancelImpl _ _ = fail "not exercised in this test"

-- | Runs a builder inside a choice, since builders are `Update` functions.
-- Signed by the admin and the owner so the consumption authority matches.
-- The choices take `actors` like the standard ones, so a caller's own
-- authority is in scope for the fetch, as an attacker's is when they act on
-- a factory.
template Harness with
    admin : Party
    owner : Party
  where
    signatory admin, owner

    nonconsuming choice Harness_ConsumeByArchive : HoldingV2.HoldingView
      with cid : ContractId HoldingV2.Holding; actors : [Party]
      controller actors
      do fst <$> consumeByArchive @UnitHolding cid

    nonconsuming choice Harness_PinAllocation : AllocationV2.AllocationView
      with cid : ContractId AllocationV2.Allocation; actors : [Party]
      controller actors
      do pinAllocationTo @UnitAllocation cid

    nonconsuming choice Harness_ConsumeLocked : HoldingV2.HoldingView
      with cid : ContractId HoldingV2.Holding; expectedAccount : HoldingV2.Account; actors : [Party]
      controller actors
      do fst <$> consumeLockedHolding unitOps admin expectedAccount cid

    nonconsuming choice Harness_ConsumeUnlocked : HoldingV2.HoldingView
      with cid : ContractId HoldingV2.Holding; expectedAccount : HoldingV2.Account; actors : [Party]
      controller actors
      do fst <$> consumeUnlockedHolding unitOps admin expectedAccount cid

    nonconsuming choice Harness_ExpireAllocations : ()
      with cancelArgs : [(ContractId AllocationV2.Allocation, AllocationV2.Allocation_Cancel)]; actors : [Party]
      controller actors
      do expireAllocationsImpl (pinAllocationTo @UnitAllocation) admin cancelArgs

    nonconsuming choice Harness_TaggedTransfer : TransferInstructionV2.TransferInstructionResult
      with transfer : TransferInstructionV2.Transfer; oneStep : Bool; actors : [Party]
      controller actors
      do executeTransfer (harnessConfig admin) taggedOps createTaggedInstruction oneStep transfer

    nonconsuming choice Harness_TaggedMint : ContractId TransferInstructionV2.TransferInstruction
      with amount : Decimal; actors : [Party]
      controller actors
      do offerMintImpl (harnessConfig admin) createTaggedInstruction (basicAccount owner) "TOK" amount t0 t2 "mint"

    nonconsuming choice Harness_TaggedAllocate : AllocationInstructionV2.AllocationInstructionResult
      with allocate : AllocationInstructionV2.AllocationFactory_Allocate
      controller allocate.actors
      do allocationFactoryImpl (harnessConfig admin) taggedOps createTaggedAllocation allocate

    nonconsuming choice Harness_TaggedUnlock : TextMap.TextMap [ContractId HoldingV2.Holding]
      with cids : [ContractId HoldingV2.Holding]; actors : [Party]
      controller actors
      do unlockHoldings taggedOps admin (basicAccount owner) cids

-- | The operations the harness runs the bodies with. Events are not under
-- test here, so emission does nothing.
unitOps : HoldingOps UnitHolding
unitOps = HoldingOps with
  createHolding = \_ v -> toInterfaceContractId <$> create UnitHolding with holding = v
  consumeHolding = consumeByArchive @UnitHolding
  withEventLog = \_ -> pure ()
  eventObservers = const []

-- | Tags each new holding with the distinct tags of its sources, so a test
-- can read which consumed holdings funded it. A holding with no source is
-- tagged "new".
taggedOps : HoldingOps TaggedHolding
taggedOps = HoldingOps with
  createHolding = \sources v -> toInterfaceContractId <$> create TaggedHolding with
    holding = v
    tag = case dedupSort (map (.tag) sources) of
      [] -> "new"
      tags -> intercalate "+" tags
  consumeHolding = consumeByArchive @TaggedHolding
  withEventLog = \_ -> pure ()
  eventObservers = const []

harnessConfig : Party -> RegistryConfig
harnessConfig admin = RegistryConfig with admin; maxTTL = days 1; lockGrace = hours 1

createTaggedInstruction : CreateTransferInstruction
createTaggedInstruction s = toInterfaceContractId <$> create TaggedTransferInstruction with state = s

createTaggedAllocation : CreateAllocation
createTaggedAllocation s = toInterfaceContractId <$> create TaggedAllocation with state = s

emptyExtraArgs : ExtraArgs
emptyExtraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata

basicOwner : HoldingV2.HoldingView -> Party
basicOwner v = case v.account.owner of
  Some p -> p
  None -> error "regular accounts only"

mustFailWith : Text -> SubmitOptions -> Commands a -> Script ()
mustFailWith expected options cmds = do
  result <- trySubmit options cmds
  case result of
    Right _ -> abort "submission succeeded but was expected to fail"
    Left err -> unless (expected `isInfixOf` show err) $
      abort ("submission failed for an unexpected reason: " <> show err)

data Fixture = Fixture with
    admin : Party
    alice : Party
    attacker : Party
    harnessCid : ContractId Harness

setup : Script Fixture
setup = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  attacker <- allocateParty "attacker"
  setTime t1
  harnessCid <- submit (actAs [admin, alice]) do createCmd Harness with admin; owner = alice
  pure Fixture with ..

-- Builders
-----------

-- | `consumeByArchive` archives the pinned template and returns its view.
testConsumeByArchive : Script ()
testConsumeByArchive = do
  Fixture{..} <- setup
  cid <- submit (actAs [admin, alice]) do
    createCmd UnitHolding with holding = mkHoldingView admin (basicAccount alice) "TOK" 5.0 None
  v <- submit (actAs admin) do
    exerciseCmd harnessCid Harness_ConsumeByArchive with cid = toInterfaceContractId @HoldingV2.Holding cid; actors = [admin]
  v.amount === 5.0
  queryContractId alice cid >>= (=== None)

-- | The builder refuses a foreign template before reading its view, even
-- when the attacker's authority is present and the view claims this admin.
testBuilderRefusesForeignHolding : Script ()
testBuilderRefusesForeignHolding = do
  Fixture{..} <- setup
  foreignCid <- submit attacker do
    createCmd ForeignHolding with
      attacker
      claimedView = mkHoldingView admin (basicAccount attacker) "TOK" 1000000.0 None
  mustFailWith "holding is not an accepted implementation" (actAs [admin, attacker]) $
    exerciseCmd harnessCid Harness_ConsumeByArchive with
      cid = toInterfaceContractId @HoldingV2.Holding foreignCid
      actors = [admin, attacker]
  -- The forgery is untouched: the refusal happened before any archive.
  Some _ <- queryContractId attacker foreignCid
  pure ()

-- | The view of an allocation by `alice` under `admin`, expiring at `t2`.
unitAllocationView : Party -> Party -> AllocationV2.AllocationView
unitAllocationView admin alice = AllocationV2.AllocationView with
  originalAllocationCid = None
  settlement = AllocationV2.SettlementInfo with executors = [admin]; id = "s"; cid = None; meta = emptyMetadata
  allocation = AllocationV2.AllocationSpecification with
    admin
    authorizer = basicAccount alice
    transferLegSides = []
    settlementDeadline = Some t2
    nextIterationFunding = Some TextMap.empty
    committed = False
    meta = emptyMetadata
  holdingCids = []
  createdAt = t1
  numIterations = 0
  expiresAt = Some t2
  availableActions = Map.empty
  meta = emptyMetadata

testPinAllocation : Script ()
testPinAllocation = do
  Fixture{..} <- setup
  let v = unitAllocationView admin alice
  genuine <- submit admin do createCmd UnitAllocation with claimedView = v; admin
  pinned <- submit admin do
    exerciseCmd harnessCid Harness_PinAllocation with
      cid = toInterfaceContractId @AllocationV2.Allocation genuine
      actors = [admin]
  pinned.allocation.authorizer === basicAccount alice
  foreign <- submit attacker do createCmd ForeignAllocation with claimedView = v; attacker
  mustFailWith "allocation is not an accepted implementation" (actAs [admin, attacker]) $
    exerciseCmd harnessCid Harness_PinAllocation with
      cid = toInterfaceContractId @AllocationV2.Allocation foreign
      actors = [admin, attacker]

-- Predicates and bounds
------------------------

testHoldingViewPredicate : Script ()
testHoldingViewPredicate = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  let ok = mkHoldingView admin (basicAccount alice) "TOK" 1.0 None
  isValidHoldingView ok === True
  isValidHoldingView (ok with amount = 0.0) === False
  isValidHoldingView (ok with account = HoldingV2.Account with owner = None; provider = None; id = "cip-112/mint") === False
  let relLock = HoldingV2.Lock with holders = [admin]; expiresAt = None; expiresAfter = Some (hours 1); context = None
  isValidHoldingView (ok with lock = Some relLock) === False
  isValidHoldingView (ok with lock = Some (relLock with expiresAfter = None)) === True

testRegistryConfigPredicate : Script ()
testRegistryConfigPredicate = do
  admin <- allocateParty "admin"
  let c = RegistryConfig with admin; maxTTL = days 90; lockGrace = hours 1
  isValidRegistryConfig c === True
  isValidRegistryConfig (c with maxTTL = minutes 0) === False
  isValidRegistryConfig (c with lockGrace = minutes 0) === False

testTransferInstructionStatePredicate : Script ()
testTransferInstructionStatePredicate = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  h <- submit (actAs [admin, alice]) do
    createCmd UnitHolding with holding = mkHoldingView admin (basicAccount alice) "TOK" 7.0 None
  let transfer = TransferInstructionV2.Transfer with
        sender = basicAccount alice
        receiver = basicAccount bob
        amount = 7.0
        instrumentId = HoldingV2.InstrumentId with admin; id = "TOK"
        requestedAt = t0
        executeBefore = t2
        inputHoldingCids = []
        meta = emptyMetadata
      s = TransferInstructionState with
        transfer
        lockedHoldingCids = [toInterfaceContractId @HoldingV2.Holding h]
        expiresAt = t2
        lockExpiresAt = t2 `addRelTime` hours 1
  isValidTransferInstructionState s === True
  isValidTransferInstructionState (s with transfer = transfer with amount = 0.0) === False
  isValidTransferInstructionState (s with transfer = transfer with sender = mintAccount) === False
  -- A mint offer comes from the mint account and locks nothing.
  isValidTransferInstructionState ((s with lockedHoldingCids = []) with transfer = transfer with sender = mintAccount) === True
  isValidTransferInstructionState (s with transfer = transfer with receiver = mintAccount) === False
  -- A burn request goes to the burn account, which never sends and never
  -- receives a mint offer.
  isValidTransferInstructionState (s with transfer = transfer with receiver = burnAccount) === True
  isValidTransferInstructionState (s with transfer = transfer with sender = burnAccount) === False
  isValidTransferInstructionState ((s with lockedHoldingCids = []) with transfer = transfer with sender = mintAccount; receiver = burnAccount) === False
  isValidTransferInstructionState (s with lockedHoldingCids = []) === False
  isValidTransferInstructionState (s with lockExpiresAt = t2) === False
  -- The view advertises each side's account parties as the actor set.
  let v = transferInstructionView s
  Map.lookup TransferInstructionV2.TIA_Accept v.availableActions === Some [[bob]]
  Map.lookup TransferInstructionV2.TIA_Withdraw v.availableActions === Some [[alice]]

testAllocationStatePredicate : Script ()
testAllocationStatePredicate = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  let leg = AllocationV2.TransferLeg with
        transferLegId = "leg-1"
        sender = basicAccount alice
        receiver = basicAccount bob
        amount = 5.0
        instrumentId = "TOK"
        meta = emptyMetadata
      settlement = AllocationV2.SettlementInfo with executors = [bob]; id = "s"; cid = None; meta = emptyMetadata
      allocation = AllocationV2.AllocationSpecification with
        admin
        authorizer = basicAccount alice
        transferLegSides = [senderSide leg]
        settlementDeadline = Some t2
        nextIterationFunding = None
        committed = False
        meta = emptyMetadata
      s = AllocationState with
        originalAllocationCid = None
        settlement
        allocation
        lockedHoldingCids = []
        requestedAt = t0
        createdAt = t1
        numIterations = 0
        expiresAt = t2
        lockExpiresAt = t2 `addRelTime` hours 1
        maxTTL = days 90
        lockGrace = hours 1
  isValidAllocationState s === True
  isValidAllocationState (s with settlement = settlement with executors = []) === False
  isValidAllocationState (s with allocation = allocation with transferLegSides = [senderSide leg with amount = 0.0]) === False
  -- A special account may authorize legs, but holds nothing to reserve.
  isValidAllocationState (s with allocation = allocation with authorizer = mintAccount) === True
  isValidAllocationState (s with allocation = allocation with authorizer = mintAccount; nextIterationFunding = Some TextMap.empty) === False
  isValidAllocationState (s with numIterations = -1) === False
  isValidAllocationState (s with lockExpiresAt = t2) === False
  isValidAllocationState (s with maxTTL = minutes 0) === False
  isValidAllocationState (s with lockGrace = minutes 0) === False
  isValidAllocationState (s with allocation = allocation with committed = True; settlementDeadline = None) === False

-- | The executors observe a factory call only when it needs no funding and
-- names no inputs: an unnecessary input would show them its id and the
-- change holding the factory returns.
testPrivateAssetAllocateExtraObservers : Script ()
testPrivateAssetAllocateExtraObservers = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  exchange <- allocateParty "exchange"
  h <- submit (actAs [admin, alice]) do
    createCmd UnitHolding with holding = mkHoldingView admin (basicAccount alice) "TOK" 10.0 None
  let incoming = AllocationV2.TransferLeg with
        transferLegId = "leg-1"
        sender = basicAccount bob
        receiver = basicAccount alice
        amount = 10.0
        instrumentId = "TOK"
        meta = emptyMetadata
      outgoing = incoming with transferLegId = "leg-2"; sender = basicAccount alice; receiver = basicAccount bob; amount = 4.0
      allocation = AllocationV2.AllocationSpecification with
        admin
        authorizer = basicAccount alice
        transferLegSides = [receiverSide incoming, senderSide outgoing]
        settlementDeadline = Some t2
        nextIterationFunding = None
        committed = False
        meta = emptyMetadata
      arg = AllocationInstructionV2.AllocationFactory_Allocate with
        settlement = AllocationV2.SettlementInfo with executors = [exchange]; id = "s"; cid = None; meta = emptyMetadata
        allocation
        requestedAt = t0
        inputHoldingCids = []
        extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata
        actors = [alice]
      observes = elem exchange . privateAssetAllocateExtraObservers
  -- Netting leaves a credit of 6 and no inputs are named: the executors
  -- observe, as under the vendored default.
  observes arg === True
  -- The same call with an unnecessary input: the executors do not observe.
  observes (arg with inputHoldingCids = [toInterfaceContractId @HoldingV2.Holding h]) === False
  -- Funding required: unchanged from the default.
  observes (arg with allocation = allocation with transferLegSides = [senderSide outgoing]) === False
  -- The account parties always observe.
  (alice `elem` privateAssetAllocateExtraObservers (arg with inputHoldingCids = [toInterfaceContractId @HoldingV2.Holding h])) === True

-- | Storage bound: capped by the deadline, saturating at `maxTime`.
testComputeStorageExpiry : Script ()
testComputeStorageExpiry = do
  computeStorageExpiry (days 90) t1 (Some t2) === t2
  computeStorageExpiry (minutes 5) t1 (Some t2) === (t1 `addRelTime` minutes 5)
  computeStorageExpiry (days 90) t1 None === (t1 `addRelTime` days 90)
  computeStorageExpiry (days 3000000) t1 None === maxTime

-- | Event informees are the account parties plus the owner's extra
-- observers, deduplicated, so listing an account party twice is harmless.
testEventObserversFor : Script ()
testEventObserversFor = do
  admin <- allocateParty "admin"
  alice <- allocateParty "alice"
  provider <- allocateParty "provider"
  auditor <- allocateParty "auditor"
  let account = HoldingV2.Account with owner = Some alice; provider = Some provider; id = "custody"
      ops : HoldingOps ()
      ops = HoldingOps with
        createHolding = \_ _ -> fail "unused"
        consumeHolding = \_ -> fail "unused"
        withEventLog = \_ -> fail "unused"
        eventObservers = const [auditor, alice]
  eventObserversFor ops admin account === dedupSort (accountParties admin account <> [auditor])
  eventObserversFor (ops with eventObservers = const []) admin account === dedupSort [alice, provider]

-- Consumption and expiry bodies
--------------------------------

-- | A `UnitHolding` signed by `admin` and `owner`, in `account`.
unitHolding : Party -> Party -> HoldingV2.Account -> Optional HoldingV2.Lock -> Script (ContractId HoldingV2.Holding)
unitHolding admin owner account lock = do
  cid <- submit (actAs [admin, owner]) do
    createCmd UnitHolding with holding = mkHoldingView admin account "TOK" 5.0 lock
  pure (toInterfaceContractId cid)

lockUntil : Party -> Optional Time -> HoldingV2.Lock
lockUntil holder expiresAt = HoldingV2.Lock with holders = [holder]; expiresAt; expiresAfter = None; context = None

savingsAccount : Party -> HoldingV2.Account
savingsAccount owner = HoldingV2.Account with owner = Some owner; provider = None; id = "savings"

-- | The default templates need the instrument admin's authority to consume a
-- holding, so another admin's holding fails authorization first. A consumer
-- whose `consumeHolding` needs less authority relies on this check.
testConsumeLockedRefusesOtherAdmin : Script ()
testConsumeLockedRefusesOtherAdmin = do
  Fixture{..} <- setup
  otherAdmin <- allocateParty "otherAdmin"
  cid <- unitHolding otherAdmin alice (basicAccount alice) (Some (lockUntil otherAdmin (Some t2)))
  mustFailWith "'inputHolding.instrumentId.admin' is not equal to" (actAs [admin, otherAdmin]) $
    exerciseCmd harnessCid Harness_ConsumeLocked with
      cid; expectedAccount = basicAccount alice; actors = [admin, otherAdmin]

-- | The same parties can hold in several accounts; funding must come from
-- the expected one.
testConsumeLockedRefusesOtherAccount : Script ()
testConsumeLockedRefusesOtherAccount = do
  Fixture{..} <- setup
  cid <- unitHolding admin alice (savingsAccount alice) (Some (lockUntil admin (Some t2)))
  mustFailWith "'inputHolding.account' is not equal to" (actAs admin) $
    exerciseCmd harnessCid Harness_ConsumeLocked with
      cid; expectedAccount = basicAccount alice; actors = [admin]

testConsumeLockedRefusesUnlockedHolding : Script ()
testConsumeLockedRefusesUnlockedHolding = do
  Fixture{..} <- setup
  cid <- unitHolding admin alice (basicAccount alice) None
  mustFailWith "input holding must be locked" (actAs admin) $
    exerciseCmd harnessCid Harness_ConsumeLocked with
      cid; expectedAccount = basicAccount alice; actors = [admin]

testConsumeUnlockedRefusesOtherAdmin : Script ()
testConsumeUnlockedRefusesOtherAdmin = do
  Fixture{..} <- setup
  otherAdmin <- allocateParty "otherAdmin"
  cid <- unitHolding otherAdmin alice (basicAccount alice) None
  mustFailWith "'inputHolding.instrumentId.admin' is not equal to" (actAs [admin, otherAdmin]) $
    exerciseCmd harnessCid Harness_ConsumeUnlocked with
      cid; expectedAccount = basicAccount alice; actors = [admin, otherAdmin]

testConsumeUnlockedRefusesOtherAccount : Script ()
testConsumeUnlockedRefusesOtherAccount = do
  Fixture{..} <- setup
  cid <- unitHolding admin alice (savingsAccount alice) None
  mustFailWith "'inputHolding.account' is not equal to" (actAs admin) $
    exerciseCmd harnessCid Harness_ConsumeUnlocked with
      cid; expectedAccount = basicAccount alice; actors = [admin]

-- | An indefinite lock never expires, so the holding can never fund a new
-- workflow.
testConsumeUnlockedRefusesIndefiniteLock : Script ()
testConsumeUnlockedRefusesIndefiniteLock = do
  Fixture{..} <- setup
  cid <- unitHolding admin alice (basicAccount alice) (Some (lockUntil admin None))
  mustFailWith "input holding is locked indefinitely" (actAs admin) $
    exerciseCmd harnessCid Harness_ConsumeUnlocked with
      cid; expectedAccount = basicAccount alice; actors = [admin]

-- | Batched expiry re-checks each allocation itself rather than trusting the
-- allocation's cancel body, so each refusal below happens before
-- `UnitAllocation`'s cancel body, which always fails, could run.
expireUnit : Fixture -> AllocationV2.AllocationView -> [Party] -> Script (Commands ())
expireUnit Fixture{..} v cancelActors = do
  cid <- submit admin do createCmd UnitAllocation with claimedView = v; admin
  pure $ exerciseCmd harnessCid Harness_ExpireAllocations with
    cancelArgs =
      [ ( toInterfaceContractId @AllocationV2.Allocation cid
        , AllocationV2.Allocation_Cancel with
            actors = cancelActors
            extraArgs = ExtraArgs with context = emptyChoiceContext; meta = emptyMetadata ) ]
    actors = [admin]

testExpireAllocationsRefusesOtherCancelActors : Script ()
testExpireAllocationsRefusesOtherCancelActors = do
  f@Fixture{..} <- setup
  setTime t3
  cmd <- expireUnit f (unitAllocationView admin alice) [admin, alice]
  mustFailWith "'cancelArg.actors' is not equal to" (actAs admin) cmd

testExpireAllocationsRefusesOtherAdmin : Script ()
testExpireAllocationsRefusesOtherAdmin = do
  f@Fixture{..} <- setup
  setTime t3
  let v = unitAllocationView admin alice
  cmd <- expireUnit f (v with allocation = v.allocation with admin = alice) [admin]
  mustFailWith "'allocation.admin' is not equal to" (actAs admin) cmd

testExpireAllocationsRefusesNoExpiry : Script ()
testExpireAllocationsRefusesNoExpiry = do
  f@Fixture{..} <- setup
  setTime t3
  cmd <- expireUnit f ((unitAllocationView admin alice) with expiresAt = None) [admin]
  mustFailWith "cannot expire an allocation without an expiry time" (actAs admin) cmd

testExpireAllocationsRefusesLiveAllocation : Script ()
testExpireAllocationsRefusesLiveAllocation = do
  f@Fixture{..} <- setup
  cmd <- expireUnit f (unitAllocationView admin alice) [admin]
  mustFailWith "strictly before deadline 'allocation.expiresAt'" (actAs admin) cmd

-- Consumer state across re-creation
------------------------------------

-- | A `TaggedHolding` of `amount` of `instrumentId` in alice's basic account.
taggedHoldingOf
  : Fixture -> Text -> Text -> Decimal -> Optional HoldingV2.Lock -> Script (ContractId HoldingV2.Holding)
taggedHoldingOf Fixture{..} instrumentId tag amount lock = do
  cid <- submit (actAs [admin, alice]) do
    createCmd TaggedHolding with holding = mkHoldingView admin (basicAccount alice) instrumentId amount lock; tag
  pure (toInterfaceContractId cid)

taggedHolding : Fixture -> Text -> Decimal -> Optional HoldingV2.Lock -> Script (ContractId HoldingV2.Holding)
taggedHolding fixture = taggedHoldingOf fixture "TOK"

tagOf : Party -> ContractId HoldingV2.Holding -> Script Text
tagOf party cid = do
  Some h <- queryContractId party (fromInterfaceContractId @TaggedHolding cid)
  pure h.tag

-- | The tags of the holdings an allocation has locked.
lockedTags : Party -> ContractId AllocationV2.Allocation -> Script [Text]
lockedTags party cid = do
  Some allocation <- queryContractId party (fromInterfaceContractId @TaggedAllocation cid)
  mapA (tagOf party) allocation.state.lockedHoldingCids

-- | Alice transfers 7 TOK to `receiver`, funded by two holdings of 5 tagged
-- "a" and "b". One step completes it; two steps leave it pending.
taggedTransfer : Fixture -> Party -> Bool -> Script TransferInstructionV2.TransferInstructionResult
taggedTransfer fixture@Fixture{..} receiver oneStep = do
  a <- taggedHolding fixture "a" 5.0 None
  b <- taggedHolding fixture "b" 5.0 None
  let actors = if oneStep then [admin, alice, receiver] else [admin, alice]
  submit (actAs actors) do
    exerciseCmd harnessCid Harness_TaggedTransfer with
      oneStep
      actors
      transfer = TransferInstructionV2.Transfer with
        sender = basicAccount alice
        receiver = basicAccount receiver
        amount = 7.0
        instrumentId = HoldingV2.InstrumentId with admin; id = "TOK"
        requestedAt = t0
        executeBefore = t2
        inputHoldingCids = [a, b]
        meta = emptyMetadata

-- | A transfer passes the inputs' states to the sender's change and to the
-- receiver's holding.
testTransferPassesInputStates : Script ()
testTransferPassesInputStates = do
  fixture@Fixture{..} <- setup
  bob <- allocateParty "bob"
  result <- taggedTransfer fixture bob True
  [change] <- pure result.senderChangeCids
  tagOf alice change >>= (=== "a+b")
  TransferInstructionV2.TransferInstructionResult_Completed [paid] <- pure result.output
  tagOf bob paid >>= (=== "a+b")

-- | A pending transfer's locked holding carries the inputs' states, so the
-- funds keep them however the transfer ends: returned to the sender on
-- reject, withdraw, and expiry, or paid to the receiver on accept.
testPendingTransferCarriesStates : Script ()
testPendingTransferCarriesStates = do
  fixture@Fixture{..} <- setup
  bob <- allocateParty "bob"
  let pending = do
        result <- taggedTransfer fixture bob False
        TransferInstructionV2.TransferInstructionResult_Pending cid <- pure result.output
        pure cid
      returnedTag (result : TransferInstructionV2.TransferInstructionResult) = do
        [cid] <- pure result.senderChangeCids
        tagOf alice cid

  rejected <- pending
  rejectResult <- submit bob do
    exerciseCmd rejected TransferInstructionV2.TransferInstruction_Reject with
      actors = [bob]; extraArgs = emptyExtraArgs
  returnedTag rejectResult >>= (=== "a+b")

  withdrawn <- pending
  withdrawResult <- submit alice do
    exerciseCmd withdrawn TransferInstructionV2.TransferInstruction_Withdraw with
      actors = [alice]; extraArgs = emptyExtraArgs
  returnedTag withdrawResult >>= (=== "a+b")

  accepted <- pending
  acceptResult <- submit bob do
    exerciseCmd accepted TransferInstructionV2.TransferInstruction_Accept with
      actors = [bob]; extraArgs = emptyExtraArgs
  TransferInstructionV2.TransferInstructionResult_Completed [paid] <- pure acceptResult.output
  tagOf bob paid >>= (=== "a+b")

  expired <- pending
  setTime t3
  expireResult <- submit admin do
    exerciseCmd (fromInterfaceContractId @TaggedTransferInstruction expired) TaggedTransferInstruction_Expire
  returnedTag expireResult >>= (=== "a+b")

-- | A mint consumes nothing, so the minted holding has no sources.
testMintHasNoSources : Script ()
testMintHasNoSources = do
  Fixture{..} <- setup
  offer <- submit admin do
    exerciseCmd harnessCid Harness_TaggedMint with amount = 5.0; actors = [admin]
  result <- submit alice do
    exerciseCmd offer TransferInstructionV2.TransferInstruction_Accept with
      actors = [alice]; extraArgs = emptyExtraArgs
  TransferInstructionV2.TransferInstructionResult_Completed [minted] <- pure result.output
  tagOf alice minted >>= (=== "new")

-- | An allocation passes each instrument's inputs to that instrument's locked
-- holding and change, and to no other instrument's. Settlement passes the
-- locked holdings' states to the next iteration's reserve and to the payout,
-- and a payout funded only by the settlement's net credit has no sources.
-- Withdrawing the successor returns the reserve with its state.
testAllocationPassesStatesPerInstrument : Script ()
testAllocationPassesStatesPerInstrument = do
  fixture@Fixture{..} <- setup
  bob <- allocateParty "bob"
  tok <- taggedHoldingOf fixture "TOK" "a" 10.0 None
  gld <- taggedHoldingOf fixture "GLD" "g" 10.0 None
  let leg instrumentId sender receiver amount = AllocationV2.TransferLeg with
        transferLegId = instrumentId
        sender = basicAccount sender
        receiver = basicAccount receiver
        amount
        instrumentId
        meta = emptyMetadata
      tagIn instrumentId (cids : TextMap.TextMap [ContractId HoldingV2.Holding]) = do
        Some [cid] <- pure (TextMap.lookup instrumentId cids)
        tagOf alice cid

  -- Alice sends 4 TOK and 3 GLD, receives 2 SLV, and reserves 2 TOK: the
  -- factory locks 6 TOK and 3 GLD and returns 4 TOK and 7 GLD.
  allocated <- submit alice do
    exerciseCmd harnessCid Harness_TaggedAllocate with
      allocate = AllocationInstructionV2.AllocationFactory_Allocate with
        settlement = AllocationV2.SettlementInfo with executors = [bob]; id = "s"; cid = None; meta = emptyMetadata
        allocation = AllocationV2.AllocationSpecification with
          admin
          authorizer = basicAccount alice
          transferLegSides =
            [ senderSide (leg "TOK" alice bob 4.0)
            , senderSide (leg "GLD" alice bob 3.0)
            , receiverSide (leg "SLV" bob alice 2.0)
            ]
          settlementDeadline = Some t2
          nextIterationFunding = Some (TextMap.fromList [("TOK", 2.0)])
          committed = False
          meta = emptyMetadata
        requestedAt = t0
        inputHoldingCids = [tok, gld]
        extraArgs = emptyExtraArgs
        actors = [alice]
  tagIn "TOK" allocated.authorizerChangeCids >>= (=== "a")
  tagIn "GLD" allocated.authorizerChangeCids >>= (=== "g")
  AllocationInstructionV2.AllocationInstructionResult_Completed allocationCid <- pure allocated.output
  lockedTags alice allocationCid >>= (=== ["g", "a"])

  -- Settling leaves 2 TOK and the 2 SLV credit: 1 TOK is reserved again, and
  -- 1 TOK and 2 SLV are paid out.
  settled <- submit (actAs [admin, bob]) do
    exerciseCmd allocationCid AllocationV2.Allocation_Settle with
      actors = [admin, bob]
      extraTransferLegSides = []
      nextIterationFunding = Some (TextMap.fromList [("TOK", 1.0)])
      extraArgs = emptyExtraArgs
  tagIn "TOK" settled.authorizerHoldingCids >>= (=== "a")
  tagIn "SLV" settled.authorizerHoldingCids >>= (=== "new")
  AllocationV2.AllocationResult_Settled (Some successorCid) <- pure settled.output
  lockedTags alice successorCid >>= (=== ["a"])

  withdrawn <- submit alice do
    exerciseCmd successorCid AllocationV2.Allocation_Withdraw with
      actors = [alice]; extraArgs = emptyExtraArgs
  tagIn "TOK" withdrawn.authorizerHoldingCids >>= (=== "a")

-- | Releasing locked holdings passes each one's state to its replacement.
testUnlockPassesEachState : Script ()
testUnlockPassesEachState = do
  fixture@Fixture{..} <- setup
  x <- taggedHolding fixture "x" 5.0 (Some (lockUntil admin (Some t2)))
  y <- taggedHolding fixture "y" 5.0 (Some (lockUntil admin (Some t2)))
  released <- submit (actAs admin) do
    exerciseCmd harnessCid Harness_TaggedUnlock with cids = [x, y]; actors = [admin]
  tags <- mapA (tagOf alice) (concatMap snd (TextMap.toList released))
  dedupSort tags === ["x", "y"]

-- | The owner unlock passes the exercised holding's state to its
-- replacement.
testOwnerUnlockPassesState : Script ()
testOwnerUnlockPassesState = do
  fixture@Fixture{..} <- setup
  locked <- taggedHolding fixture "x" 5.0 (Some (lockUntil admin (Some t2)))
  setTime t3
  unlocked <- submit alice do
    exerciseCmd (fromInterfaceContractId @TaggedHolding locked) TaggedHolding_OwnerUnlock
  tagOf alice unlocked >>= (=== "x")
