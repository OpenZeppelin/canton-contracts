module HelloWorld.HelloWorld where

-- M0 hello-world scaffold only. This is not a library primitive.
--
-- Signatories: issuer.
-- Observers: recipient.
-- Controllers: issuer controls ArchiveGreeting.
-- Choices: ArchiveGreeting consumes the contract and returns unit.
-- Disclosed parties: issuer and recipient are stakeholders.
-- Privacy expectations: visibility is limited to stakeholders and parties
-- required by the ledger transaction.
-- Authorization assumptions: issuer authorizes create and archive.
-- Archival behavior: ArchiveGreeting archives the Greeting contract.
-- Failure modes: create fails without issuer authorization; archive fails when
-- exercised by a non-issuer or against an inactive contract.
-- Upgrade and migration assumptions: none; this package is a disposable M0
-- compile proof and must not become public API.
template Greeting
  with
    issuer : Party
    recipient : Party
    message : Text
  where
    signatory issuer
    observer recipient

    choice ArchiveGreeting : ()
      controller issuer
      do
        pure ()

