-- | Experimental CIP-0112 / Token Standard V2 settlement scaffold.
--
-- Source evidence:
-- - Canton Foundation CIP-0112, "Canton Network Token Standard V2 -
--   Improvements for Privacy, Performance and Traditional Accounting".
-- - hyperledger-labs/splice branch token-standard-v2-upcoming at
--   1e34121b2b369c5dde357c098e2aaeb65250e736.
-- - Historical local preview only: canton-network/splice branch
--   token-standard-v2-daml-preview at b91de5d4b910ded598151981654dce2acc6f84ba.
--
-- This package is non-public and proposed-only. It intentionally mirrors the
-- names of the CIP-0112 V2 settlement concepts, but it does not vendor or
-- replace the Splice API packages. It is a small local scaffold for the M1
-- scoping decision in root PLAN.md and the promotion boundary ADR.
module OpenZeppelin.Settlement.Cip112 where

import DA.Action (when)

-- Shared Token Standard V2 types come from the experimental mock interface layer
-- (`experiments/token-standard-v2-mock`), which mirrors the seven
-- `splice-api-token-*-v2` packages 1:1. The `Allocation`/`SettlementFactory`
-- interfaces are imported only where needed (qualified) to avoid clashing with
-- this module's `Allocation`/`SettlementFactory` templates; here we take only the
-- shared data types unqualified.
import OpenZeppelin.TokenStandard.V2.Metadata
import OpenZeppelin.TokenStandard.V2.Holding
import OpenZeppelin.TokenStandard.V2.Allocation
  ( SettlementInfo(..)
  , TransferSide(..)
  , TransferLeg(..)
  , TransferLegSide(..)
  , RequestedAllocation(..)
  , AllocationSpecification(..)
  )
import OpenZeppelin.TokenStandard.V2.TransferEvents
  ( EventLog
  , EventLogView(..)
  , EventLog_HoldingsChange(..)
  , EventLogTransferLegSide(..)
  )

data D1ComplianceHook = D1ComplianceHook with
    hookRef : Text
    requiresPerSettlementReference : Bool
  deriving (Eq, Show)

data D2SeizureHook = D2SeizureHook with
    seizureCaseRef : Text
    custodianDestination : Account
    inFlightHandlingStatus : Text
  deriving (Eq, Show)

data AllocationRequestResult
  = AllocationRequestAccepted
  | AllocationRequestRejected
  | AllocationRequestWithdrawn
  deriving (Eq, Show)

data AllocationInstructionResult
  = AllocationInstructionPending
  | AllocationInstructionCompleted with allocationCid : ContractId Allocation
  | AllocationInstructionFailed
  deriving (Eq, Show)

data AllocationResult
  = AllocationSettled with receiptCid : ContractId SettlementReceipt
  | AllocationCancelled with returnedHoldingCids : [ContractId ToyHolding]
  | AllocationWithdrawn with returnedHoldingCids : [ContractId ToyHolding]
  | AllocationD2Swept with custodianHoldingCids : [ContractId ToyHolding]
  deriving (Eq, Show)

experimentalFeatureFlag : Text
experimentalFeatureFlag = "experimental.cip112-settlement.enabled"

-- | Minimal single-admin D2 authority witness for the experimental settlement
-- scaffold.
--
-- Signatories: `admin`, the registry root that issues the capability.
-- Observers: `assignee`, the party allowed to exercise D2 sweep authority.
-- Controllers: none.
-- Choices: none.
-- Disclosed parties: the assignee presents this CID directly to a gated choice;
-- tests disclose it only when proving a wrong actor still cannot use it.
-- Privacy expectations: only the registry admin and assignee see the
-- capability. Counterparties and settlement executors do not learn the D2
-- authority graph from settlement state.
-- Authorization assumptions: this narrowly models the S2 D4 decision for M1:
-- single-admin, admin-signed `Burner` authority. It does not implement
-- on-ledger multi-sig, topology multi-hosting, lawful-process attestations, or
-- production custody policy.
-- Archival behavior: no choices; revocation/rotation is outside this
-- experiment and must be added before any public authority surface.
-- Failure modes: a D2 sweep rejects a missing capability, wrong admin, wrong
-- assignee, or instrument scope mismatch before any locked holding is archived.
-- Upgrade and migration assumptions: this local witness mirrors the shape of
-- `RoleCapability` evidence. A promoted library surface should either import
-- the accepted capability package or add an SCU-compatible replacement without
-- mutating the baseline settlement choices.
template BurnerCapability
  with
    admin : Party
    assignee : Party
    instrumentScope : Optional InstrumentId
    featureFlag : Text
  where
    signatory admin
    observer assignee
    ensure featureFlag == experimentalFeatureFlag

-- | Toy holding used only to make allocation locking testable without creating
-- a public token package.
--
-- Signatories: `admin` plus the account parties returned by `accountParties`.
-- Observers: none beyond signatories.
-- Locked holdings additionally observe `lock.holders`, which gives settlement
-- executors visibility to the in-flight locked funds they are authorized to
-- settle or cancel.
-- Controllers: none.
-- Choices: none.
-- Disclosed parties: the instrument admin and account owner/provider are
-- stakeholders; tests disclose CIDs only where a settlement step needs them.
-- Privacy expectations: a holding is visible to the asset admin and affected
-- account parties, not to unrelated settlement counterparties.
-- Authorization assumptions: this is a toy asset witness. Real CIP-0112 assets
-- implement the Token Standard V2 holding interface and choose account-provider
-- authorization rules themselves.
-- Archival behavior: holdings are archived by allocation-instruction accept,
-- allocation settle, allocation cancel, or allocation withdraw.
-- Failure modes: creation rejects non-positive amounts or a missing feature
-- flag. No production freeze, seize, KYC, sanctions, custody, or relayer logic
-- is implemented.
-- Upgrade and migration assumptions: non-public experiment. If promoted, this
-- witness should be replaced by the accepted Token Standard V2 package import.
template ToyHolding
  with
    admin : Party
    account : Account
    instrumentId : InstrumentId
    amount : Decimal
    lock : Optional Lock
    meta : Metadata
    featureFlag : Text
  where
    signatory admin, accountParties admin account
    observer lockObservers lock
    ensure amount > 0.0 && featureFlag == experimentalFeatureFlag

    -- Implements the mock Token Standard V2 `Holding` interface so settlement
    -- outputs and event logs can refer to holdings by interface (swappable for
    -- the real `splice-api-token-holding-v2` package once imported).
    interface instance Holding for ToyHolding where
      view = HoldingView with
        account = account
        instrumentId = instrumentId
        amount = amount
        lock = lock
        meta = meta

-- | Experimental settlement factory covering request, instruction, allocation,
-- and batch settlement entrypoints.
--
-- Signatories: `admin`.
-- Observers: none.
-- Controllers: settlement executors create allocation requests and settle
-- batches; authorizer account parties create allocation instructions.
-- Choices: `SettlementFactory_CreateAllocationRequest`,
-- `SettlementFactory_CreateAllocationInstruction`,
-- `SettlementFactory_SettleBatch`.
-- Disclosed parties: the factory is private to `admin` and must be explicitly
-- disclosed to executors or account parties in tests and consumers.
-- Privacy expectations: the factory does not make a settlement public. Requests
-- and allocations carry only the parties needed for that lifecycle step.
-- Authorization assumptions: D4 is decided for M1 as single-admin capability
-- authority. Settlement remains executor-driven; D2 in-flight seizure is
-- exercised through `BurnerCapability` on `Allocation`, not through settlement
-- executors or counterparties.
-- Archival behavior: nonconsuming choices; the factory persists.
-- Failure modes: wrong actors, empty transfer-leg lists, missing authorization
-- sides, settlement mismatch, expired allocations, missing D1 references,
-- under-funded senders (locked funds must cover sender obligations — fail
-- closed), and active D2 in-flight seizure state fail before settlement commits;
-- the D2 state is resolved through `Allocation_SweepD2InFlightSeizure`.
-- Upgrade and migration assumptions: non-public experiment. Optional D1 and D2
-- hook fields follow the SCU pattern from the identity-hook upgrade spike:
-- append optional fields and add choices rather than mutating baseline choice
-- arguments once a public surface exists.
template SettlementFactory
  with
    admin : Party
    featureFlag : Text
  where
    signatory admin
    ensure featureFlag == experimentalFeatureFlag

    nonconsuming choice SettlementFactory_CreateAllocationRequest : ContractId AllocationRequest
      with
        authorizer : Account
        settlement : SettlementInfo
        allocations : [RequestedAllocation]
        requestedAt : Time
        settleAt : Optional Time
        actors : [Party]
      controller actors
      do
        requireExperimentalFlag featureFlag
        assertMsg eExecutorsMismatch (actors == settlement.executors)
        assertMsg eEmptyRequestedAllocations (not (null allocations))
        assertMsg eRequestedAllocationAdminMismatch (allRequestedAdminsMatch admin allocations)
        create AllocationRequest with
          originalRequestCid = None
          authorizer
          settlement
          allocations
          requestedAt
          settleAt
          featureFlag

    nonconsuming choice SettlementFactory_CreateAllocationInstruction : ContractId AllocationInstruction
      with
        allocation : AllocationSpecification
        requestedAt : Time
        inputHoldingCids : [ContractId ToyHolding]
        d1ComplianceHook : Optional D1ComplianceHook
        actors : [Party]
      controller actors
      do
        requireExperimentalFlag featureFlag
        assertMsg eAdminMismatch (allocation.admin == admin)
        assertMsg eAuthorizerActorsMismatch (actors == accountParties admin allocation.authorizer)
        requireValidAllocationSpecification allocation
        create AllocationInstruction with
          originalInstructionCid = None
          allocation
          requestedAt
          inputHoldingCids
          d1ComplianceHook
          featureFlag

    nonconsuming choice SettlementFactory_SettleBatch : [ContractId SettlementReceipt]
      with
        settlement : SettlementInfo
        transferLegs : [TransferLeg]
        allocationCids : [ContractId Allocation]
        actors : [Party]
        d1ComplianceRef : Optional Text
      controller actors
      do
        requireExperimentalFlag featureFlag
        assertMsg eExecutorsMismatch (actors == settlement.executors)
        assertMsg eNoTransferLegs (not (null transferLegs))
        assertMsg eBadTransferLegAmount (allTransferLegAmountsPositive transferLegs)
        allocationValues <- fetchAllocations allocationCids
        let authorizedSides = collectAllocationSides allocationValues
        assertMsg eSettlementMissingAuthorization (allTransferLegsAuthorized transferLegs authorizedSides)
        settleAllocations (admin :: actors) settlement transferLegs d1ComplianceRef allocationCids

    -- Typed, node-applied D1 path (additive; SCU-safe new choice — SettleBatch is
    -- unchanged). Verifies a signed NodeComplianceAttestation from a trusted
    -- attester covering this settlement, then settles. This is the Daml-visible
    -- node-attestation shape (Q1), layered on top of the reference-field hook.
    nonconsuming choice SettlementFactory_SettleBatchWithAttestation : [ContractId SettlementReceipt]
      with
        settlement : SettlementInfo
        transferLegs : [TransferLeg]
        allocationCids : [ContractId Allocation]
        actors : [Party]
        attestationCid : ContractId NodeComplianceAttestation
        registryCid : ContractId TrustedAttesterRegistry
      controller actors
      do
        requireExperimentalFlag featureFlag
        assertMsg eExecutorsMismatch (actors == settlement.executors)
        assertMsg eNoTransferLegs (not (null transferLegs))
        assertMsg eBadTransferLegAmount (allTransferLegAmountsPositive transferLegs)
        att <- requireNodeAttestation registryCid attestationCid settlement.settlementRef.id
        allocationValues <- fetchAllocations allocationCids
        let authorizedSides = collectAllocationSides allocationValues
        assertMsg eSettlementMissingAuthorization (allTransferLegsAuthorized transferLegs authorizedSides)
        settleAllocations (admin :: actors) settlement transferLegs (Some att.claimKind) allocationCids

-- | Request emitted by a settlement app/executor asking an account to create
-- allocations.
--
-- Signatories: `settlement.executors`.
-- Observers: authorizer account parties.
-- Controllers: authorizer account parties accept or reject; executors withdraw.
-- Choices: `AllocationRequest_Accept`, `AllocationRequest_Reject`,
-- `AllocationRequest_Withdraw`.
-- Disclosed parties: executors and authorizer account parties only.
-- Privacy expectations: apps may emit one or more requests per settlement to
-- limit which authorizers see which transfer-leg sides, matching CIP-0112's
-- confidentiality guidance.
-- Authorization assumptions: accepting the request signals readiness; actual
-- allocation creation is separate because CIP-0112 says wallets may call accept
-- in the same transaction but apps must clean up independently.
-- Archival behavior: all choices are consuming and archive the request.
-- Failure modes: wrong actor set fails; accepting does not by itself guarantee
-- allocation creation.
-- Upgrade and migration assumptions: `originalRequestCid` is reserved for
-- future request updates, matching the CIP-0112 correlation pattern.
template AllocationRequest
  with
    originalRequestCid : Optional (ContractId AllocationRequest)
    authorizer : Account
    settlement : SettlementInfo
    allocations : [RequestedAllocation]
    requestedAt : Time
    settleAt : Optional Time
    featureFlag : Text
  where
    signatory settlement.executors
    observer accountObservers authorizer
    ensure featureFlag == experimentalFeatureFlag && not (null allocations)

    choice AllocationRequest_Accept : AllocationRequestResult
      with actors : [Party]
      controller actors
      do
        assertMsg eAuthorizerActorsMismatch (actors == accountObservers authorizer)
        pure AllocationRequestAccepted

    choice AllocationRequest_Reject : AllocationRequestResult
      with actors : [Party]
      controller actors
      do
        assertMsg eAuthorizerActorsMismatch (actors == accountObservers authorizer)
        pure AllocationRequestRejected

    choice AllocationRequest_Withdraw : AllocationRequestResult
      with actors : [Party]
      controller actors
      do
        assertMsg eExecutorsMismatch (actors == settlement.executors)
        pure AllocationRequestWithdrawn

-- | Wallet/registry instruction to create an allocation by locking input
-- holdings.
--
-- Signatories: allocation `admin` plus authorizer account parties.
-- Observers: settlement executors.
-- Controllers: authorizer account parties accept or withdraw.
-- Choices: `AllocationInstruction_Accept`, `AllocationInstruction_Withdraw`.
-- Disclosed parties: admin, authorizer account parties, and executors.
-- Privacy expectations: the instruction exposes only one authorizer's funding
-- and transfer-leg sides. Other settlement parties do not see it unless they
-- are executors or explicitly disclosed.
-- Authorization assumptions: the toy accept path requires the authorizer
-- account parties exactly. Provider-managed account authority is represented by
-- `Account.provider`, but production provider policy is out of scope.
-- Archival behavior: accept archives the instruction and input holdings, then
-- creates locked holdings and an `Allocation`. Withdraw archives only the
-- instruction.
-- Failure modes: wrong actors, non-positive amounts, wrong input owner/admin,
-- and wrong input instrument fail.
-- Upgrade and migration assumptions: `originalInstructionCid` and optional
-- `d1ComplianceHook` reserve the CIP-0112 update/correlation and D1 extension
-- paths without committing to final attestation shape.
template AllocationInstruction
  with
    originalInstructionCid : Optional (ContractId AllocationInstruction)
    allocation : AllocationSpecification
    requestedAt : Time
    inputHoldingCids : [ContractId ToyHolding]
    d1ComplianceHook : Optional D1ComplianceHook
    featureFlag : Text
  where
    signatory allocation.admin, accountParties allocation.admin allocation.authorizer
    observer allocation.settlement.executors
    ensure featureFlag == experimentalFeatureFlag

    choice AllocationInstruction_Accept : AllocationInstructionResult
      with actors : [Party]
      controller actors
      do
        assertMsg eAuthorizerActorsMismatch (actors == accountParties allocation.admin allocation.authorizer)
        requireValidAllocationSpecification allocation
        lockedHoldingCids <- lockInputHoldings allocation inputHoldingCids
        allocationCid <- create Allocation with
          originalAllocationCid = None
          allocation
          lockedHoldingCids
          createdAt = requestedAt
          numIterations = 0
          d1ComplianceHook
          d2SeizureHook = None
          seizureWindowEnd = None
          featureFlag
        pure AllocationInstructionCompleted with allocationCid

    choice AllocationInstruction_Withdraw : AllocationInstructionResult
      with actors : [Party]
      controller actors
      do
        assertMsg eAuthorizerActorsMismatch (actors == accountParties allocation.admin allocation.authorizer)
        pure AllocationInstructionFailed

-- | Ready-to-settle allocation backed by locked toy holdings.
--
-- Signatories: allocation `admin` plus authorizer account parties.
-- Observers: settlement executors.
-- Controllers: `admin :: settlement.executors` settle (directly via
-- `Allocation_Settle`, or in a factory batch via `Allocation_SettleInBatch`);
-- settlement executors cancel; authorizer account parties withdraw; admin marks a
-- D2 in-flight seizure hook; a `BurnerCapability` assignee sweeps marked locked
-- holdings, with destination account parties co-authorizing only the toy holding
-- create when the preset destination is a third party.
-- Choices: `Allocation_Settle`, `Allocation_SettleInBatch`, `Allocation_Cancel`,
-- `Allocation_Withdraw`, `Allocation_MarkD2InFlightSeizure`,
-- `Allocation_SweepD2InFlightSeizure`.
-- Disclosed parties: admin, authorizer account parties, and executors.
-- Privacy expectations: allocation visibility is per authorizer and executor.
-- Batch settlement receipts expose only leg ids and the parties already
-- involved in the allocation.
-- Authorization assumptions: settlement uses the CIP-0112 default posture:
-- executor authority supplied by the settlement app plus instrument admin
-- authority from the settlement factory. D2 seizure uses the S2 D4
-- single-admin `BurnerCapability` model; the sweep caller must present an
-- admin-issued capability naming that caller. The optional destination
-- co-authorization is not seizure authority; it is required only because
-- `ToyHolding` makes account parties signatory on the replacement holding.
-- Archival behavior: settle, cancel, withdraw, and D2 sweep are consuming; D2
-- marking is consuming and creates a successor allocation. Both settle paths
-- archive this allocation's locked input holdings, then conserve value: the
-- archived locked funds must cover the authorizer's SenderSide leg amounts per
-- instrument, and any surplus is returned to the authorizer's account as a new
-- unlocked "change" holding (so locked = sum of sender obligations + returned
-- change). The authorizer's ReceiverSide legs are credited as new unlocked
-- holdings — funded across the batch by the counterparties' own debits. For the
-- direct `Allocation_Settle`, peer allocation and receipt proof CIDs are fetched
-- as authorization evidence, not co-settled by this choice. D2 sweep archives
-- locked holdings only after validating the configured custodian destination and
-- capability, then creates replacement toy holdings at that destination. For a
-- third-party destination, the destination party signs the exercise so the
-- replacement toy holding is authorized. Atomic multi-allocation settlement is a
-- property of `SettlementFactory_SettleBatch`.
-- Failure modes: wrong actors, settlement mismatch, expired settlement, missing
-- D1 reference when the optional hook requires one, unauthorized leg sides,
-- locked funds that do not cover the authorizer's sender obligations
-- (under-funded senders fail closed — no mint-from-nothing), active D2 in-flight
-- seizure on the settlement path, missing/invalid Burner capability, missing
-- custodian destination, post-deadline D2 seizure, and unlocked or out-of-scope
-- holdings fail before commit.
-- Upgrade and migration assumptions: optional D1/D2 hook fields are additive,
-- and `Allocation_SettleInBatch` is an additive (SCU-safe) choice that does not
-- change `Allocation_Settle`. `peerAllocationCids` and `peerReceiptCids` are
-- experimental proof inputs on the direct path, added before public stability.
-- They prove matching authorization exists; they do not prove atomic
-- delivery-versus-payment at the direct-choice level. If a promoted direct path
-- needs atomic co-settlement, it must consume or settle the peer allocations too,
-- or the direct choice should stay non-public. Future typed compliance/seizure
-- behavior, including lawful-process attestations or destination mutability,
-- should be added through new choices or optional fields, not by changing
-- baseline choice arguments once a public surface exists.
template Allocation
  with
    originalAllocationCid : Optional (ContractId Allocation)
    allocation : AllocationSpecification
    lockedHoldingCids : [ContractId ToyHolding]
    createdAt : Time
    numIterations : Int
    d1ComplianceHook : Optional D1ComplianceHook
    d2SeizureHook : Optional D2SeizureHook
    -- Additive (SCU-safe) D2 refinement: an optional lawful seizure window. When
    -- `None`, the terminal-deadline policy applies (promotion ADR default). When
    -- set, the lawful-process sweep choice may seize up to this time, which may
    -- extend past the settlement deadline.
    seizureWindowEnd : Optional Time
    featureFlag : Text
  where
    signatory allocation.admin, accountParties allocation.admin allocation.authorizer
    observer allocation.settlement.executors
    ensure featureFlag == experimentalFeatureFlag

    choice Allocation_Settle : ContractId SettlementReceipt
      with
        actors : [Party]
        settlement : SettlementInfo
        transferLegs : [TransferLeg]
        extraTransferLegSides : [TransferLegSide]
        peerAllocationCids : [ContractId Allocation]
        peerReceiptCids : [ContractId SettlementReceipt]
        nextIterationFunding : Optional [(Text, Decimal)]
        d1ComplianceRef : Optional Text
      controller actors
      do
        assertMsg eSettlementActorsMismatch (actors == allocation.admin :: allocation.settlement.executors)
        assertMsg eSettlementMismatch (settlement == allocation.settlement)
        assertMsg eNoTransferLegs (not (null transferLegs))
        assertMsg eBadTransferLegAmount (allTransferLegAmountsPositive transferLegs)
        requireBeforeSettlementDeadline allocation.settlement
        requireD1Reference d1ComplianceHook d1ComplianceRef
        requireNoActiveD2InFlight d2SeizureHook
        requireIteratedSettlementAllowed allocation extraTransferLegSides nextIterationFunding
        peerAllocations <- fetchAllocations peerAllocationCids
        peerReceipts <- fetchReceipts peerReceiptCids
        assertMsg ePeerAllocationMismatch (allPeerAllocationsMatch allocation peerAllocations)
        assertMsg ePeerReceiptMismatch (allPeerReceiptsMatch allocation peerReceipts)
        let localSides = allocation.transferLegSides <> extraTransferLegSides
            authorizedSides =
              localSides
                <> collectAllocationSides peerAllocations
                <> collectReceiptSides peerReceipts
        assertMsg eSettlementMissingAuthorization (allTransferLegsAuthorized transferLegs authorizedSides)
        assertMsg eAllocationLegMismatch (allAllocationSidesBackedByLegs transferLegs authorizedSides)
        assertMsg eAllocationLegMismatch (allAuthorizerLegSidesPresent allocation.authorizer transferLegs localSides)
        performSettle allocation lockedHoldingCids settlement transferLegs localSides d1ComplianceRef d2SeizureHook featureFlag

    -- Batch settlement path (SCU-safe new choice; `Allocation_Settle` is
    -- unchanged). This choice is a FACTORY-INTERNAL primitive:
    -- `SettlementFactory_SettleBatch` proves once, over all allocations, that
    -- every transfer leg has both authorized sides (the both-sidedness
    -- invariant), then settles each authorizer's allocation through this choice.
    -- Because that cross-allocation proof is established at the factory level,
    -- this choice settles a single allocation WITHOUT re-fetching peer
    -- allocations/receipts or re-running the both-sided check — eliminating the
    -- O(N^2) peer fetches the direct path would incur per batch. It conserves
    -- value for its own authorizer (locked funds cover this authorizer's
    -- SenderSide obligations), credits the authorizer's ReceiverSide legs, and
    -- emits the holdings-change event.
    --
    -- IMPORTANT: delivery-versus-payment / both-sidedness is a property of
    -- `SettlementFactory_SettleBatch`, NOT of this choice in isolation. Exercised
    -- standalone on a lone ReceiverSide allocation it would credit the receiver
    -- with no matching debit — so it MUST only be driven by the factory. It is
    -- not a candidate public surface: it requires `admin :: executors` authority
    -- (the trusted issuer, who can mint regardless), so this is a footgun to be
    -- avoided, not an untrusted-party escalation. Standalone, peer-proven
    -- settlement is `Allocation_Settle`, which keeps
    -- `peerAllocationCids`/`peerReceiptCids` and re-proves both-sidedness itself.
    choice Allocation_SettleInBatch : ContractId SettlementReceipt
      with
        actors : [Party]
        settlement : SettlementInfo
        transferLegs : [TransferLeg]
        d1ComplianceRef : Optional Text
      controller actors
      do
        assertMsg eSettlementActorsMismatch (actors == allocation.admin :: allocation.settlement.executors)
        assertMsg eSettlementMismatch (settlement == allocation.settlement)
        assertMsg eNoTransferLegs (not (null transferLegs))
        assertMsg eBadTransferLegAmount (allTransferLegAmountsPositive transferLegs)
        requireBeforeSettlementDeadline allocation.settlement
        requireD1Reference d1ComplianceHook d1ComplianceRef
        requireNoActiveD2InFlight d2SeizureHook
        requireIteratedSettlementAllowed allocation [] None
        let localSides = allocation.transferLegSides
        assertMsg eAllocationLegMismatch (allAllocationSidesBackedByLegs transferLegs localSides)
        assertMsg eAllocationLegMismatch (allAuthorizerLegSidesPresent allocation.authorizer transferLegs localSides)
        performSettle allocation lockedHoldingCids settlement transferLegs localSides d1ComplianceRef d2SeizureHook featureFlag

    choice Allocation_Cancel : AllocationResult
      with actors : [Party]
      controller actors
      do
        assertMsg eExecutorsMismatch (actors == allocation.settlement.executors)
        returnedHoldingCids <- unlockHoldings lockedHoldingCids
        pure AllocationCancelled with returnedHoldingCids

    choice Allocation_Withdraw : AllocationResult
      with actors : [Party]
      controller actors
      do
        assertMsg eAuthorizerActorsMismatch (actors == accountParties allocation.admin allocation.authorizer)
        requireWithdrawAllowed allocation
        returnedHoldingCids <- unlockHoldings lockedHoldingCids
        pure AllocationWithdrawn with returnedHoldingCids

    choice Allocation_MarkD2InFlightSeizure : ContractId Allocation
      with
        actors : [Party]
        seizureHook : D2SeizureHook
      controller actors
      do
        assertMsg eAdminActorsMismatch (actors == [allocation.admin])
        create this with d2SeizureHook = Some seizureHook

    choice Allocation_SweepD2InFlightSeizure : AllocationResult
      with
        burner : Party
        burnerCapCid : Optional (ContractId BurnerCapability)
      controller d2SweepControllers allocation.admin d2SeizureHook burner
      do
        hook <- requireD2InFlightSeizure d2SeizureHook
        requireBeforeSettlementDeadline allocation.settlement
        cap <- requireBurnerCapability burner allocation.admin burnerCapCid
        requireCustodianDestination hook.custodianDestination
        custodianHoldingCids <- sweepLockedHoldings hook.custodianDestination cap lockedHoldingCids
        -- Seizure is also a holdings change: inputs swept to the custodian outputs.
        _ <- emitHoldingsChange allocation.admin hook.custodianDestination allocation.settlement.executors lockedHoldingCids custodianHoldingCids [] featureFlag
        pure AllocationD2Swept with custodianHoldingCids

    -- Additive D2 refinements (SCU-safe new choices; Mark/Sweep above unchanged).
    -- Mark with an explicit lawful seizure window; the window may extend past the
    -- settlement deadline. Admin-only, like the baseline mark.
    choice Allocation_MarkD2WithWindow : ContractId Allocation
      with
        actors : [Party]
        seizureHook : D2SeizureHook
        windowEnd : Time
      controller actors
      do
        assertMsg eAdminActorsMismatch (actors == [allocation.admin])
        create this with
          d2SeizureHook = Some seizureHook
          seizureWindowEnd = Some windowEnd

    -- Sweep that records a lawful-process attestation reference and honours the
    -- optional seizure window (allowing post-deadline seizure only when a window
    -- was set). Separates seizure authority (BurnerCapability) from the
    -- lawful-process evidence captured here.
    choice Allocation_SweepD2WithLawfulProcess : AllocationResult
      with
        burner : Party
        burnerCapCid : Optional (ContractId BurnerCapability)
        lawfulProcessRef : Text
      controller d2SweepControllers allocation.admin d2SeizureHook burner
      do
        hook <- requireD2InFlightSeizure d2SeizureHook
        assertMsg eD2LawfulProcessMissing (lawfulProcessRef /= "")
        requireWithinSeizureWindow allocation.settlement seizureWindowEnd
        cap <- requireBurnerCapability burner allocation.admin burnerCapCid
        requireCustodianDestination hook.custodianDestination
        custodianHoldingCids <- sweepLockedHoldings hook.custodianDestination cap lockedHoldingCids
        _ <- emitHoldingsChange allocation.admin hook.custodianDestination allocation.settlement.executors lockedHoldingCids custodianHoldingCids [] featureFlag
        pure AllocationD2Swept with custodianHoldingCids

-- | Minimal settlement receipt used by the experiment to prove successful
-- atomic settlement without implementing a production asset ledger.
--
-- Signatories: `admin`.
-- Observers: authorizer account parties and settlement executors.
-- Controllers: none.
-- Choices: none.
-- Disclosed parties: admin, authorizer account parties, and executors.
-- Privacy expectations: receipt carries settlement reference, leg ids, local
-- transfer-leg sides, and optional D1/D2 references. It is visible to the
-- allocation participants and executors, and can serve as a contract-level
-- proof that a peer side already settled in the same batch sequence.
-- Authorization assumptions: created only by `Allocation_Settle` after the
-- factory/allocation checks and peer allocation or receipt proof pass.
-- Archival behavior: no choices; lifecycle management is intentionally out of
-- scope for the experiment.
-- Failure modes: none after creation; failed settlement rolls back the receipt
-- with the whole transaction.
-- Upgrade and migration assumptions: receipt is an experiment-only event stand
-- in. A real implementation should use CIP-0112 `EventLog_HoldingsChange`.
template SettlementReceipt
  with
    admin : Party
    authorizer : Account
    settlement : SettlementInfo
    settledTransferLegIds : [Text]
    settledTransferLegSides : [TransferLegSide]
    d1ComplianceRef : Optional Text
    d2SeizureHook : Optional D2SeizureHook
    featureFlag : Text
  where
    signatory admin
    observer accountParties admin authorizer, settlement.executors
    ensure featureFlag == experimentalFeatureFlag

-- | A single emitted holdings-change event implementing the mock Token Standard
-- V2 `EventLog` interface (mirrors `splice-api-token-transfer-events-v2`'s
-- `SimpleEventLogEntry` / `EventLog_HoldingsChange`): the inputs consumed and
-- outputs created in one settlement or seizure step. Wallets/indexers subscribe
-- to these entries through the `EventLog` interface instead of
-- reverse-engineering factory interactions, which would leak the sender's UTXO
-- graph to the receiver. The interface instance is what makes the conformance
-- real and queryable (`queryInterface @EventLog`).
--
-- Signatories: `event.admin`. Observers: `event.observers` (the affected
-- account's parties plus the settlement executors). Choices: none (data
-- carrier). Archival behavior: persists; each step emits its own entry. Privacy:
-- only the admin and the entry observers see it. Upgrade: experiment-only; a
-- promoted surface uses the real transfer-events package.
template SettlementEventLogEntry
  with
    event : EventLog_HoldingsChange
    featureFlag : Text
  where
    signatory event.admin
    observer event.observers
    ensure featureFlag == experimentalFeatureFlag

    interface instance EventLog for SettlementEventLogEntry where
      view = EventLogView with
        admin = event.admin
        meta = event.meta

-- | Map settlement-leg sides onto the transfer-events leg-side shape.
toEventLogSides : [TransferLegSide] -> [EventLogTransferLegSide]
toEventLogSides sides =
  map
    (\s -> EventLogTransferLegSide with side = s.side; transferLegId = s.transferLegId; otherside = s.otherside)
    sides

-- | Emit a holdings-change event for a settlement/seizure step. Authorized by
-- `admin`, which is a signatory of the enclosing allocation choice. Holdings are
-- recorded by the mock `Holding` interface contract id so the event is
-- asset-agnostic. The affected account's parties are always included in the entry
-- observers alongside the settlement executors, so the wallet whose holding
-- changed can subscribe to its own event (the stated wallet/indexer reporting
-- purpose) rather than only the executors seeing it.
emitHoldingsChange
  : Party
  -> Account
  -> [Party]
  -> [ContractId ToyHolding]
  -> [ContractId ToyHolding]
  -> [TransferLegSide]
  -> Text
  -> Update (ContractId SettlementEventLogEntry)
emitHoldingsChange admin account executors inputs outputs sides flag =
  create SettlementEventLogEntry with
    event = EventLog_HoldingsChange with
      admin
      account
      inputHoldingCids = map (toInterfaceContractId @Holding) inputs
      outputHoldingCids = map (toInterfaceContractId @Holding) outputs
      transferLegSides = toEventLogSides sides
      observers = accountParties admin account <> executors
      meta = emptyMetadata
    featureFlag = flag

-- | Admin-owned registry of trusted node attesters. Mirrors the identity-hook
-- Shape-B TrustedIssuerRegistry pattern, applied to D1 node-side compliance.
--
-- Signatories: `admin`. Observers: `attesters`. Choices: none. The registry is
-- the on-ledger trust anchor for which parties may sign compliance attestations.
template TrustedAttesterRegistry
  with
    admin : Party
    attesters : [Party]
    featureFlag : Text
  where
    signatory admin
    observer attesters
    ensure featureFlag == experimentalFeatureFlag

-- | A signed, typed node compliance attestation. Its existence proves the
-- `attester` signed it (the attester is the sole signatory). This is the
-- Daml-visible alternative to the contract-oblivious D1 reference hook: the node
-- emits this and settlement verifies it at exercise time.
--
-- Signatories: `attester`. Observers: none. Choices: none. Privacy: held by the
-- attester and disclosed to the settlement executor when settling.
template NodeComplianceAttestation
  with
    attester : Party
    attestationObservers : [Party]
    settlementRef : Text
    claimKind : Text
    issuedAt : Time
    expiresAt : Time
    featureFlag : Text
  where
    signatory attester
    -- The registry admin / settlement executors observe the attestation so the
    -- settlement transaction can fetch and verify it at exercise time.
    observer attestationObservers
    ensure featureFlag == experimentalFeatureFlag

-- | Verify a typed node attestation: signer is a registry-trusted attester, it
-- covers this settlement reference, and it is within its validity window. Returns
-- the attestation so the caller can carry its claim kind as the D1 reference.
requireNodeAttestation
  : ContractId TrustedAttesterRegistry
  -> ContractId NodeComplianceAttestation
  -> Text
  -> Update NodeComplianceAttestation
requireNodeAttestation registryCid attestationCid settlementRefId = do
  registry <- fetch registryCid
  att <- fetch attestationCid
  now <- getTime
  assertMsg eD1AttesterNotTrusted (att.attester `elem` registry.attesters)
  assertMsg eD1AttestationSettlementMismatch (att.settlementRef == settlementRefId)
  assertMsg eD1AttestationNotYetValid (now >= att.issuedAt)
  assertMsg eD1AttestationExpired (now <= att.expiresAt)
  pure att

-- | Lawful seizure-window check. With no window, the terminal settlement
-- deadline applies (promotion ADR default). With a window, seizure is permitted
-- up to that time, which may extend past the deadline.
requireWithinSeizureWindow : SettlementInfo -> Optional Time -> Update ()
requireWithinSeizureWindow settlement windowEnd = do
  now <- getTime
  case windowEnd of
    Some w -> assertMsg eD2SeizureWindowClosed (now <= w)
    None -> requireBeforeSettlementDeadline settlement

requireExperimentalFlag : Text -> Update ()
requireExperimentalFlag flag =
  assertMsg eFeatureDisabled (flag == experimentalFeatureFlag)

accountObservers : Account -> [Party]
accountObservers account =
  case (account.owner, account.provider) of
    (Some owner, Some provider) -> if owner == provider then [owner] else [owner, provider]
    (Some owner, None) -> [owner]
    (None, Some provider) -> [provider]
    (None, None) -> []

accountParties : Party -> Account -> [Party]
accountParties admin account =
  case account.owner of
    Some _ -> accountObservers account
    None ->
      case account.provider of
        Some provider -> if provider == admin then [admin] else [admin, provider]
        None -> [admin]

lockObservers : Optional Lock -> [Party]
lockObservers lock =
  case lock of
    None -> []
    Some l -> l.holders

d2SweepControllers : Party -> Optional D2SeizureHook -> Party -> [Party]
d2SweepControllers admin hook burner =
  case hook of
    None -> [burner]
    Some h -> burner :: d2DestinationControllers admin h.custodianDestination

d2DestinationControllers : Party -> Account -> [Party]
d2DestinationControllers admin destination =
  filterDifferentParties (accountObservers destination) admin

filterDifferentParties : [Party] -> Party -> [Party]
filterDifferentParties parties excluded =
  case parties of
    [] -> []
    party :: rest ->
      if party == excluded
        then filterDifferentParties rest excluded
        else party :: filterDifferentParties rest excluded

allRequestedAdminsMatch : Party -> [RequestedAllocation] -> Bool
allRequestedAdminsMatch admin allocations =
  case allocations of
    [] -> True
    allocation :: rest -> allocation.admin == admin && allRequestedAdminsMatch admin rest

requireValidAllocationSpecification : AllocationSpecification -> Update ()
requireValidAllocationSpecification allocation = do
  assertMsg eNoTransferLegSides (not (null allocation.transferLegSides) || allocation.nextIterationFunding /= None)
  assertMsg eBadTransferLegSideAmount (allTransferLegSideAmountsPositive allocation.transferLegSides)
  assertMsg eBadNextIterationFunding (validNextIterationFunding allocation.nextIterationFunding)

allTransferLegAmountsPositive : [TransferLeg] -> Bool
allTransferLegAmountsPositive legs =
  case legs of
    [] -> True
    leg :: rest -> leg.amount > 0.0 && allTransferLegAmountsPositive rest

allTransferLegSideAmountsPositive : [TransferLegSide] -> Bool
allTransferLegSideAmountsPositive sides =
  case sides of
    [] -> True
    side :: rest -> side.amount > 0.0 && allTransferLegSideAmountsPositive rest

validNextIterationFunding : Optional [(Text, Decimal)] -> Bool
validNextIterationFunding funding =
  case funding of
    None -> True
    Some entries -> allFundingPositive entries

allFundingPositive : [(Text, Decimal)] -> Bool
allFundingPositive entries =
  case entries of
    [] -> True
    (_, amount) :: rest -> amount > 0.0 && allFundingPositive rest

lockInputHoldings : AllocationSpecification -> [ContractId ToyHolding] -> Update [ContractId ToyHolding]
lockInputHoldings allocation cids =
  case cids of
    [] -> pure []
    cid :: rest -> do
      holding <- fetch cid
      assertMsg eInputHoldingWrongAccount (holding.account == allocation.authorizer)
      assertMsg eInputHoldingWrongAdmin (holding.admin == allocation.admin)
      assertMsg eInputHoldingWrongInstrument (sideInstrumentPresent holding.instrumentId.id allocation.transferLegSides)
      archive cid
      lockedCid <- create holding with
        lock = Some Lock with
          holders = allocation.admin :: allocation.settlement.executors
          expiresAt = allocation.settlement.settlementDeadline
          context = Some ("allocation for settlement " <> allocation.settlement.settlementRef.id)
      lockedRest <- lockInputHoldings allocation rest
      pure (lockedCid :: lockedRest)

sideInstrumentPresent : Text -> [TransferLegSide] -> Bool
sideInstrumentPresent instrumentId sides =
  case sides of
    [] -> False
    side :: rest -> side.instrumentId == instrumentId || sideInstrumentPresent instrumentId rest

-- | Shared settlement effect for the direct (`Allocation_Settle`) and batch
-- (`Allocation_SettleInBatch`) paths, run once authorization has been
-- established by the calling choice. It (1) archives the locked input holdings
-- and tallies the value they carried per instrument, (2) enforces value
-- conservation — the locked funds must cover the authorizer's SenderSide leg
-- amounts per instrument, returning any surplus as unlocked "change" to the
-- authorizer (under-funded senders fail closed), (3) credits the authorizer's
-- ReceiverSide legs, (4) emits the V2-aligned holdings-change event, and (5)
-- creates the settlement receipt. Authorized by the enclosing allocation's
-- signatories (admin + authorizer account parties), so it needs no extra
-- authority; across a SettleBatch — where every counterparty has its own
-- allocation — this yields true delivery-versus-payment: each party is debited
-- for its SenderSide legs (locked input value) and credited for its ReceiverSide
-- legs, with no value minted from nothing and no excess silently burned.
performSettle
  : AllocationSpecification
  -> [ContractId ToyHolding]
  -> SettlementInfo
  -> [TransferLeg]
  -> [TransferLegSide]
  -> Optional Text
  -> Optional D2SeizureHook
  -> Text
  -> Update (ContractId SettlementReceipt)
performSettle allocation lockedHoldingCids settlement transferLegs localSides d1ComplianceRef d2SeizureHook flag = do
  lockedTally <- archiveAndTallyLockedHoldings lockedHoldingCids
  -- Value conservation: the locked funds must cover this authorizer's SenderSide
  -- obligations per instrument; surplus is returned as change. Iterated
  -- settlement (nextIterationFunding set) defers per-iteration conservation —
  -- funding spans iterations and is positivity-checked only, never value
  -- accounted here — so the coverage assertion is skipped on that path while
  -- surplus is still returned so no value is silently burned.
  changeCids <- conserveSenderSides allocation.admin allocation.authorizer flag
                  (allocation.nextIterationFunding == None) lockedTally localSides
  creditedCids <- creditReceiverSides allocation.admin allocation.authorizer flag localSides
  -- Emit a V2-aligned holdings-change event for wallet/indexer discovery (the
  -- promoted reporting route is EventLog_HoldingsChange). Returned change and
  -- credited holdings are both recorded as outputs.
  _ <- emitHoldingsChange allocation.admin allocation.authorizer allocation.settlement.executors
         lockedHoldingCids (changeCids <> creditedCids) localSides flag
  create SettlementReceipt with
    admin = allocation.admin
    authorizer = allocation.authorizer
    settlement
    settledTransferLegIds = transferLegIds transferLegs
    settledTransferLegSides = localSides
    d1ComplianceRef
    d2SeizureHook
    featureFlag = flag

-- | Archive each locked input holding and tally the (instrument, amount) it
-- carried, so the settlement path can verify value conservation before crediting.
-- Tally entry for an archived locked holding: its instrument, amount, and the
-- metadata it carried (so returned change can preserve that metadata).
archiveAndTallyLockedHoldings : [ContractId ToyHolding] -> Update [(InstrumentId, Decimal, Metadata)]
archiveAndTallyLockedHoldings cids =
  case cids of
    [] -> pure []
    cid :: rest -> do
      holding <- fetch cid
      archive cid
      restTally <- archiveAndTallyLockedHoldings rest
      pure ((holding.instrumentId, holding.amount, holding.meta) :: restTally)

-- | Enforce per-instrument value conservation on the settlement path: for each
-- instrument involved, the locked funds archived for this allocation must cover
-- the authorizer's SenderSide leg amounts, and any surplus is returned to the
-- authorizer's account as a fresh unlocked "change" holding. When `enforce` is
-- False (iterated settlement, where funding spans iterations) the coverage
-- assertion is skipped, but surplus is still returned so no value is burned.
-- Authorized by the enclosing allocation's signatories (admin + authorizer), so
-- the change create needs no extra authority. All of an allocation's locked
-- holdings carry `allocation.admin` (asserted at lock time), so constructing a
-- change `InstrumentId` with that admin matches the locked instrument identity.
-- Change preserves the metadata of the first locked holding for that instrument.
conserveSenderSides
  : Party
  -> Account
  -> Text
  -> Bool
  -> [(InstrumentId, Decimal, Metadata)]
  -> [TransferLegSide]
  -> Update [ContractId ToyHolding]
conserveSenderSides admin authorizer flag enforce lockedTally sides =
  conserveByInstrument admin authorizer flag enforce lockedTally sides
    (settlementInstrumentIds admin lockedTally sides)

conserveByInstrument
  : Party
  -> Account
  -> Text
  -> Bool
  -> [(InstrumentId, Decimal, Metadata)]
  -> [TransferLegSide]
  -> [InstrumentId]
  -> Update [ContractId ToyHolding]
conserveByInstrument admin authorizer flag enforce lockedTally sides instruments =
  case instruments of
    [] -> pure []
    instrumentId :: rest -> do
      let lockedSum = lockedSumForInstrument instrumentId lockedTally
          senderSum = senderSumForInstrument instrumentId.id sides
      when enforce $
        assertMsg eSettlementNotConserved (lockedSum >= senderSum)
      changeCids <-
        if lockedSum > senderSum
          then do
            cid <- create ToyHolding with
              admin
              account = authorizer
              instrumentId
              amount = lockedSum - senderSum
              lock = None
              meta = metaForInstrument instrumentId lockedTally
              featureFlag = flag
            pure [cid]
          else pure []
      restCids <- conserveByInstrument admin authorizer flag enforce lockedTally sides rest
      pure (changeCids <> restCids)

-- | The distinct instruments a settle must reconcile: those backing the locked
-- holdings AND those named by the authorizer's SenderSide legs. Including the
-- sender-side instruments ensures an under-funded sender — a SenderSide with no
-- locked holding at all — is still checked (its locked sum is 0).
settlementInstrumentIds : Party -> [(InstrumentId, Decimal, Metadata)] -> [TransferLegSide] -> [InstrumentId]
settlementInstrumentIds admin lockedTally sides =
  dedupeInstruments (map (\(i, _, _) -> i) lockedTally <> senderInstrumentIds admin sides)

senderInstrumentIds : Party -> [TransferLegSide] -> [InstrumentId]
senderInstrumentIds admin sides =
  case sides of
    [] -> []
    side :: rest ->
      case side.side of
        SenderSide -> (InstrumentId with admin; id = side.instrumentId) :: senderInstrumentIds admin rest
        ReceiverSide -> senderInstrumentIds admin rest

dedupeInstruments : [InstrumentId] -> [InstrumentId]
dedupeInstruments instruments =
  case instruments of
    [] -> []
    instrumentId :: rest -> instrumentId :: dedupeInstruments (filter (/= instrumentId) rest)

lockedSumForInstrument : InstrumentId -> [(InstrumentId, Decimal, Metadata)] -> Decimal
lockedSumForInstrument instrumentId tally =
  case tally of
    [] -> 0.0
    (i, amount, _) :: rest ->
      (if i == instrumentId then amount else 0.0) + lockedSumForInstrument instrumentId rest

-- | Metadata of the first locked holding for an instrument, for the returned
-- change holding (empty when the instrument had no locked holding).
metaForInstrument : InstrumentId -> [(InstrumentId, Decimal, Metadata)] -> Metadata
metaForInstrument instrumentId tally =
  case tally of
    [] -> emptyMetadata
    (i, _, m) :: rest -> if i == instrumentId then m else metaForInstrument instrumentId rest

senderSumForInstrument : Text -> [TransferLegSide] -> Decimal
senderSumForInstrument instrumentId sides =
  case sides of
    [] -> 0.0
    side :: rest ->
      let here = case side.side of
            SenderSide -> if side.instrumentId == instrumentId then side.amount else 0.0
            ReceiverSide -> 0.0
       in here + senderSumForInstrument instrumentId rest

-- | Credit the settlement authorizer for each of its ReceiverSide legs by
-- creating a fresh (unlocked) holding at the authorizer's account. Authorized by
-- the enclosing `Allocation`'s signatories (admin + authorizer account parties),
-- so it needs no extra authority. SenderSide legs create nothing here — the
-- sender's value left via the archived locked input holdings.
creditReceiverSides : Party -> Account -> Text -> [TransferLegSide] -> Update [ContractId ToyHolding]
creditReceiverSides admin authorizer flag sides =
  case sides of
    [] -> pure []
    side :: rest -> do
      created <- case side.side of
        ReceiverSide -> do
          cid <- create ToyHolding with
            admin
            account = authorizer
            instrumentId = InstrumentId with admin; id = side.instrumentId
            amount = side.amount
            lock = None
            meta = side.meta
            featureFlag = flag
          pure [cid]
        SenderSide -> pure []
      restCids <- creditReceiverSides admin authorizer flag rest
      pure (created ++ restCids)

unlockHoldings : [ContractId ToyHolding] -> Update [ContractId ToyHolding]
unlockHoldings cids =
  case cids of
    [] -> pure []
    cid :: rest -> do
      holding <- fetch cid
      archive cid
      unlockedCid <- create holding with lock = None
      unlockedRest <- unlockHoldings rest
      pure (unlockedCid :: unlockedRest)

sweepLockedHoldings : Account -> BurnerCapability -> [ContractId ToyHolding] -> Update [ContractId ToyHolding]
sweepLockedHoldings destination cap cids =
  case cids of
    [] -> pure []
    cid :: rest -> do
      holding <- fetch cid
      assertMsg eD2HoldingAdminMismatch (holding.admin == cap.admin)
      assertMsg eBurnerCapabilityScopeMismatch (burnerScopeAuthorizes cap.instrumentScope holding.instrumentId)
      assertMsg eD2HoldingNotLocked (holding.lock /= None)
      archive cid
      custodianCid <- create holding with
        account = destination
        lock = None
      custodianRest <- sweepLockedHoldings destination cap rest
      pure (custodianCid :: custodianRest)

fetchAllocations : [ContractId Allocation] -> Update [Allocation]
fetchAllocations cids =
  case cids of
    [] -> pure []
    cid :: rest -> do
      allocation <- fetch cid
      allocations <- fetchAllocations rest
      pure (allocation :: allocations)

collectAllocationSides : [Allocation] -> [TransferLegSide]
collectAllocationSides allocations =
  case allocations of
    [] -> []
    allocation :: rest -> allocation.allocation.transferLegSides <> collectAllocationSides rest

fetchReceipts : [ContractId SettlementReceipt] -> Update [SettlementReceipt]
fetchReceipts cids =
  case cids of
    [] -> pure []
    cid :: rest -> do
      receipt <- fetch cid
      receipts <- fetchReceipts rest
      pure (receipt :: receipts)

collectReceiptSides : [SettlementReceipt] -> [TransferLegSide]
collectReceiptSides receipts =
  case receipts of
    [] -> []
    receipt :: rest -> receipt.settledTransferLegSides <> collectReceiptSides rest

allPeerAllocationsMatch : AllocationSpecification -> [Allocation] -> Bool
allPeerAllocationsMatch allocation peers =
  case peers of
    [] -> True
    peer :: rest ->
      peer.allocation.admin == allocation.admin
        && peer.allocation.settlement == allocation.settlement
        && peer.featureFlag == experimentalFeatureFlag
        && allPeerAllocationsMatch allocation rest

allPeerReceiptsMatch : AllocationSpecification -> [SettlementReceipt] -> Bool
allPeerReceiptsMatch allocation receipts =
  case receipts of
    [] -> True
    receipt :: rest ->
      receipt.admin == allocation.admin
        && receipt.settlement == allocation.settlement
        && receipt.featureFlag == experimentalFeatureFlag
        && allPeerReceiptsMatch allocation rest

allTransferLegsAuthorized : [TransferLeg] -> [TransferLegSide] -> Bool
allTransferLegsAuthorized legs sides =
  case legs of
    [] -> True
    leg :: rest ->
      containsSide sides (senderSide leg)
        && containsSide sides (receiverSide leg)
        && allTransferLegsAuthorized rest sides

allAllocationSidesBackedByLegs : [TransferLeg] -> [TransferLegSide] -> Bool
allAllocationSidesBackedByLegs legs sides =
  case sides of
    [] -> True
    side :: rest -> sideHasMatchingLeg legs side && allAllocationSidesBackedByLegs legs rest

allAuthorizerLegSidesPresent : Account -> [TransferLeg] -> [TransferLegSide] -> Bool
allAuthorizerLegSidesPresent authorizer legs sides =
  case legs of
    [] -> True
    leg :: rest ->
      authorizerSidePresent authorizer leg sides && allAuthorizerLegSidesPresent authorizer rest sides

authorizerSidePresent : Account -> TransferLeg -> [TransferLegSide] -> Bool
authorizerSidePresent authorizer leg sides =
  let senderOk = if leg.sender == authorizer then containsSide sides (senderSide leg) else True
      receiverOk = if leg.receiver == authorizer then containsSide sides (receiverSide leg) else True
   in senderOk && receiverOk

sideHasMatchingLeg : [TransferLeg] -> TransferLegSide -> Bool
sideHasMatchingLeg legs side =
  case legs of
    [] -> False
    leg :: rest -> sideMatchesLeg side leg || sideHasMatchingLeg rest side

sideMatchesLeg : TransferLegSide -> TransferLeg -> Bool
sideMatchesLeg side leg =
  case side.side of
    SenderSide -> side == senderSide leg
    ReceiverSide -> side == receiverSide leg

senderSide : TransferLeg -> TransferLegSide
senderSide leg = TransferLegSide with
  transferLegId = leg.transferLegId
  side = SenderSide
  otherside = leg.receiver
  amount = leg.amount
  instrumentId = leg.instrumentId
  meta = leg.meta

receiverSide : TransferLeg -> TransferLegSide
receiverSide leg = TransferLegSide with
  transferLegId = leg.transferLegId
  side = ReceiverSide
  otherside = leg.sender
  amount = leg.amount
  instrumentId = leg.instrumentId
  meta = leg.meta

containsSide : [TransferLegSide] -> TransferLegSide -> Bool
containsSide sides needle =
  case sides of
    [] -> False
    side :: rest -> side == needle || containsSide rest needle

-- | Settle each allocation in a batch through `Allocation_SettleInBatch`. The
-- factory has already proven both-sidedness over all allocations once, so each
-- allocation settles WITHOUT re-fetching peer allocations/receipts — keeping the
-- batch at O(N) fetches rather than the O(N^2) the peer-proving direct path would
-- incur. `peerAllocationCids`/`peerReceiptCids` are reserved for the standalone
-- `Allocation_Settle` direct path.
settleAllocations
  : [Party]
  -> SettlementInfo
  -> [TransferLeg]
  -> Optional Text
  -> [ContractId Allocation]
  -> Update [ContractId SettlementReceipt]
settleAllocations actors settlement transferLegs d1ComplianceRef allocationCids =
  case allocationCids of
    [] -> pure []
    allocationCid :: rest -> do
      receiptCid <- exercise allocationCid Allocation_SettleInBatch with
        actors
        settlement
        transferLegs
        d1ComplianceRef
      receiptRest <- settleAllocations actors settlement transferLegs d1ComplianceRef rest
      pure (receiptCid :: receiptRest)

requireBeforeSettlementDeadline : SettlementInfo -> Update ()
requireBeforeSettlementDeadline settlement = do
  now <- getTime
  case settlement.settlementDeadline of
    None -> pure ()
    Some deadline -> assertMsg eSettlementDeadlinePassed (now <= deadline)

requireD1Reference : Optional D1ComplianceHook -> Optional Text -> Update ()
requireD1Reference hook ref =
  case hook of
    None -> pure ()
    Some h ->
      if h.requiresPerSettlementReference
        then assertMsg eD1ComplianceReferenceMissing (ref /= None)
        else pure ()

requireNoActiveD2InFlight : Optional D2SeizureHook -> Update ()
requireNoActiveD2InFlight hook =
  case hook of
    None -> pure ()
    Some _ -> abort eD2InFlightSweepRequired

requireD2InFlightSeizure : Optional D2SeizureHook -> Update D2SeizureHook
requireD2InFlightSeizure hook =
  case hook of
    None -> abort eD2InFlightMissing
    Some h -> pure h

requireBurnerCapability
  : Party
  -> Party
  -> Optional (ContractId BurnerCapability)
  -> Update BurnerCapability
requireBurnerCapability burner expectedAdmin capCid =
  case capCid of
    None -> abort eBurnerCapabilityMissing
    Some cid -> do
      cap <- fetch cid
      assertMsg eBurnerCapabilityAdminMismatch (cap.admin == expectedAdmin)
      assertMsg eBurnerCapabilityAssigneeMismatch (cap.assignee == burner)
      assertMsg eFeatureDisabled (cap.featureFlag == experimentalFeatureFlag)
      pure cap

burnerScopeAuthorizes : Optional InstrumentId -> InstrumentId -> Bool
burnerScopeAuthorizes capScope requiredScope =
  case capScope of
    None -> True
    Some scope -> scope == requiredScope

requireCustodianDestination : Account -> Update ()
requireCustodianDestination destination =
  assertMsg eD2CustodianDestinationMissing (accountHasOwnerOrProvider destination)

accountHasOwnerOrProvider : Account -> Bool
accountHasOwnerOrProvider account =
  case (account.owner, account.provider) of
    (None, None) -> False
    (Some _, _) -> True
    (_, Some _) -> True

requireIteratedSettlementAllowed
  : AllocationSpecification
  -> [TransferLegSide]
  -> Optional [(Text, Decimal)]
  -> Update ()
requireIteratedSettlementAllowed allocation extraSides nextFunding = do
  case allocation.nextIterationFunding of
    None -> do
      assertMsg eIteratedSettlementDisabled (null extraSides)
      assertMsg eIteratedSettlementDisabled (nextFunding == None)
    Some _ -> assertMsg eBadNextIterationFunding (validNextIterationFunding nextFunding)

requireWithdrawAllowed : AllocationSpecification -> Update ()
requireWithdrawAllowed allocation =
  if allocation.committed
    then do
      now <- getTime
      case allocation.settlement.settlementDeadline of
        None -> abort eCommittedWithdrawBlocked
        Some deadline -> assertMsg eCommittedWithdrawBlocked (now > deadline)
    else pure ()

transferLegIds : [TransferLeg] -> [Text]
transferLegIds legs =
  case legs of
    [] -> []
    leg :: rest -> leg.transferLegId :: transferLegIds rest

