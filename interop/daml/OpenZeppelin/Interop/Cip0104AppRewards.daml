-- | CIP-0104 interoperability proof: settlement workflows are shaped so a
-- confirming app-provider's participation is attributable from settlement views
-- alone, WITHOUT any app-specific reward-marker contract created inside
-- settlement. CIP-0104 moves app rewards from marker contracts
-- (`FeaturedAppActivityMarker` / `AppRewardCoupon`) to traffic-based activity
-- computed off-ledger by network / SV / Scan infrastructure.
--
-- Note (compile-time fact): neither the settlement package
-- (`OpenZeppelin.Settlement.Cip112`) nor this interop package
-- defines any `FeaturedAppActivityMarker` / `AppRewardCoupon` template — there is
-- nothing reward-shaped to create. These scripts additionally show, at runtime,
-- that (a) the app-provider is the executor/controller whose authority is
-- required to settle (so its participation is real and attributable), and (b)
-- the only settlement artifacts it observes are the `SettlementReceipt`s and
-- `EventLog_HoldingsChange` entries — the exact views off-ledger attribution
-- reads — with no extra marker contract required.
--
-- NON-PUBLIC, experiment-only. No CIP-0104 reward / SV / Scan production claim.
module OpenZeppelin.Interop.Cip0104AppRewards where

import DA.Assert ((===))
import Daml.Script

import OpenZeppelin.Settlement.Cip112
import OpenZeppelin.Interop.Common
import OpenZeppelin.TokenStandard.V2.Holding

-- | The app-provider's confirming participation is attributable purely from
-- settlement views: after a batch settle it observes exactly the receipts and
-- holdings-change events — the views off-ledger reward attribution reads — and
-- no reward-marker contract is created (none exists to create).
test_cip0104_attributableViaSettlementViewsWithoutMarkers : Script ()
test_cip0104_attributableViaSettlementViewsWithoutMarkers = script do
  setTime i0
  admin <- allocateParty "reward-view-admin"
  app <- allocateParty "reward-view-app"
  alice <- allocateParty "reward-view-alice"
  bob <- allocateParty "reward-view-bob"
  let aliceAcct = basicAccount alice
      bobAcct = basicAccount bob
  aliceHolding <- mintUsd [admin, alice] admin aliceAcct 50.0
  _ <- settleUsdTransfer admin app aliceAcct bobAcct aliceHolding 50.0 "reward-view"

  -- The app-provider observes the settlement receipts and holdings-change events
  -- (the attribution surface), produced by settlement itself.
  appReceipts <- query @SettlementReceipt app
  length appReceipts === 2
  appEvents <- query @SettlementEventLogEntry app
  length appEvents === 2

-- | The app-provider's participation is load-bearing, hence attributable: only
-- the settlement executor (the app-provider) can drive `SettleBatch`. A party
-- that is not the executor cannot settle — so a confirmed settlement is always
-- attributable to the app-provider without a marker contract recording it.
test_cip0104_onlyAppProviderExecutorCanSettle : Script ()
test_cip0104_onlyAppProviderExecutorCanSettle = script do
  setTime i0
  admin <- allocateParty "reward-exec-admin"
  app <- allocateParty "reward-exec-app"
  alice <- allocateParty "reward-exec-alice"
  bob <- allocateParty "reward-exec-bob"
  notApp <- allocateParty "reward-exec-notapp"
  let aliceAcct = basicAccount alice
      bobAcct = basicAccount bob
      settlement = mkSettlementInfo "reward-exec" app
      leg = mkUsdLeg "reward-exec" aliceAcct bobAcct 15.0
  aliceHolding <- mintUsd [admin, alice] admin aliceAcct 15.0
  (factory, factoryDisc) <- mkFactory admin
  aliceAlloc <- createAndAcceptAllocation admin factory factoryDisc settlement aliceAcct [senderSide leg] [aliceHolding]
  bobAlloc <- createAndAcceptAllocation admin factory factoryDisc settlement bobAcct [receiverSide leg] []

  -- A non-executor cannot settle: participation attribution is structural.
  submitMustFail (actAs [notApp] <> discloseMany [factoryDisc]) do
    exerciseCmd factory SettlementFactory_SettleBatch with
      settlement; transferLegs = [leg]; allocationCids = [aliceAlloc, bobAlloc]
      actors = [notApp]; d1ComplianceRef = None

  -- The app-provider executor settles; the settlement info attributes it as the
  -- confirming executor.
  receipts <- submit (actAs [app] <> discloseMany [factoryDisc]) do
    exerciseCmd factory SettlementFactory_SettleBatch with
      settlement; transferLegs = [leg]; allocationCids = [aliceAlloc, bobAlloc]
      actors = [app]; d1ComplianceRef = None
  length receipts === 2
  case receipts of
    receiptCid :: _ -> do
      Some receipt <- queryContractId app receiptCid
      receipt.settlement.executors === [app]
    [] -> fail "expected a settlement receipt"
