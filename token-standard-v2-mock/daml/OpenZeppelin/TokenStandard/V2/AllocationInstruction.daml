-- | Experimental local mock of `splice-api-token-allocation-instruction-v2`
-- (`Splice.Api.Token.AllocationInstructionV2`). NON-PUBLIC, experiment-only
-- stand-in (import-gate Option D). Viewtype-only; accept/withdraw behaviour is
-- realized by the implementing template's choices.
module OpenZeppelin.TokenStandard.V2.AllocationInstruction where

import OpenZeppelin.TokenStandard.V2.Metadata
import OpenZeppelin.TokenStandard.V2.Holding
import OpenZeppelin.TokenStandard.V2.Allocation

-- | Viewtype for the `AllocationInstruction` interface. Mirrors
-- `AllocationInstructionV2.AllocationInstructionView`.
data AllocationInstructionView = AllocationInstructionView with
    allocation : AllocationSpecification
    requestedAt : Time
    inputHoldingCids : [ContractId Holding]
    meta : Metadata
  deriving (Eq, Show)

interface AllocationInstruction where
  viewtype AllocationInstructionView
