-- | Experimental local mock of `splice-api-token-transfer-events-v2`
-- (`Splice.Api.Token.TransferEventsV2`). NON-PUBLIC, experiment-only stand-in
-- (import-gate Option D). Provides the `EventLog` interface (viewtype-only) and
-- the `EventLog_HoldingsChange` event record that wallets/indexers subscribe to
-- instead of reverse-engineering factory interactions. The non-consuming
-- holdings-change emission is realized by the implementing template's choice in
-- the settlement scaffold.
module OpenZeppelin.TokenStandard.V2.TransferEvents where

import OpenZeppelin.TokenStandard.V2.Metadata
import OpenZeppelin.TokenStandard.V2.Holding
import OpenZeppelin.TokenStandard.V2.Allocation (TransferSide)

-- | The transfer-events leg side. Mirrors `TransferEventsV2.TransferLegSide`
-- (`side` / `transferLegId` / `otherside`).
data EventLogTransferLegSide = EventLogTransferLegSide with
    side : TransferSide
    transferLegId : Text
    otherside : Account
  deriving (Eq, Show)

-- | The holdings-change event. Mirrors `TransferEventsV2.EventLog_HoldingsChange`:
-- the inputs consumed and outputs created in a settlement/seizure step.
data EventLog_HoldingsChange = EventLog_HoldingsChange with
    admin : Party
    account : Account
    inputHoldingCids : [ContractId Holding]
    outputHoldingCids : [ContractId Holding]
    transferLegSides : [EventLogTransferLegSide]
    observers : [Party]
    meta : Metadata
  deriving (Eq, Show)

-- | Viewtype for the `EventLog` interface. Mirrors `TransferEventsV2.EventLogView`.
data EventLogView = EventLogView with
    admin : Party
    meta : Metadata
  deriving (Eq, Show)

interface EventLog where
  viewtype EventLogView
