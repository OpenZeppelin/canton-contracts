-- | Experimental local mock of `splice-api-token-transfer-instruction-v2`
-- (`Splice.Api.Token.TransferInstructionV2`). NON-PUBLIC, experiment-only
-- stand-in (import-gate Option D). Viewtype-only; accept/reject/withdraw
-- behaviour is realized by the implementing template's choices.
module OpenZeppelin.TokenStandard.V2.TransferInstruction where

import OpenZeppelin.TokenStandard.V2.Metadata
import OpenZeppelin.TokenStandard.V2.Holding

-- | A V2 transfer. Mirrors `TransferInstructionV2.Transfer` (account-to-account
-- with explicit input holdings).
data Transfer = Transfer with
    sender : Account
    receiver : Account
    amount : Decimal
    instrumentId : InstrumentId
    requestedAt : Time
    executeBefore : Time
    inputHoldingCids : [ContractId Holding]
    meta : Metadata
  deriving (Eq, Show)

-- | Viewtype for the `TransferInstruction` interface. Mirrors
-- `TransferInstructionV2.TransferInstructionView`.
data TransferInstructionView = TransferInstructionView with
    transfer : Transfer
    expiresAt : Optional Time
    meta : Metadata
  deriving (Eq, Show)

interface TransferInstruction where
  viewtype TransferInstructionView
