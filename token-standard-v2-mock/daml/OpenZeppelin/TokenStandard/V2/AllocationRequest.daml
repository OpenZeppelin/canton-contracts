-- | Experimental local mock of `splice-api-token-allocation-request-v2`
-- (`Splice.Api.Token.AllocationRequestV2`). NON-PUBLIC, experiment-only
-- stand-in (import-gate Option D). Viewtype-only; accept/reject/withdraw
-- behaviour is realized by the implementing template's choices.
module OpenZeppelin.TokenStandard.V2.AllocationRequest where

import OpenZeppelin.TokenStandard.V2.Metadata
import OpenZeppelin.TokenStandard.V2.Holding
import OpenZeppelin.TokenStandard.V2.Allocation

-- | Viewtype for the `AllocationRequest` interface. Mirrors
-- `AllocationRequestV2.AllocationRequestView`.
data AllocationRequestView = AllocationRequestView with
    authorizer : Account
    settlement : SettlementInfo
    allocations : [RequestedAllocation]
    settleAt : Optional Time
    meta : Metadata
  deriving (Eq, Show)

interface AllocationRequest where
  viewtype AllocationRequestView
