-- | Experimental local mock of the Canton Token Standard V2 metadata package.
--
-- Mirrors `splice-api-token-metadata-v1` (`Splice.Api.Token.MetadataV1`) shape
-- for the M1 settlement RI. This is a NON-PUBLIC, experiment-only stand-in: per
-- the CIP-0112 import-gate decision (Option D), we keep local stand-ins aligned
-- with `hyperledger-labs/splice @ token-standard-v2-upcoming` and defer importing
-- the real DARs. The upstream `Metadata` carries `TextMap AnyValue`; the
-- experiment uses an association list of `(Text, Text)` as its accepted local
-- encoding so the eventual swap to the real package is mechanical.
module OpenZeppelin.TokenStandard.V2.Metadata where

-- | Free-form key/value metadata attached to V2 records. Experimental encoding.
data Metadata = Metadata with
    entries : [(Text, Text)]
  deriving (Eq, Ord, Show)

emptyMetadata : Metadata
emptyMetadata = Metadata with entries = []
